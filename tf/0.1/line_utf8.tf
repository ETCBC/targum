וֻתקָרֵיב יָת לֵיוָאֵי לִקדָםקָדָם מַשׁכַן זמנא ותִכנֹושׁ יָת כֹל כנִשׁתָא דִבנֵי ישׂראל
וֻתקָרֵיב יָת לֵיוָאֵי קדםלִקדָם יוי ויִסמכוּן בנֵי ישׂראל יָת ידֵיהֹון עַל לֵיוָאֵי
וִירִים אהרן יָת לֵיוָאֵי אַרָמָא קדם יוי מִן בנֵי ישׂראל וִיהֹון למִפלַח יָת פוּלחָנָא דַיוי
ולֵיוָאֵי יִסמכוּן יָת ידֵיהֹון עַל רֵישׁ תֹורֵי ועִיבֵיד יָת חַד חַטָתָא ויָת חַד עַלָתָא קדם יוי לכַפָרָא עַל לֵיוָאֵי
וֻתקִים יָת לֵיוָאֵי קדָם אהרן וֻקדָם בנֹוהִי וֻתרִים יָתהֹון אַרָמָא קדם יוי
ותַפרֵישׁ יָת לֵיוָאֵי מִגֹו בנֵי ישׂראל וִיהֹון משַׁמשִׁין קדָמַי לֵיוָאֵי
וֻבָתַר כֵין יֵיעַלוּן לֵיוָאֵי למִפלַח יָת פלחן מַשׁכַן זִמנָא וֻתדַכֵי יָתהֹון וֻתרִים יָתהֹון אַרָמָא
אַרֵי אַפרָשָׁא מַפרשִׁין אִנוּן קדָמַילי מִגֹו בנֵי ישׂראל חַלָף פָתַח כֹל וַלדָא בוּכרָא כֹולָא מִבנֵי ישׂראל קָרֵיבִית יָתהֹון לִקדָמָיקָדָמָילפולחני
אַרֵי דִילִי כֹל בוּכרָא בִבנֵי ישׂראל בַאַנָשָׁא וֻבִבעִירָא ביֹומָא דִקטַלִית כֹל בוּכרָא בארעא דמצרים אַקדֵישִׁית יָתהֹון קדָמָי
וקָרֵיבִית יָת לֵיוָאֵי חַלָף כֹל בוּכרָא בִבנֵי ישׂראל
ויהַבִית יָת לֵיוָאֵי מסירין יהִיבִיןמסירין לאהרן ולִבנֹוהִי מִגֹו בנֵי ישׂראל למִפלַח יָת פוּלחַן בנֵי ישׂראל במַשׁכַן זִמנָא וֻלכַפָרָא עַל בנֵי ישׂראל ולָא יהֵי בִבנֵי ישׂראל מֹותָארגזא במִקרַב בנֵי ישׂראל לקוּדשָׁא
וַעַבַד מֹשַׁה ואהרן וכֹל כנִשׁתָא דִבנֵי ישׂראל ללֵיוָאֵי ככֹלכמא דפַקֵיד יוי יָת משׁה ללֵיוָאֵי כֵין עַבַדוּ להֹון בנֵי ישׂראל
ואִידַכִיוּ לֵיוָאֵי וחַוַרוּ לבוּשֵׁיהֹון וַאַרֵים אַהַרֹן יָתהֹון אַרָמָא קדם יוי וכַפַר עַלֵיהֹון אהרן לדַכֹואֵיהֹון
וֻבָתַר כֵין עָלוּ לֵיוָאֵי למִפלַח יָת פוּלחָנהֹון במַשׁכַן זִמנָא קדָם אַהרֹן וֻקדָם בנֹוהִי כמָא דפַקֵיד יוי יָת מֹשַׁה עַל לֵיוָאֵי כֵין עַבַדוּ להֹון
ומליל יוי עםלות משׁה למימר
דָא דִללֵיוָאֵי מִבַר עַסרִין וחַמֵישׁ חמישׁ ועסרין שׁנִין וֻלעֵילָא יֵיתֵי לחַיָילָא חֵילָא בפוּלחַן מַשׁכַן זִמנָא
וֻמִבַר חַמשִׁין שׁנִין יתוּב מֵחֵיל פוּלחָנָא ולָא יִפלַח עֹוד
וִישַׁמֵישׁ עִםית אַחֹוהִי במַשׁכַן זִמנָא למִטַר מַטרָא ופוּלחָנָא לָא יִפלַח כדֵין תַעַבֵיד ללֵיוָאֵי במַטרָתהֹון
וֻמַלֵיל יוי עִם משׁה במַדברָא דסִינַי בשַׁתָא תִניֵיתָא למִפַקהֹון מֵאַרעָא דמצרים ביַרחָא קַדמָאָה למֵימַר
ויַעבדוּן בנֵי ישׂראל יָת גזירת פִסחָא בזִמנֵיה
באַרבעַת עַסרָא יֹומָא ביַרחָאליַרחָא קדמאה הָדֵין בֵין שִׁמשַׁיָא תַעבדוּן יָתֵיה בזִמנֵיה ככֹל גזֵירָתֵיה וֻככָל דחָזֵי לֵיה תַעבדוּן יָתֵיה
וֻמַלֵיל מֹשַׁה עִם בנֵי ישׂראל למַעַבַד פִסחָא
וַעַבַדוּ יָת פִסחָא בנִיסָן באַרבעַת עַסרָא יֹומָא ליַרחָא בֵין שִׁמשַׁיָא במַדברָא דסִינַי ככֹל דפַקֵיד יוי יָת מֹשַׁה כֵין עַבַדוּ בנֵי ישׂראל
וַהוֹו גֻברַיָא דַהוֹו מסָאַבִין לִטמֵי נַפשָׁא דַאַנָשָׁא ולָא יכִילוּ למַעַבַד פִסחָא ביֹומָא הַהוּא וֻקרִיבוּ קדָם מֹשַׁה וֻקדָם אַהַרֹן ביֹומָא הַהוּא
וַאַמַרוּ גֻברַיָא הָאִינוּן לֵיה אַנַחנָא מסָאַבִין לִטמֵי נַפשָׁא דַאַנָשָׁא למָא נִתמנַע בדִיל דלָא לקָרָבָא יָת קוּרבָנָא דַיוי בִזמנֵיה בגֹו בנֵי ישׂראל
וַאַמַר להֹון מֹשַׁה אֹורִיכֹו עַד דאִשׁמַע מָא דאִתפַקַד מִן קדם יוי מימרא דייי עַל מימר דִילכֹון
ומליל יוי עםלות משׁה למימר
מַלֵיל עִם בנֵי יִשׂרָאֵל למֵימַר גבַר גבַר אַרֵי יהֵי מסָאַב לִטמֵי נַפשָׁא דַאַנָשָׁא אֹו באֹורַח רַחִיקָא לכֹון אֹו לדָרֵיכֹון ויַעַבֵיד פִסחָא קדם יוי
ביַרחָא תִניָנָא באַרבעַת עַסרָא יֹומָא בֵין שִׁמשַׁיָא יַעבדוּן יָתֵיה עַל פַטִיר וֻמרָרִין יֵיכלוּנֵיה
לָא יַשׁאַרוּן מִנֵיה עַד צַפרָא וגַרמָא לָא יִתברוּן בֵיה ככֹל גזֵירַת פִסחָא יַעבדוּן יָתֵיה
וֻגבַר דהוּא דכֵי וֻבאֹורַח לָא הַוָה ויִתמנַע מִלמַעַבַדלמיעבד פִסחָא ויִשׁתֵיצֵי אַנָשָׁא הַהוּא מֵעַמֵיה אַרֵי קוּרבָנָא דַיוי לָא קָרֵיב בזִמנֵיה חֹובֵיה יקַבֵיל גֻברָאאינשׁא הַהוּא
וַאַרֵי יִתגַייַר עִמכֹון גִיֹורָא ויַעַבֵיד פִסחָא קדָם יוי כִגזֵירַת פִסחָא וֻכדַחזֵי לֵיה כֵין יַעַבֵיד קיָמָא חַד יהֵי לכֹון וֻלגִיֹורַיָא וֻליַצִיבַיָא דאַרעָא
וֻביֹומָא דאִיתָקַם ית מַשׁכנָא חַפָא עַנָנָא יָת מַשׁכנָא למַשׁכנָא דסָהַדוּתָא וֻברַמשָׁא הָוֵי עַל מַשׁכנָא כחֵיזֹו אִישָׁתָא עַד צַפרָא
כֵין הָוֵי תדִירָא עַנָנָא חָפֵי לֵיה וחֵיזוּ אִישָׁתָא בלֵיליָאליליא
וֻלפֹום אִסתַלָקוּת ענָנָא מֵעִלָוֵי מַשׁכנָא וֻבָתַר כֵין נָטלִין בנֵי ישׂראל וֻבאַתרָא דשָׁרֵי תַמָן ענָנָא שָׁרַן בנֵי ישׂראל
עַל מֵימרָא דַיוי נָטלִין בנֵי ישׂראל ועַל מֵימרָא דַיוי שָׁרַן כֹל יֹומִין דשָׁרֵי עַנָנָא עַל מַשׁכנָא שָׁרַן
וֻבאֹורָכוּת עַנָנָא עַל מַשׁכנָא יֹומִין סַגִיאִין ונָטרִין בנֵי ישׂראל יָת מַטרַת מֵימרָא דַיוי ולָא נָטלִין
ואִית דהָוֵידי יהא עַנָנָא יֹומִין דמִניָן עַל מַשׁכנָא עננא על משׁכנא יומין דמנין עַל מֵימרָא דַיוי שָׁרַן ועַל מֵימרָא דַיוי נָטלִין
ואִית דהָוֵי עַנָנָא מֵרַמשָׁא עַד צַפרָא וֻמִסתַלַק עַנָנָא בצַפרָא ונָטלִין אֹו יֵימָם ולֵילֵי וֻמִסתַלַק עַנָנָא ונָטלִין
אֹו תרֵין יֹומִין אֹו יַרחָא אֹו עִידָן בעִידָן באֹורָכוּת עַנָנָא עַל מַשׁכנָא למִשׁרֵי עַלֹוהִי שָׁרַן בנֵי ישׂראל ולָא נָטלִין וֻבאִסתַלָקוּתֵיה נָטלִין
עַל מֵימרָא דַיוי שָׁרַן ועַל מֵימרָא דַיוי נָטלִין יָת מַטרַת מֵימרָא דַיוי נָטרִין עַל מֵימרָא דַיוי בִידָא דמֹשַׁה
ומליל יוי עםלות משׁה למימר
עִיבֵיד לָך תַרתֵין חַצֹוצרָן דִכסַף נגִיד תַעַבֵיד יָתהֹון ויִהויָןויִהוִיָן לָך לעָרָעָא כנִשׁתָא וֻלאַטָלָאלאעלא יָת מַשׁרִיתָא
ויִתקעוּן בהֹון ויִזדמנוּן לוָתָךלך כֹל כנִשׁתָא לִתרַע מַשׁכַן זִמנָא
ואִם בַחדָא יִתקעוּן ויִזדָמנוּן לוָתָךלך רַברבַיָא רֵישֵׁי אַלפַיָא דישׂראל
ותִתקעוּן יַבָבתָא ויִטלָן מַשׁרִיָתָא דשָׁריָן קִדוּמָאמדינחא
ותִתקעוּן יַבָבתָא תִניָנוּת ויִטלָן מַשׁרִיָתָא דשָׁריָן דרֹומָא יַבָבתָא יִתקעוּן למַטלָנֵיהֹון
וֻבמִכנַשׁ יָת קהָלָא תִתקעוּן ולָא תיַבבוּן
וֻבנֵי אהרן כָהַנַיָא יִתקעוּן בַחצֹוצרָתָא ויִהויָןויִהוִיָן לכֹון לִקיָם עָלַם לדָרֵיכֹון
וַאַרֵי תֵיעַלוּן לאָגָחָא קרָבָא בַאַרַעכֹון עַל מעִיקֵי דִמעִיקִין לכֹון וֻתיַבבוּן בַחצֹוצרָתָא ויֵיעֹול דוּכרָנכֹון לטָבָא קדם יוי אַלָהַכֹון ותִתפַרקוּן מִסָנאֵיכֹוןמבעלי דבביכון
וֻביֹום חַדוַתכֹון וֻבמֹועַדֵיכֹון וֻברֵישֵׁי יַרחֵיכֹון וֻתִתקעוּן בַחצֹוצרָתָא עַל עַלָוָתהֹון ועַל נִכסַת קוּדשֵׁיכֹון וִיהֹון לכֹון לדוּכרָנָא קדָם אַלָהַכֹין אַנָא יוי אַלָהַכֹון
וַהַוָה בשַׁתָא תִניֵיתָא ביַרחָא תִניָנָא בעַסרִין ביַרחָאליַרחָא אִסתַלַק עַנָנָא מֵעִלָוֵי מַשׁכנָא דסָהַדוּתָא
וֻנטַלוּ בנֵי ישׂראל למַטלָנֵיהֹון מִמִדברָא דסִינַי וֻשׁרָא עַנָנָא במַדברָא דפָראָן
וֻנטַלוּ בקַדמֵיתָא עַל מֵימרָא דַיוי בִידָא דמֹשַׁה
וֻנטַל טֵיקַס מַשׁרִית בנֵי יהוּדָה בקַדמֵיתָא לחֵילֵיהֹון ועַל חֵילֵיה נַחשֹׁון בַר עַמִינָדָב
ועַל חֵילָא דשִׁבטָא דִבנָי יִשָׂשׂכָר נתַנאֵל בַר צוּעָר
ועַל חֵילָא דשִׁבטָאלשׁיבטא דִבנֵי זבוּלֻן אַלִיאָב בַר חֵילֹן
וֻמִתפָרַק מַשׁכנָא ונָטלִין בנֵי גֵרשֹׁון וֻבנֵי מרָרִי נָטלֵי מַשׁכנָא
ונָטֵיל טֵיקַס מַשׁרִית ראובן לחֵילֵיהֹון ועַל חֵילֵיה אַלִיצוּר בַר שׁדֵיאוּר
ועַל חֵילָא דשִׁבטָא דִבנֵי שִׁמעֹון שׁלֻמִיאֵל בַר צוּרִי שַׁדָי
ועַל חֵילָא דשִׁבטָא דִבנֵי גָד אַליָסָף בַר דעוּאֵל
ונָטלִין בנֵי קהָת נָטלֵי מַקדשָׁא וֻמקִימִין יָת מַשׁכנָא עַד מֵיתֵיהֹון
ונָטֵיל טֵיקַס מַשׁרִית בנֵי אַפרַיִם לחֵילֵיהֹון ועַל חֵילֵיה אַלִישָׁמָע בַר עַמִיהוּד
ועַל חֵילָא דשִׁבטָא דִבנֵי מנָשָׁה גַמלִיאֵל בַר פדָה צוּר
ועַל חֵילָא דשִׁבטָא דִבנֵי בִניָמִן אַבִידָן בַר גִדעֹנִי
ונָטֵיל טֵיקַס מַשׁרִית בנֵי דָן מכַנֵישׁ לכֹל מַשׁרִיָתָא לחֵילֵיהֹון ועַל חֵילֵיה אַחִיעַזַר בַר עַמִי שַׁדָי
ועַל חֵילָא דשִׁבטָא דִבנֵי אָשֵׁר פַגעִיאֵל בַר עָכרָן
ועַל חֵילָא דשִׁבטָא דִבנֵי נַפתָלִי אַחִירַע בַר עֵינָן
אִלֵין מַטלָנֵי בנֵי ישׂראל לחֵילֵיהֹון וֻנטַלוּ
וַאַמַר מֹשַׁה לחֹבָב בַר רעוּאֵל מִדיַנָאָה חַמוּהִי דמֹשַׁה נָטלִין אַנַחנָא לאַתרָא דַאַמַר יוי יָתֵיה אַתֵין לכֹון אֵיתַא עִימַנָא ונֹוטֵיב לָך אַרֵי יוי מַלֵיל לאֵיתָאָה טָבתָא עַל יִשׂרָאֵל
וַאַמַר לֵיה לָא אֵיזִיל אַלָהֵין לאַרעִי וֻלַילָדוּתִי אֵיזִיל
וַאַמַר לָא כעַן תִשׁבֹוק יָתַנָא אַרֵי עַל כֵין ידַעתָא כַד הַוֵינָא שָׁרַן במַדברָא וֻגבוּרָן דאִתעַבִידָא לַנָא חַזֵיתָא בעֵינָך
וִיהֵי אַרֵי תֵיזֵילתיעול עִמַנָא וִיהֵי טָבָא הַהוּא דיֹוטֵיב יוי עִמַנָא ונֹוטֵיב לָך
וֻנטַלוּ מִטוּרָא דאִתגלִי עַלֹוהִי יקָרָא דַיוי מַהלַך תלָתָא יֹומִין וַאַרֹון קיָמָא דַיוי נָטֵיל קדָמֵיהֹון מַהלַך תלָתָא יֹומִין לאַתקָנָא להֹון אַתַר בֵית מִשׁרֵי
וַעַנַן יקָרָא דַיוי מַטַל עִלָוֵיהֹוןעליהון בִימָמָא במִטַלהֹון מִן מַשׁרִיתָא
וַהַוָה במִיטַל אַרֹונָא וַאַמַר מֹשַׁה אִתגלִי יוי ויִתבַדרוּן סָנאָך ויערקוּן בַעלֵי דבָבָך מִן קדָמָך
וֻבמִשׁרֹוהִי הוה אַמַר תוּב יוי שׁרִי בִיקָרָך בגֹו רִבוָת אַלפַיָא דיִשׂרָאֵל
וַהַוָה עַמָא כַד מִסתַקפִין בִישׁ קדם יוי וֻשׁמִיַע קדם יוי וֻתקֵיף רוּגזֵיה וֻדלֵיקַת בהֹון אִישָׁתָא מִן קדָם יוי ושֵׁיצִיאַת בִסיָפֵי מַשׁרִיתָא
וֻצוַח עַמָא למֹשַׁהעַל מֹשַׁה וצַלִי מֹשַׁה קדם יוי ואִשׁתקַעַת אִישָׁתָא
וֻקרָא שׁמֵיה דאַתרָא הַהוּא דלֵיקתָא אַרֵי דלֵיקַת בהֹון אִישָׁתָא מִן קדם יוי
ורַברבִיןועֵירַברבִיןוערבובין דבֵינֵיהֹון שַׁאִילוּ שׁאֵילָתָא ותָבוּ וֻבכֹו אַף בנֵי ישׂראל וַאַמַרוּ מַן יֹוכֵילִינַנָא בִסרָא
דכִירִין אַנַחנָא יָת נוּנַיָא דַהוֵינָא אָכלִין במִצרַיִם מַגָן יָת בֹוצִינַיָאקישׁואיא ויָת אַבַטִיחַיָא וכָרָתֵי ובוּצלֵי ותוּמֵי
וֻכעַן נַפשַׁנָא דָאִיבָאתַאִיבָא לֵית כֹל מִדָעַם אַלָהֵין למַנָא עֵינַנָא
וֻמַנָא כבַר זרַע גִידָא הוּא וחַזוֵיה כחֵיזוּ בדוּלחָא
שָׁיטִיןנפקין עַמָא ולָקטִין דצָבֵי טָחֵין ברִחיָא וֻדצָבֵיאו דצבי דָאֵיך בִמדֹוכתָא וֻמבַשׁלִין לֵיה בקִדרָא ועָבדִין יָתֵיה גרִיצָןגריסן והָוֵי טַעמֵיה כִטעֵים דלִישׁ במִשׁחָא
וכַד נָחֵית טַלָא עַל מַשׁרִיתָא בלֵיליָאליליא נָחֵית מַנָא עַלֹוהִי
וֻשׁמַע מֹשַׁה יָת עַמָא בָכַן לזַרעַיָתהֹון גבַר בִתרַעלתרע מַשׁכנֵיה וֻתקֵיף רוּגזָא דַיוי לַחדָא וֻבעֵינֵי מֹשַׁה בִישׁ
וַאַמַר מֹשַׁה קדם יוי למָא אַבאֵישׁתָא לעַבדָך וֻלמָא לָא אַשׁכַחִית רַחמִין קדָמָך לשַׁוָאָה יָת מַטוּל כֹל עַמָא הָדֵין עַלָי
הַאַב אַנָא לכֹל עַמָא הָדֵין אִם בנַי אִנוּן דַאַמַרת לִי סֹובַרהִי בתוּקפָך כמָא דִמסֹובַר תֹורביַנָא יָת יָנקָא עַל אַרעָא דקַיֵימִית לַאַבָהָתֹוהִי
מַנָן לִי בִסרָא למִיתַן לכֹל עַמָא הָדֵין אַרֵי יִבכֹון עַלַי למֵימַר הַב לַנָא בִסרָא ונֵיכֹול
לֵית אַנָא יָכֵיל בִלחֹודַי לסֹובָרָא יָת כֹל לכל עַמָא הָדֵין אַרֵי יַקִיר מִנִי
ואִם כדֵין אַת עָבֵיד לִי קטֹולנִי כעַן מִקטָל אִם אַשׁכַחִית רַחמִין בעֵינָךקָדָמָך ולָא אִחזֵי בבִשׁתִי
וַאַמַר יוי למשׁה כנֹושׁ קדָמַי שִׁבעִין גֻברָא מִסָבֵי יִשׂרָאֵל דיָדַעת אַרֵי אִיֻנון סָבֵי עַמָא וסָרכֹוהִי ותִדבַר יָתהֹון למַשׁכַן זִמנָא ויִתעַתדוּן תַמָן עִמָך
ואִתגלִי וַאַמַלֵיל עִמָךיתך תַמָן וַאַרַבֵי מִן רוּחָא דַעַלָך וַאַשַׁוֵי עִלָיֵהֹוןעלֵיהֹון וִיסֹוברוּן עִמָך במַטוּל עַמָא ולָא תסֹובַר אַת בִלחֹודָך
וֻלעַמָא תֵימַר אִזדָמַנוּ לִמחַר ותֵיכלוּן בִסרָא אַרֵי בכֵיתֹון קדם יוי למֵימַר מַן יֹוכֵילִינַנָא בִסרָא אַרֵי טָב לַנָא במִצרַיִם ויִתֵין יוי לכֹון בִסרָא ותֵיכלוּן
לָא יֹומָא חַד תֵיכלוּן ולָא תרֵין יֹומִין ולָא חַמשָׁה יֹומִין ולָא עַסרָא יֹומִין ולָא עַסרִין יֹומִין
עַד ירַח יֹומִין עַד דִתקוּצוּן בֵיה וִיהֵי לכֹון לתַקלָא חַלָף דקַצתוּן במֵימרָאית מימרא דַיוי דִשׁכִינתֵיה שָׁריָא בֵינֵיכֹון וֻבכֵיתֹון קדָמֹוהִי למֵימַר למָא דנָן נפַקנָא מִמִצרָיִם
וַאַמַר מֹשַׁה שֵׁית מאָה אַלפִין גֻברָא רִגלָאָה עַמָא דַאַנָא בֵינֵיהֹון ואַת אַמַרת בִסרָא אַתֵין להֹון ויֵיכלוּן ירַח יֹומִין
הַעָן ותֹורִין יִתנַכסוּן להֹון הַיסַפקוּן להֹון אִם יָת כֹל נוּנֵי יַמָא יִתכַנשׁוּן להֹון הַיסַפקוּן להֹון
וַאַמַר יוי למֹשַׁה הַמֵימרָא דַיוי יִתעַכַב כעַן תִחזֵי הַיעָרעִינָך פִתגָמִי אִם לָא
וֻנפַק מֹשַׁה וֻמַלֵיל עִם עַמָא לעמא יָת כל פִיתגָמַיָא דַיוי וֻכנַשׁ שִׁבעִין גֻברָא מִסָבֵי עַמָא וַאַקֵים יָתהֹון סחור סחור למַשׁכנָא סחרנות משׁכנא
ואִתגלִי יוי בַעַנָנָא וֻמַלֵיל עִמֵיה ורַבִי מִן רוּחָא דַעַלֹוהִי וִיהַב עַל שִׁבעִין גֻברָא סָבַיָא וַהַוָה כַד שׁרָת עַלֵיהֹון רוּחַ נבוּאָה וֻמִתנַבַן ולָא פָסקִין
ואִשׁתאַרוּ תרֵין גֻברִין במַשׁרִיתָא שֹׁום חַד אַלדָד ושֹׁום תִניָנָא מֵידָד וֻשׁרָת עַלֵיהֹון רוּחַ נבוּאָה ואִינוּן בִכתִיבַיָא ולָא נפַקוּ למַשׁכנָא ואִתנַבִיוּ במַשׁרִיתָא
וֻרהַט עוּלֵימָא וחַוִי למֹשַׁה וַאַמַר אַלדָד וֻמֵידָד מִתנַבַן במַשׁרִיתָא
וַאַתֵיב יהֹושֻׁעַ בַר נוּן משׁוּמשָׁנֵיה דמֹשַׁה מִעוּלֵימוּתֵיה וַאַמַר רִבֹונִי מֹשַׁה אֵיסרִינוּן
וַאַמַר לֵיה מֹשַׁה הַקִנאַתִי אַת מקַנֵי לי רעֵינָא פֹון דִיהֹון כֹל עַמֵיה דַיוי נבִיִין אַרֵי יִתֵין יוי יָת רוּחַ נבוּאַתֵיה עַלֵיהֹון
ואִתכנֵישׁ מֹשַׁה למַשׁרִיתָא הוּא וסָבֵי ישׂראל
ורוּחָא נטַל מִן קדם יוי ואַפרַח סלָיו מִן יַמָא וֻרמָהִי עַל מַשׁרִיתָא כמַהלַך יֹומָא לכָא וֻכמַהלַך יֹומָא לכָא סחור סחור למַשׁרִיתָא וֻכרוּם תַרתֵין אַמִין עַל אַפֵי כל ארעא
וקָם עַמָא כֹל יֹומָא הַהוּא וכֹל לֵיליָא וכֹל יֹומָא דבָתרֹוהִי וֻכנַשׁוּ יָת סלָיו דאַזעַר כנַשׁ עַסרָה דגֹורִין וֻשׁטַחוּ להֹון מַשׁטחִין סחור סחור למַשׁרִיתָא
בִסרָא עַד כעַןדהוא בֵין שִׁנֵיהֹון עַד לָא פסַק ורוּגזָא דַיוי תקֵיף בעַמָא וֻקטַל יוי בעַמָא קטֹול סַגִי לַחדָא
וֻקרָא יָת שׁמֵיה דאַתרָא הַהוּא קִברֵי דִמשַׁאַלֵי אַרֵי תַמָן קבַרוּ יָת עַמָא דשַׁאִילוּ
מִקִברֵי דִמשַׁאַלֵי נטַלוּ עַמָא לחַצֵירֹות וַהוֹו בַחַצֵירֹות
וֻמַלֵילַת מִריָם ואַהַרֹן במֹשַׁה עַל עִיסַקעַל עֵיסַק אִיתתָא שַׁפִירתָא דִנסִיב אַרֵי אִיתתָא שַׁפִירתָא דִנסִיב רַחִיקרַחֵיק
וַאַמַרוּ הַלחֹוד ברַם עִם מֹשַׁה במשׁה מַלֵיל יוי הַלָא אַף עִמַנָאבנא מַלֵיל וֻשׁמִיַע קדם יוי
וגֻברָא מֹשַׁה עִנותָן לַחדָא מִכֹל אַנָשָׁא דעַל אַפֵי ארעא
וַאַמַר יוי בִתכֵיף למֹשַׁה ולאהרן וֻלמִריָם פוּקוּ תלָתֵיכֹון למַשׁכַן זִמנָא וֻנפַקוּ תלָתֵיהֹון
ואִתגלִי יוי בַעַמוּדָא דַעַנָנָא וקָם בִתרַעלתרע מַשׁכנָאמשׁכן זמנא וֻקרָא אהרן וֻמִריָם וֻנפַקוּ תַרוֵיהֹון
וַאַמַר שׁמַעוּ כעַן פִתגָמַי אִם יהֹון לכֹון נבִיִין אַנָא יוי בחַזוִין אַנָא מִתגלֵי להֹון בחִלמִין אַנָא ממַלֵיל עִמהֹון
לָא כֵין עַבדִי מֹשַׁה בכָל עַמִיבֵיתִי מהֵימָן הוּא
מַמלַל עִם מַמלַל ממַלֵילנָא עִמֵיה בחֵיזוּ ולָא בחִדוָן וֻבִדמוּת יקָרָא דַיוי מִסתַכַל וֻמָדֵין לָא דחֵילתוּן למַלָלָא בעַבדִי במשׁה
וֻתקֵיף רוּגזָא דַיוי בהֹון ואִסתַלַק
וַעַנָנָא אִסתלַקאִסתַלַק מֵעִלָוִי מַשׁכנָא והָא מִריָם חָורָא כתַלגָא ואִתפנֵי אַהַרֹן לוָת מִריָם למרים והָא סגִירָא
וַאַמַר אַהַרֹן למֹשַׁה בבָעוּ רִבֹונִי לָא כעַן תשַׁוֵי עַלַנָא חֹובָא דאִטפַשׁנָא ודִסרַחנָא
לָא כעַן תִתרַחַק דָא מִבֵינַנָא אַרֵי אַחָתַנָא הִיא צַלִי כעַן עַל בִסרָא מִיתָא הָדֵין דבַה ויִתַסִי
וצַלִי מֹשַׁה קדם יוי למֵימַר אַלָהָא בבָעוּ אַסִיאַסִי כעַן יָתַהלה
וַאַמַר יוי למֹשַׁה ואִילוּ אַבוּהָא מִיזָף נזַף בַה הַלָא תִתכלֵים שִׁבעָה יֹומִין תִסתגַר שִׁבעָה יֹומִין מִיבַרָאלמברא למַשׁרִיתָא וֻבָתַר כֵין תִתכנֵישׁ
ואִסתגַרַת מִריָם מִיבַרָא למַשׁרִיתָא שִׁבעָה יֹומִין ועַמָא לָא נטַל עַד דאִתכנֵישַׁת מִריָם
וֻבָתַר כֵין נטַלוּ עַמָא מֵחַצֵירֹות וֻשׁרֹו במַדברָא דפָארָן
ומליל יוי עםלות משׁה למימר
שׁלַח לָך גֻברִין וִיאַללוּן יָת אַרעָא דִכנַעַן דַאַנָא יָהֵיב לִבנֵי יִשׂרָאֵל גֻברָא חַד גֻברָא חַד לשִׁבטָא דַאַבָהָתֹוהִי תִשׁלחוּן כֹל רַבָא דִבהֹוןבהון
וֻשׁלַח יָתהֹון מֹשַׁה מִמִדברָא דפָארָן עַל מֵימרָא דַיוי כוּלהֹון גֻברִין רֵישֵׁי בנֵי ישׂראל אִנוּן
ואִלֵין שׁמָהָתהֹון לשִׁבטָא דִראוּבֵן שַׁמוּעַ בַר זַכוּר
לשִׁבטָא דִשִׁמעֹון שָׁפָט בַר חֹורִי
לשִׁבטָא דִיהוּדָה כָלֵב בַר יפֻנַה
לשִׁבטָא דיִשׂשָׂכָר יִגאָל בַר יֹוסֵף
לשִׁבטָא דאפרים הֹושֵׁעַ בַר נוּן
לשִׁבטָא דבִניָמִין פַלטִי בַר רָפוּא
לשִׁבטָא דִזבוּלוּן גַדִיאֵל בַר סֹודִי
לשִׁבטָא דיֹוסֵף לשִׁבטָא דִמנַשַׁה גַדִי בַר סוּסִי
לשִׁבטָא דדָן עַמִיאֵל בַר גמַלִי
לשִׁבטָא דאָשֵׁר סתוּר בַר מִיכָאֵל
לשִׁבטָא דנַפתָלִי נַחבִי בַר וָפסִי
לשִׁבטָא דגָד גאוּאֵל בַר מָכִי
אִלֵין שׁמָהָת גַברַיָא דִשׁלַח משׁה לאַלָלָא יָת אַרעָא וֻקרָא מֹשַׁה להֹושֵׁעַ בַר נוּן יהֹושֻׁעַ
וֻשׁלַח יָתהֹון מֹשַׁה לאַלָלָא יָת ארעא דִכָנַעַן וַאַמַר להון סַקוּ דָאדין בדָרֹומָא ותִסקוּן לטוּרָא
ותִחזֹון יָת ארעא מַא הִיא ויָת עַמָא דיָתֵיב עַלַה הַתַקֵיף הוּא אִם חַלָשׁ הַזעֵיר הוּא אִם סַגִי
וֻמָא ארעא דהוּא יָתֵיב בַה הַטָבָא הִיא אִם בִישָׁא וֻמָא קִרוַיָא דהוּא יָתֵיב בהֹון הַבפַצחִין אִם בכַרכִין
וֻמָא אַרעָא הַעַתִירָאדעתירא הִיא אִם מִסכֵינָא הַאִית בַה אִילָנִין אִם לָא ותִתַקפוּן ותִיסבוּן מֵאִיבָא דארעא ויֹומַיָא יֹומֵי בִכוּרֵי עִנבִין
וֻסלִיקוּ ואַלִילוּ יָת ארעא מִמִדברָא דצִין עַד רחֹוב למָטֵי חַמָת
וֻסלִיקוּ בדָרֹומָא וַאַתֹו עַד חַברֹון ותַמָן אַחִימַן שֵׁשַׁי וָתַלמַי בנֵי גִיבָרָא וחַברֹון שׁבַע שׁנִין אִתבנִיאַת קדָם טַאַנֵיס דמִצרָים
וַאַתֹו עַד נַחלָא דאִתכָלָא וקָצוּ מִתַמָן עֹובַרתָא ואִתכָל דעִנבִין חַד ונַטלוּהִי בַאַרִיחָא בִתרֵין וֻמִן רִמֹונַיָא וֻמִן תֵינַיָא
לאַתרָא הַהוּא קרָא נַחלָא דאִתכָלָא עַל עֵיסַק אִתכָלָא דקָצוּ מִתַמָן בנֵי ישׂראל
ותָבוּ מִלאַלָלָא ית ארעא מִסֹוף אַרבעִין יֹומִין
וַאַזַלו וַאַתֹו לוָת מֹשַׁה למשׁה וֻלוָת אהרן לאהרן וֻלוָת כֹל ולכל כנִישׁתָא דִבנֵי ישׂראל למַדברָא דפָארָן לִרקַם וַאַתִיבוּ יָתהֹון פִתגָמָא ויָת כֹל כנִשׁתָא ואַחזִיאוּנוּן יָת אִיבָא דאַרעָא
ואִשׁתַעִיוּ לֵיה וַאַמַרוּ אַתֵינָא לאַרעָא דִשׁלַחתַנָא ואַף עָבדָא חַלָב וֻדבַשׁ הִיא ודֵין אִיבַה
לחֹוד אַרֵי תַקִיף עַמָא דיָתֵיב בארעא וקִרוַיָא כרִיכָן רַברבָן לַחדָא ואַף בנֵי גִיבָרָא חַזֵינָא תַמָן
עַמָלקָאָה יָתֵיב בַאַרַע דָרֹומָא וחִיתָאָה וִיבוּסָאָה וַאַמֹורָאָה יָתֵיב בטוּרָא וֻכנַעַנָאָה יָתֵיב עַל יַמָא ועַל כֵיף יַרדנָא
ואַצֵית כָלֵיב יָת עַמָא למֹשַׁהלות משׁה וַאַמַר מִיסָק נִיסַק ונֵירֹות יָתַה אַרֵי מִיכָל נִיכֹול לַה
וגֻברַיָא דִסלִיקוּ עִמֵיה אַמַרוּ לָא נִיכֹול למִיסַק לוָת עַמָא אַרֵי תַקִיף הוּא מִינַנָא
ואַפִיקוּ שׁוּם בִישׁ עַל ארעא דאַלִילוּ יָתַה לִבנֵילוָת בנֵי ישׂראל למֵימַר ארעא דַעַבַרנָא בַה לאַלָלָא יָתַה אַרַע מקַטלָא יָתבַהָא הִיא וכֹל עַמָא דַחזֵינָא בגַוַה אַנָשִׁין דמִשׁחָן
ותַמָן חַזֵינָא יָת גִיבַרָיָא בנֵי עַנָק מִן גִיבָרַיָא וַהוֵינָא בעֵינֵי נַפשַׁנָא כקַמצִין וכֵין הַוֵינָא בעֵינֵיהֹון
וַאַרֵימַת כֹל כנִשׁתָא וִיהַבוּ יָת קָלהֹון וֻבכֹו עַמָא בלֵיליָא הַהוּא
ואִתרַעָמוּ עַל מֹשַׁה ועַל אהרן כֹל בנֵי יִשׂרָאֵל וַאַמַרוּ להֹון כֹל כנִשׁתָא לוֵי דמֵיתנָא בארעא דמצרים אֹו במַדברָא הָדֵין לוֵי דמֵיתנָא
וֻלמָא יוי מַעֵיל יָתַנָא לארעא הָדָא למִיפַל בחַרבָא נשַׁנָא וטַפלַנָא יהֹון לבִיזָא הַלָא טָב לַנָא דִנתוּב למִצרָיִם
וַאַמַרוּ גבַר לַאַחוּהִי נמַנֵי רֵישָׁא וֻנתוּב למִצרָיִם
וֻנפַל מֹשַׁה ואהרן עַל אַפֵיהֹון קדָם כֹל קהָלָא כנִשׁתָא דִבנֵי ישׂראל
וִיהֹושֻׁעַ בַר נוּן וכָלֵב בַר יפֻנַה מִן מאַללֵידאלילו ית ארעא בַזַעוּ לבוּשֵׁיהֹון
וַאַמַרוּ לכֹל כנִשׁתָא דִבנֵי ישׂראל למֵימַר ארעא דַעַבַרנָא בַה לאַלָלָא יָתַה טָבָא ארעא לַחדָא לַחדָא
אִם רַעַוָא בַנָא מִן קדָם יוי ויַעֵיל יָתַנָא לאַרעָא הָדָא ויִתנַה לַנָא ארעא דהִיא עָבדָא חַלָב וֻדבָשׁ
ברַם במֵימרָא דַיוי לָא תִמרדוּן ואַתוּן לָא תִדחַלוּן יָתמִןמן קדם עַמָא דארעא אַרֵי בִידַנָא מסִירִין אִינוּן עַדָא תוּקפהֹון מִנהֹון וֻמֵימרָא דַיוי בסַעַדַנָא לָא תִדחַלוּן מִנהֹון
וַאַמַרוּ כֹל כנִשׁתָא למִרגַם יָתהֹון באַבנַיָא וִיקָרָא דַיוי אִתגלִי במַשׁכַן זמנא לכֹללות כל בנֵי ישׂראל
וַאַמַר יוי למֹשַׁה עַד אִימַתִי יהֹון מַרגזִין קדָמַי עַמָא הָדֵין ועַד אִימַתִי לָא יהֵימנוּן במֵימרִי ככֹל אָתַיָא דַעַבַדִית בֵינֵיהֹון
אִמחֵינוּן במֹותָא וַאַשֵׁיצֵינוּן וַאַעַבֵיד יָתָך לעַם רַבסגיא ותַקִיףוסגי מִינהֹון
וַאַמַר מֹשַׁה קדם יוי ויִשׁמעוּן מִצרָאֵי אַרֵי אַסֵיקתָא בחֵילָך יָת עַמָא הָדֵין מִבֵינֵיהֹון
ויֵימרוּן ליָתֵיב ארעא לדיתיב בארעא הָדָא דִשׁמַעוּשׁמעו אַרֵי אַת יוי שׁכִינתָךדשׁכינתך שָׁריָא בגֹו עַמָא הָדֵין דִבעֵינֵיהֹון חַזֹו שׁכִינַת יקָרָך יוי יקרא דייי וַעַנָנָך מַטַלקאים עִלָוֵיהֹון וֻבעַמוּדָא דַעַנָנָא אַת מדַבַר קדָמֵיהֹון בִימָמָא וֻבעַמוּדָא דאִישָׁתָא בלֵיליָא
וֻתקַטֵיל יָת עַמָא הָדֵין כגַברָא חַד ויֵימרוּן כל עַממַיָא דִשׁמַעוּ יָת שֵׁימַע גבוּרתָך למֵימַר
מִדלֵית יוּכלָא קדם יוי לַאַעָלָא יָת עַמָא הָדֵין לארעא דקַיֵים להֹון וקַטֵילִינוּן במַדברָא
וֻכעַן סַגִי כעַן חֵילָא קדָמָךמן קדם יוי כמָא דמַלֵילתָא למֵימַר
יוי מַרחֵיק רגַז וֻמַסגֵי למַעַבַד טָבוָן וקשׁוט שָׁבֵיק לַעַוָיָן ולִמרֹוד ולחובין סָלַח לִדתָיבִין לאֹורָיתֵיה ולִדלָא תָיבִין לָא מזַכֵי מַסעַר חֹובֵי אַבָהָן עַל בנִין מָרָדִין עַל דָר תלִיתַי ועַל דָר רבִיעָי
שׁבֹוק כעַן לחֹובֵי עַמָא הָדֵין כסַגִיאוּת טָבוָתָך וֻכמָא דִשׁבַקתָא לעַמָא הָדֵין מִמִצרַיִם ועַד כעַן
וַאַמַר יוי שׁבַקִית כפִתגָמָך
וֻברַם קַיָים אַנָא וֻמַליָא יקָרָא דַיוי יָת כֹל ארעא
אַרֵי כֹל גֻברַיָא דַחזֹו יָת יקָרִי ויָת אָתוָתִי דַעַבַדִית במִצרַיִם וֻבמַדברָא ונַסִיוּ קדָמַי דנָן עַסַר זִמנִין ולָא קַבִילוּ למֵימרִיבמימרי
אִם יִחזֹון יָת אַרעָא דקַיֵימִית לַאַבָהָתהֹון וכֹל דאַרגִיזוּ קדָמַי לָא יִחזֵינַה
ועַבדִי כָלֵב חַלָף דַהוָת רוּחַ אוּחרִי עִמֵיה ואַשׁלֵים בָתַר דַחַלתִי וַאַעֵילִינֵיה לארעא דעָל לתַמָן וֻבנֹוהִי יֵירתוּנַהיתָרכִנַה
וַעמָלקָאָה וֻכנַעַנָאָה יָתֵיב במֵישׁרָא מחַר אִתפנֹו וטוּלוּ לכֹון למַדברָא אֹורַח יַמָא דסוּף
וֻמַלֵיל יוי עִם מֹשַׁה ולאהרןועִם אַהרֹן למֵימַר
עַד אִימַתִי לִכנִשׁתָא בִישׁתָא הָדָא בישׁא הדין דאִנוּן מִתרָעַמִין עַלַי יָת תוּרעַמָת בנֵי ישׂראל דאִנוּן מִתרָעַמִין עַלַי שׁמִיַע קדָמָי
אֵימַר להֹון קיָם אַנָא אַמַר יוי אִם לָא כמָא דמַלֵילתוּן קדָמַי כֵין אַעַבֵיד לכֹון
במַדברָא הָדֵין יִפלוּן פִגרֵיכֹון וכֹל מִניָנכֹון לכֹל חוּשׁבָנכֹון מִבַר עַסרִין שׁנִין וֻלעֵילָא דאִתרָעַמִיתוּן עַלָי
אִם אַתוּן תֵיעַלוּן לארעא דקַיֵימִית במֵימרִי לאַשׁרָאָה יָתכֹון בַה אַלָהֵין כָלֵב בַר יפֻנַה וִיהֹושֻׁעַ בַר נוּן
וטַפלכֹון דַאַמַרתוּן לבִיזָא יהֵי ואַעֵיל יָתהֹון ויִדעוּןויִחזֹון יָת ארעא דקַצתוּן בַה
וֻפִגרֵיכֹון דִילכֹוןאתון יִפלוּן במַדברָא הָדֵין
וֻבנֵיכֹון יהֹון מאַחַרִין במַדברָא אַרבעִין שׁנִין וִיקַבלוּן יָת חֹובֵיכֹון עַד דִיסוּפוּן פִגרֵיכֹון במַדברָא
במִניַן יֹומַיָא דאַלֵילתוּן יָת ארעא אַרבעִין יֹומִין יֹומָא לשַׁתָא יֹומָא לשַׁתָא תקַבלוּן יָת חֹובֵיכֹון אַרבעִין שׁנִין ותִידעוּן יָת דאִיתרָעַמִיתוּן עַלָי
אַנָא יוי גזַרִית במֵימרִי ואקיים אִם לָא דָא אַעַבֵיד לכֹל כנִשׁתָא בִישׁתָא הָדָא דאִתרָעַמוּדאִזדָמַנוּ עַלָי במַדברָא הָדֵין יסוּפוּן ותַמָן ימוּתוּן
וגַברַיָא דִשׁלַח מֹשַׁה לאַלָלָא יָת אַרעָא ותָבוּ ואַרעִימוּ עַלֹוהִי יָת כֹל כנִשׁתָא לאַפָקָא שֹׁום בִישׁ עַל ארעא
וֻמִיתוּ גַברַיָא דאַפִיקוּ שֹׁום בִישׁ עַל ארעא בישׁתא במֹותָנָא קדם יוי
וִיהֹושֻׁעַ בַר נוּן וכָלֵב בַר יפֻנַה אִתקַיַמוּ מִן גַברַיָא הָאִינוּן דַאַזַלוּ לאַלָלָא יָת ארעא
וֻמַלֵיל מֹשַׁה יָת כל פִתגָמַיָא הָאִלֵין עִם כֹל לכֹל בנֵי ישׂראל ואִתאַבַלוּ עַמָא לַחדָא
ואַקדִימוּ בצַפרָא וֻסלִיקוּ לרֵישׁ טוּרָא למֵימַר הָא אַנַחנָא סָלקִין לאַתרָא דַאַמַר יוי אַרֵי חַבנָא
וַאַמַר מֹשַׁה למָא דנָן אַתוּן עָברִין עַל גזֵירַת מֵימרָא דַיוי והִיא לָא תַצלַח
לָא תִסקוּן אַרֵי לֵית שׁכִינתָא דַיוי בֵינֵיכֹון ולָא תִתַברוּן קדָם בַעַלֵי דבָבֵיכֹון
אַרֵי עַמָלקָאָה וֻכנַעַנָאָה תַמָן קדָמֵיכֹון ותִפלוּן בחַרבָא אַרֵי עַל כֵין תַבתוּן מִבָתַר פוּלחָנָאדחלתא דַיוי ולָא יהֵי מֵימרָא דַיוי בסַעדַכֹון
ואַרשַׁעוּ למִיסַק לרֵישׁ טוּרָא וַאַרֹון קיָמָא דַיוי וֻמֹשַׁה לָא עַדֹו מִגֹו מַשׁרִיתָא
וֻנחַת עַמָלקָאָה וֻכנַעַנָאָה דיָתֵיב בטוּרָא הַהוּא וֻמחֹונוּן וֻטרַדוּנוּן עַד חָרמָה
ומליל יוי עםלות משׁה למימר
מַלֵיל עִם בנֵי ישׂראל ותֵימַר להֹון אַרֵי תֵיעַלוּן לַאַרַע מֹותבָנֵיכֹון דַאַנָא יָהֵיב לכֹון
ותַעבדוּן קוּרבָנָא קדם יוי עַלָתָא אֹו נִכסַת קוּדשַׁיָא לפָרָשָׁאלאפרשׁא נִדרָא אֹו בִנדַבתָאלנדבתא אֹו במֹועַדֵיכֹון למַעַבַד לאִתקַבָלָא ברַעַוָא קדם יוי מִן תֹורֵי אֹו מִן עָנָא
וִיקָרֵיב דִמקָרֵיב קוּרבָנֵיה קדם יוי מִנחָתָא סוּלתָא עַסרֹונָא דפִיל ברַבעוּת הִינָא מִשׁחָא
וחַמרָא לנִסכָא רַבעוּת הִינָא תַעַבֵיד עַל עַלָתָא אֹו לנִכסַת קוּדשַׁיָא לאִימרָא חַד
אֹו לדִכרָא תַעַבֵיד מִנחָתָא סוּלתָא תרֵין עַסרֹונִין דפִילָא בִמשַׁח תַלתוּת הִינָא
וחַמרָא לנִסכָא תַלתוּת הִינָא תקָרֵיב לאִיתקַבָלָא ברַעַוָא קדם יוי
וַאַרֵי תַעַבֵיד בַר תֹורֵי על עַלָתָא אֹו נִכסַת קוּדשַׁיָא לפָרָשָׁאלאפרשׁא נִדרָא אֹו נִכסַת קוּדשַׁיָא קדם יוי
וִיקָרֵיב עַל בַר תֹורֵי מִנחָתָא סוּלתָא תלָתָה עַסרֹונִין דפִיל בִמשַׁח פלגוּת הִינָא
וחַמרָא דתקָרֵיב לנִסכָא פַלגוּת הִינָא קוּרבַן דמִתקַבַל ברַעַוָא קדם יוי
כדֵין יִתעַבֵיד לתֹורָא חַד אֹו לדִכרָא חַד אֹו לאִימַר באִימרַיָא אֹו בעִזַיָאבבני עזיא
כמִניַן דתַעבדוּן כדֵין תַעבדוּן לחַד כמִניָנהֹוןבמניניהון
כֹל יַצִיבָאדיציבא יַעַבֵיד כדֵין יָת אִלֵין לקָרָבָא קוּרבַן דמִתקַבַל ברָעַוָא קדם יוי
וַאַרֵי יִתגַייַר עִמכֹון גִיֹורָא אֹו דבֵינֵיכֹוןדי בביניכון לדָרֵיכֹון ויַעַבֵיד קוּרבַן דמִתקַבַל ברַעַוָא קדם יוי כמָא דתַעבדוּן כֵין יַעַבֵיד
קהָלָא קיָמָא חַד לכֹון ולגִיֹורַיָא דיִתגַיירוּןדי יתגייר ביניכון קיָם עָלַם לדָרֵיכֹון כוָתכֹון גִיֹורָאכגיורא יהֵי קדם יוי
אֹורָיתָא חַדָא ודִינָא חַד יהֵי לכֹון וֻלגִיֹורַיָא דיִתגַיירוּן עִמכֹוןביניכון
ומליל יוי עםלות משׁה למימר
מַלֵיל עִם בנֵי יִשׂרָאֵל ותֵימַר להֹון במֵיעַלכֹון לארעא דַאַנָא מַעֵיל יָתכֹון לתַמָן
וִיהֵי במֵיכַלכֹון מִלַחמָא דארעא תַפרשׁוּן אַפרָשׁוּתָא קדם יוי
רֵישׁ אָצוָתכֹון חַלתָא תַפרשׁוּן אַפרָשׁוּתָא כמָא דמַפרשִׁין מִן אִידרָא כֵין תַפרשׁוּן יָתַה
מֵרֵישׁ אָצוָתכֹון תִתנוּן קדם יוי אַפרָשׁוּתָא לדָרֵיכֹון
וַאַרֵי תִשׁתלֹון ולָא תַעבדוּן יָת כֹל פִקֹודַיָא הָאִלֵין דמַלֵיל יוי עִם מֹשַׁה
יָת כֹל דפַקֵיד יוי לוָתכֹוןלכֹוןיתכון בִידָא דמֹשַׁה מִן יֹומָא דפַקֵיד יוי וֻלהַלאָה לדָרֵיכֹון
וִיהֵי אִםארי מֵעֵינֵי כנִשׁתָא אִתעַבֵידַת לשָׁלוּבשׁלו ויַעבדוּןוייתון כֹל כנִשׁתָא תֹור בַר תֹורֵי חַד לעַלָתָא לאִתקַבָלָא ברַעַוָא קדם יוי וֻמִנחָתֵיה ונִסכֵיה כדַחזֵי וֻצפִיר בַר עִזִין חַד לחַטָתָא
וִיכַפַר כָהַנָא עַל כֹל כנִשׁתָא דִבנֵי ישׂראל ויִשׁתבֵיק להֹון אַרֵי שָׁלוּתָא הִיא ואִינוּן אֵיתִיוּ יָת קוּרבָנהֹון קוּרבָנָא קדם יוי וחֹובַתהֹוןוחטאתהון קדם יוי עַל שָׁלוּתהֹון
ויִשׁתבֵיק לכֹל כנִשׁתָא דִבנֵי יִשׂרָאֵל וֻלגִיֹורַיָא דיִתגַיירוּן בֵינֵיהֹון אַרֵי לכֹל עַמָא בשָׁלוּתָא
ואִם אַנָשׁ חַד יחֹוב בשָׁלוּ וִיקָרֵיב עִיזָא בַתבר שַׁתַה לחַטָתָא
וִיכַפַר כָהנָא עַל אנָשׁ דאִשׁתלִי בִמחֹובֵיה בשָׁלוּ קדם יוי לכַפָרָא עַלֹוהִי ויִשׁתבֵיק לֵיה
יַצִיבָאליציבא בִבנֵי ישׂראל וֻלגִיֹורַיָא דיִתגַיירוּן בֵינֵיהֹון אֹורָיתָא חַדָא יהֵי לכֹון לדיַעַבֵיד בשָׁלוּ
וַאַנָשׁ דיַעַבֵיד ברֵישׁ גלֵי מִן יַצִיבַיָא וֻמִן גִיֹורַיָא קדם יוי הוּא מַרגֵיזדארגיז ויִשׁתֵיצֵי אַנָשָׁא הַהוּא מִיגֹו עַמֵיה
אַרֵי עַל פִתגָמָא דַיוי בַסַר ויָת פִקֹודֹוהִי אַשׁנִי אִשׁתֵיצָאָה יִשׁתֵיצֵי אַנָשָׁא הַהוּא חֹובֵיה בֵיה
וַהוֹו בנֵי ישׂראל במַדברָא ואַשׁכַחוּ גַברָא כַד מגָבֵיב אָעִין ביֹומָא דשַׁבתָא
וקָרִיבוּ יָתֵיה דאַשׁכַחוּ יָתֵיה כַד מגָבֵיב אָעִין לוָת מֹשַׁה וֻלוָת אַהַרֹן וֻלוָת כֹל כנִשׁתָא
וַאַסַרוּ יָתֵיה בבֵית מַטרָא אַרֵי לָא אִתפרֵישׁ להֹון מָא דיַעבדוּןיתעביד לֵיה
וַאַמַר יוי למֹשַׁה אִתקטָלָא יִתקטִיל גֻברָא רגוּמוּ יָתֵיה באַבנַיָא כֹל כנִשׁתָא מִבַרָאלמברא למַשׁרִיתָא
ואַפִיקוּ יָתֵיה כֹל כנִישׁתָא למִבַרָא למַשׁרִיתָא וֻרגַמוּ יָתֵיה באַבנַיָא וֻמִית כמָא דפַקֵיד יוי יָת מֹשַׁה
וַאַמַר יוי למֹשַׁהלות משׁה למֵימַר
מַלֵיל עִם בנֵי ישׂראל ותֵימַר להֹון ויַעבדוּן להֹון כרוּספדִין עַל כַנפֵיגדפי כסוּתהֹון לדָרֵיהֹון ויִתנוּן עַל כרוּספַד כַנפָא כרוספדא דכנפאדגדפא חוּטָא דִתכִילתָא
וִיהֵי לכֹון לִכרוּספדִין ותִחזֹון יָתֵיה ותִדכרוּן יָת כֹל פִקֹודַיָא דַיוי ותַעבדוּן יָתהֹון ולָא תִטעֹון בָתַר הַרהוּר לִבכֹון וֻבָתַר חֵיזוּ עֵינֵיכֹון דאַתוּן טָעַן בָתרֵיהֹון
בדִיל דתִדכרוּן ותַעבדוּן יָת כֹל פִקֹודַי וֻתהֹון קַדִישִׁין קדָם אַלָהַכֹון
אַנָא יוי אַלָהַכֹון דאַפֵיקִית יָתכֹון מארעא דמצרים למִהוֵי לכֹון לאַלָה אַנָא יוי אַלָהַכֹון
וֻאִתפלֵיג קֹרַח בַר יִצהָר בַר קהָת בַר לֵוִי ודָתָן וַאַבִירָם בנֵי אַלִיאָב ואֹון בַר פַלַת בנֵי ראוּבֵן
וקָמוּ לאַפֵיקדם מֹשַׁה וגַברַיָא מִבנֵי ישׂראל מָתַן וחַמשִׁין רַברבֵי כנִשׁתָא מעָרעֵי זמָן אַנָשִׁין דִשׁמָא
ואִתכנִישׁוּ עַל מֹשַׁה ועַל אַהַרֹן וַאַמַרוּ להֹון סַגִי לכֹון אַרֵי כֹל כנִשׁתָא כוּלהֹון קַדִישִׁין וֻבֵינֵיהֹון שָׁריָא שׁכִינתָא דַיוי וֻמָדֵין אַתוּן מִתרַברבִין עַל קהָלָא דַיוי
וֻשׁמַע מֹשַׁה וֻנפַל עַל אַפֹוהִי
וֻמַלֵיל עִם קֹרַח ועִם כֹל כנִשׁתֵיה למֵימַר בצַפרָא וִיהֹודַע יוי יָת דכָשַׁר לֵיה ויָת דקַדִישׁ וִיקָרֵיב לִקדָמֹוהִי ויָת דיִתרעֵי בֵיה יקָרֵיב לשִׁימוּשֵׁיה
דָא עַבִידוּ סוּבוּ לכֹון מַחתִיָן קֹרַח וכָל כנִשׁתֵיה
והַבוּ בהֹון אִישָׁתָא ושַׁוֹו עַלֵיהֹון קטֹורַת בוּסמִין קדם יוי מחַר וִיהֵי גַברָא דיִתרעֵי בֵיה יוי הוּא קַדִישׁדקדישׁ סַגִי לכֹון בנֵי לֵוִי
וַאַמַר מֹשַׁה לקֹרַח שׁמַעוּ כעַן בנֵי לֵוִי
הַזעֵיר לכֹון אַרֵי אַפרֵישׁ אַלָהָא דיִשׁראל יָתכֹון מִכנִשׁתָא דישׂראל לקָרָבָא יָתכֹון לִקדָמֹוהִי למִפלַח יָת פוּלחַן מַשׁכנָא דַיוי ולִמקָם קדָם כנִשׁתָא לשַׁמָשׁוּתהֹון
וקָרֵיב יָתָך ויָת כֹל אַחָך בנֵי לֵוִי עִמָך וֻבָעַן אַתוּן וכען אתון בעןובעתון אַף כהוּנתָא רַבתָא
בכֵין אַת וכֹל כנִשׁתָך אִזדָמַנתוּןדאִזדָמַנתוּן עַלקדם יהוה ואהרן מַא הוּא אַרֵי מִתרָעַמִיתוּן עַלֹוהִי
וֻשׁלַח משׁה למִקרֵי לדָתָן ולַאַבִירָם בנֵי אַלִיאָב וַאַמַרוּ לָא נִיסַק
הַזעֵיר אַרֵי אַסֵיקתַנָא מֵאַרַע עָבדָא חַלָב וֻדבַשׁ לקַטָלוּתַנָא במַדברָא אַרֵי מִתרָרַבת עַלַנָא אַף אִתרַברָבָא
אַףברם לָא לאַרַע עָבדָא חַלָב וֻדבַשׁ אַעֵילתַנָאאסקתנא וִיהַבת לַנָא אַחסָנַת חַקלִין וכַרמִין הַעֵינֵי גֻברַיָא הָאִינוּןהָאִלֵין תִשׁלַח לעַוָרָא לָא נִיסַק
וֻתקֵיף למֹשַׁהמשׁה לַחדָא וַאַמַר קדם יוי לָא תקַבֵיל ברַעַוָא קוּרבָנהֹון לָא חַמָרָא דחַדחד מִנהֹון שַׁחַרִית ולָא אַבאֵישִׁית לחַדית חד מִנהֹון
וַאַמַר משׁה לקֹרַח אַת וכֹל כנִשׁתָך הַוֹו זמִינִין לִקדָםקדם יוי אַת ואִינוּן ואהרן מחַר
וסוּבוּ גבַר מַחתִיתֵיה ותִיתנוּן עַלֵיהֹון קטֹורַת בוּסמִין וֻתקָרבוּן קדם יוי גבַר מַחתִיתֵיה מָתַן וחַמשִׁין מַחתִיָן וָאַת ואהרן גבַר מַחתִיתֵיה
וֻנסִיבוּ גבַר מַחתִיתֵיה וִיהַבוּ עַלֵיהֹון אִישָׁתָא ושַׁוִיוּ עַלֵיהֹון קטֹורַת בוּסמִין וקָמוּ בִתרַע מַשׁכַן זִמנָא וֻמֹשַׁה ואַהַרֹן
וֻכנַשׁ עַלֵיהֹון קֹרַח יָת כֹל כנִשׁתָא לִתרַע מַשׁכַן זימנא ואִתגלִי יקָרָא דַיוי לכֹל כנִשׁתָא
ומליל יוי עִםלות מֹשַׁה ולאהרןועִם אַהרֹןולות אהרן למימר
אִתפָרַשׁוּ מִגֹו כנִשׁתָא הָדָא וַאַשֵׁיצֵי יָתהֹון כשָׁעָא
וֻנפַלוּ עַל אַפֵיהֹון וַאַמַרוּ אֵל אַלָה רוּחַיָא לכֹל בִסרָא גֻברָאהגברא חַד יחוּב ועַל כֹל כנִשׁתָא יהֵי רוּגזָא
ומליל יוי עםלות משׁה למימר
מַלֵיל עִם כנִשׁתָא למֵימַר אִסתַלַקוּ מסחור סחור למַשׁכנָא דקֹרַח דָתָן וַאַבִירָם
וקָם מֹשַׁה וַאַזַל לוָת דָתָן וַאַבִירָם וַאַזַלוּ בָתרֹוהִי סָבֵי ישׂראל
וֻמַלֵיל עִם כנִשׁתָא למֵימַר זוּרוּ כעַן מֵעִלָוֵי מַשׁכנֵי גֻברַיָא חַיָבַיָא הָאִלֵין ולָא תִקרבוּן בכֹל דִילהֹון דִלמָא תִלקֹון בכֹל חֹובֵיהֹון
ואִסתַלַקוּ מֵעִלָוֵימעל מַשׁכנָא דקֹרַח דָתָן וַאַבִירָם מִסחֹור סחֹור ודָתָן וַאַבִירָם נפַקוּ קָימִין בִתרַע מַשׁכנֵיהֹון וֻנשֵׁיהֹון וֻבנֵיהֹון וטַפלהֹון
וַאַמַר משׁה בדָא תִידעוּן אַרֵי יוי שַׁלחַנִי למַעַבַד יָת כֹל עוּבָדַיָא הָאִלֵין אַרֵי לָא מִרעוּתִי
אִם כמֹותָא דכֹלכל אַנָשָׁא ימוּתוּן אִילֵין וֻסעוּרָא דכֹלכל אַנָשָׁא יִסתעַר עַלֵיהֹון לָא יוי שַׁלחַנִי
ואִם ברִיאָה יִברָא יוי ותִפתַח ארעא יָת פוּמַה ותִבלַע יָתהֹון ויָת כֹל דִילהֹון ויַחַתוּןויֵיחתוּן כִיד חַיִין לִשׁאֹול ותִידעוּן אַרֵי אַרגִיזוּ גַברַיָא הָאִלֵיןהאנון קדָםית יוי
וַהַוָה כַד שֵׁיצִי למַלָלָא יָת כֹל פִתגָמַיָא הָאִלֵין ואִתבזַעַת אַרעָא דִתחֹותֵיהֹון
וֻפתַחַת ארעא יָת פוּמַה וֻבלַעַת יָתהֹון ויָת אַנָשׁ בָתֵיהֹון ויָת כֹל אַנָשָׁא דִלקֹרַח ויָת כֹל קִניָנָא
וֻנחַתוּ אִנוּן וכֹל דִילהֹון כִיד חַיִין לִשׁאֹול וַחפַת עַלֵיהֹון ארעא וַאַבַדוּ מִגֹו קהָלָא
וכֹל ישׂראל דִבסַחרָנֵיהֹון עַרַקוּ לקָלהֹון אַרֵי אַמַרוּ דִלמָא תִבלעִינַנָא ארעא
ואִישָׁתָא נפַקַת מִן קדָםמקדם יוי וַאַכַלַת יָת מָאתַן וחַמשִׁין גֻברָא מקָרבֵין קטֹורַת בוּסמַיָא
ומליל יוי עםלות משׁה למימר
אֵימַר לאַלעָזָר בַר אַהַרֹן כָהַנָא ויַפרֵישׁ יָת מַחתִיָתָא מִבֵיןמן יקֵידַיָאיוקדתא ויָת אִישָׁתָא יַרחֵיק להַלאָהלהַלָא אַרֵי אִתקדַשָׁאאִתקַדַשָׁא
יָת מַחתִיָת חַיָבַיָא הָאִילֵין דאִתחַייַבוּ בנַפשָׁתהֹון ויַעבדוּן יָתהֹון טַסִין רדִידִין רדידין טסין חוּפָאָה למַדבחָא אַרֵי קָרִיבוּנִין קדם יוי ואִתקַדַשָׁא ויִהוִיָןויִהויָן לאָת לִבנֵי ישׂראל
וֻנסֵיב אַלעָזָר כָהַנָא יָת מַחתִיָת נחָשָׁא דקָרִיבוּ יקֵידַיָא ורַדִידוּנִין חוּפָאָה למַדבחָא
דוּכרָנָא לִבנֵי ישׂראל בדִיל דלָא יִקרַב גבַר חִילֹונַי דלָא מִזַרעָא דאַהַרֹן הוּא לאַסָקָאלאקטרא קטֹורַת בוּסמִין קדם יוי ולָא יהֵי כקֹרַח וכִכנִשׁתֵיה כמָא דמַלֵיל יוי בִידָא דמֹשַׁה לֵיה
ואִתרָעַמוּ כֹל כנִשׁתָא דִבנֵי ישׂראל ביֹומָאמיומא דבָתרֹוהִי עַל מֹשַׁה ועַל אַהַרֹן למֵימַר אַתוּן גרַמתוּן דמִית עַמָא דַיוי
וַהַוָה באִתכַנָשׁוּת כנִשׁתָא עַל מֹשַׁה ועַל אַהַרֹן ואִתפנִיוּ למַשׁכַן זִמנָא והָא חַפָהִי עַנָנָא ואִתגלִי יקָרָא דַיוי
ועָלואתא מֹשַׁה ואהרן לִקדָם מַשׁכַן זימנא
ומליל יוי עםלות משׁה למימר
אִתפָרַשׁוּ מִגֹו כנִשׁתָאקהלא הָדָא וַאַשֵׁיצֵי יָתהֹון כשָׁעָא וֻנפַלוּ עַל אַפֵיהֹון
וַאַמַר מֹשַׁה לאהרן סַב יָת מַחתִיתָא והַב עַלַה אִישָׁתָא מֵעִלָוֵי מַדבחָא ושַׁו קטֹורַת בוּסמִין ואֹובֵיל בִפרִיַע לִכנִשׁתָא וכַפַר עַלֵיהֹון אַרֵי נפַק רוּגזָא מִן קדם יוי שָׁרִי מֹותָנָא
וֻנסֵיב אַהַרֹן כמָא דמַלֵיל מֹשַׁה וֻרהַט לגֹו קהָלָא והָא שָׁרִי מֹותָנָא בעַמָא וִיהַב יָת קטֹורַת בוּסמַיָא וכַפַר עַל עַמָא
וקָם בֵין מִיתַיָא וֻבֵין חַיַיָא ואִתכלִי מֹותָנָא
וַהוֹו דמִיתוּ במֹותָנָא אַרבעַת עַסַר אַלפִין וֻשׁבַע מאָה בָר מִדמִיתוּ עַל פלוּגתָא דקֹרַח
ותָב אהרן לוָת מֹשַׁה למשׁה לִתרַע מַשׁכַן זִמנָא וֻמֹותָנָא אִתכלִי
ומליל יוי עםלות משׁה למימר
מַלֵיל עִים בנֵי ישׂראל וסַב מִינהֹון חוּטרָא חוּטרָא לבֵית בָאלבֵית אַבָא מִן כֹל מִכֹל רַברבָנֵיהֹון לבֵית אַבָהָתהֹון תרֵי עַסַר חוּטרִין גבַר יָתעל שׁמֵיה תִכתֹוב עַל חוּטרֵיה
ויָת שׁמָא דאַהַרֹן תִכתֹוב עַל חוּטרָא דלֵוִי אַרֵי חוּטרָא חַד לרֵישׁ בֵית אַבָהָתהֹון
ותַצנַעִינוּן במַשׁכַן זִמנָא קדָם סָהַדוּתָא דַאַזָמֵין מֵימרִי לכֹון תַמָן
וִיהֵי גֻברָא דיִתרעֵידאִתרעֵי בֵיה חוּטרֵיה יַנעֵי וַאַנִיַח מִן קדָמַי יָת תוּרעַמָת בנֵי ישׂראל דאִינוּן מִתרָעַמִין עַלֵיכֹון
וֻמַלֵיל משׁה עִם בנֵי ישׂראל וִיהַבוּ לֵיה כֹל רַברבָנֵיהֹון חוּטרָא לרַבָא חַד חוּטרָא לרַבָא חַד לבֵית אַבָהָתהֹון תרֵי עַסַר חוּטרִין וחוּטרָא דאהרן בגֹו חוּטרֵיהֹון
ואַצנַע מֹשַׁה יָת חוּטרַיָא קדם יוי במַשׁכנָא דסָהַדוּתָא
וַהַוָה ביֹומָאמיומא דבָתרֹוהִי ועָל מֹשַׁה למַשׁכנָאבמשׁכנא דסָהַדוּתָא והָא יַעָאנעאינע חוּטרָא דאהרן לבֵית לֵוִי ואַפֵיק לַבלַבִין וַאַנֵיץ נַץ וכַפֵית שִׁגדִיןשׁקדין
ואַפֵיק מֹשַׁה יָת כֹל חוּטרַיָא מִן קדםמקדם יוי לכֹללות כללות בנֵי ישׂראל ואִשׁתמֹודַעוּ וֻנסִיבוּ גבַר חוּטרֵיה
וַאַמַר יוי למֹשַׁה אַתֵיב יָת חוּטרָא דאַהַרֹן לִקדָםקדָם סָהַדוּתָא למַטרָא לאָת לעַמָא סָרבָנָא וִיסוּפָן תוּרעַמָתהֹון מִן קדָמַימקדמי ולָא ימוּתוּן
וַעַבַד משׁה כמָא דפַקֵיד יוי יָתֵיה כֵין עַבַד
וַאַמַרוּ בנֵי ישׂראל למֹשַׁה למֵימַר הָא מִינַנָא קטֵילַת חַרבָא הָא מִינַנָא בלַעַת ארעא הָא מִינַנָא מִיתוּ במֹותָנָא
כֹל דקָרִיב מִקרָב למַשׁכנָא דַיוי מָאִית הָא אַנַחנָא סָיפִין לִיממָת
וַאַמַר יוי לאהרן אַת וֻבנָך וֻבֵית אַבוּך עִמָך תסַחַלסַלחוּן עַל חֹובֵי מַקדשָׁא ואַת וֻבנָך עִמָך תסַלחוּן עַל חֹובֵי כהוּנַתכֹון
ואַף יָת אַחָך שִׁבטָא דלֵוִי שִׁבטָא דַאַבוּך קָרֵיב לוָתָך ויִתֹוספוּן עַלָך וִישַׁמשׁוּנָך ואַת וֻבנָך עִימָך קדָם מַשׁכנָא דסָהַדוּתָא
ויִטרוּן מַטַרתָך וֻמַטרַת כֹל מַשׁכנָא ברַם למָנֵי קוּדשָׁא וֻלמַדבחָא לָא יִקרבוּן ולָא ימוּתוּן אַף אִינוּן אַף אַתוּן
ויִתֹוספוּן עַלָך ויִטרוּן יָת מַטרַת מַשׁכַן זִמנָא לכֹל פוּלחַן מַשׁכנָא וחִילֹונַי לָא יִקרַב לוָתכֹון
ותִיטרוּן יָת מַטרַת קוּדשָׁא ויָת מַטרַת מַדבחָא ולָא יהֵי עֹוד רוּגזָא עַל בנֵי ישׂראל
וַאַנָא הָא קָרֵיבִית יָת אַחֵיכֹון לֵיוָאֵי מִגֹו בנֵי ישׂראל לכֹון מַתנָא יהִיבִין קדם יוי למִפלַח יָת פוּלחַן מַשׁכַן זִמנָא
ואַת וֻבנָך עִימָך תִיטרוּן יָת כהוּנַתכֹון לכֹל פִתגָם מַדבחָא וֻלמִגָיו לפָרוּכתָא ותִפלחוּן ית פוּלחַן מַתנָא אַתֵין יָת כהוּנַתכֹון וחִילֹונַי דיִקרַב יִתקטֵיל
וַמַלֵיל יוי לאַהַרֹןעִם אַהרֹן וַאַנָא הָא יהַבִית לָך יָת מַטרַת אַפרָשׁוָתִיבני ישׂראל לכֹל קוּדשַׁיָא דִבנֵי יִשׂרָאֵל לָך יהַבתִינוּן לִרבוּ ולִבנָך לִקיָם עָלַם
דֵין יהֵי לָך מִקֹודַשׁ קוּדשַׁיָא מֹותַר מִן אִישָׁתָא לכָלכל קוּרבָנהֹון לכָל מִנחָוָותהֹון וֻלכָלוכל חַטָווָתהֹוןחובתהון וֻלכָל אַשָׁמהֹון דיִתִיבוּן קדָמַי קֹודַשׁ קוּדשִׁין דִילָך הוּא ודִבנָךולבנך
בקוּדַשׁ קוּדשִׁין תֵיכלִינֵיה כֹל דכוּרָא יֵיכֹול יָתֵיה קוּדשָׁא יהֵי לָך
ודֵין לָך אַפרָשׁוּת מַתנָתהֹון לכֹל אַרָמוּת בנֵי ישׂראל לָך יהַבתִינוּן ולִבנָך ולִבנָתָך עִימָך לִקיָם עָלַם כֹל דיִדכֵי בבֵיתָך יֵיכֹול יָתֵיה
כֹל טוּב משַׁח וכֹל טוּב חַמַר ועִיבוּר רֵישִׁיתהֹון דיִתנוּן קדם יוי לָך יהַבתִינוּן
בִכוּרֵי כֹל דִבאַרַעהֹון דיֵיתֹון לִקדָםקָדָם יוי דִילָךלך יהֵי כֹל דיִדכֵי בבֵיתָך יֵיכלִינֵיה
כֹל חִרמָא בישׂראל דִילָך יהֵי
כֹל פָתַח וַלדָא לכֹל בִסרָא דִיקָרבוּן קדם יוי בַאַנָשָׁא וֻבִבעִירָא יהֵי לָך ברַם מִפרָק תִפרֹוק יָת בוּכרָא דַאַנָשָׁא ויָת בוּכרָא דִבעִירָא מסָאַבָא תִפרוּק
ופוּרקָנֵיהופריקוהי מִבַר יַרחָא תִפרֹוק בפוּרקָנֵיה כסַף חַמֵישׁ סִלעִין בסִלעֵי קוּדשָׁא עַסרִין מָעִין הוּא
ברַם בוּכרָא דתֹורָא אֹו בוּכרָא דאִימרָא אֹו בוּכרָא דעִיזָא לָא תִפרוּק קוּדשָׁא אִינוּן יָת דַמהֹון תִזרֹוק עַל מַדבחָא ויָת תַרבהֹון תַסֵיק קוּרבַן לאִתקַבָלָאדמִתקַבַל ברַעַוָא קדם יוי
וֻבִסרהֹון יהֹון לָך כחַדיָא דַאַרָמוּתָא וֻכשָׁקָא דיַמִינָא דִילָך יהֵי
כֹל אַפרָשׁוּת קוּדשַׁיָא דִיַפרשׁוּן בנֵי ישׂראל קדם יוי יהַבִית לָך ולִבנָך ולִבנָתָך עִימָך לִקיָם עָלַם קיָם מלַח עָלמָא הוּא קדם יוי לָך וֻלִבנָך עִימָך
וַאַמַר יוי לאהרן בַאַרַעהֹון לָא תַחסֵין וחוּלָק לָא יהֵי לָך בֵינֵיהֹון מַתנָן יהַבִיתדִיַבִית לָך אִינִין חוּלָקָך ואַחסָנתָך בגֹו בנֵי ישׂראל
ולִבנֵי לֵוִי הָא יהַבִית כֹל מַעַסרָא בישׂראל לאַחסָנָא חַלָף פוּלחָנהֹון דאִינוּן פָלחִין יָת פוּלחַן מַשׁכַן זִמנָא
ולָא יִקרבוּן עֹוד בנֵי ישׂראל למַשׁכַן זִמנָא לקַבָלָא חֹובָא לִיממָת
ויִפלחוּן לֵיוָאֵי אִנוּן יָת פוּלחַן מַשׁכַן זִמנָא ואִינוּן יקַבלוּן חֹובֵיהֹון קיָם עָלַם לדָרֵיהֹון וֻבגֹו בנֵי ישׂראל לָא יַחסנוּן אַחסָנָא
אַרֵי יָת מַעסַר בנֵי ישׂראל דיַפרשׁוּן קדם יוי אַפרָשׁוּתָא יהַבִיתדיהבית ללֵיוָאֵי לאַחסָנָא עַל כֵין אַמַרִית להֹון בגֹו בנֵי ישׂראל לָא יַחסנוּן אַחסָנָא
ומליל יוי עםלות משׁה למימר
ועִם לֵיוָאֵי ולליואי תמַלֵיל ותֵימַר להֹון אַרֵי תִיסבוּן מִן בנֵי מבני ישׂראל יָת מַעַשׂרָא דִיהַבִית לכֹון מִנהֹון באַחסָנַתכֹון ותַפרשׁוּן מִנֵיה אַפרָשׁוּתָא קדם יוי מַעַסרָא מִן מַעַסרָא
ותִתחַשֵׁיב לכֹון אַפרָשׁוּתכֹון כעִיבוּרָאכַעבוּרָא מִן אִידרָא וֻכמַלאַתָא מִן מַעַצַרתָא
כֵין תַפרשׁוּן אַף אַתוּן ית אַפרָשׁוּתָא קדם יוי מִכֹל מַעַשׂרֵיכֹון דתִסבוּן מִן בנֵי ישׂראל ותִתנוּןותפרשׁון מִנֵיה יָת אַפרָשׁוּתָא קדם יוי לאהרן כָהַנָא
מִכֹל מַתנָתכֹון תַפרשׁוּן יָת כֹל אַפרָשׁוּתָא קדם יוי דייי מִכֹל שׁוּפרֵיה יָת קוּדשֵׁיהמקדשׁיה מִנֵיה
ותֵימַר להֹון באַפרָשׁוּתכֹון יָת שׁוּפרֵיה מִנֵיה ויִתחַשֵׁיב ללֵיוָאֵי כעַללַת אִידרָא וֻכעַללַת מַעַצַרתָאמעשׂרתא
ותֵיכלוּן יָתֵיה בכֹל אַתַר אַתוּן וַאַנָשׁ בָתֵיכֹון אַרֵי אַגרָא הוּא לכֹון חַלָף פוּלחָנכֹון במַשׁכַן זִמנָא
ולָא תקַבלוּן עַלֹוהִי חֹובָא באַפרָשׁוּתכֹון יָת שׁוּפרֵיה מִנֵיה ויָת קוּדשַׁיָא דִבנֵי ישׂראל לָא תַחַלוּן ולָא תמוּתוּן
וֻמַלֵיל יוי עִםלות מֹשַׁה ולאהרןועִם אַהרֹןולות אהרן למֵימַר
דָא גזֵירַת אֹורָיתָא דפַקֵיד יוי למֵימַר מַלֵיל עִם בנֵי ישׂראל ויִסבוּן לָך תֹורתָא סִמֹוקתָא שַׁלמתָא דלֵית בַה מוּמָא דלָא סלֵיק עַלַה נִירָא
ותִיתנוּן יָתַה לאַלעָזָר כָהַנָא ויַפֵיק יָתַה למִבַרָא למַשׁרִיתָא ויִכֹוס יָתַה קדָמֹוהִי
ויִסַב אַלעָזָר כָהַנָא מִדמַה באַצבעֵיה ויַדֵי לִקבֵיל אַפֵי מַשׁכַן זִמנָא מִדמַהמן דמה שׁבַע זִמנִין
ויֹוקֵיד יָת תֹורתָא לעֵינֹוהִי יָת מַשׁכַה ויַת בִסרַה ויָת דמַה עַל אוּכלַה יֹוקֵיד
ויִסַב כָהַנָא אָעָא דאַרזָא ואֵיזֹובָא וֻצבַע זהֹורִי ויִרמֵי לגֹו יקֵידַת תֹורתָא
וִיצַבַע לבוּשֹׁוהִי כָהַנָא ויַסחֵי בִסרֵיה במַיָא וֻבָתַר כֵין יֵיעֹול למַשׁרִיתָא וִיהֵי מסָאַב כָהַנָא עַד רַמשָׁא
וֻדמֹוקֵיד יָתַה יצַבַע לבוּשֹׁוהִי במַיָא ויַסחֵי בִסרֵיה במַיָא וִיהֵי מסָאַב עַד רַמשָׁא
ויִכנֹושׁ גבַר דכֵי יָת קִטמָא דתֹורתָא ויַצנַע מִבַרָאלמברא למַשׁרִיתָא בַאַתַרלַאַתַר דכֵי וֻתהֵי לִכנִשׁתָא דִבנֵי ישׂראל למַטרָא למֵי אַדָיוּתָא חַטָתָא הִיא
וִיצַבַע דכָנֵישׁ יָת קִטמָא דתֹורתָא יָת לבוּשֹׁוהִי וִיהֵי מסָאַב עַד רַמשָׁא וֻתהֵי לִבנֵי ישׂראל וֻלגִיֹורַיָא דיִתגַיירוּן בֵינֵיהֹון לִקיָם עָלַם
דיִקרַב במִיתָא לכֹל טמי נַפשָׁא דַאַנָשָׁא וִיהֵי מסָאַב שִׁבעָה יֹומִין
הוּא יַדֵי עַלֹוהִי ביֹומָא תלִיתָאָה וֻביֹומָא שׁבִיעָאָה יִדכֵי ואִם לָא יַדֵי עַלֹוהִי ביֹומָא תלִיתָאָה וֻביֹומָא שׁבִיעָאָה לָא יִדכֵי
כֹל דיִקרַב במִיתָא בנַפשָׁא דִימוּת ולָא יַדֵי עַלֹוהִי יָת מַשׁכנָא דַיוי סַאֵיב ויִשׁתֵיצֵי אַנָשָׁא הַהוּא מִישׂראל אַרֵי מֵי אַדָיוּתָא לָא אִזדרִיקוּ עַלֹוהִי מסָאַב יהֵי עֹוד סאֹובתֵיה בֵיה
דָא אֹורָיתָא אַנָשׁ אַרֵי ימוּת במַשׁכנָא כֹל דעָלֵיל למַשׁכנָאבמשׁכנא וכֹל דִבמַשׁכנָא יהֵי מסָאַב שִׁבעָה יֹומִין
וכֹל מָן דַחסַף פתִיַח דלֵית מגוּפַת שִׁיָע מַקַף עַלֹוהִי מסָאַב הוּא
וכֹל דיִקרַב עַל אַפֵי חַקלָא בִקטִיל חַרבָא אֹו במִיתָא אֹו בגַרמָא דַאַנָשָׁא אֹו בקַברָא יהֵי מסָאַב שִׁבעָה יֹומִין
ויִסבוּן לדִמסָאַב מֵעַפַר יקֵידַת חַטָתָא ויִתֵין עַלֹוהִי מֵי מַבוּעַ למָן
ויִסַב אֵיזֹובָא ויִטבֹול במַיָא גבַר דכֵי ויַדֵי עַל מַשׁכנָא ועַל כֹל מָנַיָא ועַל כל נַפשָׁתָא דַהוֹו תַמָן ועַל דיִקרַב בגַרמָא אֹו בִקטִילָא אֹו במִיתָא אֹו בקַברָא
ויַדֵי דַכיָא עַל מסָאַבָא ביֹומָא תלִיתָאָה וֻביֹומָא שׁבִיעָאָה וִידַכֵינֵיה ביֹומָא שׁבִיעָאָה וִיצַבַע לבוּשֹׁוהִי ויַסחֵי במַיָא ויִדכֵי ברַמשָׁא
וֻגבַר דיִסתָאַבדיהי מסאב ולָא יַדֵי עַלֹוהִי ויִשׁתֵיצֵי אַנָשָׁא הַהוּא מִגֹו קהָלָא אַרֵי יָת מַקדשָׁא דַיוי סַאֵיב מֵי אַדָיוּתָא לָא אִזדרִיקוּאזריקו עַלֹוהִי מסָאַב הוּא
וֻתהֵי להֹון לִקיָם עָלַם וֻדמַדֵיודידי מֵי אַדָיוּתָא יַבַע לבוּשֹׁוהִי וֻדיִקרַב במֵי אַדָיוּתָא יהֵי מסָאַב עַד רַמשָׁא
וכֹל דיִקרַב בֵיה מסָאַבָא יהֵי מסָאַב וַאַנָשׁ דיִקרַב בֵיה יהֵי מסָאַב עַד רַמשָׁא
וַאַתֹו בנֵי ישׂראל כֹל כנִשׁתָא למַדברָאמַדברָא דצִין ביַרחָא קַדמָאָה וִיתֵיב עַמָא בִרקַם וֻמֵיתַת תַמָן מִריָם ואִתקבַרַת תַמָן
ולָא הַוָה מַיָא לִכנִשׁתָא ואִתכנִישׁוּ עַל מֹשַׁה ועַל אַהַרֹן
וֻנצָא עַמָא עִם מֹשַׁה וַאַמַרוּ למֵימַר לוֵי דמֵיתנָא במֹותָא דַאַחַנָא קדם יוי
וֻלמָא אַתֵיתֹוןאעילתון יָת קהָלָא דַיוי למַדברָא הָדֵין לִיממָת תַמָן אַנַחנָא וֻבעִירַנָא
וֻלמָא אַסֵיקתוּנָא מִמִצרַיִם לַאַעָלָאלאֵיתָאָה יָתַנָא לאַתרָא בִישָׁא הָדֵין לָאלית אַתַר כָשַׁר לבֵית זרַע ואַף לָא תֵינִין וגוּפנִין ורִמֹונִין וֻמַיָא לֵיתלא אית למִשׁתֵי
ועָלואתא מֹשַׁה ואַהַרֹן מִן קדָםמקדם קהָלָא לִתרַע מַשׁכַן זִמנָא וֻנפַלוּ עַל אַפֵיהֹון ואִתגלִי יקָרָא דַיוי להֹון
ומליל יוי עםלות משׁה למימר
סַבטול יָת חוּטרָא ותִכנֹושׁ יָת כנִשׁתָאקהָלָא אַת ואהרן אַחוּך וֻתמַללוּן עִם כֵיפָא לעֵינֵיהֹון ויִתֵין מֹוהִיממוהי ותַפֵיק להֹון מַיָא מִן כֵיפָא ותַשׁקֵי יָת כנִשׁתָא ויָת בעִירהֹון
וֻנסֵיב מֹשַׁה יָת חוּטרָא מִן קדם יוי כמָא דפַקדֵיה
וֻכנַשׁוּ משׁה ואהרן יָת קהָלָא לִקדָם כֵיפָא וַאַמַר להֹון שׁמַעוּ כעַן סָרבָנַיָא הַמִן כֵיפָא הָדֵין נַפֵיק לכֹון מַיָא
וַאַרֵים מֹשַׁה יָת ידֵיה וֻמחָא יָת כֵיפָא בחוּטרֵיה תַרתֵין זִמנִין וֻנפַקוּ מַיָא סַגִיאֵי וֻשׁתִיאַת כנִשׁתָא וֻבעִירהֹון
וַאַמַר יוי למֹשַׁה ולאהרן חַלָף דלָאלָא הֵימֵינתוּן במֵימרִי לקַדָשׁוּתִי לעֵינֵי בנֵי ישׂראל בכֵין לָא תַעַלוּן יָת קהָלָאעמא הָדֵין לארעאלאתרא דִיהַבִית להֹון
אִינוּן מֵי מַצוּתָא דִנצֹו בנֵי ישׂראל קדם יוי ואִתקַדַשׁ בהֹון
וֻשׁלַח מֹשַׁה אִזגַדִין מֵרקַם לוָת מַלכָא למלכא דַאַדֹום כִדנָן אַמַר אַחוּך ישׂראל אַת יָדעַת יָת כֹל עַקתָא דאַשׁכַחתַנָא
וֻנחַתוּ אַבָהָתַנָא למצרים וִיתֵיבנָא במצרים יֹומִין סַגִיאִין ואַבאִישׁוּ לַנָא מִצרָאֵימצרים ולַאַבָהָתַנָא
וצַלִינָא קדם יוי וקַבֵיל צלֹותַנָא וֻשׁלַח מַלאַכָא ואַפקַנָא ממִצרַיִם והָא אַנַחנָא בִרקַם קַרתָא דבִסטַרבסטר תחוּמָך
נעִיבַר כעַן באַרעָך לָא נעִיבַר בַחקַל וֻבִכרַם ולָא נִשׁתֵי מֵי גוּב באֹורַחאורח מַלכָא נֵיזֵיל לָא נִסטֵי ליַמִינָאימינה ולִסמָלָא עַד דנִיעִיבַר תחוּמָך
וַאַמַר לֵיה אַדֹוםאדֹומָאָה לָא תעִיבַר בִתחוּמִי דִלמָא בִדקָטלִיןבקטלין בחַרבָאדחרבא אִיפֹוק לקַדָמוּתָך
וַאַמַרוּ לֵיה בנֵי יִשׂרָאֵל באֹורַח כבִישָׁא נִיסַק ואִם מַיָךמימך נִשׁתֵי אַנָא וֻבעִירִי ואִיתֵין דמֵיהֹון לחֹוד לֵית פִתגָם בִישׁדבישׁ ברַגלַי אַעִיבַר
וַאַמַר לָא תעִיבַר וֻנפַק אַדֹומָאָה לקַדָמוּתֵיה בחֵיל רַב וֻביַד תַקִיפָא
וסָרֵיב אַדֹומָאָה לָא שׁבַק למשׁבק יָת ישׂראל למִיעִיבַר בִתחוּמֵיה וֻסטָא ישׂראל מִלוָתֵיה
וֻנטַלוּ מֵרקַם וַאַתֹו בנֵי ישׂראל כֹל כנִשׁתָא להֹור טוּרָא
וַאַמַר יוי למשׁה ולאהרן בהֹור טוּרָא עַל תחוּם אַרעָא דאַדֹום למֵימַר
יִתכנֵישׁ אהרן לעַמֵיה אַרֵי לָא יֵיעֹול לארעא דִיהַבִית לִבנֵי ישׂראל עַל דסָרֵיבתוּן עַל מֵימרִי למֵי מַצוּתָא
דַבַר יָת אַהַרֹן ויָת אַלעָזָר ברֵיה ואַסֵיק יָתהֹון להֹור טוּרָא
ואַשׁלַח יָת אהרן יָת לבוּשֹׁוהִי ותַלבֵישֵׁינוּן יָת אַלעָזָר ברֵיה ואַהַרֹן יִתכנֵישׁ וִימוּת תַמָן
וַעַבַד מֹשַׁה כמָא דפַקֵיד יוי וֻסלִיקוּ להֹור טוּרָא לעֵינֵי כֹל כנִשׁתָא
ואַשׁלַח מֹשַׁה יָת אהרן יָת לבוּשֹׁוהִי ואַלבֵישׁ יָתהֹון יָת אַלעָזָר ברֵיה וֻמִית אַהַרֹן תַמָן ברֵישׁ טוּרָא וֻנחַת מֹשַׁה ואַלעָזָר מִן טוּרָא
וַחזֹוואִתַחזִיאוּ כֹל כנִשׁתָא אַרֵידהא מִית אהרן וֻבכֹו יָת אהרן תלָתִין יֹומִין כֹל בֵית יִשׂרָאֵל
וֻשׁמַע כנַעַנָאָה מַלכָא דַעַרַד יָתֵיב דָרֹומָא אַרֵי אַתָאעל ישׂראל אֹורַח מאַללַיָא וַאַגִיַח קרָבָא בישׂראל וֻשׁבָא מִנֵיה שִׁביָא
וקַיֵים ישׂראל קיָם קדָם יוי וַאַמַר אִם מִמסַר תִמסַר יָת עַמָא הָדֵין בִידִי וַאַגַמַר יָת קִרוֵיהֹון
וקַבֵיל יוי צלֹותֵיה דישׂראל וֻמסַר יָת כנַעַנָאָה וגַמַר יָתהֹון ויָת קִרוֵיהֹון וֻקרָא שׁמֵיה דאַתרָא חָרמָה
וֻנטַלוּ מֵהֹור טוּרָא אֹורַח יַמָא דסוּף לאַקָפָא יָת ארעא דַאַדֹום ועַקַת נַפשָׁאלנפשׁא דעַמָא באוּרחָא
ואִתרָעַם עַמָא קדָם יוי במימרא דייי ועִם מֹשַׁה נצֹו למָא דנן אַסֵיקתוּנָא מִמִצרַיִם לִיממָת במַדברָא אַרֵי לֵית לַחמָא ולֵית מַיָא ונַפשַׁנָא עַקַת במַנָא הָדֵין דמֵיכלֵיהבמיכליה קַלִיל
וגָרִי יוי בעַמָא יָת חִיוָיָן קָלַן ונַכִיתוּ יָת עַמָא וֻמִית עַם סַגִי מִישׂראל
ואַתָא עַמָא לוָת מֹשַׁה למשׁה וַאַמַרוּ חַבנָא אַרֵי אִתרָעַמנָא קדם יוי ועִמָך נצֵינָא צַלִי קדם יוי ויַעַדֵי מִנַנָא יָת חִיויָא וצַלִי מֹשַׁה עַל עַמָא
וַאַמַר יוי למֹשַׁה עִיבֵיד לָך קַליָא ושַׁו יָתֵיה עַל אָת וִיהֵי כֹל דיִתנכֵית ויִחזֵי יָתֵיה ויִתקַיַים
וַעַבַד מֹשַׁה חִיויָא דִנחָשָׁא ושַׁויֵה עַל אָת והָוֵי כַד נָכֵית חִיויָא יָת גַברָא וֻמִסתַכַל בחִויָאלחיויא דִנחָשָׁא וֻמִתקַיַים
וֻנטַלוּ בנֵי ישׂראל וֻשׁרֹו באֹבֹות
וֻנטַלוּ מֵאֵבֹות וֻשׁרֹו בִמגָזַת עִברָאֵי במַדברָא דעַל אַפֵי מֹואָב מִמַדנַח שִׁמשָׁא
מִתַמָן נטַלוּ וֻשׁרֹו בנַחלָא דזָרַד
מִתַמָן נטַלוּ וֻשׁרֹו מֵעִברָא דאַרנֹון דִבמַדברָא דנָפֵיק מִתחוּם אַמֹורָאָה אַרֵי אַרנֹון תחוּם מֹואָב בֵין מֹואָב וֻבֵין אַמֹורָאָה
עַל כֵין יִתאַמַר בסִפרָא קרָבִין עַבַדדעבד יוי עַל יַמָא דסוּף וֻגבוּרָן עַלדעל נַחלֵי אַרנֹון
ושָׁפֹוךושָׁפֵיך לנַחלַיָאנחליא דמִדַברִין לִקבֵיל לחָיַת וֻמִסתמֵיך לִתחוּם מֹואָב
וֻמִיתַמָן אִתיהֵיבַת להֹון בֵירָא הִיא בֵירָא דַאַמַר יוי למֹשַׁה כנֹושׁ יָת עַמָא ואִתֵין להֹון מַיָא
בכֵין שַׁבַח יִשׂרָאֵל יָת תוּשׁבַחתָא הָדָא סַקִי בֵירָא שַׁבַחוּ לַה
בֵירָא דחַפרוּהָאחפרוה רַברבַיָא כרֹוהָא רֵישֵׁי עַמָא סַפרַיָאבספריא בחוּטרֵיהֹוןבקלמסיהון וֻמִמִדברָא אִיתיהֵיבַת להֹון
וֻמדאִתיהֵיבַת להֹון נָחַתָא עִמהֹון לנַחלַיָא וֻמִנַחלַיָא סָלקָא עִמהֹון לרָמָתָא
וֻמֵרָמתָא לחִילַיָא דִבחַקלֵידי בחקל מֹואָב לרֵישׁרֵישׁ רָמתָא וֻמִסתַכיָא עַל אַפֵי בֵית ישִׁימֹון
וֻשׁלַח ישׂראל אִזגַדִין לוָת סִיחֹון מַלכָא אַמֹורָאָהדַאמֹורָאָה למֵימַר
אַעִיבַר באַרעָך לָא נִסטֵי בַחקַל וֻבִכרַם ולָא נִשׁתֵי מֵי גוּב באֹורַח מַלכָא נֵיזֵיל עַד דנִיעִיבַר תחוּמָך
ולָא שׁבַק סִיחֹון יָת יִשׂרָאֵל למִיעִיבַר בִתחוּמֵיה וֻכנַשׁ סִיחֹון יָת כֹל עַמֵיה וֻנפַק לקַדָמוּת ישׂראל למַדברָא וַאַתָא ליָהַץ וַאַגִיַח קרָבָא בישׂראל
וֻמחָהִי יִשׂרָאֵל לפִתגָם דחָרַב וִירֵית יָת אַרעֵיה מֵאַרנֹונָא עַד יוּבקָא עַד בנֵי עַמֹון אַרֵי תַקִיף תחוּמָא דִבנֵי עַמֹון
וֻנסֵיבוכבשׁ ישׂראל יָת כֹל קִרוַיָא הָאִלֵין וִיתֵיב ישׂראל בכֹל קִרוֵי אַמֹורָאָה בחַשׁבֹון וֻבכֹל כַפרָנַנָא
אַרֵי חַשׁבֹון קַרתָא דסִיחֹון מַלכָא אַמֹורָאָהדַאמֹורָאָה הִיא והוּא אַגִיַח קרָבָא במַלכָא דמֹואָב קַדמָאָה וֻנסֵיבוכבשׁ יָת כֹל אַרעֵיה מִנֵיהמידיה עַד אַרנֹון
עַל כֵין יֵימרוּן מַתָלַיָא עוּלוּ לחַשׁבֹון תִתבנֵי ותִשׁתַכלַל קַרתָא דסִיחֹון
אַרֵי קִידוּם תַקִיף כאִישָׁא נפַק מֵחַשׁבֹון עָבדֵי קרָבָא כשַׁלהָבִיתָא מִקַרתָא דסִיחֹון קַטִילוּ עַמָא דִשׁרֵי בִלחָיַת מֹואָב כוּמרַיָא דפָלחִין בֵית דַחלַת רָמתָא דאַרנֹון
וָי לכֹון מֹואַבָאֵי אַבַדתוּן עַמָא דפָלחִין לִכמֹושׁ מסַר בנֹוהִי צִירִין וֻבנָתֵיה בשִׁביָא למַלכָא אַמֹורָאָה סִיחֹון
פסַקַת מַלכוּ מֵחַשׁבֹון עַדָא שׁוּלטַן מִדִיבֹון וצַדִיאוּ עַד נֹפַח דִסמִיך עַל מֵידבָא
וִיתֵיב ישׂראל בַאַרַע אַמֹורָאָה
וֻשׁלַח מֹשַׁה לאַלָלָא יָת יַעַזֵר וֻכבַשׁוּ כַפרָנַהָא ותָרֵיך יָת אַמֹורָאָה דתַמָן
ואִתפנִיוּ וֻסלִיקוּ לאֹורַח מַתנַן וֻנפַק עֹוג מַלכָא דמַתנָן לקַדָמוּתהֹון הוּא וכָל עַמֵיה לאָגָחָא קרָבָא לאַדרַעִי
וַאַמַר יוי למֹשַׁה לָא תִדחַל מִנֵיה אַרֵי בִידָך מסַרִית יָתֵיה ויָת כֹל עַמֵיה ויָת אַרעֵיה ותַעַבֵיד לֵיה כמָא דַעַבַדתָא לסִיחֹן מַלכָא אַמֹורָאָה דיָתֵיב בחַשׁבֹון
וֻמחֹו יָתֵיה ויָת בנֹוהִי ויָת כֹל עַמֵיה עַד דלָא אִשׁתאַר לֵיה משֵׁיזִיב וִירִיתוּ יָת אַרעֵיה
וֻנטַלוּ בנֵי ישׂרָאֵל וֻשׁרֹו במֵישׁרַיָא דמֹואָב מֵעִברָא ליַרדנָא דִירִיחֹו
וַחזָא בָלָק בַר צִפֹור יָת כֹל דַעַבַד ישׂראל לַאַמֹורָאָה
וֻדחֵיל מֹואַבָאָה מִן קדם עַמָא לַחדָא אַרֵי סַגִי הוּא ועַקַת למֹואַבָאָה מִן קדָם בנֵי יִשׂרָאֵל
וַאַמַר מֹואַבָאָה לסָבֵי מִדיַן כעַן ישֵׁיצֹון קהָלָא יָת כֹל סַחרָנַנָאדי בסחרננא כמָא דִמלַחֵיך תֹורָא יָת יָרֹוקָא דחַקלָא וֻבָלָק בַר צִפֹור מַלכָא למֹואָבדמואבלמואבאה בעִידָנָה הַהוּא
וֻשׁלַח אִזגַדִין לוָת בִלעָם לבלעם בַר בעֹור לִפתֹור אַרָםלארם דעַל פרָת אַרַעלארעא בנֵי עַמֵיה למִקרֵי לֵיה למֵימַר הָא עַמָא נפַק ממצרים הָא חַפָא יָת עֵין שִׁמשָׁא דארעא והוּא שׁרֵי מִלקִבלִי
וֻכעַן אֵיתַא כעַן לֹוט לִי יָת עַמָא הָדֵין אַרֵי תַקִיף הוּא מִנִי מָא אִם אִיכֹול לאָגָחָא בֵיה קרָב וַאַתָרכִינֵיה מִן אַרעָא אַרֵי ידַענָא יָת דִתבָרֵיך מבָרַך ודִתלוּט לִיט
וַאַזַלוּ סָבֵי מֹואָב וסָבֵי מִדיָן וקִסמַיָא בִידֵיהֹון וַאַתֹו לוָת בִלעָםלבלעם וֻמַלִילוּ עִמֵיה פִתגָמֵי בָלָק
וַאַמַר להֹון בִיתוּ הָכָא בלֵיליָא וַאַתֵיב יָתכֹון פִתגָמָא כמָא דִימַלֵיל יוי עִמִי ואֹורִיכוּ רַברבֵי מֹואָב עִם בִלעָם
וַאַתָא מֵימַר מִן קדם יוי לוָת בִלעָם לבלעם וַאַמַר מַן גֻברַיָא הָאִלֵין דעִמָךעמך
וַאַמַר בִלעָם קדם יוי בָלָק בַר צִפֹור מַלכָא דמֹואָב שׁלַח לוָתִי
הָא עַמָא נפַקדִנפַק ממצרים וַחפָא יָת עֵין שִׁמשָׁא דארעא כעַן אֵיתַא לֹוט לִי יָתֵיה מָא אִם אִיכֹול לאָגָחָא בֵיה קרָב וַאַתָרכִינֵיה
וַאַמַר יוי לבִלעָם לָא תֵיזֵיל עִמהֹון לָא תלוּט יָת עַמָא אַרֵי ברִיך הוּא
וקָם בִלעָם בצַפרָא וַאַמַר לרַברבֵי בָלָק אִיזִילוּ לַאַרַעכֹון אַרֵי לֵית רַעַוָא קדםמן קדם יוי דלָא למִשׁבקִי למֵיזַל עִמכֹון
וקָמוּ רַברבֵי מֹואָב וַאַתֹו לוָת בָלָק וַאַמַרוּ סָרֵיב בִלעָם למֵיתֵי עִמַנָא
ואֹוסֵיף עֹוד בָלָק שׁלַחלמשׁלח רַברבִין סַגִיאִין ויַקִירִיןותַקִיפִין מֵאִלֵין
וַאַתֹו לוָת בִלעָם וַאַמַרוּ לֵיה כִדנָן אַמַר בָלָק בַר צִפֹור לָא כעַן תִתמנַע מִלמֵיתֵי לוָתִי
אַרֵי יַקָרָא אַיַקרִינָך לַחדָא וכֹל דתֵימַר לִילותי אַעַבֵיד ואֵיתַא כעַן לֹוט לִי יָת עַמָא הָדֵין
וַאַתֵיב בִלעָם וַאַמַר לעַבדֵי בָלָק אִם יִתַןיִתֵין לִי בָלָק מלֵי בֵיתֵיה כסַף וֻדהַב לֵית לִי רשׁוּ למִיעִיבַר עַל גזֵירַת מֵימרָא דיוי אַלָהִי דאלהי למַעַבַד זעֵירתָא אֹו רַבתָא
וֻכעַן אֹורִיכוּ כעַן הָכָא אַף אַתוּן בלֵיליָא ואִידַע מָא יֹוסֵף יוי למַלָלָא עִמִי
וַאַתָא מֵימַר מִן קדם יוי לוָת בלעם לבלעם בלֵיליָא וַאַמַר לֵיה אִם למִקרֵי לָך אַתֹו גַברַיָא קוּם אִזֵיל עִמהֹון וֻברָםולחוד יָת פִתגָמָא דַאַמַלֵיל עִמָך יָתֵיה תַעַבֵיד
וקָם בִלעָם בצַפרָא וזָרֵיז יָת אַתָנֵיה וַאַזַל עִם רַברבֵי מֹואָב
וֻתקֵיף רוּגזָא דַיוי אַרֵי אָזֵיל הוּא ואִתעַתַד מַלאַכָא דַיוי באֹורחָא לסָטָןלמשׂטן לֵיה והוּא רָכֵיב עַל אַתָנֵיה וֻתרֵין עוּלֵימֹוהִי עִמֵיה
וַחזָת אַתָנָא יָת מַלאַכָא דַיוי מעַתַד באֹורחָא וחַרבֵיה שׁלִיפָא בִידֵיה וֻסטָת אַתָנָא מִן אֹורחָא וַאַזַלַת בחקלָא וֻמחָא בִלעָם יָת אַתָנָא לאתנא לאַסטָיוּתַה באֹורחָאלאֹורחָא
וקָם מַלאַכָא דַיוי בִשׁבִיל כַרמַיָא אַתרָא דגָדֵירָא מִיכָא וגָדֵירָאואתרא דגדירא מִיכָא
וַחזָת אַתָנָא יָת מַלאַכָא דַיוי ואִדחֵיקַת עִם כוּתלָא לכותלא וֻדחַקַת יָת רִגלָא דבִלעָם בכוּתלָאלכותלא ואֹוסֵיף למִמחַהלאלקיותה
ואֹוסֵיף מַלאַכָא דַיוי עַבַרלמיעבר וקָם בָאַתַר עָק דלֵית אֹורַח למִסטֵי ליַמִינָאימינא ולִסמָלָאוסמאלא
וַחזָת אַתָנָא יָת מַלאַכָא דַיוי וֻרבַעַת תחֹות בִלעָם וֻתקֵיף רוּגזָא דבִלעָם וֻמחָא יָת אַתָנָא בחוּטרָא
וֻפתַח יוי יָת פוּמָא דַאַתָנָא וַאַמַרַת לבִלעָם מָא דָא עַבַדִית לָך אַרֵי מחֵיתַנִי דנַן תלָת זִמנִין
וַאַמַר בִלעָם לאַתָנָא אַרֵי חַייֵכת בִי אִילוּ פֹון אִית חַרבָא בִידִי אַרֵי כעַן קטַלתִיך
וַאַמַרַת אַתָנָא לבִלעָם הַלָא אַנָא אַתָנָך דרָכֵיבת עַלַי מִדאִיתָך עַד יֹומָא הָדֵין הַמֵילָף אַלֵיפנָא למַעַבַד לָך כדֵין וַאַמַר לָא
וֻגלָא יוי יָת עֵינֵי בִלעָם וַחזָא יָת מַלאַכָא דַיוי מעַתַד באֹורחָא וחַרבֵיה שׁלִיפָא בִידֵיה וֻכרַע וֻסגֵיד לאַפֹוהִי
וַאַמַר לֵיה מַלאַכָא דַיוי עַל מָא מחֵיתָא יָת אַתָנָך דנָן תלָת זִמנִין הָא אַנָא נפַקִית לסָטָןלמסטן אַרֵי גלֵי קדָמַי דאַת רעֵי למֵיזַל באֹורחָא לקִבלִי
וַחזָתנִי אַתָנָא וֻסטָת מִן קדָמַי דנָן תלָת זִמנִין אִילוּ פֹון לָאדלא סטָת מִן קדָמַימקדמי אַרֵי כעַן אַף יָתָך קטַלִית ויָתַה קַיֵימִית
וַאַמַר בלעם למַלאַכָא דַיוי חַבִית אַרֵי לָא יָדַענָא דאַתארֵי אַת מעַתַד לקַדָמוּתִי באֹרחָא וֻכעַן אִם בִישׁ בעֵינָךקדמך אֵיתוּב לִילותי
וַאַמַר מַלאַכָא דַיוי לבִלעָם אִיזֵיל עִם גַברַיָא וֻברַםולחוד יָת פִתגָמָא דַאַמַלֵיל עִמָךלותך יָתֵיה תמַלֵיל וַאַזַל בִלעָם עִם רַברבֵי בָלָק
וֻשׁמַע בָלָק אַרֵי אַתָא בלעם וֻנפַק לקַדָמוּתֵיה לקַרתָא דמֹואָב דעַל תחוּם אַרנֹון דבִסטַר תחוּמָא
וַאַמַר בָלָק לבלעם הַלָא מִשׁלָח שׁלַחִית לוָתָך למִקרֵי לָך למָא לָא אַתֵיתָא לוָתִי הַבקוּשׁטָאהברם בקושׁטא הַוֵיתָא אָמַר לֵית אַנָא יָכִיליָכֵיל ליַקָרוּתָך
וַאַמַר בִלעָם לבָלָקלות בלק הָא אַתֵיתִי לוָתָך כעַן הַמֵיכָל יָכֵילנָא למַלָלָא מִידָעַם פִתגָמָא דִישַׁוֵי יוי בפוּמִי יָתֵיה אַמַלֵיל
וַאַזַל בלעם עִם בָלָק ואַעַלֵיהואתו לקִריַת מָחֹוזֹוהִי
וֻנכַס בָלָק תֹורִין ועָן ושַׁלַחושׁדר לבִלעָם וֻלרַברבַיָא דעִמֵיה
וַהַוָה בצַפרָא וֻדבַר בָלָק יָת בִלעָם ואַסקֵיה לרָמַת דַחלָתֵיה וַחזָא מִיתַמָן קצָת מִן עַמָא
וַאַמַר בִלעָם לבָלָק בנֵי לִי הָכָא שִׁבעָה מַדבחִין ואַתקֵין לִי הָכָא שִׁבעָה תֹורִין ושִׁבעָה דִכרִין
וַעַבַד בָלָק כמָא דמַלֵיל בִלעָם ואַסֵיק בָלָק וֻבִלעָם תֹור וֻדכַר עַל כָל מַדבַח במדבחא
וַאַמַר בִלעָם לבָלָק אִתעַתַד עַל עַלָתָך וַאַהָך מָא אִם יעָרַע מֵימַר מִן קדם יוי לקַדָמוּתִי ופִתגָמָא דיַחזֵינַנִי וַאַחַוֵי לָך וַאַזַל יחִידָי
ועָרַע מֵימַר מִן קדם יוי בבִלעָםלות בלעםלבלעם וַאַמַר קדָמֹוהִיליה יָת שִׁבעָה מַדבחִין סדַרִית ואַסֵיקִית תֹור וֻדכַר עַל כָל מַדבַח
ושַׁוִי יוי ית פִתגָמָא בפוּמָא דבִלעָם וַאַמַר תוּב לוָת בָלָק וֻכדֵין תמַלֵיל
ותָב לוָתֵיה והָא הוא מעַתַד עַל עַלָתֵיה הוּא וכֹל רַברבֵי מֹואָב
וֻנטַל מַתלֵיה וַאַמַר מִן אַרָם דַברַנִי בָלָק מַלכָא דמֹואָב מִטוּרֵי מַדִנחָא אֵיתַא לֹוט לִי יַעַקֹב ואֵיתָא תָרֵיך לִי ית ישׂראל
מָא אַלוּטֵיה דלָאלא לָטֵיה אֵל וֻמָא אַתָרכֵיה דלָא תָרכֵיה יוי
אַרֵי מֵרֵישׁ טוּרַיָא חַזֵיתֵיה וֻמֵירמָתָא סכֵיתֵיה הָא עַמָא בִלחֹודֵיהֹון עַתִידִין דיַחסנוּן עָלמָא וֻכעַממַיָאוֻבעַממַיָא לָא יִדדָנוּן גמֵירָא
מַן יִכֹולדיכול למִמנֵי דעַדקַיָאדעתקיא דבֵית יַעַקֹב דַאַמִיר עַלֵיהֹון יִסגֹוןדיִסגֹון כעַפרָא דארעא אֹו חַדָא מֵאַרבַע מַשׁרִיָתָא דיִשׂרָאֵל תמוּת נַפשִׁי מֹותָא דקַשִׁיטֹוהִידעַשִׁיקֹוהִי וִיהֵי סֹופִי כוָתהֹון
וַאַמַר בָלָק לבלעם מָא עַבַדת לִי לִמלָט סָנאַי דבַרתָך והָא בָרָכָא מבָרַכת להֹון
וַאַתֵיב וַאַמַר הלָא יָת דִישַׁוֵי יוי בפוּמִי יָתֵיה אִיטַר למַלָלָא
וַאַמַר לֵיה בָלָק אֵיתַא כעַן עִמִי לַאַתַר אָחָרָן דתִחזֵי מִתַמָן לחֹוד קצָתֵיה תִחזֵי וכוּלֵיה לָא תִחזֵי וֻתלוּטֵיה לִי מִתַמָן
ודַברֵיה לַחקַל סָכוּתָא לרֵישׁ רָמתָא וֻבנָא שִׁבעָה מַדבחִין ואַסֵיק תֹור וֻדכַר עַל כָל מַדבַח
וַאַמַר לבָלָק אִתעַתַד הָכָא עַל עַלָתָך וַאַנָא אִתמטֵי עַד כָאכען
ועָרַע מֵימַר מִן קדם יוי בבִלעָםלבלעםלות בלעם ושַׁוֵי פִתגָמָא בָפוּמֵיה וַאַמַר תוּב לוָת בָלָק וֻכדֵין תמַלֵיל
וַאַתָא לוָתֵיה והוּאוהא הוא מעַתַד עַל עַלָתֵיה ורַברבֵי מֹואָב עִמֵיה וַאַמַר לֵיה בָלָק מָא מַלֵיל יוי
וֻנטַל מַתלֵיה וַאַמַר קוּם בָלָק וֻשׁמָע אַצֵית למֵימרִי בַר צִפֹור
לָא כמִלֵי בנֵי אַנָשָׁא מֵימַר אַלָהָא בנֵי אַנָשָׁא אָמרִין וֻמכַדבִין ואַף לָא כעוּבָדֵי בנֵי בִסרָא דאִנוּן גָזרִין למַעַבַד תָיבִין וֻמִתמַלכִין הוּאדהוא אָמַר ועָבֵידולא יעביד וכֹל מֵימרֵיה מִתקַיַים
הָא בִרכָן קַבֵילִית אַבָרכִינֵיה לישׂראל ולָא אַתֵיב בִרכתִי מִנֵיה
אִסתַכַלִית ולֵית פָלחֵי גִלוּלִין בִדבֵית יַעַקֹב ואַף לָא עָבדֵי לֵיאוּת שׁקַר ביִשׂרָאֵלברבות בית ישׂראל מֵימרָא דַיוי אַלָהַהֹון בסַעַדהֹון וֻשׁכִינַת מַלכהֹון בֵינֵיהֹון
אֵלאלהא דאַפֵיקִינוּן מִמצרים תוּקפָא ורוּמָא דִילֵיה
אַרֵי לָא נחָשַׁיָא צָבַן דיִיטַב לִדבֵיתבדבית יַעַקֹב ואַף לָא קַסָמַיָא רָעַן בִרבוּת בֵית בדבית ישׂראל כעִידָןבעידן יִתאַמַר ליַעַקֹב וֻלישׂראל מָא עַבַד אַלָהָא
הָא עַמָא כלֵיתָא שׁרֵי וֻכאַריָא יִתנַטַל לָא יִשׁרֵי באַרעֵיה עַד דיִקטֹוליקטול קטֹול ונִכסֵי עַממַיָא יֵירַת
וַאַמַר בָלָק לבִלעָם אַף מלָט לָא תלוּטִינוּן אַף בָרָכָא לָא תבָרֵיכִינוּן
וַאַתֵיב בִלעָם וַאַמַר לבָלָק הַלָא מַלֵילִית עִמָךלותך למֵימַר כֹל דִימַלֵיל יוי יָתֵיה אַעַבֵיד
וַאַמַר בָלָק לבִלעָם אֵיתַא כעַן אִדברִינָך לַאַתַר אוּחרָן מָא אִם תהֵי רַעַוָא מִן קדם יוי וֻתלוּטֵיה לִי מִתַמָן
וֻדבַר בָלָק יָת בלעם לרֵישׁרֵישׁ רָמתָא דפעור דמִסתַכיָא עַל אַפֵי בֵית ישִׁימֹון
וַאַמַר בִלעָם לבָלָק בנֵי לִי הָכָא שִׁבעָה מַדבחִין ואַתקֵין לִי הָכָא שִׁבעָה תֹורִין ושִׁבעָה דִכרִין
וַעַבַד בָלָק כמָא דַאַמַר בִלעָם ואַסֵיק תֹור וֻדכַר עַל כָל מַדבַח
וַחזָא בִלעָם אַרֵי תָקֵיןטב קדםבעֵינֵי יוי לבָרָכָא יָת ישׂראל ולָא הַלֵיךאזל כִזמַן בִזמַן אַלָהֵין לקַדָמוּת נחָשַׁיָא ושַׁוִי למַדברָאבמַדברָאלקביל עיגלא דעבדו ישׂראל במדברא אַפֹוהִי
וֻזקַף בִלעָם יָת עֵינֹוהִי וַחזָא יָת ישׂראל שָׁרַן לשִׁבטֹוהִי וֻשׁרָת עַלֹוהִי רוּחַ נבוּאָה מִן קדם יוי
וֻנטַל מַתלֵיה וַאַמַר אֵימַר בִלעָם בַר בעֹור ואֵימַר גֻברָא דשַׁפִיר חָזֵי
אֵימַר דשָׁמַע מֵימַר מִן קדָם אֵלייי דחֵיזוּוחזו מִן קדָם שַׁדַי חָזֵי שָׁכֵיב וֻמִתגלֵי לֵיה
מָא טָבָא אַרעָך יַעַקֹב בֵית מִשׁרָךבֵית מותבך ישׂראל
כנַחלִין דמִדַברִין כגִינַת שִׁקיָא עַלדעַל פרָת כבוּסמַיָא דִנצַב יוי כאַרזִין דִנצִיבִין עַל מַיָא
יִסגֵי מַלכָא דיִתרַבַא מִבנֹוהִי ויִשׁלֹוט בעַממִין סַגִיאִין ויִתַקַף מֵאַגַג מַלכֵיה ותִינַטַל מַלכוּתֵיה
אֵלאלהא דאַפֵיקִינוּן מִמצרים תוּקפָא ורוּמָא דִילֵיה יֵיכלוּן בֵיתבני ישׂראל נִכסֵי עַממַיָא סָנאֵיהֹון וֻבבִיזַת מַלכֵיהֹון יִתפַנקוּן ואַרעָתהֹון יַחסנוּן
ינוּחַ יִשׁרֵי בִתקֹוף כאַריָא וֻכלֵיתָא לֵיתדלית מלכו דִיקִימִינֵיהדיזעזעיניהדיזדעזעיניה ברִיכָךמברכך יהֹון ברִיכִין ולִיטָך יהֹון לִיטִין
וֻתקֵיף רוּגזָא דבָלָק בבִלעָםלבלעם וֻשׁקַפִינוּן לִידֹוהִי וַאַמַר בָלָק לבִלעָם לִמלָט סָנאַי דבַרתָךקרֵיתָך והָא בָרָכָא מבָרַכת להֹון דנָן תלָת זִמנִין
וֻכעַן אִיזֵיל לָך לאַתרָך אַמַרִית יַקָרָא אֵיַקרִינָך והָא מַנעָך יוי מִן יקָר מיקר
וַאַמַר בִלעָם לבָלָק הַלָא אַףגם עִם אִזגַדָך לאיזגדך דִשׁלַחתָא לוָתִי מַלֵילִית למֵימַר
אִם יִתֵין לִי בָלָק מלֵי בֵיתֵיה כסַף וֻדהַב לֵית לִי רשׁוּ למִיעִיבַר עַל גזֵירַת מֵימרָא דַיוי למַעַבַד טָבתָא אֹו בִשׁתָא מִרעוּתִימֵרעוּתִי דִימַלֵיל יוי יָתֵיה אַמַלֵיל
וֻכעַן הָאַנָא אָזֵיל לעַמִי אֵיתַא אִמלכִינָך מָא דתַעַבֵיד וַאַחַוֵי לָך מָא דיַעַבֵיד עַמָא הָדֵין לעַמָך בסֹוף יֹומַיָא
וֻנטַל מַתלֵיה וַאַמַר אֵימַר בִלעָם בַר בעֹור ואֵימַר גֻברָא דשַׁפִיר חָזֵי
אֵימַר דשָׁמַע מֵימַר מִן קדָם אֵל ויָדַע מַדַע מִן קדָם עִלָאָה דחֵיזוּחֵיזוּ מִן קדָם שַׁדַי חָזֵי שָׁכֵיב וֻמִתגלֵי לֵיה
חַזֵיתֵיה ולָא כעַן סכֵיתֵיה ולָיתֹוהִיולא איתוהי קָרֵיב כַד יקוּם מַלכָא מִיַעַקֹבמדבית יעקב ויִתרַבַא משִׁיחָא מישׂראלמדבית ישׂראל וִיקַטֵיל רַברבֵי מֹואָב ויִשׁלֹוט בכָל בנֵי אַנָשָׁא
וִיהֵי אַדֹוםאדומאה ירוּתָא וִיהֵי ירוּתָא שֵׂעִיר לבַעלֵי דבָבֹוהִי וישׂראל יַצלַח בנִכסִין
ויֵיחֹות חַד מִדבֵית יעקב ויֹובֵיד משֵׁיזִיב מִקִריַת עַממַיָא
וַחזָא יָת עַמָלקָאָה וֻנטַל מַתלֵיה וַאַמַר רֵישׁ קרָבַיָא דישׂראל הַוָה עַמָלֵק וסֹופֵיה לעָלמָא יֵיבַד
וַחזָא יָת שָׁלמָאָה וֻנטַל מַתלֵיה וַאַמַר תַקִיף בֵית מֹותבָך ושַׁו בִכרַך תַקִיף מדֹורָך
אַרֵי אִם יהֵי לשֵׁיצָאָה שָׁלמָאָה עַד מָא אַתוּרָאָה יִשׁבֵינָך
וֻנטַל מַתלֵיה וַאַמַר וָי לחַיָבַייָא דיֵיחֹון כַד יַעַבֵיד אַלָהָא יָת אִלֵין
וסִיעָןוציען יִצטָרחָןדאיצטרחן מֵרֹומָאֵימן רומאי וִיעַנֹון לאַתוּר וישַׁעבדוּןוישׁתעבדון לעֵבַר פרָת ואַף אִינוּן לעָלמָא יֵיבדוּן
וקָם בִלעָם וַאַזַל ותָב לאַתרֵיה ואַף בָלָק אַזַל לאֹורחֵיהלאתריה
וִיתֵיב ישׂראל בשִׁטִין ושָׁרִי עַמָא למִטעֵי בָתַר בנָת מֹואָב
וֻקרַאָה לעַמָא לדִבחֵי טָעַוָתהֹון וַאַכַל עַמָא וֻסגִידוּ לטָעַוָתהֹון
ואִתחַבַר ישׂראל לבַעלָאלפלחי בעלא פעֹור וֻתקֵיף רוּגזָא דַיוי בישׂראל
וַאַמַר יוי למֹשַׁה דבַר יָת כֹל רֵישֵׁי עַמָא ודוּן וֻקטֹול דחַייָב קטֹול קדם יוי לִקבֵיל שִׁמשָׁא וִיתוּב תקֹוף רוּגזָא דַיוי מישׂראל
וַאַמַר מֹשַׁה לדַייָנֵי ישׂראל קטוּלוּ גבָר גַברֹוהִי דאִתחַבַרוּ לבַעלָא פעֹור
והָא גֻברָא מִבנֵי ישׂראל אַתָא וקָרֵיב לוָת אַחֹוהִי יָת מִדיַנֵיתָא לעֵינֵי מֹשַׁה וֻלעֵינֵי כֹל כנִשׁתָא דִבנֵי ישׂראל ואִינוּן בָכַן בִתרַע מַשׁכַן זִמנָא
וַחזָא פִנחָס בַר אַלעָזָר בַר אַהַרֹן כָהַנָא וקָם מִגֹו כנִשׁתָא וֻנסֵיב רוּמחָא בִידֵיה
ועָלואתא בָתַר גַברָא בַר ישׂראל לקוּבתָא וֻבַזַע יָת תַרוֵיהֹון יָת גֻברָא בַר ישׂראל ויָת אִיתתָא בִמעַהָאלמעהא ואִתכלִי מֹותָנָא מֵעַל בנֵי ישׂראל
וַהוֹו דמִיתוּ במֹותָנָא עַסרִין ואַרבעָה אַלפִין
וֻמַלֵיל יוי עִםלות מֹשַׁה למֵימַר
פִנחָס בַר אַלעָזָר בַר אַהַרֹן כָהַנָא אַתֵיב יָת חִמתִי מֵעַל בנֵי יִשׂרָאֵל בדקַנִי יָת קִנאַתִי בֵינֵיהֹון ולָא שֵׁיצִיתִי יָת בנֵי ישׂראל בקִנאַתִי
בכֵין אֵימַר הָאַנָא גָזַר לֵיה יָת קִיָמִיקיָמִי שׁלָם
וֻתהֵי לֵיה ולִבנֹוהִי בָתרֹוהִי קִיָםקיָם כהוּנַת עָלַם חַלָף דקַנִי קדָם אַלָהֵיה וכַפַר עַל בנֵי ישׂראל
ושֵׁם גֻברָא בַר ישׂראל קטִילָא דאִתקטִיל עִם מִדיַנֵיתָא זִמרִי בַר סָלוּא רַב בֵית בָאבֵית אבא לבֵיתלשׁבט שִׁמעֹון
ושֹׁום אִיתתָא דאִתקטֵילַת מִדיַנֵיתָא כָזבִי בַת צוּר רֵישׁ אוּמֵי בֵית אַבָא במִדיָן הוּא
ומליל יוי עםלות משׁה למימר
אַעֵיק למִדיַנָאֵיית מדינאי וֻתקַטֵיל יָתהֹון
אַרֵי מעִיקִין אִינוּן לכֹון בִנִכלֵיהֹון דנַכִילוּ לכֹון עַל עֵיסַק פעֹור ועַל עֵיסַק כָזבִי בַת רַבָא דמִדיָן אַחָתהֹון דאִתקטֵילַת ביֹומָא דמֹותָנָא עַל עֵיסַק פעֹור
וַהוָה בָתַר מֹותָנָא וַאַמַר יוי למֹשַׁה וֻלאַלעָזָר בַר אהרן כָהַנָא למֵימַר
קַבִילוּ יָת חוּשׁבַן כֹל כנִשׁתָא דִבנֵי ישׂראל מִבַר עַסרִין שׁנִין וֻלעֵילָא לבֵית אַבָהָתהֹון כֹל נָפֵיקדנפיק חֵילָא בישׂראל
וֻמַלֵילומנא מֹשַׁה ואַלעָזָר כָהַנָא אַמַרוּ למִמנֵי יָתהֹון במֵישׁרַיָא דמֹואָב עַל יַרדנָא דִירִיחֹו למֵימַר
מִבַר עַסרִין שׁנִין וֻלעֵילָא כמָא דפַקֵיד יוי יָת מֹשַׁה וֻבנֵי ישׂראל דִנפַקוּ מארעא דמצרים
ראוּבֵן בוּכרָא דישׂראל בנֵי ראוּבֵן חַנֹוך זַרעִית חַנֹוך לפַלוּא זַרעִית פַלוּא
לחַצרֹן זַרעִית חַצרֹון לכַרמִי זַרעִית כַרמִי
אִלֵין זַרעַיָת ראוּבֵן וַהוֹו מִניָנֵיהֹון אַרבעִין וֻתלָתָה אַלפִין וֻשׁבַע מאָה וֻתלָתִין
וֻבנֵי פַלוּא אַלִיאָב
וַבנֵי אַלִיאָב נמוּאֵל ודָתָן וַאַבִירָם הוּא דָתָן וַאַבִירָם מעָרעֵי כנִשׁתָא דאִתכנִישׁוּ עַל מֹשַׁה ועַל אַהַרֹן בִכנִישׁתָא דקֹרַח באִתכַנֵישֵׁיהֹון עַל יהוה
וֻפתַחַת אַרעָא יָת פוּמַה וֻבלַעַת יָתהֹון ויָת קֹרַח במֹותָא דִכנִשׁתָא כַד אַכַלַת אִישָׁתָא יָת מָאתַן וחַמשִׁין גֻברָא וַהוֹו לאָת
וֻבנֵי קֹרַח לָא מִיתוּ
בנֵי שִׁמעֹון לזַרעַיָתהֹון לִנמוּאֵל זַרעִית נמוּאֵל ליִמִין זַרעִית יָמִין ליָכִין זַרעִית יָכִין
לזַרַח זרעית זַרַח לשָׁאוּל זרעית שָׁאוּל
אִלֵין זַרעיָת שִׁמעֹון עַסרִין וֻתרֵין אַלפִין וֻמָתַן
בנֵי גָד לזַרעַיָתהֹון לִצפֹון זרעית צפֹון לחַגִי זרעית חַגִי לשׁוּנִי זרעית שׁוּנִי
לאָזנִי זרעית אָזנִי לעֵרִי זרעית עֵרִי
לַאַרֹוד זַרעִית אַרֹוד לאַראֵלִי זרעית אַראֵלִי
אִלֵין זַרעַיָת בנֵי גָד למִניָנֵיהֹון אַרבעִין אַלפִין וחַמֵישׁ מאָה
בנֵי יהוּדָה עֵר ואֹונָן וֻמִית עֵר ואֹונָן באַרעָא דִכנָעַן
וַהוֹו בנֵי יהוּדָה לזַרעַיָתהֹון לשֵׁלָה זרעית שֵׁלָה לפַרַץ זרעית פַרַץ לזַרַח זרעית זַרַח
וַהוֹו בנֵי פַרַץ לחַצרֹון זַרעִית חַצרֹון לחָמוּל זרעית חָמוּל
אִלֵין זַרעַיָת יהוּדָה למִניָנֵיהֹון שִׁבעִין ושִׁתָה אַלפִין וחַמֵישׁ מאָה
בנֵי יִשָׂשׂכָר לזרעַיָתהֹון תֹולָע זרעית תֹולָע לפוָּה זרעִית פוָּה
ליָשׁוּב זרעית יָשׁוּב לשִׁמרֹן זרעית שִׁמרֹון
אִלֵין זַרעַיָת יִשָׂשׂכָר למִניָנֵיהֹון שִׁתִין ואַרבעָה אַלפִין וֻתלָת מאָה
בנֵי זבוּלֻן לזַרעַיָתהֹון לסַרַד זַרעִית סַרַד לאֵלֹון זרעית אֵלֹון ליַחלאֵל זַרעִית יַחלאֵל
אִלֵין זַרעַיָת זבוּלֻן למִניָנֵיהֹון שִׁתִין אַלפִין וחַמֵישׁ מאָה
בנֵי יֹוסֵף לזַרעַיָתהֹון מנַשַׁה ואַפרָיִם
בנֵי מנַשַׁה למָכִיר זרעית מָכִיר וֻמָכִיר אֹולֵיד יָת גִלעָד לגִלעָד זרעית גִלעָד
אִלֵין בנֵי גִלעָד אִיעַזַר זָרעית אִיעַזַר לחֵלַק זַרעִית חֵלַק
ואַשׁרִיאֵל זרעית אַשׁרִיאֵל ושַׁכַם זַרעִית שַׁכַם
וֻשׁמִידָע זרעית שׁמִידָע וחֵפַר זרעית חֵפַר
וֻצלָפחָד בַר חֵפַר לָא הַוֹו לֵיה בנִין אַלָהֵין בנָן ושֹׁום בנָת צלָפחָד מַחלָה ונֹעָה חָגלָה מִלכָה ותִרצָה
אִלֵין זַרעיָת מנַשַׁה וֻמִניָנֵיהֹון חַמשִׁין וֻתרֵין אַלפִין וֻשׁבַע מאָה
אִלֵין בנֵי אַפרַיִם לזַרעַיָתהֹון לשׁוּתַלַח זַרעִית שׁוּתַלַח לבַכַר זרעית בַכַר לתַחַן זרעית תַחַן
ואִלֵין בנֵי שׁוּתָלַח לעֵרָן זָרעִית עֵרָן
אִלֵין זַרעַיָת בנֵי אַפרַיִם למִניָנֵיהֹון תלָתִין וֻתרֵין אַלפִין וחַמֵישׁ מאָה אִלֵין בנֵי יֹוסֵף לזַרעַיָתהֹון
בנֵי בִניָמִין לזַרעַיָתהֹון לבַלַע זרעית בַלַע לאַשׁבֵל זרעית אַשׁבֵל לַאַחִירָם זרעית אַחִירָם
לשׁוּפָם זרעית שׁוּפָם לחוּפָם זרעית חוּפָם
וַהוֹו בנֵי בַלַע אַרד ונַעַמָן זרעית אַרד לנַעַמָן זרעית נַעַמָן
אִלֵין בנֵי בִניָמִן לזַרעַיָתהֹון וֻמִניָנֵיהֹון אַרבעִין וחַמשָׁה אַלפִין ושֵׁית מאָה
אִלֵין בנֵי דָן לזַרעַיָתהֹון לשׁוּחָם זרעית שׁוּחָם אִלֵין זַרעַיָת דָן לזַרעַיָתהֹון
כֹל זַרעַיָת שׁוּחָם למִניָנֵיהֹון שִׁתִין ואַרבעָה אַלפִין ואַרבַע מאָה
בנֵי אָשֵׁר לזַרעַיָתהֹון ליִמנָה זַרעִית יִמנָה ליִשׁוִי זרעית יִשׁוִי לברִיעָה זרעית ברִיעָה
לִבנֵי ברִיעָה לחַבַר זרעית חַבַר למַלכִיאֵל זרעית מַלכִיאֵל
ושֹׁום בַת אָשֵׁר שָׂרַח
אִלֵין זַרעַיָת בנֵי אָשֵׁר למִניָנֵיהֹון חַמשִׁין וֻתלָתָה אַלפִין ואַרבַע מאָה
בנֵי נַפתָלִי לזַרעַיָתהֹון ליַחצאֵל זרעית יחצאל לגוּנִי זרעית גוּנִי
ליֵצַר זרעית יֵצַר לשִׁלֵם זרעית שִׁלֵם
אִלֵין זַרעַיָת נַפתָלִי לזַרעַיָתהֹון וֻמִניָנֵיהֹון אַרבעִין וחַמשָׁה אַלפִין ואַרבַע מאָה
אִלֵין מִניָנֵי בנֵי ישׂראל שֵׁית מאָה וחַד אַלפִין שׁבַע מאָה וֻתלָתִין
ומליל יוי עםלות משׁה למימר
לאִלֵין תִתפלַג ארעא באַחסָנָא במִניַן שׁמָהָן
לסַגִיאֵי תַסגֹון אַחסָנַתהֹון ולִזעֵירֵי תַזעַרוּן אַחסַנַתהֹון גבַר לפֹום מִניָנֹוהִי תִתיהֵיב אַחסָנתֵיה
ברַם בעַדבָא תִתפלַג ית ארעא לִשׁמָהָת שִׁבטֵי אַהָבָתהֹון יַחסנוּן
עַל פֹום עַדבָא תִתפלַג אַהחסָנַתהֹון בֵין סַגִיאֵי לִזעֵירֵי
ואִלֵין מִניָנֵי לֵיוָאֵי לזַרעַיָתהֹון לגֵרשֹׁון זרעית גֵרשֹׁון לִקהָת זרעית קהָת לִמרָרִי זרעית מרָרִי
אִלֵין זַרעַיָת לֵוִי זרעית לִבנִי זרעית חַברֹון זרעית מַחלִי זרעית מוּשִׁי זרעית קֹרַח וֻקהָת אֹולֵיד יָת עַמרָם
ושֹׁום אִיתַת עַמרָם יֹוכַבַד בַת לֵוִי דִילֵידַת יָתַה ללֵוִי במִצרָיִם וִילֵידַת לעַמרָם יָת אַהַרֹן ויָת מֹשַׁה ויָת מִריָם אַחָתהֹון
ואִיתִילֵיד לאהרן יָת נָדָב ויָת אַבִיהוּא יָת אַלעָזָר ויָת אִיתָמָר
וֻמִית נָדָב וַאַבִיהוּא בקָרֵיבֵיהֹוןבקָרֹובֵיהֹון אִישָׁתָא נוּכרֵיתָא קדם יוי
וַהוֹו מִניָנֵיהֹון עַסרִין וֻתלָתָה אַלפִין כֹל דכוּרָא מִבַר יַרחָא וֻלעֵילָא אַרֵי לָא אִתמנִיוּ בגֹו בנֵי ישׂראל אַרֵי לָא אִתיהֵיבַת להֹון אַחסָנָא בגֹו בנֵי יִשׂרָאֵל
אִלֵין מִניָנֵי מֹשַׁה ואַלעָזָר כָהנָא דִמנֹו יָת בנֵי ישׂראל במֵישׁרַיָא דמֹואָב יַרדנָא דִירִיחֹו
וֻבאִילֵין לָא הַוָה גבַר מִמִניָנֵי מֹשַׁה ואהרן כָהַנָא דִמנֹו יָת בנֵי ישׂראל במַדברָא דסִינָי
אַרֵי אַמַר יוי להֹון ממָת ימוּתוּן במַדברָא ולָא אִשׁתאַר מִנהֹון אַנָשׁגבר אַלָהֵין כָלֵב בַר יפֻנַה וִיהֹושֻׁעַ בַר נוּן
וֻקרִיבָא בנָת צלָפחָד בַר חֵפַר בַר גִלעָד בַר מָכִיר בַר מנַשַׁה לזַרעַיָתמזרעית מנַשַׁה בַר יֹוסֵף ואִלֵין שׁמָהָת בנָתֵיה מַחלָה ונֹעָה וחָגלָה וֻמִלכָה ותִרצָה
וקַמָא קדָם מֹשַׁה וֻקדָם אַלעָזָר כָהַנָא וֻקדָם רַברבַיָא וכֹלוקדם כנשׁתָא בִתרַע מַשׁכַן זִמנָא למֵימַר
אַבוּנָא מִית במַדברָא והוּא לָא הַוָה בגֹו כנִשׁתָא דאִזדָמַנוּדאתכנשׁו עַל יוי בִכנִשׁתָא דקֹרַח אַרֵי בחֹובֵיה מִית וֻבנִין לָא הַוֹו לֵיה
למָא יִתמנַע שׁמָא דַאַבוּנָא מִגֹו זַרעִיתֵיה אַרֵי לֵית לֵיה בַר הַב לַנָא אַחסָנָא בגֹו אַחֵי אַבוּנָא
וקָרֵיב מֹשַׁה יָת דִינהֹון לִקדָםקדם יוי
וַאַמַרומליל יוי למֹשַׁהלות משׁהעם משׁה למֵימַר
יָאוּת בנָת צלָפחָד ממַללָן מִיתָן תִתֵין להֹון אַחוּדַת אַחסָנָא בגֹו אַחֵי אַבוּהֹון ותַעַבַר יָת אַחסָנַת אַבוּהֹון להֹון
ועִם בנֵי ישׂראל תמַלֵיל למֵימַר גבַראנָשׁ אַרֵי ימוּת וֻבַר לֵית לֵיה ותַעברוּן יָת אַחסָנתֵיה לִברַתֵיה
ואִם לֵית לֵיה ברַתָא ותִיתנוּן יָת אַחסָנתֵיה לַאַחֹוהִי
ואִם לֵית לֵיה אַחִין ותִתנוּן יָת אַחסָנתֵיה לַאַחֵי אַבוּהִי
ואִם לֵית אַחִין לַאַבוּהִי ותִתנוּן יָת אַחסָנתֵיה לקָרִיבֵיה דקָרִיב לֵיה מִזַרעִיתֵיה ויֵירַת יָתַה וֻתהֵי לִבנֵי ישׂראל לִגזֵירַת דִין כמָא דפַקֵיד יוי יָת מֹשַׁה
וַאַמַר יוי למֹשַׁה סַק לטוּרָא דעִברָאֵי הָדֵין וִחזֵי יָת ארעא דכנען דִיהַבִיתדַאנָא יָהֵיב לִבנֵי ישׂראל
ותִחזֵי יָתַה ותִתכנֵישׁ לעַמָך אַף אַת כמָא דאִתכנֵישׁ אהרן אַחוּך
כמָא דסָרֵיבתוּןדשׁקרתון עַל מֵימרִי במימרי במַדברָא דצִין במַצוּתבמי מצות כנִשׁתָא לקַדָשׁוּתִי במַיָא לעֵינֵיהֹון אִינוּן מֵי מַצוּת רקַם מַדברָאבמדברא דצִין
וֻמַלֵיל מֹשַׁה קדםעם יוי למֵימַר
ימַנֵי יוי אַלָה רוּחַיָא לכֹל בִסרָא גֻברָא ממנן עַל כנִשׁתָא
דיִפֹוק קדָמֵיהֹון וֻדיֵיעֹול קדָמֵיהֹון וֻדיַפֵיקִינוּן וֻדיַעֵילִינוּן ולָא תהֵי כנִשׁתָא דַיוי כעָנָא דלֵית להֹון רָעֵי
וַאַמַר יוי למֹשַׁה דבַרסב לָך יָת יהֹושֻׁעַ בַר נוּן גבַר דרוּחַ נבוּאָה בֵיה ותִסמֹוך יָת ידָך עַלֹוהִי
וֻתקִים יָתֵיה קדָםלקדם אַלעָזָר כָהַנָא וֻקדָםולקדם כֹל כנִשׁתָא וֻתפַקֵיד יָתֵיה לעֵינֵיהֹון
ותִתֵין מִזִיוָך עַלֹוהִי בדִיל דִיקַבלוּןדישׁמעון מִנֵיה כֹל כנשׁתָא דִבנֵי ישׂראל
וֻקדָםולִקדָם אַלעָזָר כָהַנָא יקוּם ויִשׁאַל לֵיה בדִין אוּרַיָא קדָם יוי עַל מֵימרֵיה יהֹון נָפקִין ועָל מֵימרֵיה יהֹון עָלִין הוּא וכָל בנֵי ישׂראל עִמֵיה וכֹל כנִשׁתָא
וַעַבַד מֹשַׁה כמָא דפַקֵיד יוי יָתֵיה וֻנסֵיבוֻדבַר יָת יהֹושֻׁעַ וַאַקִימֵיה קדָם אַלעָזָר כָהַנָא וֻקדָם כֹל כנִשׁתָא
וֻסמַך יָת ידֹוהִי עלֹוהִי וֻפַקדֵיה כמָא דמַלֵיל יוי בִידָא דמֹשַׁה
ומליל יוי עםלות משׁה למימר
פַקֵיד יָת בנֵי ישׂראל ותֵימַר להֹון יָת קוּרבָנִי לחֵים סִידוּר לקוּרבָנִי לאִתקַבָלָא ברַעַוָא תִיטרוּן לקָרָבָא קדָמַי בזִמנֵיה
ותֵימַר להֹון דֵין קוּרבָנָא דִתקָרבוּן קדם יוי אִימרִין בנֵי שׁנָא שַׁלמִין תרֵין ליֹומָא עַלָתָא תדִירָא
יָת אִימרָא חַד תעַבֵיד בצַפרָא ויָת אִימרָא תִניָנָא תַעַבֵיד בֵין שִׁמשַׁיָא
וחַד מִן עַסרָא בִתלָת סאִין סוּלתָא מִנחָתָאלמִנחָתָא דפִילָא בִמשַׁח כָתִישָׁא רַבעוּת הִינָא
עַלַת תדִירָא דאִתעַבֵידַת בטוּרָא דסִינַי לאִתקַבָלָא ברַעַוָא קוּרבָנָא קדם יוי
ונִסכֵיה רַבעוּת הִינָא לאִימרָא חַד בקוּדשָׁא יִתנַסַך נִיסוּך דַחמַרבחמר עַתִיק קדם יוי
ויָת אִימרָא תִניָנָא תַעַבֵיד בֵין שִׁמשַׁיָא כמִנחַת צַפרָא וֻכנִסכֵיה תַעַבֵיד קוּרבַן דמִתקַבַללאיתקבלא ברַעַוָא קדם יוי
וֻביֹומָא דשַׁבתָא תרֵין אִמרִין בנֵי שׁנָא שַׁלמִין וֻתרֵין עַסרֹונִין סוּלתָא מִנחָתָא דפִילָא בִמשַׁח ונִסכֵיה
עַלַת שַׁבָא תִתעַבֵידדתתעביד בשַׁבָא עַל עַלַת תדִירָא ונִסכַה
וֻברֵישֵׁי יַרחֵיכֹון תקָרבוּן עַלָתָא קדָם יוי תֹורֵי בנֵי תֹורֵי תרֵין וֻדכַר חַד אִימרִין בנֵי שׁנָא שִׁבעָה שַׁלמִין
וֻתלָתָה עַסרֹונִין סוּלתָא מִנחָתָא דפִילָא בִמשַׁח לתֹורָא חַד וֻתרֵין עַסרֹונִין סוּלתָא מִנחָתָא דפִילָא בִמשַׁח לדִכרָא חַד
ועַסרֹונָא עַסרֹונָא סוּלתָא מִנחָתָא דפִילָא בִמשַׁח לאִימרָא חַד עַלָתָא לאִתקַבָלָא ברַעַוָא קוּרבָנָא קדם יוי
ונִסכֵיהֹון פַלגוּת הִינָא יהֵי לתֹורָא ותַלתוּת הִינָא לדִכרָא ורַבעוּת הִינָא לאִימרָא חַמרָא דָא עַלַת רֵישׁ ירַח בִירַח באִתחַדָתוּתֵיה כֵין לכֹל רֵישֵׁי יַרחֵי שַׁתָא
וֻצפִיר בַר עִזִין חַד לחַטָתָא קדם יוי עַל עַלַת תדִירָא יִתעַבֵיד ונִסכֵיה
וֻביַרחָא קַדמָאָה באַרבעָת עַסרָא יֹומָא ליַרחָא פִסחָא קדם יוי
וֻבחַמֵישַׁת עַסרָא יֹומָא ליַרחָא הָדֵין חַגָא שִׁבעָה יֹומִין פַטִירָא יִתאַכִיל
ביֹומָא קַדמָאָה מעָרַע קַדִישׁ כֹל עַבִידַת פוּלחַן לָא תַעבדוּן
וֻתקָרבוּן קוּרבָנָא עַלָתָא קדם יוי תֹורֵי בנֵי תֹורֵי תרֵין וֻדכַר חַד ושִׁבעָה אִמרִין בנֵי שׁנָא שַׁלמִין יהֹון לכֹון
וֻמִנחָתהֹון סוּלתָא דפִילָא בִמשַׁח תלָתָה עַסרֹונִין לתֹורָא ותרֵין עַסרֹונִין לדִכרָא תַעַבדוּן
עַסרֹונָא עַסרֹונָא תַעַבֵיד לאִימרָא חַד כֵין לשִׁבעָה אִימרִין
וֻצפִירָא דחַטָתָא חַד לכַפָרָא עַלֵיכֹון
בָר מֵעַלַת צַפרָא דהִיא עַלַת די לעלתא תדִירָא תַעבדֹון יָת אִלֵין
כאִלֵין תַעבדוּן ליֹומָא שִׁבעָה יֹומִין לחֵים קוּרבַן דמִתקַבַל ברַעַוָא קדם יוי עַל עַלַת תדִירָא יִתעַבֵיד ונִסכֵיה
וֻביֹומָא שׁבִיעָאָה מעָרַע קַדִישׁ יהֵי לכֹון כֹל עַבִידַת פוּלחַן לָא תַעבדוּן
וֻביֹומָא דבִכוּרַיָא בקָרֵיבֵיכֹוןבקָרֹובֵיהֹון מִנחָתָא חַדַתָא קדָם יוי בעַצרָתכֹון מעָרַע קַדִישׁ יהֵי לכֹון כֹל עַבִידַת פוּלחַן לָא תַעבדוּן
וֻתקָרבוּן עַלָתָא לאִתקַבָלָא ברַעַוָא קדם יוי תֹורֵי בנֵי תֹורֵי תרֵין דכַר חַד שִׁבעָה אִימרִין בנֵי שׁנָא
וֻמִנחָתהֹון סוּלתָא דפִילָא בִמשַׁח תלָתָה עַסרֹונִין לתֹורָא חַד תרֵין עַסרֹונִין לדִכרָא חַד
עַסרֹונָא עַסרֹונָא תַעַבֵיד לאִימרָא חַד כן לשִׁבעָה אִימרִין
צפִיר בַר עִזִין חַד לכַפָרָא עַלֵיכֹון
בָר מֵעַלַת תדִירָאצפרא וֻמִנחָתֵיה תַעבדוּן שַׁלמִין יהֹון לכֹון ונִסכֵיהֹון
וֻביַרחָא שׁבִיעָאָה בחַד ליַרחָא מעָרַע קַדִישׁ יהֵי לכֹון כֹל עַבִידַת פוּלחַן לָא תַעבדוּן יֹום יבָבָא יהֵי לכֹון
ותַעבדוּן עַלָתָא לאִתקַבָלָא ברַעַוָא קדם יוי תֹור בַר תֹורֵי חַד דכַר חַד אִימרִין בנֵי שׁנָא שִׁבעָא שַׁלמִין
וֻמִנחָתהֹון סוּלתָא דפִילָא בִמשַׁח תלָתָה עַסרֹונִין לתֹורָא תרֵין עַסרֹונִין לדִכרָא חד
ועַשׂרֹונָא חַד לאִימרָא חַד כֵין לשִׁבעָה אִימרִין
וֻצפִיר בַר עִזִין חַד חַטָתָאלחטאתא לכַפָרָא עַלֵיכֹון
בָר מֵעַלַת רישׁ יַרחָא וֻמִנחָתַה וַעַלַת תדִירָא וֻמִנחָתַה ונִסכֵיהֹון כדַחזֵי להֹון לאִתקַבָלָא ברַעַוָא קוּרבָנָא קדם יוי
וֻבעַסרָא יומא ליַרחָא שׁבִיעָאָה הָדֵין מעָרַע קַדִישׁ יהֵי לכֹון וֻתעַנֹון יָת נַפשָׁתכֹון כָל עַבִידָאעיבידת פולחנא לָא תַעבדוּן
וֻתקָרבוּן עַלָתָא קדם יוי לאִתקַבָלָא ברַעַוָא תֹור בַר תֹורֵי חַד דכַר חַד אִימרִין בנֵי שׁנָא שִׁבעָה שַׁלמִין יהֹון לכֹון
וֻמִנחָתהֹון סוּלתָא דפִילָא בִמשַׁח תלָתָה עַסרֹונִין לתֹורָא חד תרֵין עַסרֹונִין לדִכרָא חַד
עַסרֹונָא עַסרֹונָא לאִימרָא חַד כֵין לשִׁבעָה אִימרִין
צפִיר בַר עִזִין חַד חַטָתָאלחטאתא בָר מֵחַטַת כִפוּרַיָא וַעַלַת תדִירָא וֻמִנחָתַה ונִסכֵיהֹון
וֻבַחמֵישַׁת עַסרָא יֹומָא ליַרחָא שׁבִיעָאָה מעָרַע קַדִישׁ יהֵי לכֹון כֹל עַבִידַת פוּלחַן לָא תַעבדוּן ותֵיחַגוּן חַגָא קדם יוי שִׁבעָה יֹומִין
וֻתקָרבוּן עַלָתָא קוּרבַן דמִתקַבַל ברַעַוָא קדם יוי תֹורֵי בנֵי תֹורֵי תלָת עַסַר דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין יהֹון
וֻמִנחָתהֹון סוּלתָא דפִילָא בִמשַׁח תלָתָה עַסרֹונִין לתֹורָא חַד לִתלָת עַסַר תֹורִין תרֵין עַסרֹונִין לדִכרָא חַד לִתרֵין דִכרִין
ועַשׂרֹונָא עַסרֹונָא לאִימרָא חַד כֵין לאַרבעַת עַסַר אִימרִין
וֻצפִיר בַר עִזִין חַד חַטָתָא בָר מֵעַלַת תדִירָא מִנחָתַה ונִסכַה
וֻביֹומָא תִניָנָא תֹורֵי בנֵי תֹורֵי תרֵי עַסַר דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
וֻמִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִימרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִיר בַר עִזִין חַד חַטָתָא בָר מֵעַלַת תדִירָא וֻמִנחָתַה ונִסכֵיהֹון
וֻביֹומָא תלִיתָאָה תֹורִין חַד עַסַר דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
וֻמִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִמרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִירָא דחַטָתָא חַד בָר מֵעַלַת תדִירָא וֻמִנחָתַה ונִסכַה
וֻביֹומָא רבִיעָאָה תֹורֵי עַסרָא דִכרִין תרֵין אִמרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
מִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִימרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִיר בַר עִזִין חַד חַטָתָאלחטתא בַר מֵעַלַת תדִירָא מִנחָתַה ונִסכַה
וֻביֹומָא חַמִישָׁאָה תֹורֵי תִשׁעָה דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
וֻמִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִמרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִירָא דחַטָתָא חַד בָר מֵעַלַת תדִירָא וֻמִנחָתַה ונִסכַה
וֻביֹומָא שׁתִיתָאָה תֹורֵי תמָניָא דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
וֻמִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִימרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִירָא דחַטָתָא חַד בָר מֵעַלַת תדִירָא מִנחָתַה ונִסכַהָא
וֻביֹומָא שׁבִיעָאָה תֹורֵי שִׁבעָה דִכרִין תרֵין אִימרִין בנֵי שׁנָא אַרבעַת עַסַר שַׁלמִין
וֻמִנחָתהֹון ונִסכֵיהֹון לתֹורֵי לדִכרֵי וֻלאִימרֵי במִניָנֵיהֹון כדַחזֵי להֹון
וֻצפִירָא דחַטָתָא חַד בָר מֵעַלַת תדִירָא מִנחָתַה ונִסכַה
ביֹומָא תמִינָאָה כנִישִׁין תהֹון לכֹון כֹל עַבִידַת פוּלחַן לָא תַעבדוּן
וֻתקָרבוּן עַלָתָא קוּרבַן דמִתקַבַל ברַעַוָא קדם יוי תֹור חַד דכַר חַד אִימרִין בנֵי שׁנָא שִׁבעָה שַׁלמִין
מִנחָתהֹון ונִסכֵיהֹון לתֹורָא לדִכרָא וֻלאִימרֵי במִניָנֵיהֹון כדַחזֵי
וֻצפִירָא דחַטָתָא חַד בָר מֵעַלַת תדִירָאצפרא וֻמִנחָתַה ונִסכַה
אִלֵין תַעבדוּן קדם יוי במֹועַדֵיכֹוןבזמניכון בָר מִנִדרֵיכֹון ונִדבָתכֹון לַעַלָוָתכֹון וֻלמִנחָווָתכֹון וֻלנִסכֵיכֹון וֻלנִכסַת קוּדשֵׁיכֹון
וַאַמַר מֹשַׁה לִבנֵי יִשׂרָאֵל ככֹלכל דפַקֵיד יוי יָת מֹשַׁה
וֻמַלֵיל מֹשַׁה עִם רֵישֵׁי שִׁבטַיָא לִבנֵי ישׂראל למֵימַר דֵין פִתגָמָא דפַקֵיד יוי
גבַר אַרֵי יִדַר נדַר קדם יוי אֹו יקַיֵים קיָם למֵיסַר אִיסָר עַל נַפשֵׁיה לָא יבַטֵיל פִתגָמֵיה ככֹל דיִפֹוק מִפוּמֵיה יַעַבֵיד
ואִיתתָא אַרֵי תִידַר נדַר קדם יוי ותֵיסַר אִיסָר בבֵית אַבוּהָא ברַביוּתַה
ויִשׁמַע אַבוּהָא יָת נִדרַה וַאַסָרַה דַאַסַרַת עַל נַפשַׁה ויִשׁתֹוק לַה אַבוּהָא וִיקוּמוּן כֹל נִדרַהָא וכֹל אֵיסָרֵי דַאַסַרַת עַל נַפשַׁה יקוּמוּן
ואִם אַעַדִי אַבוּהָא יָתהֹון ביֹומָא דִשׁמַע כֹל נִדרַהָא וַאַסָרַהָא דַאַסַרַת עַל נַפשַׁה לָא יקוּמוּן וֻמִן קדם יוי יִשׁתבֵיק לַה אַרֵי אַעַדִי אַבוּהָא יָתהֹון
ואִם מִהוָה תִהוֵי לִגבַר ונִדרַהָא עַלַה אֹו פֵירוּשׁ סִפוָתַהָא דַאַסַרַת עַל נַפשַׁה
ויִשׁמַע בַעַלַה ביֹומָא דִשׁמַע ויִשׁתֹוק לַה וִיקוּמוּן נִדרַהָא וַאַסָרַהָא דַאַסַרַת עַל נַפשַׁה יקוּמוּן
ואִם ביֹומָא דִשׁמַע בַעַלַה אַעַדִי יָתהֹון וֻבַטֵיל יָת נִדרַה דַעַלַהדי עלהא ויָת פֵירוּשׁ סִפוָתַהָא דַאַסַרַת עַל נַפשַׁה וֻמִן קדם יוי יִשׁתבֵיק לַה
וֻנדַר אַרמלָא וֻמתָרכָא כֹל דַאַסַרַת עַל נַפשַׁה קַייָם עַלַה
ואִם בֵיתבבית בַעַלַה נדַרַת אֹו אַסַרַת אֵיסַר עַל נַפשַׁה בקִיוּם
וֻשׁמַע בַעַלַה וֻשׁתֵיק לַה לָא אַעַדִי יָתהֹון וִיקוּמוּן כֹל נִדרַהָא וכֹל אֵיסָרֵי דַאַסַרַת עַל נַפשַׁה יקוּמוּן
ואִם בַטָלָא יבַטֵיל יָתהֹון בַעַלַה ביֹומָא דִשׁמַע כֹל אַפָקוּת סִפוָתַהָא לנִדרַהָא וֻלאִיסַר נַפשַׁה לָא יקוּמוּן בַעַלַה בַטֵילִינוּן וֻמִן קדם יוי יִשׁתבֵיק לַה
כֹל נדַר וכֹל קִיוּמַתקיום אִסָר לסַגָפָא נפַשׁ בַעַלַה יקַיֵימִינוּן וֻבַעַלַה יבַטֵילִינוּן
ואִם מִשׁתָק יִשׁתֹוק לַה בַעַלַה מִיֹום ליֹום וִיקַייֵם יָת כֹל נִדרַהָא אֹו יָת כֹל אַסָרַהָא דַעַלַה קַיֵים יָתהֹון אַרֵי שׁתֵיק לַה ביֹומָא דִשׁמַע
ואִם בַטָלָא יבַטֵיל יָתהֹון בָתַר דִשׁמַע וִיקַבֵיל יָת חֹובַה
אִלֵין קִיָמַיָאקיָמַיָא דפַקֵיד יוי יָת מֹשַׁה בֵין גֻברָא לאִיתתֵיה בֵין אַבָא לִברַתֵיה ברַביוּתַה בֵית אַבוּהָא
ומליל יוי עםלות משׁה למימר
אִתפרַע פֹורעָנוּת בנֵי ישׂראל מִן מִדיַנָאֵי בָתַר כֵין תִתכנֵישׁ לעַמָך
וֻמַלֵיל מֹשַׁה עִם עַמָא למֵימַר זָרִיזוּאיזדריזו מִנכֹון גֻברִין לחֵילָא וִיהֹון עַל מִדיָן למִיתַן פֹורעָנוּת דִין עַמֵיה דַיוי במִדיָן
אַלפָא לשִׁבטָא אַלפָא לשִׁבטָא לכֹל שִׁבטַיָא דישׂראל תִשׁלחוּן לחֵילָא
ואִתבחַרוּ מֵאַלפַיָא דיִשׂרָאֵל אַלפָא לשִׁבטָא תרֵי עַסַר אַלפִין מזָרזֵי חֵילָא
וֻשׁלַח יָתהֹון מֹשַׁה אַלפָא לשִׁבטָא לחֵילָא יָתהֹון ויָת פִינחָס בַר אַלעָזָר כָהַנָא לחֵילָא וֻמָנֵי קוּדשָׁא וַחַצֹוצרָת יבָבתָא בִידֵיה
ואִתחַיַלוּוחיילו עַל מִדיָן כמָא דפַקֵיד יוי יָת מֹשַׁה וֻקטַלוּ כָל דכוּרָא
ויָת מַלכֵי מִדיָן קטַלוּ עַל קטִילֵיהֹון יָת אַוִי ויָת רקַם ויָת צוּר ויָת חוּר ויָת רַבַע חַמשָׁה מַלכֵי מִדיָן ויָת בִלעָם בַר בעֹור קטַלוּ בחַרבָאלפתגם דחרב
וֻשׁבֹו בנֵי ישׂראל יָת נשֵׁי מִדיָן ויָת טַפלהֹון ויָת כֹל בעִירהֹון ויָת כֹל גֵיתֵיהֹון ויָת כֹל נִכסֵיהֹון בַזוּ
ויָת כֹל קִרוֵיהֹון במֹותבָנֵיהֹון ויָת כֹל בֵית סִגדַתהֹון אֹוקִידוּ בנוּרָא
וֻשׁבֹו יָת כֹל עַדָאָה ויָת כֹל דבַרתָא בַאַנָשָׁא וֻבִבעִירָא
ואֵיתִיוּ לוָת מֹשַׁה וֻלוָת אַלעָזָר כָהַנָא וֻלוָת כנִשׁתָא דִבנֵי ישׂראל יָת שִׁביָא ויָת דבַרתָא ויָת עַדָאָה למַשׁרִיתָא למֵישׁרַיָא דמֹואָב עַלדעַל יַרדנָא דִירִיחֹו
וֻנפַקוּ מֹשַׁה ואַלעָזָר כָהַנָא וכֹל רַברבֵי כנִשׁתָא לקַדָמוּתהֹון למִבַרָא למַשׁרִיתָא
וֻרגֵיז מֹשַׁה עַל דממַנַן עַל חֵילָא רַבָנֵי אַלפֵי ורַבָנֵי מָאוָתָא דַאתֹו מֵחֵיל קרָבָא
וַאַמַר להֹון מֹשַׁה הַקַיֵימתוּן כֹל נוּקבָא
הָא אִינִין הַוַאָה לִבנֵי ישׂראל בעֵיצַת בִלעָם לשַׁקָרָא שׁקַר קדם יוי עַל עֵיסַק פעֹור וַהוָת מַחתָאמותנא בִכנִשׁתָא דַיוי
וֻכעַן קטוּלוּ כֹל דכוּרָא בטַפלָא וכֹל אִיתתָא דיָדעַת גבַר למִשׁכבֵי דכוּרָא קטוּלוּ
וכֹל טַפלָא בִנשַׁיָא דלָא ידַעָא מִשׁכבֵי דכוּרָא קַיִימוּ לכֹון
ואַתוּן שׁרֹו מִבַרָא למַשׁרִיתָא שִׁבעָה יֹומִין כֹל דִקטַל נַפשָׁא וכֹל דִקָרֵיב בִקטִילָא תַדֹון עַלֹוהִי ביֹומָא תלִיתָאָה וֻביֹומָא שׁבִיעָאָה אַתוּן וֻשׁבֵיכֹון
וכֹל לבוּשׁ וכֹל מָן דִמשַׁך וכֹל עֹובָד מַעַזֵידמַעזֵי וכֹל מָן דאָע תַדֹון עַלֹוהִי
וַאַמַר אַלעָזָר כָהַנָא לגַברֵי חֵילָא דַאַתֹו לִקרָבָא דָא גזֵירַת אֹורָיתָא דפַקֵיד יוי יָת מֹשַׁה
ברַם יָת דַהבָא ויָת כַספָא יָת נחָשָׁא יָת בַרזלָאפרזלא יָת עַבָצָאאבָצָא ויָת אַבָרָא
כֹל מִדָעַם דמִתָעַל בנוּרָא תַעברוּנֵיה בנוּרָא ויִדכֵי ברַם במֵי אַדָיוּתָא יִתדֵיידכי וָכֹל דלָא מִתָעַל בנוּרָא תַעברוּנֵיה במַיָא
וֻתחַוורוּן לבוּשֵׁיכֹון ביֹומָא שׁבִיעָאָה וֻתִדכֹון וֻבָתַר כֵין תֵיעַלוּן למַשׁרִיתָא
וַאַמַרומליל יוי למֹשַׁהלות משׁהעם משׁה למֵימַר
קַבֵיל יָת חוּשׁבַן דִברַתדָברַת שִׁביָא בַאַנָשָׁא וֻבִבעִירָא אַת ואַלעָזָר כָהַנָא ורֵישֵׁי אַבָהָת כנִשׁתָא
וֻתפַלֵיג יָת דבַרתָא דשׁביא בֵין גַברֵי מגִיחֵי קרָבָא דִנפַקוּ לחֵילָא וֻבֵין כֹל כנִשׁתָא
ותַפרֵישׁ נסִיבָאנציבא קדם יוי מִן גַברֵי מגִיחֵי קרָבָא דִנפַקוּ לחֵילָא ובין כל כנישׁתא חַדָא נַפשָׁא מֵחַמֵישׁ מאָה מִן אַנָשָׁא וֻמִן תֹורֵי וֻמִן חַמָרֵי וֻמִן עָנָא
מִפַלגוּתהֹון תִיסבוּן ותִתֵין לאַלעָזָר כָהַנָא אַפרָשׁוּתָא קדָם יוי
וֻמִפַלגוּת בנֵי ישׂראל תִסַב חַד דיִתַחַד מִן חַמשִׁין מִן אַנָשָׁא מִן תֹורֵי מִן חַמָרֵי וֻמִן עָנָא מִכֹל בעִירָא ותִתֵין יָתהֹון ללֵיוָאֵי נָטרֵי מַטרַת מַשׁכנָא דַיוי
וַעַבַד מֹשַׁה ואַלעָזָר כָהַנָא כמָא דפַקֵיד יוי יָת מֹשַׁה
וַהוָת דבַרתָא שׁאָר בִזָא דבַזוּ עַמָא דִנפַקוּ לחֵילָא מנין עָנָא שֵׁית מאָה ושִׁבעִין וחַמשָׁה אַלפִין
ותֹורֵי שִׁבעִין וֻתרֵין אַלפִין
וַחמָרֵי שִׁתִין וחַד אַלפִין
ונַפשָׁא דַאַנָשָׁא מִן נשַׁיָא דלָא ידַעָא מִשׁכבֵי דכוּרָא כֹל נַפשָׁתָא תלָתִין וֻתרֵין אַלפִין
וַהוָת פַלגוּתָא חוּלָק גַברַיָא דִנפַקוּ בחֵילָאלחֵילָא מִניַן עָנָא תלָת מאָה וֻתלָתִין ושִׁבעָה אַלפִין וחַמֵישׁ מאָה
וַהוָתוַהַוָה נסִיבָא קדם יוי מִן עָנָא שֵׁית מאָה ושִׁבעִין וחַמֵישׁ
ותֹורֵי תלָתִין ושִׁיתָה אַלפִין וֻנסִיבהֹון קדם יוי שִׁבעִין וֻתרֵין
וֻחמָרֵי תלָתִין אַלפִין וחַמֵישׁ מאָה וֻנסִיבהֹון קדם יוי שִׁתִין וחַד
ונַפשָׁא דַאַנָשָׁא שִׁיתַת עַסַר אַלפִין וֻנסִיבהֹון קדם יוי תלָתִין ותַרתֵין נַפשָׁן
וִיהַב מֹשַׁה יָת נסִיבדנסב אַפרָשׁוּתָא קדם יוי לאַלעָזָר כָהַנָא כמָא דפַקֵיד יוי יָת מֹשַׁה
וֻמִפַלגוּת בנֵי יִשׂרָאֵל דִפלַג מֹשַׁה מִן גַברַיָא דִנפַקוּ לחֵילָא
וַהוָת פַלגוּת כנִשׁתָא מִן עָנָא תלָת מאָה וֻתלָתִין ושִׁבעָה אַלפִין וחַמֵישׁ מאָה
ותֹורֵי תלָתִין ושִׁיתָא אַלפִין
וֻחמָרֵי תלָתִין אַלפִין וחַמֵישׁ מאָה
ונַפשָׁא דַאַנָשָׁא שִׁיתַת עַסַר אַלפִין
וֻנסֵיב מֹשַׁה מִפַלגוּת בנֵי ישׂראל יָת דאִיתַחַד חַד מִן חַמשִׁין מִן אַנָשָׁא וֻמִן בעִירָא וִיהַב יָתהֹון ללֵיוָאֵי נָטרֵי מַטרַת מַשׁכנָא דַיוי כמָא דפַקֵיד יוי יָת מֹשַׁה
וֻקרִיבוּ לוָת מֹשַׁה דִממַנַן עַל אַלפֵי די לאלפי חֵילָא רַבָנֵי אַלפֵי ורַבָנֵי מָאוָתָא
וַאַמַרוּ למֹשַׁה עַבדָך קַבִילוּ יָת חוּשׁבַן גַברֵי מגִיחֵי קרָבָא דעִמַנָא ולָא שׁגָא מִנַנָא אַנָשׁ
וקָרֵיבנָא יָת קוּרבָנָא קדם יוי דַייי גבַר דאַשׁכַח עִמֵיה מָן דִדהַב שֵׁירִין ושַׁבבִין עִזקָן קדָשִׁין וֻמָחֹוך לכַפָרָא עַל נַפשָׁתַנָא קדם יוי
וֻנסֵיב מֹשַׁה ואַלעָזָר כָהַנָא יָת דַהבָא מִנהֹון כֹל מָאן דעוּבָדָא
וַהַוָה כֹל דהַב אַפרָשׁוּתָאארמותא דאַפרִישׁוּדארימו קדם יוי שִׁתַת עַסַר אַלפִין שׁבַע מאָה וחַמשִׁין סִלעִין מִן רַבָנֵי אַלפֵי וֻמִן רַבָנֵי מָאוָתָא
גַברִין דחֵילָא בַזוּ גבַר לנַפשֵׁיהדי ליה
וֻנסֵיב מֹשַׁה ואַלעָזָר כָהַנָא יָת דַהבָא מִן רַבָנֵי אַלפֵי וֻמָאוָתָא ואֵיתִיוּ יָתֵיה למַשׁכַן זִמנָא דוּכרָנָא לִבנֵי ישׂראל קדָם יוי
וֻבעִיר סַגִי הַוָה לִבנֵי ראוּבֵן וֻלִבנֵי גָד תַקִיף לַחדָא וַחזֹו יָת אַרַע יַעזֵר ויָת אַרַע גִלעָד והָא אַתרָא אַתַר כָשַׁר לבֵית בעִיר
וַאַתֹו בנֵי גָד וֻבנֵי ראוּבֵן וַאַמַרוּ למֹשַׁה וֻלאַלעָזָר כָהַנָא וֻלרַברבֵי כנִשׁתָא למֵימַר
עַטָרֹותמכללתאשַׁכלֵילתָאמכלכלתא ודִבֹןוֻמַלבֵישׁתָא ויַעזֵרשֹׁופָןסופרי וסיעןומכוורוכומרין ונִמרָהוֻבֵית נִמרֵידבית נמרין וחַשׁבֹוןוֻבֵית חֻשׁבָנָאובית צחונא ואַלעָלֵהוֻבַעלֵי דבָבָאובעיל דיבון וֻשׁבָםוסִיעָתוסימא וֻנבֹווֻבֵית קבוּרתָא דמֹשַׁהדקבורתא דמשׁהגברתא דמשׁה דא היא וֻבעֹן
אַרעָא דִמחָא יוי יָת יָתבַהָא קדָם כנִשׁתָא דישׂראל אַרַעאתר כָשׁרָא לבֵית בעִיר הִיא וֻלעַבדָך אִית בעִיר
וַאַמַרוּ אִם אַשׁכַחנָא רַחמִין בעֵינָך תִתיהֵיב יָת אַרעָא הָדָא לעַבדָך לאַחסָנָא לָא תִעברִינַנָא יָת יַרדנָא
וַאַמַר מֹשַׁה לִבנֵי גָד ולִבנֵי ראוּבֵן הַאַחֵיכֹון יֵיתֹוןייעלון לאָגָחָא קרָבָא לקרבא ואַתוּן תִתבוּן הָכָא
וֻלמָא תֹונֹון יָת לִיבָא דִבנֵי ישׂראל מִלמִיעִיבַרלמעבר לארעא דִיהַב להֹון יוי
כדֵין עַבַדוּ אַבָהָתכֹון כַד שׁלַחִית יָתהֹון מֵרקַם גֵיאָה למִחזֵי יָת ארעא
וֻסלִיקוּ עַד נַחלָא דאִתכָלָא וַחזֹו יָת ארעא ואֹונִיאוּ יָת לִיבָא דִבנֵי ישׂראל בדִיל דלָא למֵיעַל לארעא דִיהַב להֹון יוי
וֻתקֵיף רוּגזָא דַיוי ביֹומָא הַהוּא וקַיֵים למֵימַר
אִם יִחזֹון גַברַיָא דִסלִיקוּ מִמִצרַיִם מִבַר עַסרִין שׁנִין וֻלעֵילָא יָת ארעא דקַיֵימִית לאברָהָם ליִצחָק וֻליַעַקֹב אַרֵי לָא אַשׁלִימוּשׁלימו בָתַר דַחַלתִי
אַלָהֵין כָלֵב בַר יפֻנַה קנִיזָאָה וִיהֹושֻׁעַ בַר נוּן אַרֵי אַשׁלִימוּ בָתַר דַחַלתָא דַיוי
וֻתקֵיף רוּגזָא דַיוי בישׂראל ואֹוחַרִינוּן במַדברָא אַרבעִין שׁנִין עַד דסָף כֹל דָרָא דַעַבַד דבִישׁבישׁ קדם יוי
והָא קַמתוּן בָתַרבאתרחלף אַבָהָתכֹון תַלמִידֵי גַברַיָא חַיָיבַיָא לאֹוסָפָא עֹוד עַל תקֹוף רוּגזָא דַיוי לישׂראלעַל יִשׂרָאֵלבישׂראל
אַרֵי תתוּבוּן מִבָתַר דַחַלתֵיהפולחניה ויֹוסֵף עֹוד לאֹוחָרוּתהֹון במַדברָא וֻתחַבלוּן לכֹל עַמָא הָדֵין
וֻקרִיבוּ לוָתֵיה וַאַמַרוּ חַטרִין דעָן נִבנֵי לִבעִירַנָא הָכָא וקִרוִין לטַפלַנָא
וַאַנַחנָא נִזדָרַז מַבעִין קדָם בנֵי ישׂראל עַד דנַעֵילִינוּן לַאַתַרהֹון ויִתֵיב טַפלַנָא בקִרוִין כרִיכָן מִן קדָם יָתבֵי ארעא
לָא נתוּב לבָתַנָא עַד דיַחסנוּןדיחסין בנֵי ישׂראל גבַר אַחסָנתֵיה
אַרֵי לָא נַחסֵין עִמהֹון מֵעִברָא ליַרדנָהדירדנא וֻלהַלָאָהוֻלהַלָה אַרֵי קַבֵילנָא אַחסָנתַנָא לַנָא מֵעִברָא דיַרדנָאליַרדנָא מַדִנחָא
וַאַמַר להֹון מֹשַׁה אִם תַעבדוּן יָת פִתגָמָא הָדֵין אִם תִזדָרזוּן קדָם עַמָא דַיוי לִקרָבָאלאגחא קרבא
ויִעִיבַר לכֹון כֹל דִמזָרַז יָת יַרדנָא קדָם עַמָא דַיוי עַד דִיתָרֵיך יָת בַעלֵי דבָבֹוהִי מִן קדָמֹוהִימקדמוהי
ותִתכבֵישׁ ארעא קדָם עַמָא דַיוי וֻבָתַר כֵין תתוּבון וֻתהֹון זַכָאִין קדָםמִן קדם יוי וֻמישׂראל וֻתהֵי ארעא הָדָא לכֹון לאַחסָנָא קדם יוי
ואִם לָא תַעבדוּן כֵין הָא חַבתוּן קדם יוי ודַעוּ חֹובַתכֹון דתַשׁכַח יָתהֹון
בנֹו לכֹון קִרוִין לטַפלכֹון וחַטרִין לעָנכֹון וֻדיִפֹוק מִפוּמכֹון תַעבדוּן
וַאַמַר בנֵי גָד וֻבנֵי ראוּבֵן למֹשַׁה למֵימַר עַבדָך יַעבדוּן כמָא דרִיבֹונִי מפַקֵיד
טַפלַנָא נשַׁנָא גֵיתַנָא וכֹל בעִירַנָא יהֹון תַמָן בקִרוֵי גִלעָד
ועַבדָך יִעברֹון כֹל מזַרַזדמזרז חֵילָאלחילא קדָםלִקדָם עַמָא דַיוי לִקרָבָאלאגחא קרבא כמָא דרִיבֹונִי ממַלֵיל
וֻפַקֵיד להֹון מֹשַׁה יָת אַלעָזָר כָהַנָא ויָת יהֹושֻׁעַ בַר נוּן ויָת רֵישֵׁי אַבָהָת שִׁבטַיָא דִבנֵילִבנֵי ישׂראל
וַאַמַר מֹשַׁה להֹון אִם יִעברוּן בנֵי גָד וֻבנֵי ראוּבֵן עִמכֹון יָת יַרדנָא כֹל דִמזַרַז לִקרָבָא קדָם עַמָא דַיוי ותִתכבֵישׁ ארעא קדָמֵיכֹון ותִיתנוּן להֹון יָת אַרַע גִלעָד לאַחסָנָא
ואִם לָא יִעברוּן מזָרזִין עִמכֹון ויַחסנוּן בֵינֵיכֹון בארעא דִכנָעַן
וַאַתִיבוּ בנֵי גָד וֻבנֵי ראוּבֵן למֵימַר יָת דמַלֵיל יוי לעַבדָך כֵין נַעַבֵיד
נַחנָא נעִיבַר מזָרזִין קדָם עַמָא דַיוי לארעאאַרעָא דִכנָעַן ועִמַנָא אַחוּדַת אַחסָנתַנָא לַנָא מֵעִברָא ליַרדנָא
וִיהַב להֹון מֹשַׁה לִבנֵי גָד ולִבנֵי ראוּבֵן וֻלפַלגוּת שִׁבטָא דִמנַשַׁה בַר יֹוסֵף יָת מַלכוּת סִיחֹון מַלכָא אַמֹורָאָהדאמוראה ויָת מַלכוּתֵיה דעֹוג מַלכָא דמַתנַן ארעא לקִרוַהָא בתחוּמַהָא קִרוֵי ארעא סחור סחור
וֻבנֹו בנֵי גָד יָת דִיבֹן ויָת עַטָרֹת ויָת עַרֹועֵר
ויָת עַטרֹות שֹׁופָן ויָת יַעַזֵר ורָמתָאויגבהה
ויָת בֵית נִמרָה ויָת בֵית הָרָן קִרוִין כרִיכָן וחַטרִין דעָן
וֻבנֵי ראוּבֵן בנֹו יָת חַשׁבֹון ויָת אַלעָלֵא ויָת קִריָתָיִם
ויָת נבֹו ויָת בַעַל מעֹון מַקפָן שׁמָהָן ויָת שִׁבמָה וֻקרֹו בִשׁמָהָן יָת שׁמָהָת קִרוַיָא דִבנֹו
וַאַזַלוּ בנֵי מָכִיר בַר מנַשַׁה לגִלעָד וכַבשׁוּהָא ותָרֵיךואריתו יָת אַמֹורָאָה דבַה
וִיהַב מֹשַׁה יָת גִלעָד למָכִיר בַר מנַשַׁה וִיתֵיב בַה
ויָאִיר בַר מנַשַׁה אַזַל וֻכבַשׁ יָת כַפרָנֵיהֹון וֻקרָא יָתהֹון כַפרָנֵי יָאִיר
ונֹבַח אַזַל וֻכבַשׁ יָת קנָת ויָת כַפרָנַהַא וֻקרָא לַה נֹבַח בִשׁמֵיה
אִלֵין מַטלָנֵי בנֵי ישׂראל דִנפַקוּ מארעא דמצרים לחֵילֵיהֹון בִידָא דמֹשַׁה ואַהַרֹן
וֻכתַב מֹשַׁה יָת מַפקָנֵיהֹון למַטלָנֵיהֹון עַל מֵימרָא דַיוי ואִלֵין מַטלָנֵיהֹון למַפקָנֵיהֹון
וֻנטַלוּ מֵרַעמסֵס ביַרחָא קַדמָאָה בַחמֵישַׁת עַסרָא יֹומָא ליַרחָא קַדמָאָה מִבָתַר פִסחָאיומא דפסחא נפַקוּ בנֵי ישׂראל ברֵישׁ גלֵי לעֵינֵי כָל מִצרָאֵימִצרָיִם
וֻמִצרָאֵי מקַברִין יָת דִקטַל יוי בהֹון כֹל בוּכרָא וֻבטָעַוָתהֹון עַבָד יוי דִינִין
וֻנטַלוּ בנֵי ישׂראל מֵרַעמסֵס וֻשׁרֹו בסֻכֹות
וֻנטַלוּ מִסֻכֹות וֻשׁרֹו באֵיתָם דבִסטַר מַדברָא
וֻנטַלוּ מֵאֵיתָם ותָב עַל פֹום חִירָתָא דִקדָםדעל אפי בעֵיל צפֹון וֻשׁרֹו קדָם מִגדֹול
וֻנטַלוּ מִן קדָםמקודםמפום חִירָתָא וַעַבַרוּ בגֹו יַמָא למַדברָאבמַדברָא דאֵיתָם וַאַזַלוּ מַהלַך תלָתָה יֹומִין במִדבַר אֵיתָם וֻשׁרֹו במָרָה
וֻנטַלוּ מִמָרָה וַאַתֹו לאֵילִים וֻבאֵילִים תרֵי עַסַר מַבוּעִין דמַיִין ושִׁבעִין דִקלִין וֻשׁרֹו תַמָן
וֻנטַלוּ מֵאֵילִים וֻשׁרֹו עַל יַמָא דסוּף
וֻנטַלוּ מִיַמָא דסוּף וֻשׁרֹו במַדברָא דסִין
וֻנטַלוּ מִמַדברָא דסִין וֻשׁרֹו בדָפקָה
וֻנטַלוּ מִדָפקָה וֻשׁרֹו באָלוּשׁ
וֻנטַלוּ מֵאָלוּשׁ וֻשׁרֹו בִרפִידִין ולָא הַוָה תַמָן מַיָא לעַמָא למִשׁתֵי
וֻנטַלוּ מֵרפִידִים וֻשׁרֹו במַדברָא דסִינָי
וֻנטַלוּ מִמַדברָא דסִינָי וֻשׁרֹו בקִברֵי דִמשַׁאַלֵי
ונטלו מִקִברֵי דִמשַׁאַלֵי וֻשׁרֹו בַחַצֵרֹות
ונטלו מֵחַצֵרֹות ושׁרו ברִתמָה
ונטלו מֵרִתמָה וֻשׁרֹו ברִמֹון פָרַץ
וֻנטַלוּ מרמון פרץ ושׁרו בלִבנָה
ונטלו מלבנה ושׁרו ברִסָה
ונטלו מרסה ושׁרו בִקהֵלָת
ונטלו מִקהֵלָת ושׁרו בטוּרָא דשָׁפַר
ונטלו מִטוּרָא דשָׁפַר ושׁרו בַחַרָדָה
וֻנטַלוּ מֵחַרָדָה ושׁרו במַקהֵלֹת
ונטלו מִמַקהֵלֹת ושׁרו בתָחַת
ונטלו מתחת ושׁרו בתָרַח
ונטלו מִתָרַח וֻשׁרֹו במִתקָה
ונטלו ממתקה וֻשׁרֹו בחַשׁמֹנָה
ונטלו מֵחַשׁמֹונָה ושׁרו במֹוסֵרֹות
ונטלו מִמֵסֵרֹות ושׁרו בִבנֵי יַעקָן
וֻנטַלוּ מִבנֵי יַעַקָן ושׁרו בחֹר גִדגָד
וֻנטַלוּ מֵחֹר גִדגָד ושׁרו ביָטבָת
ונטלו מִיָטבָת ושׁרו בעַברֹנָהבערבונה
ונטלו מעברנהמערבונה ושׁרו בעציון גָבַר
ונטלו מֵעַציֹן גָבַר ושׁרו במַדברָא דצִין הִיא רקַם
ונטלו מֵרקַם ושׁרו בהֹור טוּרָא בִסיָפֵיבסטר ארעא דַאַדֹום
וֻסלֵיק אהרן כָהַנָא להֹור טוּרָא עַל מֵימרָא דַיוי וֻמִית תַמָן בִשׁנַת אַרבעִין למִפַק בנֵי ישׂראל מארעא דמצרים ביַרחָא חַמִישָׁאָה בחַד ליַרחָא
ואהרן בַר מאָה ועַסרִין וֻתלָת שׁנִין כַד מִית בהֹור טוּרָא
וֻשׁמַע כנַעַנָאָה מַלכָא דַעַרָד והוּא יָתֵיב בדָרֹומָא בארעא דִכנָעַן במֵיתֵי בנֵי ישׂראל
וֻנטַלוּ מֵהֹור טוּרָא וֻשׁרֹו בצַלמֹונָה
וֻנטַלוּ מִצַלמֹנָה וֻשׁרֹו בפוּנֹן
ונטלו מפונון ושׁרו באֹבֹת
ונטלו מאבת ושׁרו בִמגָזַתבמקצת עִברָאֵי בִתחוּם מֹואָב
וֻנטַלוּ מֵעִיִיםמִמגָזָתָא וֻשׁרֹו בדִבֹן גָד
וֻנטַלוּ מִדִיבֹן גָד וֻשׁרֹו בעלמֹון דִבלָתָיִם
וֻנטַלוּ מעלמן דִבלָתָיִם ושׁרו בטוּרֵיבטוּרָא דעִברָאֵי דִקדָםקדָם נבֹו
וֻנטַלוּ מִטוּרֵימִטוּרָא דעִברָאֵי וֻשׁרֹו במֵישׁרַיָא דמֹואָב עַל יַרדנָא דִירִיחֹו
וֻשׁרֹו עַל יַרדנָא מִבֵית ישִׁימֹות עַד מֵישַׁר שִׁטִין במֵישׁרַיָא דמֹואָב
וֻמַלֵיל יוי עִם מֹשַׁה במֵישׁרַיָא דמֹואָב עַל יַרדנָא דִירִיחֹו למֵימַר
מַלֵיל עִם בנֵי ישׂראל ותֵימַר להֹון אַרֵי אַתוּן עָברִין יָת יַרדנָא לארעא דִכנָעַן
וֻתתָרכוּן יָת כֹל יָתבֵי ארעא מִן קדָמֵיכֹוןמקדמיכון ותֵיבדוּן יָת כֹל בֵית סִגדַתהֹון ויָת כֹל צַלמֵי מַתכָתהֹון תֹובדוּן ויָת כֹל בָמָתהֹון תשֵׁיצֹון
וֻתתָרכֹוןותירתון יָת יָתבֵי ארעא ויִיתבוּן בַה אַרֵי לכֹון יהַבִית יָת ארעא למֵירַת יָתַה
ותַחסנוּן יָת ארעא בעַדבָא לזַרעַיָתכֹון לסַגִיאֵי תַסגֹון יָת אַחסָנַתהֹון ולִזעֵירֵי תַזעַרוּן יָת אַחסָנַתהֹון לִדיִפֹוק לֵיה תַמָן עַדבָא דִילֵיה יהֵי לשִׁבטֵי אַבָהָתכֹון לשׁבטא דאבהתכון תַחסנוּן
ואִם לָא תתָרכוּן יָת יָתבֵי ארעא מִן קדָמֵיכֹון וִיהֵי דתַשׁאַרוּן מִנהֹון לסִיעָן נָטלָן זֵין לקִבלכֹון ולמַשִׁריָן מַקפָנכֹוןמפקן לכון וִיעִיקוּן לכֹון עַל ארעא דאַתוּן יָתבִין בַה
וִיהֵי כמָא דחַשֵׁיבִית למַעַבַד להֹון אַעַבֵיד לכֹון
ומליל יוי עםלות משׁה למימר
פַקֵיד יָת בנֵי ישׂראל ותֵימַר להֹון אַרֵי אַתוּן עָלִין לארעא דכנען דָא אַרעָא דתִתפלַגדתפל לכֹון באַחסָנָא ארעא דִכנָעַן לִתחוּמַהָא
וִיהֵי לכֹון רוּחַתחום דָרֹומָא מִמַדברָא דצִין עַל תחוּמֵיידי אַדֹוםאדומאה וִיהֵי לכֹון תחוּם דָרֹומָא מִסִיָפֵי יַמָא דמִלחָא קִדוּמָא
ויַסחַרויסתחר לכֹון תחוּמָא מִדָרֹומָא למַסקָנָא דעַקרַבִין למסקני עקרבים ויִעִיבַר לצִין וִיהֹון מַפקָנֹוהִי מִדָרֹומָא לִרקַם גֵיאָה ויִפֹוק לַחצַר אַדָר ויִעִיבַר לעַצמֹון
ויִסתחַר תחוּמָא מֵעַצמֹון לנַחלָא דמצרים וִיהֹון מַפקָנֹוהִי ליַמָאלמערבא מערבא
וֻתחוּם מַעַרבָא וִיהֵי לכֹון יַמָא רַבָא וֻתחוּמֵיה דֵין יהֵי לכֹון תחוּם מַעַרבָא
ודֵין יהֵי לכֹון תחוּם צִפוּנָא מִן יַמָא רַבָא תכָונוּן לכֹון להֹורהור טוּרָא
מֵהֹור טוּרָא תכָונוּן למָטֵי חַמָת וִיהֹון מַפקָנֹוהִי דִתחוּמָא לִצדָד
ויִפֹוק תחוּמָא לזִפרֹון וִיהֹון מַפקָנֹוהִי לַחצַר עֵינָן דֵין יהֵי לכֹון תחוּם צִפוּנָא
וֻתכָונוּן לכֹון לִתחוּם קִדוּמָא מֵחַצַר עֵינָן לִשׁפָם
ויֵיחֹות תחוּמָא מִשׁפָם לרִבלָה מִמַדנַח לעָיִן ויֵיחֹות תחוּמָא ויִמטֵי עַל כֵיףעל כתף יַם גִנֵיסַר קִדוּמָא
ויֵיחֹות תחוּמָא ליַרדנָא וִיהֹון מַפקָנֹוהִי ליַמָאיַמָא דמִלחַא דָא תהֵי לכֹון אַרעָא לִתחוּמַהָא סחור סחור
וֻפַקֵיד מֹשַׁה יָת בנֵי ישׂראל למֵימַר דָא ארעא דתַחסנוּן יָתַה בעַדבָא דפַקֵיד יוי למִתַן לתִשׁעָה שִׁבטִין וֻפַלגוּת שִׁבטָא
אַרֵי קַבִילוּ שִׁבטָא דִבנֵי ראובן לבֵית אַבָהָתהֹון ושִׁבטָא דִבנֵי גָד לבֵית אַבָהָתהֹון וֻפַלגוּת שִׁבטָא דִמנַשַׁה קַבִילוּ אַחסָנַתהֹון
תרֵין שִׁבטִין וֻפַלגוּת שִׁבטָא קַבִילוּ אַחסָנַתהֹון מֵעִברָא ליַרדנָא דִירִיחֹו קִדוּמָא מַדִנחָא
ומליל יוי עםלות משׁה למימר
אִלֵין שׁמָהָת גַברַיָא דיַחסנוּן לכֹון יָת ארעא אַלעָזָר כָהַנָא וִיהֹושֻׁעַ בַר נוּן
ורַבָא חַד רַבָא חַד מִשִׁבטָא תִדברוּןתסבון לאַחסָנָא יָת ארעא
ואִלֵין שׁמָהָת גַברַיָא לשִׁבטָא דִיהוּדָה כָלֵב בַר יפֻנַה
וֻלשִׁבטָא דִבנֵי שִׁמעֹון שׁמוּאֵל בַר עַמִיהוּד
לשִׁבטָא דבִניָמִין אַלִידָד בַר כִסלֹון
וֻלשִׁבטָא דִבנֵי דָן רַבָא בֻקִי בַר יָגלִי
לִבנֵי יֹוסֵף לשׁיבטא דִבנֵי מנַשַׁה רַבָא חַנִיאֵל בַר אֵפֹד
לשִׁבטָא דִבנֵי אפרים רַבָא קמוּאֵל בַר שִׁפטָן
וֻלשִׁבטָא דִבנֵי זבולן רַבָא אַלִיצָפָן בַר פַרנָך
וֻלשִׁבטָא דִבנֵי יִשָׂשׂכָר רַבָא פַלטִיאֵל בַר עַזָן
ולשׁבטא דִבנֵי אָשֵׁר רַבָא אַחִיהוּד בַר שׁלֹומִי
ולשׁבטא דִבנֵי נַפתָלִי רַבָא פדַהאֵל בַר עַמִיהוּד
אִלֵין דפַקֵיד יוי לאַחסָנָא יָת בנֵי ישׂראל בארעא דִכנָעַן
וֻמַלֵיל יוי עִם מֹשַׁה במֵישׁרַיָא דמֹואָב עַל יַרדנָא דִירִיחֹו למֵימַר
פַקֵיד יָת בנֵי ישׂראל ויִתנוּן ללֵיוָאֵי מֵאַחסָנַת אַחֻדַתהֹון קִרוִין למִיתַב ורַוַח לקִרוַיָא סַחרָנֵיהֹוןדי בסחרניהוןסחור סחור תִתנוּן ללֵיוָאֵי
ויִהוִיָןוִיהֹון קִרוַיָא להֹון למִתַב ורַוחֵיהֹון יהֹון לִבעִירהֹון וֻלקִניָנהֹון וֻלכָל חֵיוָתהֹון
ורַוחֵי קִרוַיָא דתִיתנוּן ללֵיוָאֵי מִכֹותַל קַרתָא וֻלבַרָא אַלַף אַמִין סחור סחור
ותִמשׁחוּן מִבַרָא לקַרתָא יָת רוּחַ לרוח קִדוּמָא תרֵין אַלפִין אַמִין ויָת רוּחַ דָרֹומָא תרֵין אַלפִין אַמִין ויָת רוּחַ מַערבָא תרֵין אַלפִין אַמִיןבאמין ויָת רוּחַ ולרוח צִפוּנָא תרֵין אַלפִין אַמִיןבאמין וקַרתָא בִמצִיַע דֵין יהֵי להֹון רַוחֵי קִרוַיָא
ויָת קִרוַיָא דתִתנוּן ללֵיוָאֵי יָת שֵׁית קִרוֵי שֵׁיזָבוּתָא דתִתנוּן למִיעִירַק לתַמָןתמן קָטֹולָא וַעַלֵיהֹון תִיתנוּן אַרבעִין ותַרתֵין קִרוִין
כֹל קִרוַיָא דתִתנוּן ללֵיוָאֵי אַרבעִין ותַמנֵי קִרוִין יָתהֹון ויָת רַוחֵיהֹון
וקִרוַיָא דתִתנוּן מֵאַחוּדַתמאחסנת בנֵי ישׂראל מִן סַגִיאֵי תַסגֹון וֻמִן זעֵירֵי תַזעַרוּן גבַר כפֹום אַחסָנתֵיה דיַחסנוּן יִתֵין מִקִרוֵיהִי ללֵיוָאֵי
ומליל יוי עםלות משׁה למימר
מַלֵיל עִם בנֵי ישׂראל ותֵימַר להֹון אַרֵי אַתוּן עָברִין יָת יַרדנָא לארעא דכנען
וֻתזָמנֹון לכֹון קִרוִין קִרוֵי שֵׁיזָבוּתָא יִהויָןיִהוִיָן לכֹון ויִעִירֹוק לתַמָןתמן קָטֹולָא דיִקטֹול נַפשָׁא בשָׁלוּ
ויִהוִיָןויִהויָן לכֹון קִרוַיָא לשֵׁיזָבָא מִגָאֵל דמָא ולָא ימוּת קָטֹולָא עַד דִיקוּם קדָם כנִשׁתָא לדִינָא
וקִרוַיָא דתִתנוּן שֵׁית קִרוֵי שֵׁיזָבוּתָא יִהוִיָןיִהויָן לכֹון
יָת תלָת קִרוַיָא תִתנוּן מֵעִברָא ליַרדנָא ויָת תלָת קִרוַיָא תִתנוּן בארעא דִכנָעַן קִרוֵי שֵׁיזָבוּתָא יִהוִיָןיִהויָן
לִבנֵי ישׂראל וֻלגִיֹורַיָא וֻלתֹותָבַיָא דבֵינֵיהֹוןביניכון יִהוִיָןיִהויָן שֵׁית קִרוַיָא הָאִלֵין לשֵׁיזָבָא למִיעִירַק לתַמָןתמן כֹל דיִקטֹול נַפשָׁא בשָׁלוּ
ואִם במָן דבַרזַלדפרזלא מחָהִי וקַטלֵיה קָטֹולָא הוּא אִתקטָלָא יִתקטִיל קָטֹולָא
ואִם באַבנָא דמִתנַסבָא ביַד דהִיא כמִיסַת דִימוּת בַה מחָהִי וקַטלֵיה קָטֹולָא הוּא אִתקטָלָא יִתקטִיל קָטֹולָא
אֹו במָן דאָע דמִתנסֵיב ביַד דהוּא כמִיסַת דִימוּת בֵיה מחָהִי וקַטלֵיה קָטֹולָא הוּא אִתקטָלָא יִתקטִיל קָטֹולָא
גָאֵיל דמָא הוּא יִקטֹול יָת קָטֹולָא כַד אִתחַייַב לֵיה מִן דִינָא הוּא יִקטלִינֵיה
ואִם בסִנאָהבדבבו דחָהִי אֹו רמָא עַלֹוהִי בכָמנָא וקַטלֵיה
אֹו בִדבָבוּ מחָהִי בִידֵיה וקַטלֵיה אִתקטָלָא יִתקטִיל מָחיָא קָטֹולָא הוּא גָאֵיל דמָא יִקטֹול יָת קָטֹולָא כַד אִתחַייַב לֵיה מן דינא
ואִם בִתכֵיף בלָא דבָבוּ דחָהִי אֹו רמָא עַלֹוהִי כֹל מָן בלָא כמַן לֵיה
אֹו בכֹל אַבנָא דהִיא כמִיסַת דִימוּת בַה בלָא חָזֵי וֻרמָא עַלֹוהִי וֻמִיתוקַטלֵיה והוּא לָא סָנֵי לֵיה ולָא תָבַע בִשׁתֵיה
וִידִינוּן כנִשׁתָא בֵין מָחיָא וֻבֵין גָאֵיל דמָא עַל דִינַיָא הָאִילֵין
וִישֵׁיזבוּן כנִשׁתָא יָת קָטֹולָא מִיַד גָאֵיל דמָא ויָתִיבוּן יָתֵיה כנִשׁתָא לִקריַת שֵׁיזבוּתֵיה דַעַרַק לתַמָן ויִתֵיב בַה עַד דִימוּת כָהַנָא רַבָא דרַבִי יָתֵיה בִמשַׁח קוּדשָׁא
ואִם מִיפַק יִפֹוק קָטֹולָא יָתמןל  תחוּם קִריַת שֵׁיזָבוּתֵיה דַעַרַק לתַמָן
ויַשׁכַח יָתֵיה גָאֵיל דמָא מִבַרָא לִתחוּם קִריַת לקִריַת שֵׁיזָבוּתֵיה ויִקטֹול גָאֵיל דמָא יָת קָטֹולָא לֵית לֵיה דַם
אַרֵי בקִריַת שֵׁיזָבוּתֵיה יִתֵיב עַד דִימוּת כָהַנָא רַבָא וֻבָתַר דִימוּת כָהַנָא רַבָא יתוּב קָטֹולָא לַאַרַע אַחסָנתֵיה
ויהֹון אִלֵין לכֹון לִגזֵירַת דִין לדָרֵיכֹון בכול מֹותבָנֵיכֹון
כֹל דיקטֹול נַפשָׁא לפֹוםעַל פֹום סָהַדִין יִקטֹול יָת קָטֹולָא וסָהִיד חַד לָא יַסהֵיד בַאַנָשׁבנפשׁא למִקטַל
ולָא תקַבלוּן מָמֹון עַל אַנָשׁ קָטֹול לנפשׁא קטולא דהוּא חַייָב לִיממָתלמִקטַל אַרֵי אִתקטָלָא יִתקטִיל
ולָא תקַבלוּן מָמֹון למִיעִירַק לקִריַת שֵׁיזָבוּתֵיה לִמתָב למִתַב בארעא עַד דִימוּת כָהַנָא
ולָא תחַייבוּן יָת ארעא דאַתוּן יתבין בַה אַרֵי דמָא הוּא מחַייֵב יָת ארעא וֻלאַרעָא לָא מִתכַפַר עַל דַם זַכַי דאִתאַשַׁד בַה אַלָהֵין בדַם אָשׁדֵיה
ולָא תסָאַבוּן יָת ארעא דאַתוּן יָתבִין בַה דשִׁכִינתִי שָׁריָא בגַוַה אַרֵי אַנָא יוי שׁכִינתִי שָׁריָא שׁרי בגֹו בנֵי יִשׂרָאֵל
וֻקרִיבוּ רֵישֵׁי אַבָהָתָא לזַרעיָת בנֵי גִלעָד בַר מָכִיר בַר מנַשַׁה מִזַרעַיָת בנֵי יֹוסֵף וֻמַלִילוּ קדָם מֹשַׁה וֻקדָםולקדם רַברבַיָא רֵישֵׁי אַבָהָתָא לִבנֵי יִשׂרָאֵל
וַאַמַרוּ יָת רִבֹונִי פַקֵיד יוי למִתַן יָת ארעא באַחסָנָא בעַדבָא לִבנֵי ישׂראל ורִבֹונִי אִתפַקַד במֵימרָא דַיוי למִיתַן יָת אַחסָנַת צלָפחָד אַחוּנָא לִבנָתֵיה
ויִהוִיָןויִהויָן לחַד מִבנֵי שִׁבטֵי בנֵי ישׂראל לִנשִׁין ותִתמנַע אַחסָנתהֹון מֵאַחסָנַת אַבָהָתַנָא ותִתֹוסַף עַל אַחסָנַת שִׁבטָא דיִהוִיָןדיִהויָן די תהויין להֹון וֻמֵעַדַב אַחסָנתַנָא יִתמנַע
ואִם יהֵי יֹובֵילָא לִבנֵי ישׂראל ותִיתֹוסַף אַחסָנַתהֹון עַל אַחסַנַת שִׁבטָא דיִהוִיָןדיִהוָן די תהויין להֹון וֻמֵאַחסנָת שִׁבטָא דַאַבָהָתַנָא תִתמנַע אַחסָנַתהֹון
וֻפַקֵיד מֹשַׁה יָת בנֵי ישׂראל עַל מֵימרָא דַיוי למֵימַר יָאוּת שִׁבטָא דִבנֵי יֹוסֵף ממַללִין
דֵין פִתגָמָא דפַקֵיד יוי לִבנָת צלָפחָד למֵימַר לִדתָקֵין בעֵינֵיהֹון יִהוִיָןיִהויָן לִנשִׁין ברַם לזַרעִית שִׁבטָא דַאַבוּהֵין יִהוִיָןיִהויָן לִנשִׁין
ולָא תַסחַר אַחסָנָא לִבנֵי ישׂראל מִשִׁבטָא לשִׁבטָא אַרֵי גבַר באַחסָנַת שִׁבטָא דַאַבָהָתֹוהִי יִדבקוּן בנֵי יִשׂרָאֵל
וכָל ברַתָא יָרתַת אַחסָנָא מִשִׁבטַיָא דִבנֵי ישׂראל לחַד מִזַרעִית שִׁבטָא דַאַבוּהָא תהֵי לאִיתוּלאינתו בדִיל דיֵירתוּן בנֵי ישׂראל גבַר אַחסָנַת אַבָהָתֹוהִי
ולָא תַסחַר אַחסָנָא מִשִׁבטָא לשִׁבטָא אוּחרָנָא אַרֵי גבַר באַחסָנתֵיה יִדבקוּן שִׁבטַיָא דִבנֵי יִשׂרָאֵל
כמָא דפַקֵיד יוי יָת מֹשַׁה כֵין עַבַדָא בנָת צלָפחָד
וַהוַאָה מַחלָה תִרצָה וחָגלָה וֻמִלכָה ונֹעָה בנָת צלָפחָד לִבנֵי אַחֵי אַבוּהֵיןאחבוהין לִנשִׁין
מִזַרעַיָת בנֵי מנַשַׁה בַר יֹוסֵף הַוַאָה לִנשִׁין וַהוָת אַחסָנַתהֹון עַל שֵׁיבַט זַרעִית אַבוּהֵין
אִלֵין פִקֹודַיָא ודִינַיָא דפַקֵיד יוי בִידָא דמֹשַׁה ית משׁה לוָת בנֵי לבני יִשׂרָאֵל במֵישׁרַיָא דמֹואָב עַל יַרדנָא דִירִיחֹו
אִלֵין פִתגָמַיָא דמַלֵיל מֹשַׁה עִים כֹל בני ישׁראל בעִברָא דיַרדנָא אֹוכַח יָתהֹון עַל דחָבוּ במַדברָא ועַל דאַרגִיזוּ במֵישׁרָא לִקבֵיללָקָבֵיל יַם סוּף בפָרָן אִתַפַלוּ עַל מַנָא וֻבַחַצֵרֹות אַרגִיזוּ עַל בִסרָא ועַל דַעַבַדוּ עֵיגַל דִדהַב
מַהלַך חַד עַסַר יֹומִין מֵחֹורֵב אֹורַח טוּרָא דסֵעִיר עַד רקַם גֵיאָה
וַהַוָה באַרבעִין שׁנִין בחַד עַסַר יַרחִין בחַד ליַרחָא מַלֵיל משׁה עִם בנֵי יִשׁרָאֵל ככֹל דפַקֵיד יוי יָתֵיה לוָתהֹון
בָתַר דִמחָא יָת סִיחֹון מַלכָא אַמֹורָאָה דיָתֵיב בחַשׁבֹון וָיָת עֹוג מַלכָא דמַתנַן דיָתֵיב בעַשׁתָרֹות באַדרַעִי
בעִברָא דיַרדנָא בארעא דמֹואָב שָׁרִי מֹשַׁה פָרֵישׁ יָת אוּלפָן אֹורָיתָא הָדָא למֵימַר
יוי אַלָהַנָא מַלֵיל עִמַנָא בחֹורֵב למֵימַר סַגִי לכֹון דִיתֵיבתוּן בטוּרָא הָדֵין
אִתפנֹואיתפניאו וטוּלוּ לכֹון ועוּלוּ לטוּרָא דַאַמֹורָאָה וֻלכָל מגִירֹוהִי במֵישׁרָא בטוּרָא וֻבשָׁפֵילתָא וֻבדָרֹומָא וֻבִספַר יַמָא אַרַע כנַעַנָאָה ולִיבנָן עַד נַהרָא רַבָא נַהרָא פרָת
חַזֹו דִיהַבִית קדָמֵיכֹון יָת ארעא עוּלוּ ואַחסִינוּ יָת אַרעָא דקַיֵים יוי לַאַבָהָתכֹון לאַברָהָם ליִצחָק וֻליַעַקֹב למִיתַן להֹון ולִבנֵיהֹון בָתרֵיהֹון
וַאַמַרִית לכֹון בעִידָנָא הַהוּא למֵימַר לֵית אַנָא יָכֵיל בִלחֹודַי לסֹובָרָא יָתכֹון
יוי אַלָהַכֹון אַסגֵי יָתכֹון והָאִיתֵיכֹון יֹומָא דֵין ככֹוכבֵי שׁמַיָא לִסגֵילמיסגי
יוי אַלָהָא דַאַבָהָתכֹון יֹוסֵף עַלֵיכֹון כוָתכֹון אַלַף זִמנִין וִיבָרֵיך יָתכֹון כמָא דמַלֵיל לכֹון
אֵיכדֵין אַסֹובַר בִלחֹודַי טוּרחֵיכֹון ועִסקֵיכֹוןועַסקֵיכֹון ודִינכֹון
הַבוּהֻבוּ לכֹון גֻברִיןגַברִין חַכִימִין וסוּכלתָנִין וֻמַדעַןומנדען לשִׁבטֵיכֹון וַאַמַנֵינֻין רֵישִׁיןראשׁין עַלֵיכֹון
וַאַתֵיבתוּן יָתִי וַאַמַרתוּן תָקֵין פִיתגָמָא דמַלֵילתָא למַעַבַד
וֻדבַרִית יָת רֵישֵׁי שִׁבטֵיכֹון גֻברִין חַכִימִין וֻמַדעַןומנדען וֻמַנִיתִי יָתהֹון רֵישִׁין עַלֵיכֹון רַבָנֵי אַלפֵי ורַבָנֵי מָאוָתָא ורַבָנֵי חַמשִׁין ורַבָנֵי עִיסֹוריָתָא וסָרכִין לשִׁבטֵיכֹון
וֻפַקֵידִית יָת דַיָינֵיכֹון בעִידָנָא הַהוּא למֵימַר שׁמַעוּ בֵין אַחֵיכֹון וֻתדִינוּןותדונון קוּשׁטָא בֵין גֻברָאגַברָא וֻבֵין אַחוּהִי וֻבִין גִיֹורָא
לָא תִשׁתמֹודעוּן אַפֵיאפין בדִינָא מִלֵי זעֵירָא כרַבָא תִשׁמעוּןתקבלון לָא תִדחַלוּן מִן קדָם גַברָאאנשׁ אַרֵי דִינָא דַיוי הוּא וֻפִתגָמָא דיִקשֵׁי מִנכֹון תקָרבוּן לוָתִי ואִשׁמעִינֵיה
וֻפַקֵידִית יָתכֹון בעִידָנָא הַהוּא יָת כֹל פִתגָמַיָא דתַעבדוּן
וֻנטַלנָא מֵחֹורֵב והַלֵיכנָא יָת כֹל מַדברָא רַבָא וֻדחִילָא הַהוּא דַחזֵיתֹון אֹורַח טוּרָא דַאַמֹורָאָה כמָא דפַקֵיד יוי אַלָהַנָא יָתַנָא וַאַתֵינָא עַד רקַם גֵיאָה
וַאַמַרִית לכֹון אַתֵיתֹון עַד טוּרָא דַאַמֹורָאָה דַיוי אַלָהַנָא יָהֵיב לַנָא
חַזִי דִיהַב יוי אַלָהָך קדָמָך יָת ארעא סַק אַחסֵין כמָא דמַלֵיל יוי אַלָהָא דַאַבָהָתָך לָך לָא תִדחַל ולָא תִתַבַרתִתבַר
וֻקרֵיבתוּן לוָתִי כוּלכֹון וַאַמַרתוּן נִשׁלַח גֻברִיןגַברִין קדָמַנָא וִיאַללוּן לַנָא יָת ארעא ויָתִיבוּן יָתַנָא פִתגָמָא יָת אֹורחָא דנִיסַק בַה ויָת קִרוַיָא דנֵיעֹול להֹון
וֻשׁפַר בעֵינַי פִתגָמָא וֻדבַרִית מִנכֹון תרֵי עַסַר גֻברִיןגַברִין גֻברָא חַד לשִׁבטָא
ואִתפנִיוּ וֻסלִיקוּ לטוּרָא וַאַתֹו עַד נַחלָא דאִתכָלָאדאַתכָלָא ואַלִילוּ יָתַה
וֻנסִיבוּ ביַדהֹון מֵאִיבָא דארעא וַאַחִיתוּואוחיתו לַנָא וַאַתִיבוּ יָתַנָא פִתגָמָא וַאַמַרוּ טָבָא ארעא דַיוי אַלָהַנָא יָהֵיב לַנָא
ולָא אַבֵיתֹון למִיסַק וסָרֵיבתוּן עַל מֵימרָא דַיוי אַלָהַכֹון
ואִתרָעַמתוּן במַשׁכנֵיכֹון וַאַמַרתוּן בִדסָנֵי יוי יתַנָא אַפקַנָא מֵאַרעָא דמצרים למִימסַר יָתַנָא בִידָא דַאַמֹורָאָה לשֵׁיצָיוּתַנָא
לאָן אַנַחנָא סָלקִין אַחַנָא תבַרוּ יָת לִיבַנָא למֵימַר עַם רַב ותַקִיף מִינַנָא קִרוִין רַברבָן וֻכרִיכָן עַד צֵית שׁמַיָא ואַף בנֵי גִיבָרָא חַזֵינָא תַמָן
וַאַמַרִית לכֹון לָא תִיתַברוּן ולָא תִדחַלוּן מִנהֹון
יוי אַלָהַכֹון דִמדַבַר קדָמֵיכֹון מֵימרֵיה יגִיַח לכֹון ככֹל דַעַבַד עִמכֹון במצרים לעֵינֵיכֹון
וֻבמַדברָא דַחזֵיתָא דסֹוברָך יוי אַלָהָך כמָא דִמסֹובַר גַברָא יָת ברֵיה בכֹל אֹורחָא דהַלֵיכתוּן עַד מֵיתֵיכֹון עַד אַתרָא הָדֵין
וֻבפִתגָמָא הָדֵין לֵיתֵיכֹון מהֵימנִין במֵימרָא דַיוי אַלָהַכֹון
דִמדַבַר קדָמֵיכֹון באוּרחָא לאַתקָנָא לכֹון אַתַר בֵית מִשׁרֵי לאַשׁרָיוּתכֹון בעַמוּדָא דאִישָׁתָא בלֵיליָא לאַחזָיוּתכֹון באֹורחָא דִתהָכוּן בַה וֻבעַמוּדָא דַעַנָנָא בִימָמָא
וֻשׁמִיַע קדם יוי יָת קָל פִתגָמֵיכֹון וֻרגֵיז וקַיֵים למֵימַר
אִם יִחזֵי גבַר בגַברַיָאבגוּברַיָא הָאִלֵין דָרָא בִישָׁא הָדֵין יָת ארעא טָבתָא דקַיֵימִית למִתַן לַאַבָהָתהֹון
אַלָהֵין כָלֵב בַר יפֻנַה הוּא יִחזֵינַה ולֵיה אַתֵין יָת ארעא דִדרֵיך בַה ולבנֹוהִי חַלָף דאַשׁלֵים בָתַר דַחַלתָאדַחלתָא דַיוי
אַף עַלַי הַוָה רגַז מִן קדם יוי בדִילכֹון למֵימַר אַף אַת לָא תֵיעֹול לתַמָן
יהֹושֻׁעַ בַר נוּן דקָאֵים קדָמָך הוּא יֵיעֹול לתַמָן יָתֵיה תַקֵיף אַרֵי הוּא יַחסנִינַה ליִשׁרָאֵל
וטַפלכֹון דַאַמַרתוּן לבִיזָא יהֵי וֻבנֵיכֹון דלָא ידַעוּ יֹומָא דֵין טָב וֻבִישׁ אִנוּן יֵיעַלוּן לתַמָן וֻלהֹון אִיתנִינַה ואִינוּן יֵירתוּנַה
ואַתוּן אִתפנֹואיתפניאו לכֹון וטוּלוּ למַדברָא אֹורַח יַמָא דסוּף
וַאַתֵיבתוּן וַאַמַרתוּן לִי חַבנָא קדם יוי אַנַחנָא נִיסַק וֻנגִיַח קרָב ככֹל דפַקדַנָא יוי אַלָהַנָא וזָרֵיזתוּן גבַר יָת מָנֵי קרָבֵיה ושָׁרֵיתוּן למִיסַק לטוּרָא
וַאַמַר יוי לִי אֵימַר להֹון לָא תִיסקוּן ולָא תגִיחוּן קרָב אַרֵי לֵית שׁכִינתִי שׁריא בֵינֵיכֹון ולָא תִיתַברוּן קדָם בַעַלֵי דבָבֵיכֹון
וֻמַלֵילִית עִמכֹון ולָא קַבֵילתוּן וסָרֵיבתוּן עַל מֵימרָא דַיוי ואַרשַׁעתוּן וֻסלֵיקתוּן לטוּרָא
וֻנפַק אַמֹורָאָה דיָתֵיב בטוּרָא הַהוּא לקַדָמוּתכֹון וֻרדַפוּ יָתכֹון כמָא דנָתזָןדנתיזן דַברַיָתָאדברותא וֻטרַדוּ יָתכֹון בסֵעִיר עַד חָרמָה
ותַבתוּן וֻבכֵיתֹון קדם יוי ולָא קַבֵיל יוי צלֹותכֹון ולָא אַצֵית למִלֵיכֹון
וִיתֵיבתוּן בִרקַם יֹומִין סַגִיאִין כיֹומַיָא דִיתֵיבתוּן
ואִתפנִינָא וֻנטַלנָא למַדברָא אֹורַח יַמָא דסוּף כמָא דמַלֵיל יוי עִמִי ואַקֵיפנָא יָת טוּרָא דסֵעִיר יֹומִין סַגִיאִין
וַאַמַר יוי לִי למֵימַר
סַגִי לכֹון דאַקֵיפתוּן יָת טוּרָא הָדֵין אִתפנֹואיתפניאו לכֹון לצִפוּנָא
ויָת עַמָא פַקֵיד למֵימַר אַתוּן עָברִין בִתחוּם אַחֵיכֹון בנֵי עֵשָׁו דיָתבִין בסֵעִיר ויִדחַלוּןויִדַחלוּן מִנכֹון ותִסתַמרוּןותסטמרון לַחדָא
לָא תִתגָרֹון בהֹון אַרֵי לָא אַתֵין לכֹון מֵאַרַעהֹון עַד מִדרַךמַדרַך פַרסַת רגַל אַרֵי ירוּתָא לעֵשָׁו יהַבִית יָת טוּרָא דסֵעִיר
עִיבוּרָאעבוּרָא תִזבנוּן מִנהֹון בכַספָא ותֵיכלוּן ואַף מַיָא תִזבנוּן מִנהֹון בכַספָא ותִשׁתֹון
אַרֵי יוי אַלָהָך בָרכָך בכָל עוּבָדֵי ידָך סֹופֵיקסיפק לָך צוּרכָך בִמהָכָך יָת מַדברָא רַבָא הָדֵין דנָן אַרבעִין שׁנִין מֵימרָא דַיוי אַלָהָך בסַעַדָךעמך לָא חַסַרתָאמנעתא מִדָעַם
וַעַבַרנָא מִלוָת אַחַנָא בנֵי עֵשָׁו דיָתבִין בסֵעִיר מֵאֹורַח מֵישׁרָא מֵאֵילַת וֻמֵעַציֹון גָבַר ואִתפנִינָא וַעַבַרנָא אֹורַח מַדברָא דמֹואָב
וַאַמַר יוי לִי לָא תצוּר עַלית מֹואַבָאֵי ולָא תִתגָרֵי למַעַבַד עִמהֹון קרָב אַרֵי לָא אַתֵין לָך מֵאַרַעהֹון ירוּתָא אַרֵי לִבנֵי לֹוט יהַבִית יָת לחָיַת ירוּתָא
אֵימתָנֵי מִלקַדמִין יתִיבוּ בַה עַם רַב וסַגִי ותַקִיף כגִיבָרַיָא
גִיבָרַיָא מִתחַשׁבִין אַף אִנוּן כגִיבָרַיא וֻמֹואַבָאֵי קָרַן להֹון אֵימתָנֵי
וֻבסֵעִיר יתִיבוּ חֹורָאֵי מִלקַדמִין וֻבנֵי עֵשָׁו תָרִיכוּנוּן ושֵׁיצִיאוּנוּן מִן קדָמֵיהֹון וִיתִיבוּ בַאַתַרהֹון כמָא דַעַבַד ישׁראל לַאַרַע ירוּתתֵיה דִיהַב יוי להֹון
כעַן קוּמוּ ועֵיבַרוּוַעבֻרוּ לכֹון יָת נַחלָא דזָרַד וַעַבַרנָא יָת נַחלָא דזָרַד
ויֹומַיָא דהַלֵיכנָא מֵרקַם גֵיאָה עַדית דַעַבַרנָא יָת נַחלָא דזַרַד תלָתִין ותַמנֵי שׁנִין עַד דסָף כֹל דָרָא גַברֵיגֻברֵי מגִיחֵי קרָבָא מִגֹו מַשׁרִיתָא כמָא דקַיֵים יוי להֹון
ואַף מַחָא מִן קדם יוי הַוָת בהֹון לשֵׁיצָיוּתהֹון מִגֹו מַשׁרִיתָא עַד דִשׁלִימוּ
וַהַוָה כַד שׁלִימוּ כֹל גַברֵיגֻברֵי מגִיחֵי קרָבָא לִיממָת מִגֹו עַמָא
וֻמַלֵיל יוי עִמִי למֵימַר
אַת עָבַר יֹומָא דֵין יָת תחוּם מֹואָב יָת לחָיַת
ותִתקָרַבותתקריב לִקבֵיללָקָבֵיל בנֵי עַמֹון לָא תצוּר עַלֵיהֹון ולָא תִתגָרֵי למַעַבַד עִמהֹון קרָב אַרֵי לָא אַתֵין מֵאַרַע בנֵי עַמֹון לָך ירוּתָא אַרֵי לִבנֵי לֹוט יַהַבתַה ירוּתָא
אַרַע גִבָרַיָא מִתחַשׁבָא אַף הִיא גִבָרִין יתִיבוּ בַה מִלקַדמִין ועַמֹונָאֵי קָרַן להֹון חַשׁבָנֵיחושׁבני
עַם רַב וסַגִי ותַקִיף כגִיבָרַיָא ושֵׁיצִינוּן יוי מִן קדָמֵיהֹון ותָרִיכוּנוּןוִירִיתוּנוּן וִיתִיבוּ בַאַתַרהֹון
כמָא דַעַבַד לִבנֵי עֵשָׁו דיָתבִין בסֵעִיר דשֵׁיצִי יָת חֹורָאֵי מִן קדָמֵיהֹון ותָרִיכוּנוּן וִיתִיבוּ בַאַתַרהֹון עַד יֹומָא הָדֵין
ועַוָאֵי דיָתבִין בִרפִיַחבפציח עַד עַזָה קפוּטקָאֵי דִנפַקוּ מִקפוּטקִיָא שֵׁיצִיאוּנוּן וִיתִיבוּ בַאַתַרהֹון
קוּמוּ טוּלוּ ועֵיבַרוּוַעבֻרוּ יָת נַחלָא דאַרנֹון חַזִי דִמסַרִית בִידָך יָת סִיחֹון מַלכָא דחַשׁבֹון אַמֹורָאָה ויָת אַרעֵיה שָׁרִי לתָרָכוּתֵיה ואִיתגָרִי למַעַבַד עִמֵיה קרָב
יֹומָא הָדֵיןדֵין אַשָׁרֵי למִיתַן זֵיעַתָךזִיעתָךזועתך ודַחלתָך עַל אַפֵי עַממַיָא דִתחֹות כֹל שׁמַיָא דיִשׁמעוּן שִׁמעָך וִיזוּעוּן ויִתַברוּןוידחלון מִן קדָמָך
וֻשׁלַחִית אִזגַדִין מִמִדבַר קדֵמֹות לוָת סִיחֹון מַלכָא דחַשׁבֹון פִתגָמֵי שׁלָמָא למֵימַר
אַעִיבַר באַרעָך באֹורחָא באוּרחָא אִיזֵיל לָא אִסטֵי ליַמִינָא ולִסמָלָאושׂמאלא
עִיבוּרָאעבוּרָא בכַספָא תזַבֵין לִי ואֵיכוּל וֻמַיָא בכַספָא תִתֵין לִי ואִשׁתֵי לחֹוד אַעִיבַר ברַגלָי
כמָא דַעַבַדוּ לִי בנֵי עָשֵׁו דיָתבִין בסֵעִיר וֻמֹואַבָאֵי דיָתבִין בִלחָיָת עַד דאִיעִיבַר יָת יַרדנָא לארעא דַיוי אַלָהַנָא יָהֵיב לַנָא
ולָא אַבָא סִיחֹון מַלכָא דחַשׁבֹון למִשׁבקַנָא למִיעִיבַרלאַעבָרוּתַנָא בִתחוּמֵיה אַרֵי אַקשִׁי יוי אַלָהָך יָת רוּחֵיה ותַקֵיףואתקיף יָת לִיבֵיה בדִיל למִמסרֵיה בִידָך כיֹומָא הָדֵין
וַאַמַר יוי לִי חַזִי דשָׁרִיתִי למִמסַר קדָמָך יָת סִיחֹון ויָת אַרעֵיה שָׁרִי לתָרָכוּתֵיה למֵירַת יָת אַרעֵיה
וֻנפַק סִיחֹון לקַדָמוּתַנָא הוּא וכָל עַמֵיה לאָגָחָא קרָבָא ליָהַץ
וֻמַסרֵיה יוי אַלָהַנָא קדָמַנָא וֻמחֵינָא יָתֵיה ויָת בנֹוהִי ויָת כֹל עַמֵיה
וֻכבַשׁנָא יָת כֹל קִרֹוהִי בעִדָנָא הַהוּא וגַמַרנָא יָת כֹל קִרוַיָא גַברַיָאגֻברַיָא וֻנשַׁיָא וטַפלָא לָא אַשׁאַרנָא משֵׁיזִיב
לחֹוד בעִירָא בַזנָא לַנָא וַעַדַי קִרוַיָא דכבַשׁנָא
מֵעַרֹעֵר דעַל כֵיף נַחלָא דאַרנֹון וקַרתָא דִבנַחלָא ועַד גִלעָד לָא הַוָת קַרתָא דִתקֵיפַת מִנַנָא יָת כֹולָא מסַר יוי אַלָהַנָא קדָמַנָא
לחֹוד אַרַע בנֵי עַמֹון לָא קָרֵיבתָאקרֵיבתָא עָל כֵיף נחַל יוּבקָא וקִרוֵי טוּרָא וכֹל דפַקֵיד יוי אַלָהַנָא
ואִתפנִינָא וֻסלֵיקנָא לאֹורַח מַתנַן וֻנפַק עֹוג מַלכָא דמַתנַן לקַדָמוּתַנָא הוּא וכָל עַמֵיה לאָגָחָא קרָבָא לאַדרַעִי
וַאַמַר יוי לִי לָא תִדחַל מִנֵיה אַרֵי בִידָך מסַרִית יָתֵיה ויָת כֹל עַמֵיה ויָת אַרעֵיה ותַעַבֵיד לֵיה כמָא דַעַבַדתָא לסִיחֹון מַלכָא דַאַמֹורָאָה דיָתֵיב בחַשׁבֹון
וֻמסַרויהב יוי אַלָהַנָא בִידַנָא אַף יָת עֹוג מַלכָא דמַתנַן ויָת כֹל עַמֵיה וֻמחֵינָהִי עַד דלָא אִשׁתאַר לֵיה משֵׁיזִיב
וֻכבַשׁנָא יָת כֹל קִרוֹוהִי בעִדָנָא הַהוּא לָא הַוָת קַרתָא דלָא נסֵיבנָא מִינהֹון שִׁתִין קִרוִין כֹל בֵית פַלַך טרָכֹונָאתרָכֹונָא מַלכוּתֵיה דעֹוג במַתנַן
כָל אִלֵין קִרוִין כרִיכָן מַקפָןמֻקפָן שׁוּר רָם דִילהֹוןדלהין דַשִׁין ועָברִין בָר מִקִרוֵי פַצחַיָא דסַגִיאָן לַחדָא
וגַמַרנָא יָתהֹון כמָא דַעַבַדנָא לסִיחֹון מַלכָא דחַשׁבֹון גַמַרנָא כֹל קִרוַיָא גַברַיָאגֻברַיָא וֻנשַׁיָא וטַפלָא
וכֹל בעִירָא וַעַדַיועַדַי קִרוַיָא בַזנָא לַנָא
וֻנסֵיבנָאוכבשׁנא בעִידָנָא הַהוּא יָת ארעא מִיַד תרֵין מַלכֵי אַמֹורָאָה דִבעִברָא דיַרדנָא מִנַחלָא דאַרנֹון עַד טוּרָא דחַרמֹון
צִידֹונָאֵי קָרַן לחַרמֹון סִריֹון וַאַמֹורָאֵי קָרַן לֵיה טוּר תַלגָא
כֹל קִרוֵי מֵישׁרָא וכֹל גִלעָד וכֹל מַתנַן עַד סַלכָה ואַדרַעִי קִרוֵי מַלכוּתֵיה דעֹוג במַתנַן
אַרֵי לחֹוד עֹוג מַלכָא דמַתנַן אִשׁתאַר מִשׁאָר גִיבַרָיָא הָא עַרסֵיה עַרסָא דבַרזלָאדפרזלא הַלָא הִיא ברַבַת בנֵי עַמֹון תֵישַׁעתשַׁע אַמִין אוּרכַה ואַרבַע אַמִין פוּתיַה באַמַת מלַך
ויָת ארעא הָדָא יָרֵיתנָאירֵיתנָא בעִידָנָא הַהוּא מֵעַרֹועֵר דעַל נַחלָא דאַרנֹון וֻפַלגוּת טוּרָא דגִלעָד וקִרוֹוהִי יהַבִית לשֵׁיבַט ראוּבֵן וֻלשֵׁיבַט גָד
וֻשׁאָר גִלעָד וכֹל מַתנָן מַלכוּתֵיה דעֹוג יהַבִית לפַלגוּת שִׁבטָא דִמנַשַׁה כֹל בֵית פַלַך טרָכֹונָאתרָכֹונָא לכֹל מַתנַן הַהוּא מִתקרֵי אַרַע גִיבָרַיָא
יָאִיר בַר מנַשַׁה נסֵיבנסַב יָת כֹל בֵית פַלַך טרָכֹונָאתרָכֹונָא עַד תחוּם גשׁוּרָאָה וַאַפֵיקֹורֹוסוַאפֵיקֵירוּס וֻקרָא יָתהֹוןיתהין עַל שׁמֵיה יָת מַתנַן כַפרָנֵי יָאִיר עַד יֹומָא הָדֵין
וֻלמָכִיר יהַבִית יָת גִלעָד
וֻלשֵׁיבַט ראוּבֵן וֻלשֵׁיבַט גָד יהַבִית מִן גִלעָד ועַד נַחלָא דאַרנֹון גֹו נַחלָא וֻתחוּמֵיה ועַד יֹובקָא נַחלָא תחוּמָא דִבנֵי עַמֹון
וֻמֵישׁרָא ויַרדנָא וֻתחוּמֵיה מִגִנֵיסַר ועַד יַמָא דמֵישׁרָא יַמָא דמִלחָא תחֹות מִשׁפַךמַשׁפַך מֵירָמתָא מַדנחָאמַדִנחָא
וֻפַקֵידִית יָתכֹון בעִידָנָא הַהוּא למֵימַר יוי אַלָהַכֹון יהַב לכֹון יָת ארעא הָדָא למֵירתַה מזָרזִין תִעִברֻין קדָם אַחֵיכֹון בנֵי ישׁראל כֹל מזָרַז חֵילָא
לחֹוד נשֵׁיכֹון וטַפלכֹון וֻבעִירכֹוןוגיתיכון יָדַענָא אַרֵי בעִיר סַגִי לכֹון יִתבוּן בקִרוֵיכֹון דִיהַבִית לכֹון
עַד דִינִיַחדִינוּחַ יוי לַאַחֵיכֹון כוָתכֹון ויִירתוּן אַף אִינוּן יָת אַרעָא דַיוי אַלָהַכֹון יָהֵיב להֹון בעִברָא דיַרדנָא וֻתתוּבוּן גבַר לִירוּתתֵיה דִיהַבִית לכֹון
ויָת יהֹושֻׁעַ פַקֵידִית בעִדָנָא הַהוּא למֵימַר עֵינָך חַזָאָה יָת כֹל דַעַבַד יוי אַלָהַכֹון לִתרֵין מַלכַיָא הָאִלֵין כֵין יַעַבֵיד יוי לכֹל מַלכוָתָא דאַת עָבַר לתַמָן
לָא תִדחַלוּן מִנהֹון אַרֵי יוי אַלָהַכֹון מֵימרֵיה מגִיַח לכֹון
וצַלִיתִי קדָם יוי בעִדָנָא הַהוּא למֵימַר
יוי אַלֹהִים אַת שָׁרִיתָא לאַחזָאָה יָת עַבדָך יָת רבוּתָך ויָת ידָך תַקִיפתָא דאַתדמאן הוּא אַלָהָא דִשׁכִינתָך בִשׁמַיָא מִלעֵילָא ושַׁלִיט בארעא לֵית דיַעַבֵיד כעוּבָדָך וֻכגִבָרוָתָך
אַעִיבַר כעַן ואיחזי יָת אַרעָא טָבתָא דִבעִיברָא דיַרדנָא טוּרָא טָבָא הָדֵין וֻבֵית מַקדשָׁא
וַהַוָה רגַז מִן קדם יוי עַלַי בדִילכֹון ולָא קַבֵיל מִנִי וַאַמַר יוי לִי סַגִי לָך לָא תֹוסֵיף למַלָלָא קדָמַי עֹוד בפִתגָמָא הָדֵין
סַק לרֵישׁ רָמתָא וֻזקֹוףוֻזקַף עֵינָך למַעַרבָא וֻלצִפוּנָא וֻלדָרֹומָא וֻלמַדִנחָא וֻחזִי בעֵינָך אַרֵי לָא תִעִיבַר יָת יַרדנָא הָדֵין
וֻפַקֵיד יָת יהֹושֻׁעַ ותַקֵיפהִי ועַלֵימהִיואַלֵימהִי אַרֵי הוּא יעִיבַר קדָםית עַמָא הָדֵין והוּא יַחסֵין יָתהֹון יָת ארעא דתִחזֵי
וִיתֵיבנָא בחִילתָא לִקבֵיללָקָבֵיל בֵית פעֹור
וֻכעַן ישׁראל שׁמַע לִקיָמַיָיא וֻלדִינַיָיא דַאַנָא מַלֵיףמאליף יָתכֹון למַעַבַד בדִיל דתֵיחֹון ותֵיעַלוּן ותֵירתוּן יָת ארעא דַיוי אַלָהָא דַאַבָהָתכֹון יָהֵיב לכֹון
לָא תֹוספוּןתֵיספוּן עַל פִתגָמָא דַאַנָא מפַקֵיד יָתכֹון ולָא תִמנעוּן מִנֵיה למִטַר יָת פִקֹודַיָא דַיוי אַלָהַכֹון דַאַנָא מפַקֵיד יָתכֹון
עֵינֵיכֹון חַזַאָה יָת דַעַבַד יוי בפָלחֵי בַעַלָא פעֹור אַרֵי כֹל גַברָאגוּברָא דהַלֵיך בָתַר בַעלָא פעֹור שֵׁיצִיֵה יוי אַלָהָך מִבֵינָך
ואַתוּן דאִידבֵיקתוּןדאיתדבקתון בדַחלתָא דַיוי אַלָהַכֹון קַיָימִין כוּלכֹון יֹומָא דֵין
חַזֹו דאַלֵיפיִת יָתכֹון קיָמִיןקִיָמִין ודִינִין כמָא דפַקדַנִי יוי אַלָהִי למַעַבַד כֵין בגֹו אַרעָא דאַתוּן עָלִין לתַמָן למֵירתַה
ותִיטרוּן ותַעבדוּן אַרֵי הִיא חוּכמַתכֹוןחָכמַתכֹון וסוּכלתָנוּתכֹון לעֵינֵי עַממַיָא דיִשׁמעוּן יָת כֹל קִיָמַיָאקיָמַיָא הָאִלֵין ויֵימרוּן לחֹוד עַם חַכִים וסוּכלתָן עַמָא רַבָא הָדֵין
אַרֵי מַן עַם רַב דלֵיה אַלָה קָרִיב לֵיה לקַבָלָא צלֹותֵיה בעִידָן עָקתֵיה כַיוי אַלָהַנָא בכֹל עִידָן דַאַנַחנָא מצַלַן קדָמֹוהִי
וֻמַן עַם רַב דלֵיה קִיָמִיןקיָמִין ודִינִין קַשִׁיטִין ככֹל אֹורָיתָא הָדָא דַאַנָא יָהֵיב קדָמֵיכֹוןקוּדָמֵיכֹון יֹומָא דֵין
לחֹוד אִסתַמַראִסתמַר לָך וטַר נַפשָׁך לַחדָא דִלמָא תִתנשֵׁי יָת פִתגָמַיָא דַחזַאָה עֵינָך ודִלמָא יעִידֹון מִלִבָך כֹל יֹומֵי חַייָך וֻתהֹודַעִינוּן לִבנָך ולִבנֵי בנָך
יֹומָא דקַמתָא קדָם יוי אַלָהָך בחֹורֵב כַד אַמַר יוי לִי כנֹושׁאכנישׁ קדָמַי יָת עַמָא ואַשׁמַעִינוּן יָת פִתגָמַי דיֵילפוּן למִדחַל קדָמַי כֹל יֹומַיָא דאִנוּן קַייָמִין עַל ארעא ויָת בנֵיהֹון יַלפֹוןיאלפון
וֻקרֵיבתוּן וקַמתוּן בשִׁפֹולֵי טוּרָא וטוּרָא בָעַר באִישָׁתָא עַד צֵית שׁמַיָא חַשֹׁוכָא עַנָנָא וַאַמִיטתָא
וֻמַלֵיל יוי עִמכֹון מִגֹו אִישָׁתָא קָל פִתגָמִין אַתוּן שָׁמעִין וֻדמוּ לֵיתֵיכֹון חָזַן אַלָהֵין קָלָא
וחַוִי לכֹון יָת קִיָמֵיהקיָמֵיה דפַקֵיד יָתכֹון למַעַבַד עַסרָה פִתגָמִין וֻכתַבִינוּן עַל תרֵין לוּחֵי אַבנַיָא
ויָתִי פַקֵיד יוי בעִדָנָא הַהוּא לאַלָפָא יָתכֹון קִיָמִיןקיָמִין ודִינִין למַעַבַדכֹון יָתהֹון בארעא דאַתוּן עָברִין לתַמָן למֵירתַה
ותִסתַמרוּןותסטמרון לַחדָא לנַפשָׁתכֹון אַרֵי לָא חַזֵיתֹון כֹל דמוּ ביֹומָא דמַלֵיל יוי עִמכֹון בחֹורֵב מִגֹו אִישָׁתָא
דִלמָא תחַבלוּן ותַעבדוּן לכֹון צַלמָאצילמא דמוּת כֹל צוּרָא דמוּת דכַר אֹו נוּקבָא
דמוּת כֹל בעִירָא דִבאַרעָא דמוּת כֹל צִיפַר גַפָאגדפא דפָרַח דתיעוף באַוֵיר רקִיַע שׁמַיָא
דמוּת כֹל רִחשָׁא דבארעא דמוּת כֹל נוּנֵי דִבמַיָא מִלרַע לארעא
ודִלמָא תִזקֹוףתִזקוּף עֵינָך לִשׁמַיָא ותִחזֵי יָת שִׁמשָׁא ויָת סֵיהַרָא ויָת כֹוכבַיָא כֹל חֵילֵי שׁמַיָא ותִטעֵי ותִסגֹוד להֹון ותִפלַחִינִין דזָמֵין יוי אַלָהָך יָתהֹון לכֹל עַממַיָא דִתחֹות כָל שׁמַיָא
ויָתכֹון קָרֵיב יוי לדַחלתֵיה ואַפֵיק יָתכֹון מִכוּרָא דבַרזלָאדפרזלא ממצרים למִהוֵי לֵיה לעַם אַחסָנָא כיֹומָא הָדֵין
וֻמִן קדם יוי הַוָה רגַז עַלַי עַל פִתגָמֵיכֹון וקַיֵים בדִיל דלָא למִעברִי יָת יַרדנָא וֻבדִיל דלָא למֵיעַל לארעא טָבתָא דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא
אַרֵי אַנָא מָאִית בארעא הָדָא לֵית אַנָא עָבַר יָת יַרדנָא ואַתוּן עָברִין ותֵירתוּן יָת ארעא טָבתָא הָדָא
אִסתמַרוּאיסטמרו לכֹון דִלמָא תִתנשֹׁוןתנשׁון יָת דַחַלתָאקִיָמָא דַיוי אַלָהַכֹון דִגזַר עִמכֹון ותַעבדוּן לכֹון צַלַםצֵילַם דמוּת כֹולָא דפַקדָך יוי אַלָהָך
אַרֵי יוי אַלָהָך מֵימרֵיה אִישָׁא אָכלָא הוּא אֵל קַנָא
אַרֵי תֵילדוּןתולדון בנִין וֻבנֵי בנִין ותִתעַתקוּן בארעא וֻתחַבלוּן ותַעבדוּן צַלַםצֵילַם דמוּת כֹולָא ותַעבדוּן דבִישׁ קדם יוי אַלָהָך לאַרגָזָא קדָמֹוהִי
אַסהֵידִית בכֹון יֹומָא דֵין יָת שׁמַיָא ויָת אַרעָא אַרֵי מֵיבָד תֵיבדוּן בִפרִיַע מֵעַל ארעא דאַתוּן עָברִין יָת יַרדנָא לתַמָן למֵירתַה לָא תֵירכוּןתורכון יֹומִין עַלַה אַרֵי אִשׁתֵיצָאָה תִשׁתֵיצֹון
וִיבַדַר יוי יָתכֹון בֵינֵי עַממַיָא ותִשׁתאַרוּן עַם דמִניָן בעַממַיָא דִידַבַרדאגלי יוי יָתכֹון לתַמָן
ותִפלחוּן תַמָן לעַממַיָא פָלחֵי טָעַוָתָא עֹובָד ידֵי אַנָשָׁא אָעָא ואַבנָא דלָא חָזַן ולָא שָׁמעִין ולָא אָכלִין ולָא מרִיחִין
ותִתבַע מִתַמָן יָת דַחַלתָא דַיוי אַלָהָך ותַשׁכַח אַרֵי תִבעֵיתתבע מִן קדָמֹוהִי בכֹל לִיבָך וֻבכָל נַפשָׁך
כַד תֵיעֹוק לָך ויַשׁכחוּנָךויערעונך כֹל פִתגָמַיָא הָאִלֵין בסֹוף יֹומַיָא ותתוּב לדַחַלתָאלדַחלתָא דַיוי אַלָהָך וֻתקַבֵיל למֵימרֵיה
אַרֵי אַלָהָא רַחמָנָא יוי אַלָהָך לא יִשׁבקֵינָךירטשׁינך ולָא יחַבלִינָך ולָא יִתנשֵׁיינשׁי יָת קִיָמָאקיָמָא דַאַבָהָתָך דקַיֵים להֹון
אַרֵי שׁאַל כעַן ליֹומַיָא קַדמָאֵי דַהוֹו קדָמָך למִן יֹומָא דִברָא יוי אָדָם עַל ארעא וֻלמִסִיָפֵי שׁמַיָא ועַד סִיָפֵיסיָפֵי שׁמַיָא הַהַוָה כפִתגָמָא רַבָא הָדֵין אֹו הַאִשׁתמָע דִכוָתֵיה
הַשׁמַע עַמָא קָל מֵימרָא דַיוי דִמַלֵיל מִגֹו אִישָׁתָא כמָא דִשׁמַעתָא אַת ואִתקַיַים
אֹו נִסִין עַבַד יוי לאִתגלָאָה למִפרַק לֵיה עַם מִגֹו עַם בנִסִין באָתִין וֻבמֹופתִין ובִקרָבָא וֻבִידָא תַקִיפתָא וֻבִדרָעָא מרָממָא וֻבחִזָנִיןוֻבחַזוָנִין רַברבִין ככֹל דַעַבַד לכֹון יוי אַלָהַכֹון במצרים לעֵינֵיכֹון
אַת אִתחַזִיתָאאִתַחזִיתָא למִידַע אַרֵי יוי הוּא אַלֹהִים לֵית עֹוד בָר מִנֵיה
מִן שׁמַיָא אַשׁמעָך יָת קָל מֵימרֵיה לאַלָפוּתָך ועַל ארעא אַחזִיָך יָת אִישָׁתֵיה רַבתָא וֻפִתגָמֹוהִי שׁמַעתָא מִגֹו אִישָׁתָא
וֻחלָף אַרֵי רָחֵים יָת אַבָהָתָך ואִתרעִי בִבנֵיהֹון בָתרֵיהֹון ואַפקָך במֵימרֵיה בחֵילֵיה רַבָא מִמִצרָיִם
לתָרָכָא עַממִין רַברבִין ותַקִיפִין מִינָך מִן קדָמָך לאַעָלוּתָך למִתַן לָך יָת אַרַעהֹון אַחסָנָא כיֹומָא הָדֵין
ותִידַע יֹומָא דֵין ותָתֵיב ללִיבָך אַרֵי יוי הוּא אַלֹהִים דִשׁכִינתֵיה בִשׁמַיָא מִלעֵילָא ושַׁלִיט עַל ארעא מִלרַע לֵית עֹוד
ותִיטַר יָת קיָמֹוהִיקִיָמֹוהִי ויָת פִקֹודֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין דיִיטַב לָך ולִבנָך בָתרָך וֻבדִיל דתֹורֵיךדתאריך יֹומִין עַל ארעא דַיוי אַלָהָך יָהֵיב לָך כֹל יֹומַיָא
בכֵין אַפרֵישׁ מֹשַׁה תלָת קִרוִין בעִברָא דיַרדנָא מַדנַח שִׁמשָׁא
למִיעִירַקלמערוק לתַמָן קָטֹולָא דיִקטֹול יָת חַברֵיה בלָא מַדעֵיה והוּא לָא סָנֵישׂנא לֵיה מֵאִתמָלִי וֻמִדקַמֹוהִיומדקדמוהי ויִעִירֹוק לַחדָא מִן קִרוַיָא הָאִלֵין ויִתקַיַים
יָת בַצַר במַדברָא באַרַע מֵישׁרָא לשֵׁיבַט ראוּבֵן ויָת רָאמֹות בגִלעָד לשֵׁיבַט גָד ויָת גֹולָן במַתנַן לשִׁבטָא דמנשׁה
ודָא אֹורָיתָא דִסדַרדסַדַר מֹשַׁה קדָם בנֵי יִשׁרָאֵל
אִלֵין סָהִדוָתָא וֻקיָמַיָא ודִינַיָא דמַלֵיל מֹשַׁה עִם בנֵי ישׁראל במִפַקהֹון מִמִצרָיִם
בעִברָא דיַרדנָא בחִילתָא לִקבֵיללָקבֵיל בֵית פעֹור בארַעבאַרַע סִיחֹון מַלכָא אמֹורָאָה דיָתֵיב בחַשׁבֹון דִמחָאדקטל מֹשַׁה וֻבנֵי ישׁראל במִפַקהֹון מִמִצרָיִם
וִירִיתוּ יָת אַרעֵיה ויָת אַרַע עֹוג מַלכָא דמַתנַן תרֵין מַלכֵי אַמֹורָאָה דִבעִברָא דיַרדנָא מַדנַח שִׁמשָׁא
מֵעַרֹועֵר דעַל כֵיף נַחלָא דאַרנֹון ועַד טוּרָא דסִאֹון הוּא חַרמֹון
וכֹל מֵישׁרָא עִברָא דיַרדנָא מַדִנחָאמַדנחָא ועַד יַמָא דמֵישׁרָא תחֹות מַשׁפַךמִשׁפַך מֵירָמתָא
וֻקרָא מֹשַׁה לכֹל יִשׁרָאֵל וַאַמַר להֹון שׁמַע ישׁראל יָת קִיָמַיָאקיָמַיָא ויָת דִינַיָא דַאַנָא ממַלֵיל קדָמֵיכֹוןבאֻדנֵיכֹון יֹומָא דֵין ותֵילפוּן יָתהֹון ותִיטרוּן למַעַבַדהֹון
יוי אַלָהַנָא גָזַרגזַר עִמַנָא קִיָםקיָם בחֹורֵב
לָא עִםיָת אַבָהָתַנָא גזַר יוי יָת קִיָמַיָאקיָמָא הָדֵיןהדא אַלָהֵיןאלא עִמַנָא אַנַחנָא אִלֵין כָאהכא יֹומָא דֵין כוּלַנָא קַייָמִין
מַמלַל עִם מַמלַל מַלֵיל יוי עִמכֹון בטוּרָא מִיגֹו אִישָׁתָא
אַנָא הַוֵיתִי קָאֵים בֵין מֵימרָא דַיוי וֻבֵינֵיכֹון בעִדָנָא הַהוּא לחַוָאָה לכֹון יָת פִתגָמַיָא דַיוי אַרֵי דחֵילתוּן מִן קדָם אִישָׁתָא ולָא סלֵיקתוּן בטוּרָא למֵימַר
אַנָא יוי אַלָהָך דאַפֵיקתָך מארעא דמצרים מִבֵית עַבדוּתָא
לָא יִהוֵי לָך אַלָה אָחָרָןאֻחרָן בָר מִנִי
לָא תַעַבֵיד לָך צַלַםצֵילַם כֹל דמוּ דבִשׁמַיָא מִלעֵילָא ודִבאַרעָא מִלרַע ודִבמַיָא מִלרַע לאַרעָא
לָא תִסגֹוד להֹון ולָא תִפלַחִינִין אַרֵי אַנָא יוי אַלָהָך אֵל קַנָא מַסעַר חֹובֵי אַבָהָן עַל בנִין מָרָדִין עַל דָר תלִיתַי ועַל דָר רבִיעַי לשָׁנאַילסָנאָי כַד מַשׁלמִין בנַיָא למִחטֵי בָתַר אַבָהָתהֹון
ועָבֵיד טֵיבוּ לאַלפֵי דָרִין לרָחַמַי וֻלנָטרֵי פִקֹודָי
לָא תֹומֵיתֵימֵי בִשׁמַא דַיוי אַלָהָך למַגָנָא אַרֵי לָא יזַכֵי יוי יָת דיֹומֵי בִשׁמֵיה לשִׁקרָא
טַר יָת יֹומָא דשַׁבתָא לקַדָשׁוּתֵיה כמָא דפַקדָך יוי אַלָהָך
שִׁיתָא יֹומִין תִפלַח ותַעַבֵיד כֹל עִבִידתָך
ויֹומָא שׁבִיעָאָה שַׁבתָא קדָם יוי אַלָהָך לָא תַעַבֵיד כֹל עַבִידָא אַת וֻברָך וֻברַתָך ועַבדָך ואַמתָך ותֹורָך וֻחמָרָך וכֹל בעִירָך וגִיֹורָך דִבקִרוָך בדִיל דִינוּחַ עַבדָך ואַמתָך כוָתָך
ותִדכַר אַרֵי עַבדָא הַוֵיתָא בארעא דמִצרַיִם ואַפקָך יוי אַלָהָך מִיתַמָן ביַד תַקִיפָא וֻבִדרָע מרָמַם עַל כֵין פַקדָך יוי אַלָהָך למַעַבַד יָת יֹומָא דשַׁבתָא
יַקַר יָת אַבוּך ויָת אִימָך כמָא דפַקדָך יוי אַלָהָך בדִיל דיֵירכוּןדיורכון יֹומָך וֻבדִיל דיִיטַבדיוטיב לָך עַל אַרעָא דַיוי אַלָהָך יָהֵיב לָך
לָא תִקטֹולתִקטוּל נפַשׁ
ולָא תגוּף
ולָא תִגנוּב נפשׁא
ולָא תַסהֵיד בחַברָך סָהַדוּתָא דשִׁקרָא סהיד שׁקר
ולָא תַחמֵידתחַמֵיד איתַת חַברָך ולָא תִירֹוג בֵית חַברָך חַקלֵיה ועַבדֵיה ואַמתֵיה תֹורֵיה וֻחמָרֵיה וכֹל דִלחַברָך
יָת פִתגָמַיָא הָאִלֵין מַלֵיל יוי עִם כֹל קהַלכֹון בטוּרָא מִגֹו אִישָׁתָא עַנָנָא וַאַמִטתָא קָל רַב ולָא פָסִיק וֻכתַבִינוּן עַל תרֵין לוּחֵי אַבנַיָא וִיהַבִינוּן לִי
וַהַוָה כמִשׁמַעכֹוןכשׁמעכון יָת קָלָא מִגֹו חַשֹׁוכָא וטוּרָא בָעַר באִישָׁתָא וֻקרֵיבתוּןוֻקרַבתוּן לוָתִי כֹל רֵישֵׁי שִׁבטֵיכֹון וסָבֵיכֹון
וַאַמַרתוּן הָא אַחזִיַנָא יוי אַלָהַנָא יָת יקָרֵיה ויָת רבוּתֵיה ויָת קָל מֵימרֵיה שׁמַענָא מִגֹו אִישָׁתָא יֹומָא הָדֵיןדין חַזֵינָא אַרֵי ממַלֵיל יוי עִם אַנָשָׁא ויִתקַיַים
וֻכעַן למָא נמוּת אַרֵי תֵיכלִינַנָא אִישָׁתָא רַבתָא הָדָא אִם מֹוספִין אַנַחנָא למִשׁמַע יָת קָל מֵימרָא דַיוי אַלָהַנָא עֹוד מָיתִיןוממיתין אַנַחנָא
אַרֵי מַן כֹל בִסרָא דשָׁמַע קָל מֵימרָא דַיוי קַיָימָא דִממַלֵיל מִגֹו אִישָׁתָא כוָתַנָא ואִתקַיַים
קרַב אַת וֻשׁמַעותקבל יָת כֹל דיֵימַר יוי אַלָהַנָא ואַת תמַלֵיל עִמַנָא יָת כֹל דִמַלֵיל יוי אַלָהַנָא עִמָך וֻנקַבֵיל ונַעַבֵיד
וֻשׁמִיַע קדם יוי יָת קָל פִתגָמֵיכֹון במַלָלוּתכֹון עִמִי וַאַמַר יוי לִי שׁמִיַע קדָמַי יָת קָל פִתגָמֵי עַמָא הָדֵין דמַלִילוּ עִמָך אַתקִינוּ כֹל דמַלִילוּ
לוֵי דִיהֵי לִיבָא הָדֵין להֹון למִדחַל קדָמַייתי וֻלמִיטַר יָת כֹל פִקֹודַי כֹל יֹומַיָא בדִיל דיִיטַבדיוטיב להֹון ולִבנֵיהֹון לעָלַם
אִיזֵיל אֵימַר להֹון תוּבוּ לכֹון למַשׁכנֵיכֹון
ואַת הָכָא קוּם קדָמַי וַאַמַלֵיל עִמָך יָת כֹל תַפקֵידתָא וֻקיָמַיָא ודִינַיָא דתַלֵיפִינוּן ויַעבדוּן בארעא דַאַנָא יָהֵיב להֹון למֵירתַה
ותִיטרוּן למַעַבַד כמָא דפַקֵיד יוי אַלָהַכֹון יָתכֹון לָא תִסטֹון ליַמִינָא ולִסמָלָא
בכֹל אֹורחָא דפַקֵיד יוי אַלָהַכֹון יָתכֹון תהָכוּן בדִיל דתֵיחֹון ויִיטַבויוטיב לכֹון ותֵירכוּןותורכון יֹומִין בארעא דתֵירתוּןדתחסנון
ודָא תַפקֵידתָא קיָמַיָאקִיָמַיָא ודִינַיָא דפַקֵיד יוי אַלָהַכֹון לאַלָפָא יָתכֹון למַעַבַד באַרעָא דאַתוּן עָברִין לתַמָן למֵירתַה
בדִיל דתִדחַל קדםית יוי אַלָהָך למִיטַר יָת כֹל קיָמֹוהִיקִיָמֹוהִי ופִקֹודֹוהִי דַאַנָא מפַקֵיד לָך אַת וֻברָך וֻבַר ברָך כֹל יֹומֵי חַייָך וֻבדִיל דיֵירכוּןדיורכוןדיסגון יֹומָך
וֻתקַבֵיל ישׁראל ותִיטַר למַעַבַד דיִיטַבדיוטב לָך וֻדתִסגֹון לַחדָא כמָא דמַלֵיל יוי אַלָהָא דַאַבָהָתָך לָך אַרַע עָבדָא חַלָב וֻדבָשׁ
שׁמַעקביל ישׁראל יוי אַלָהַנָא יוי חַד
ותִרחַם יָת יוי אַלָהָך בכֹל לִיבָך וֻבכָל נַפשָׁך וֻבכָל נִכסָך
וִיהֹון פִתגָמַיָא הָאֵלִין דַאַנָא מפַקֵיד לָך יֹומָא דֵין עַל לִיבָך
ותתַנֵינוּן לִבנָך וֻתמַלֵיל בהֹון במִתבָך בבֵיתָך וֻבִמהָכָך באֹורחָא וֻבמִשׁכבָךובשׁכבך ובִמקִימָך
ותִקטַרִינוּן לאָת עַל ידָך וִיהֹון לִתפִלִין בֵין עֵינָך
ותִכתֹובִינוּן עַל מזֹוזיָן ותקבַעִינוּן בסִיפֵי בֵיתָך וֻבתַרעָך
וִיהֵי אַרֵי יַעֵילִינָך יוי אַלָהָך לארעא דקַיֵים לַאַבָהָתָך לאברהם ליצחק וליעקב למִיתַן לָך קִרוִין רַברבָן וטָבָן דלָא בנֵיתָא
וֻבָתִין מלַן כֹל טוּב דלָא מלֵיתָא וגוּבִין פסִילַןפסילין דלָא פסַלתָא כַרמִין וזֵיתִין דלָא נצַבתָא ותֵיכֹול ותִסבַע
אִסתַמַראִסתמַר לָך דִלמָא תִתנשֵׁי יָת דַחלתָא דַיוי דאַפקָך מארעא דמצרים מִבֵית עַבדוּתָא
יָת יוי אָלהָך תִדחַל וֻקדָמֹוהִי תִפלַח וֻבִשׁמֵיה תקַיֵים
לָא תהָכוּן בָתַר טָעַוָת עַממַיָא מִטָעַוָת עַממַיָא דִבסַחרָנֵיכֹוןדי בסחרוניכון
אַרֵי אֵלאלהא קַנָא יוי אַלָהָך שׁכִינתֵיה בֵינָך דִלמָא יִתקַףיתקוף רוּגזָא דַיוי אַלָהָך בָך וִישֵׁיצֵינָך מֵעַל אַפֵי אַרעָא
לָא תנַסֹון קדםית יוי אַלָהַכֹון כמָא דנִסֵיתֹון בנִיסֵיתָא
מִיטַר תִיטרוּן יָת פִיקֹודַיָא דַיוי אַלָהַכֹון וסָהִדוָתֵיה וֻקיָמֹוהִי דפַקדָך
ותַעַבֵיד דכָשַׁר וֻדתָקֵין קדם יוי בדִיל דיִיטַבדיוטב לָך ותֵיעֹול ותֵירַת יָת ארעא טָבתָא דקַיֵים יוי לַאַבָהָתָך
למִתבַר יָת כֹל בַעַלֵי דבָבָך מִן קדָמָך כמָא דמַלֵיל יוי
אַרֵי יִשׁאַלִינָך ברָך מחַר למֵימַר מָא סָהִדוָתָא וֻקיָמַיָא ודִינַיָא דפַקֵיד יוי אַלָהַנָא יָתכֹון
ותֵימַר לִברָך עַבדִין הַוֵינָא לפַרעֹה במִצרָיִם ואַפקַנָא יוי ממצרים ביַד תקִיפָא
וִיהַב יוי אָתִין וֻמֹופתִין רַברבִין וֻבִישִׁין במִצרַיִם בפַרעֹה וֻבכָל אַנָשׁ בֵיתֵיה לעֵינַנָא
ויָתַנָא אַפֵיק מִתַמָן בדִיל לאַעָלָא יָתַנָא למִתַן לַנָא יָת ארעא דקַיֵים לַאַבָהָתַנָא
וֻפַקדַנָא יוי למַעַבַד יָת כֹל קִיָמַיָאקיָמַיָא הָאִלֵין למִדחַל קדםית יוי אַלָהַנָא דיִיטַבלמיטב לַנָא כֹל יֹומַיָא לקַיָמוּתַנָא כיֹומָא הָדֵין
וזָכוּתָא תהֵי לַנָא אַרֵי נִיטַר למַעַבַד יָת כֹל תַפקֵידתָא הָדָא קדם יוי אַלָהַנָא כמָא דפַקדַנָא
אַרֵי יַעֵילִינָך יוי אַלָהָך לארעא דאַת עָלֵיל לתַמָן למֵירתַה וִיתָרֵיך עַממִין סַגִיאִין מִן קדָמָך חִתָאֵי וגַרגִישָׁאֵי וַאַמֹורָאֵי וֻכנַעַנָאֵי וֻפרִיזָאֵי וחִיוָאֵי וִיבוּסָאֵי שִׁבעָה עַממִין סַגִיאִין ותַקִיפִין מִנָך
ויִמסַרִינוּן יוי אַלָהָך קדָמָך ותִמחֵינוּן גַמָרָא תגַמַר יָתהֹון לָא תִגזַר להֹון קיָםקִיָם ולָא תרַחֵים עַלֵיהֹון
ולָא תִתחַתֵןתִתחַתַן בהֹון ברַתָך לָא תִתֵין לִברֵיה וֻברַתֵיה לָא תִסַב לִברָך
אַרֵי יַטעַיָןיַטעיָין יָת בנָך מִבָתַר דַחַלתִי ויִפלחוּן לטָעַוָת עַממַיָא ויִתקַףויתקיף רוּגזָא דַיוי בכֹון וִישֵׁיצֵינָך בִפרִיַע
אַרֵי אִם כדֵין תַעבדוּן להֹון אֵיגֹורֵיהֹון תתָרעוּן וקָמָתהֹון תתַברוּן וַאַשֵׁירֵיהֹון תקָצצוּןתקוצצון וצַלמֵיהֹוןוצִלמֵיהֹון תֹוקדוּןתֵיקדוּן בנוּרָא
אַרֵי עַם קַדִישׁ אַת קדָם יוי אַלָהָך בָך אִתרעִי יוי אַלָהָך למִהוֵי לֵיה לעַם חַבִיב מִכֹל עַממַיָא דעַל אַפֵי ארעא
לָא מִדסַגִיאִין אַתוּן מִכֹל עַממַיָא צָבֵיצבִי יוי בכֹון ואִתרעִי בכֹון אַרֵי אַתוּן זעֵירִין מִכֹל עַממַיָא
אַרֵי מִדרָחֵים יוי יָתכֹון וֻמִדנָטַר יָת קִיָמָאקיָמָא דקַיֵים לַאַבָהָתכֹון אַפֵיק יוי יָתכֹון ביַד תַקִיפָא וֻפַרקָך מִבֵית עַבדוּתָא מִידָא דפרעה מַלכָא דמצרים
ותִידַע אַרֵי יוי אַלָהָך הוּא אַלֹהִים אַלָהָא מהֵימנָא נָטַר קִיָמָאקיָמָא וחִסדָא לרָחַמֹוהִי וֻלנָטרֵי פִקֹודֹוהִי לאַלַף דָרִין
וֻמשַׁלֵיםוֻמשַׁלַם לסָנאֹוהִי טָבוָןטבן דִאִינוּן עָבדִין קדָמֹוהִי בחַיֵיהֹון לאֹובֵידֵיהֹוןלאֵיבֹודֵיהֹון לָא מאַחַר עֹובָד טָב לסָנאֹוהִי טָבוָןטבן דאִינוּן עָבדִין קדָמֹוהִי בחַיֵיהֹון משַׁלֵיםמשַׁלַם להֹון
ותִיטַר יָת תַפקֵידתָא ויָת קִיָמַיָאקיָמַיָא ויָת דִינַיָא דַאַנָא מפַקֵיד לָך יֹומָא דֵין למַעַבַדהֹון
וִיהֵי חַלָף דִתקַבלוּן יָת דִינַיָא הָאִלֵין ותִיטרוּן ותַעבדוּן יָתהֹון ויִטַר יוי אַלָהָך יָת קִיָמָאקיָמָא ויָת חִסדָא דקַיֵים לַאַבָהָתָך
ויִרחַמִינָך וִיבָרכִינָך ויַסגֵינָך וִיבָרֵיך וַלדָא דִמעָך ואִיבָא דאַרעָך עִיבוּרָךעבוּרָך וחַמרָך וֻמִשׁחָך בַקרֵי תֹורָך ועַדרֵי עָנָך עַל ארעא דקַיֵים לאַבָהָתָך למִיתַן לָך
ברִיך תהֵי מִכֹל עַממַיָא לָא יהֵי בָך עַקַרעקַר ועַקרָא וֻבִבעִירָך
ויַעַדֵי יוי מִינָך כֹל מַרעִין וכֹל מַכתָשֵׁי מִצרַיִם בִישַׁיָא דִידַעתָא לָא ישַׁוֵינוּן בָך ויִתֵינֵינוּן בכָל סָנאָך
וֻתגַמַר יָת כֹל עַממַיָא דַיוי אַלָהָך יָהֵיב לָך לָא תחוּס עֵינָך עַלֵיהֹון ולָא תִפלַח יָת טָעַוָתהֹון אַרֵי לתַקלָא יהֹון לָך
אַרֵידילמא תֵימַר בלִיבָך סַגִיאִין עַממַיָא הָאִלֵין מִנִי אֵיכדֵין אִיכֹול לתָרָכוּתהֹון
לָא תִדחַל מִנהֹון אִידכָרָאמִדכָר תִדכַר יָת דַעַבַד יוי אַלָהָך לפַרעֹה וֻלכָל מִצרָאֵי
נִסִין רַברבָןרַברבִין דַחזַאָה עֵינָך ואָתַיָא וֻמֹופתַיָא וִידָא תַקִיפתָא וֻדרָעָא מרָממָאמרממתא דאַפקָךדפקדך יוי אַלָהָך כֵין יַעַבֵיד יוי אַלָהָך לכֹל עַממַיָא דאַת דחֵיל מִן קדָמֵיהֹון
ואַף יָת עָרָעִיתָא יגָרֵי יוי אַלָהָך בהֹון עַד דיֵיבדוּן דאִשׁתאַרוּ וֻדאִיטמַרוּ מִן קדָמָך
לָא תִיתבַר מִן קדָמֵיהֹון אַרֵי יוי אַלָהָך שׁכִינתֵיה בֵינָך אַלָהָא רַבָא וֻדחִילָא
וִיתָרֵיך יוי אַלָהָך יָת עַממַיָא הָאִלֵין מִן קדָמָך זעֵיר זעֵיר לָא תִיכֹול לשֵׁיצָיוּתהֹון בִפרִיַע דִלמָא תִסגֵי עַלָך חַיַתחיות בָרָא
ויִמסַרִינוּן יוי אַלָהָך קדָמָך וִישַׁגֵישִׁינוּן שִׁיגוּשׁ רַב עַד דיִשׁתיֵצֹון
ויִמסַר מַלכֵיהֹון בִידָך ותֹובֵיד יָת שֹׁמהֹוןשׁוּמהֹון מִתחֹות שׁמַיָא לָא יִתעַתַד אַנָשׁ קדָמָך עַד דִתשֵׁיצֵי יָתהֹון
צַלמֵיצילמי טָעַוָתהֹון תֹוקדוּןתֵיקדוּן בנוּרָא לָא תַחמֵידתחַמֵיד כַספָא ודַהבָא דַעַלֵיהֹון ותִסַב לָך דִלמָא תִיתקֵילתִתַקֵיל בֵיה אַרֵי מרַחַקמרֻחַק קדם יוי אַלָהָך הוּא
ולָא תַעֵיל דִמרַחַקדִמרֻחַק לבֵיתָך וֻתהֵי חִרמָאחַרמָא כוָתֵיה שַׁקָצָא תשַׁקצִינֵיה ורַחָקָא תרַחַקִיהֵיה אַרֵי חִרמָאחַרמָא הוּא
כֹל תַפקֵידתָא דַאַנָא מפַקֵיד לָך יֹומָא דֵין תִיטרוּן למַעַבַד בדִיל דתֵיחֹון ותִסגֹון ותֵיעַלוּן ותֵירתוּן יָת ארעא דקַיֵים יוי לַאַבָהָתכֹון
ותִדכַר יָת כֹל אֹורחָא דדַברָך יוי אַלָהָך דנָן אַרבעִין שׁנִין במַדברָא בדִיל לעַנָיוּתָך לנַסָיוּתָך למִידַע יָת דִבלִבָך הַתִיטַר פִקֹודֹוהִי אִם לָא
ועַניָך ואַכפנָך ואֹוכלָך יָת מַנָא דלָא ידַעתָא ולָא ידַעוּ אַבָהָתָך בדִיל להֹודָעוּתָךלאודעותך אַרֵי לָא עַל לַחמָא בִלחֹודֹוהִי מִתקַייַם אַנָשָׁא אַרֵי עַל כֹל אַפָקוּת מֵימַר מִן קדָם יוי חָיֵיחַיֵי אַנָשָׁא
כסוּתָך לָא בלִיאַת מִינָך וֻמסָנָך לָא יחִיפוּ דנָן אַרבעִין שׁנִין
ותִידַע עִם לִיבָךלבבך אַרֵי כמָא דמַלֵיף גַברָאגֻברָא יָת ברֵיה יוי אַלָהָך מַלֵיף לָך
ותִיטַר יָת פִיקֹודַיָא דַיוי אַלָהָך לִמהָךלמיזל באֹורחָן דתַקנָן קדָמֹוהִי וֻלמִדחַל יָתֵיה
אַרֵי יוי אַלָהָך מַעֵיל לָך לַאַרַע טָבתָאטבא אַרעאַרַע נָגדָא נַחלִין דמַיִין מַבוּעֵי עֵינָוָן וֻתהֹומִין נָפקִין בִבִקעָןבבַקעָן וֻבטוּרִין
אַרַע חִיטִין וֻסעָרִין וגוּפנִין ותֵינִיןותאינין ורִימֹונִין ארעא דזֵיתַהָא עָבדִין מִשׁחָא והִיא עָבדָא דבַשׁ
ארעא דלָא במִסכֵינוּ תֵיכֹולתאכול בַה לַחמָא לָא תַחסַר כֹל מִדָעַם בַה ארעא דאַבנַהָא בַרזלָאפרזלא וֻמִטוּרַהָא תִפסֹול נחָשָׁא
ותֵיכֹול ותִסבַע וֻתבָרֵיך ית יוי אַלָהָך עַל ארעא טָבתָא דִיהַב לָך
אִסתַמַראִסתמַר לָך דִלמָא תִתנשֵׁיתינשׁי יָת דַחַלתָאדַחלתָא דַיוי אַלָהָך בדִיל דלָא למִיטַר פִקֹודֹוהִי ודִינֹוהִי וֻקיָמֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין
דִילמָא תֵיכֹול ותִסבַע וֻבָתִין שַׁפִירִין תִבנֵי ותִיתֵיב
ותֹורָך ועָנָך יִסגֹון וכַספָא ודַהבָא יִסגֵי לָך וכֹל דלָך יִסגֵי
ויִירַםויתקף לִיבָך ותִתנשֵׁיותינשׁי יָת דַחַלתָאדַחלתָא דַיוי אַלָהָך דאַפקָך מארעא דמצרים מִבֵית עַבדוּתָא
דדַברָך במַדברָא רַבָא וֻדחִילָא אַתַר דחִיָווָןדחוין קָלַן ועַקרַבִין וֻבֵית צַהוָנָא אַתַר דלֵית מַיָא דאַפֵיק לָך מַיָא מִטִנָרָא תַקִיפָא
דאֹוכלָך מַנָא במַדברָא דלָא ידַעוּ אַבָהָתָך וֻבדִיל לעַנָיוּתָך וֻבדִיל לנַסָיוּתָך לאֵיטָבָאלאֹוטָבָא לָך בסֹופָך
ותֵימַר בלִיבָך חֵילִי וֻתקֹוף ידַי קנֹוכנשׁ לִי יָת נִכסַיָא הָאִלֵין
ותִדכַר יָת יוי אַלָהָך אַרֵי הוּא יָהֵיב בָך עֵיצָאחילא למִקנֵי נִכסִין בדִיל לקַיָימָאלאקמא יָת קִיָמֵיהקיָמֵיה דקַיֵים לַאַבָהָתָך כיֹומָא הָדֵין
וִיהֵי אִם אִתנשָׁאָה תִתנשֵׁי מנשׁא תנשׁי יָת דַחלתָא דַיוי אַלָהָך וֻתהָך בָתַר טָעַוָת עַממַיָא ותִפלחִינוּן ותִסגֹוד להֹון אַסהֵידִית בכֹון יֹומָא דֵין אַרֵי מֵיבָד תֵיבדוּן
כעַממַיָא דַיוי מֹובֵיד מִן קדָמֵיכֹון כֵין תֵיבדוּןתובדון חַלָף דלָא קַבֵילתוּן למֵימרָא דַיוי אַלָהַכֹון
שׁמַע ישׁראל אַת עָבַר יֹומָא דֵין יָת יַרדנָא למֵיעַל למֵירַתלתרכא עַממִין רַברבִין ותַקִיפִין מִנָך קִרוִין רַברבָןרברבין וֻכרִיכָן עַד צֵית שׁמַיָא
עַם רַב ותַקִיף בנֵי גִיבָרַיָאענק דאַת ידַעתָ ואַת שׁמַעתָא מַן יִכֹול לִמקָם קדָם בנֵי גִיבָרָא
ותִידַע יֹומָא דֵיןהדין אַרֵי יוי אַלָהָך הוּא עָבַר קדָמָך מֵימרֵיה אִישָׁא אָכלָא הוּא ישֵׁיצֵינוּן והָא יתַבַרִינוּןיִתברִינוּן קדָמָך וֻתתָרֵיכִינוּן ותֹובדֵינוּן בִפרִיַע כמָא דמַלֵיל יוי לָך
לָא תֵימַר בלִיבָך בִדיִתבַר יוי אַלָהָך יָתהֹון מִן קדָמָך למֵימַר בזָכוּתִי אַעלַנִיאיתיני יוי למֵירַת יָת ארעא הָדָא וֻבחֹובֵי עַממַיָא הָאֵלִין יוי מתָרֵיך להֹון מִן קדָמָך
לָא בזָכוּתָך וֻבקַשִׁיטוּת לִיבָך אַת עָלֵיל למֵירַת יָת אַרַעהֹון אַרֵי בחֹובֵי עַממַיָא הָאִלֵין יוי אלהך מתָרֵיך להֹון מִן קדָמָך וֻבדִיל לקַייָמָא יָת פִתגָמָא דקַיֵים יוי לאַבָהָתָך לאברהם ליצחק וֻליַעַקֹב
ותִידַע אַרֵי לָא בזָכוּתָך יוי אַלָהָך יָהֵיב לָך יָת ארעא טָבתָא הָדָא למֵירתַה אַרֵי עַם קשֵׁי קדָל אַת
הַוִי דכִיר אידכר לָא תִתנשֵׁיתינשׁי יָת דאַרגֵיזתָא קדם יוי אַלָהָך במַדברָא למִן יֹומָא דִנפַקתָא מארעא דמצרים עַד מֵיתֵיכֹון עַד אַתרָא הָדֵין מסָרבִין הַוֵיתֹון קדם יוי
וֻבחֹורֵב אַרגֵיזתוּן קדם יוי וֻתקֵיף רוּגזָא דַיוי בכֹון לשֵׁיצָאָה יָתכֹון
במִיסקִי לטוּרָא למִסַב לוּחֵי אַבנַיָא לוּחֵי קִיָמָאקיָמָא דִגזַר יוי עִמכֹון וִיתֵיבִית בטוּרָא אַרבעִין ימָמִין ואַרבעִין לֵילָוָן לַחמָא לָא אַכַלִית וֻמַיָא לָא שׁתִיתִיאשׁתיתי
וִיהַב יוי לִי יָת תרֵין לוּחֵי אַבנַיָא כתִיבִין באַצבעָא דַיוי וַעַלֵיהֹון ככֹל פִתגָמַיָא דמַלֵיל יוי עִמכֹון בטוּרָא מִגֹו אִישָׁתָא ביֹומָא דִקהָלָא
וַהַוָה מִסֹוף אַרבעִין ימָמִין ואַרבעִין לֵילָוָן יהַב יוי לִי יָת תרֵין לוּחֵי אַבנַיָא לוּחֵי קִיָמָאקיָמָא
וַאַמַר יוי לִי קוּם חֹות בִפרִיַע מִכָא אַרֵי חַבֵיל עַמָך דאַפֵיקתָא ממצרים סטֹו בִפרִיַע מִן אֹורחָא דפַקֵידתִינוּן עַבָדוּ להֹון מַתכָא
וַאַמַר יוי לִי למֵימַר גלֵי קדָמַי עַמָא הָדֵין והָא עַם קשֵׁי קדָל הוּא
אָנַח בָעוּתָך מִן קדָמַי וַאַשֵׁיצֵינוּן ואִימחֵי יָת שֹׁומהֹוןשׁוּמהֹון מִתחֹות שׁמַיָא ואַעַבֵיד יָתָך לעַם תַקִיף וסַגִי רב ותקיף מִנהֹון
ואִתפנִיתִי וֻנחַתִית מִן טוּרָא וטוּרָא בָעַר באִישָׁתָא וֻתרֵין לוּחֵי קִיָמָאקיָמָא עַל תַרתֵין ידַיידָי
וַחזֵית והָא חַבתוּן קדם יוי אַלָהַכֹון עַבַדתוּן לכֹון עֵיגַל מַתכָא סטֵיתֹון בִפרִיַע מִן אֹורחָא דפַקֵיד יוי יָתכֹון
ואַחַדִית בִתרֵין לַוחַיָא וֻרמֵיתִינוּן מֵעַל תַרתֵין ידַי ותַבַרתִינוּן לעֵינֵיכֹון
ואִשׁתַטַחִית קדם יוי כִיד בקַדמֵיתָא אַרבעִין ימָמִין ואַרבעִין לֵילָוָן לַחמָא לָא אַכַלִית וֻמַיָא לָא שׁתִיתִיאשׁתיתי עַל כֹל חֹובַתכֹון דחַבתוּן למַעַבַד דבִישׁ קדם יוי לאַרגָזָא קדָמֹוהִי
אַרֵי דחֵילִית מִן קדָם רוּגזָא וחִמתָא דִרגַז יוי עַלֵיכֹון לשֵׁיצָאָה יָתכֹון וקַבֵיל יוי צלֹותִי אַף בזִמנָא הַהוּא
ועַל אַהַרֹן הַוָה רגַז מִן קדם יוי לַחדָא לשֵׁיצָיוּתֵיה וצַלִיתִי אַף עַל אַהַרֹן בעִדָנָא הַהוּא
ויָת חֹובַתכֹון דַעַבַדתוּן יָת עִגלָא נסֵיבִית ואֹוקֵידִית יָתֵיה בנוּרָא ושַׁפִית יָתֵיה בשֹׁופִינָא יָאוּת עַד דַהוָה דַקִיק לעַפרָא וֻרמֵית יָת עַפרֵיה לנַחלָא דנָחֵית מִן טוּרָא
וֻבִדלֵיקתָא וֻבנִיסֵיתָאוֻבנַסֵיתָא וֻבקִברֵיוֻבקַברֵי דִמשַׁאַלֵי מַרגזִין הַוֵיתֹון קדם יוי
וכַד שׁלַח יוי יָתכֹון מֵרקַם גֵיאָה למֵימַר סַקוּסֻקוּעוֻלוּ ואַחסִינוּ יָת אַרעָא דִיהַבִית לכֹון וסָרֵיבתוּן עַל מֵימרָא דַיוי אַלָהַכֹון ולָא הֵימֵינתוּן לֵיה ולָא קַבֵילתוּן למֵימרֵיה
מסָרבִין הַוֵיתֹון קדם יוי מִיֹומָא דִידַעִית יָתכֹון
ואִשׁתַטַחִית קדם יוי יָת אַרבעִין ימָמִין ויָת אַרבעִין לֵילָוָן דאִשׁתַטַחִית אַרֵי אַמַר יוי לשֵׁיצָאָה יָתכֹון
וצַלִיתִי קדם יוי וַאַמַרִית יוי אַלֹהִים לָא תחַבֵיל עַמָך ואַחסָנתָך דִפרַקתָא בתוּקפָך דאַפֵיקתָא מִמִצרַים ביַד תַקִיפָא
אִידכַר לעַבדָך לאַברָהָם ליצחק וליעקב לָא תִתפנֵי לקַשָׁיוּת עַמָא הָדֵין וֻלחֹובֵיהֹון ולִחטָאֵיהֹון
דִלמָא יֵימרוּן דָירֵי ארעא דאַפֵיקתַנָא מִתַמָן מִדלֵית יוּכלָא קדם יוי לאַעָלוּתהֹון לארעא דמַלֵיל להֹון וֻמִדסָנֵי יָתהֹון אַפֵיקִינוּן לקַטָלוּתהֹון במַדברָא
ואִנוּן עַמָך ואַחסָנתָך דאַפֵיקתָא בחֵילָך רַבָא וֻבִדרָעָך מרָממָא
בעִדָנָא הַהִיא אַמַר יוי לִי פסֹול לָך תרֵין לוּחֵי אַבנַיָא כקַדמָאֵי וסַק לִקדָמַי לטוּרָא ותַעַבֵיד לָך אַרֹונָא דאָעָא
ואַכתֹוב עַל לוּחַיָא יָת פִתגָמַיָא דַהוֹו עַל לוּחַיָא קַדמָאֵי דתַבַרתָא וֻתשַׁוֵינוּן בַאַרֹונָא
וַעַבַדִית אַרֹונָא דאָעֵי שִׁטִין וֻפסַלִית תרֵין לוּחֵי אַבנַיָא כקַדמָאֵי וֻסלֵיקִית לטוּרָא וֻתרֵין לוּחַיָא בִידִי
וֻכתַב עַל לוּחַיָא כִכתָבָא קַדמָאָה יָת עַסרָא פִתגָמִין דמַלֵיל יוי עִמכֹון בטוּרָא מִגֹו אִישָׁתָא ביֹומָא דִקהָלָא וִיהַבִינוּן יוי לִי
ואִתפנִיתִי וֻנחַתִית מִן טוּרָא ושַׁוִיתִי יָת לוּחַיָא בַאַרֹונָא דַעַבַדִית וַהוֹו תַמָן כמָא דפַקדַנִי יוי
וֻבנֵי ישׁראל נטַלוּ מִבאֵרֹת בנֵי יַעקָן למֹוסֵרָה תַמָן מִית אַהַרֹן ואִתקבַר תַמָן ושַׁמֵישׁ אַלעָזָר ברֵיה תחֹותֹוהִי
מִתַמָן נטַלוּ לגֻדגֹוד וֻמִן גֻדגֹוד ליָטבָת אַרַע נָגדיָאנָגדָא נַחלִין דמַיִן
בעִדָנָא הַהוּא אַפרֵישׁ יוי יָת שִׁבטָא דלֵוִי למִיטַל יָת אַרֹון קִיָמָאקיָמָא דַיוי לִמקָם קדם יוי לשַׁמָשׁוּתֵיה וֻלבָרָכָא בִשׁמֵיה עַד יֹומָא הָדֵין
עַל כֵין לָא הַוָה ללֵוִי חוּלָק ואַחסָנָא עִם אַחֹוהִי יוי הוּא אַחסָנתֵיה כמָא דמַלֵיל יוי אַלָהָך לֵיה
וַאַנָא הַוֵיתִי קָאֵים בטוּרָא כיֹומַיָא קַדמָאֵי אַרבעִין ימָמִין ואַרבעִין לֵילָוָן וקַבֵיל יוי צלֹותִי אַף בזִמנָא הַהוּאהַהִיא לָא אַבָא יוי לחַבָלוּתָך
וַאַמַר יוי לִי קוּם אִיזֵיל למַטוּל קדָם עַמָא ויֵיעַלוּן ויֵירתוּן יָת ארעא דקַיֵימִית לַאַבָהָתהֹון למִיתַן להֹון
וֻכעַן ישׁראל מָא יוי אַלָהָך תָבַע מִנָך אַלָהֵין למִדחַל קדםית יוי אַלָהָך לִמהָך בכֹל אֹורחָן דתָקנָן קדָמֹוהִי וֻלמִרחַם יָתֵיה וֻלמִפלַח קדם יוי אַלָהָך בכֹל לִבָך וֻבכָל נַפשָׁך
למִיטַר יָת פִיקֹודַיָא דַיוי ויָת קיָמֹוהִיקִיָמֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין דיִיטַבדיוטב לָך
הָא דַיוי אַלָהָך שׁמַיָא וֻשׁמֵי שׁמַיָא ארעא וכֹל דבַה
לחֹוד בַאַבָהָתָך צבִיצָבֵי יוי למִרחַם יָתהֹון ואִתרעִי בִבנֵיהֹון בָתרֵיהֹון מִכָל עַממַיָא כיֹומָא הָדֵין
ותִעדֹון יָת טַפשׁוּתטיפשׁות לִבכֹון וֻקדָלכֹון לָא תַקשׁוּן עֹוד
אַרֵי יוי אַלָהַכֹון הוּא אַלָה דַיָנִיןאלהין וֻמָרֵי מַלכִין אַלָהָא רַבָא גִיבָרָא וֻדחִילָא דלֵית קדָמֹוהִי מִסַב אַפִין ואַף לָא לקַבָלָא שׁוּחדָא
עָבֵיד דִין יִתַםיתים ואַרמלָא ורָחֵים גִיֹורָא למִתַן לֵיה מָזֹון וֻכסוּ
ותִרחַמוּן יָת גִיֹורָא אַרֵי דַיָירִין הַוֵיתֹון בארעא דמצרים
יָת יוי אַלָהָך תִדחַל וֻקדָמֹוהִי תִפלַח וֻלדַחלתֵיה תִתקָרַבתתקריב וֻבִשׁמֵיה תקַיֵים
הוּא תוּשׁבַחתָך והוּא אַלָהָך דַעַבַד עִימָך יָת רַברבָתָא ויָת חַסִינָתָא הָאִלֵין דַחזַאָה עֵינָך
בשִׁבעִין נַפשָׁן נחַתוּ אַבָהָתָך למצרים וֻכעַן שַׁויָך יוי אַלָהָך ככֹוכבֵי שׁמַיָא לִסגֵי
ותִרחַם יָת יוי אַלָהָך ותִיטַר מַטרַת מֵימרֵיה וֻקיָמֹוהִי ודִינֹוהִי ופִיקֹודֹוהִי כֹל יֹומַיָא
ותִידעוּן יֹומָא דֵין אַרֵי לָא יָת בנֵיכֹון דלָא ידַעוּ וֻדלָא חַזֹו יָת אוּלפָנָא דַיוי אַלָהַכֹון יָת רבוּתֵיה ויָת ידֵיה תַקִיפתָא וֻדרָעֵיה מרָממָא
ויָת אָתוָתֵיה ויָת עוּבָדֹוהִיעֹובָדֹוהִי דַעַבַד בגֹו מצרים לפרעה מַלכָא דמצרים וֻלכָל אַרעֵיה
וֻדעַבַד למַשׁרִיַתלמַשׁריָת מִצרָאֵי לסוּסָוָתהֹון ולִרתִיכֵיהֹון דאַטֵיף יָת מֵי יַמָא דסוּף עַל אַפֵיהֹון במִרדַפהֹון בָתרֵיכֹון וַאַבֵידִינוּןואובידינון יוי עַד יֹומָא הָדֵין
ודַעַבַד לכֹון במַדברָא עַד מֵיתֵיכֹון עַד אַתרָא הָדֵין
ודַעַבַד לדָתָן ולַאַבִירָם בנֵי אַלִיאָב בַר ראוּבֵן דִפתַחַת ארעא יָת פוּמַה וֻבלַעתנוּןוֻבלַעַת יָתהֹון ויָת אַנָשׁ בָתֵיהֹון ויָת מַשׁכנֵיהֹון ויָת כֹל יקוּמָא דעִמהֹון בגֹו בנֵי ישׁראל
אַרֵי עֵינֵיכֹון חַזָאָהחזאן יָת כֹל עוּבָדָא דַיוי רַבָא דַעַבַד
ותִיטרוּן יָת כֹל תַפקֵידתָא דַאַנָא מפַקֵיד לָך יֹומָא דֵין בדִיל דתִיתַקפוּן ותֵיעַלוּן ותֵירתוּן יָת ארעא דאַתוּן עָברִין לתַמָן למֵירתַה
וֻבדִיל דתֹורכוּןדתֵירכוּן יֹומִין עַל ארעא דקַיֵים יוי לַאַבָהָתכֹון למִתַן להֹון ולִבנֵיהֹון אַרַע עָבדָא חַלָב וֻדבָשׁ
אַרֵי ארעא דאַת עָלֵיל לתַמָן למֵירתַה לָא כארעא דמצרים הִיא דִנפַקתוּן מִתַמָן דִזרַעת יָת זַרעָך וֻמַשׁקֵית לֵיה ברַגלָךבריגלך כגִינַת יַרקָא
וארעא דאַתוּן עָברִין לתַמָן למֵירתַה אַרַע טוּרִין וֻבַקעָןוֻבִקעָן למִטַר שׁמַיָא שָׁתיָא מַיָא
ארעא יהוה אַלָהָך תָבַע יָתַה תדִירָא עֵינֵי יוי אַלָהָך בַה מֵרֵישַׁה דשַׁתָא ועַד סֹופַה דשַׁתָא
וִיהֵי אִם קַבָלָא תקַבלוּן לפִקֹודַי דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין למִרחַם יָת יוי אַלָהַכֹון וֻלמִפלַח קדָמֹוהִי בכֹל לִבכֹון וֻבכָל נַפשׁכֹון
ואִיתֵין מטַר אַרַעכֹון בעִידָנֵיה בַכִיר ולַקִישׁ ותִכנֹושׁ עִיבוּרָךעבוּרָך וחַמרָך וֻמִשׁחָך
ואִיתֵין עִסבָא בחַקלָך לִבעִירָך ותֵיכֹול ותִסבַע
אִסתמַרוּ לכֹון דִלמָא יִטעֵי לִיבכֹון ותִסטֹון ותִפלחוּן לטָעַוָת עַממַיָא ותִסגדוּן להֹון
ויִתקַףויתקוף רוּגזָא דַיוי בכֹון ויֵיחֹוד יָת שׁמַיָא ולָא יהֵי מִטרָא וארעא לָא תִתֵין יָת עַלַלתַה ותֵיבדוּן בִפרִיַע מֵעַל ארעא טָבתָא דַיוי יָהֵיב לכֹון
וֻתשַׁוֹון יָת פתגָמַי אִלֵיןהאלין עַל לִיבכֹון ועַל נַפשׁכֹון ותִקטרוּן יָתהֹון לאָת עַל יַדכֹון וִיהֹון לִתפִלִין בֵין עֵינֵיכֹון
ותַלפוןותילפון יָתהֹון יָת בנֵיכֹון למַלָלָא בהֹון במִיתבָך בבֵיתָך וֻבִמהָכָך באֹורחָא וֻבִמשׁכבָך וֻבִמקִימָך
ותִכתֹובִינוּן עַל מזֹוזיָן ותִקבַעִינוּן בסִיפֵי בֵיתָך וֻבתַרעָךובדרעך
בדִיל דִיִסגֹון יֹומֵיכֹון ויֹומֵי בנֵיכֹון עַל ארעא דקַיֵים יוי לַאַבָהָתכֹון למִתַן להֹון כיֹומֵי שׁמַיָא עַל ארעא
אַרֵי אִם מִיטָר תִיטרוּן יָת כֹל תַפקֵידתָא הָדָא דַאַנָא מפַקֵיד יָתכֹון למַעבדַה למִרחַם יָת יוי אַלָהַכֹון לִמהָך בכֹל אֹורחָן דתָקנָן קדָמֹוהִי וֻלאִתקרָבָאוֻלאִתקָרָבָא לדַחלתֵיה
וִיתָרֵיך יוי יָת כֹל עַממַיָא הָאִלֵין מִן קדָמֵיכֹון ותֵירתוּן עַממִין סַגִיאִיןרַברבִין ותַקִיפִין מִנכֹון
כֹל אַתרָא דתִדרֹוך פַרסַת רַגלכֹון בֵיה לכֹוןדִילכֹון יהֵי מִן מַדברָא ולִבנָן מִן נַהרָא רַבָא נַהרָא פרָת ועַד יַמָא מַעַרבָאָהבתראה יהֵי תחוּמכֹון
לָא יִתעַתַד אַנָשׁ קדָמֵיכֹון דַחלַתכֹון ואֵימַתכֹון יִתֵין יוי אַלָהַכֹון עַל אַפֵי כֹל ארעא דתִדרָכֹון בַה כמָא דמַלֵיל לכֹון
חַזֹו דַאַנָא יָהֵיב קדָמֵיכֹון יֹומָא דֵין בִרכָן וֻלוָטִין
יָת בִרכָן אִם תקַבלוּן לפִקֹודַיָא דַיוי אַלָהַכֹון דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין
וֻלוָטִין אִם לָא תקַבלוּן לפִקֹודַיָא דַיוי אַלָהַכֹון ותִסטֹון מִן אֹורחָא דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין לִמהָך בָתַר טָעַוָת עַממַיָא דלָא ידַעתוּן
וִיהֵי אַרֵי יַעִילִינָךיַעֵילִנָך יוי אַלָהָך לארעא דאַת עָלֵיל לתַמָן למֵירתַה ותִתֵין יָת מבָרכַיָא עַל טוּרָא דִגרִיזִין ויָת מלָטטַיָא עַל טוּרָא דעֵיבָל
הַלָא אִינוּן בעִברָא דיַרדנָא אַחֹורֵי אֹורַח מַעַלָנֵי שִׁמשָׁא בַאַרַע כנַעַנָאָה דיָתֵיב במֵישׁרָא לִקבֵיללָקָבֵיל גִלגָלָא בִסטַר מֵישׁרֵי מֹורַה
אַרֵי אַתוּן עָברִין יָת יַרדנָא למֵיעַל למֵירַת יָת ארעא דַיוי אַלָהַכֹון יָהֵיב לכֹון ותֵירתוּן יָתַה ותִתבוּן בַה
ותִיטרוּן למַעַבַד יָת כֹל קִיָמַיָאקיָמַיָא ויָת דִינַיָא דַאַנָא יָהֵיב קדָמֵיכֹון יֹומָא דֵין
אִלֵין קִיָמַיָא ודִינַיָא דתִיטרוּן למַעַבַד בארעא דִיהַב יוי אַלָהָא דַאַבָהָתָך לָך למֵירתַה כֹל יֹומַיָא דאַתוּן קַיָמִין עַל ארעא
אַבָדָא תאַבדוּן יָת כֹל אַתרַיָא דִפלַחוּ תַמָן עַממַיָא דאַתוּן יָרתִין יָתהֹון יָת טָעַוָתהֹון עַל טוּרַיָא רָמַיָא ועַל רָמָתָא וֻתחֹות כֹל אִילָן עַבֹוף
וֻתתָרעוּן יָת אֵיגֹורֵיהֹון וֻתתַברוּן יָת קָמָתהֹון וַאַשֵׁירֵיהֹון תֹוקדוּן בנוּרָא וצִלמֵי טָעַוָתהֹון תקָצצוּן ותֹובדוּן יָת שׁוּמהֹון מִן אַתרָא הַהוּא
לָא תַעבדוּן כֵין קדם יוי אַלָהַכֹון
אַלָהֵין לאַתרָא דיִתרעֵי יוי אַלָהַכֹון מִכָל שִׁבטֵיכֹון לאַשׁרָאָה שׁכִינתֵיה תַמָן לבֵית שׁכִינתֵיה תִתבעוּן ותֵיתֹון לתַמָן
ותַיתֹון לתַמָן עַלָוָתכֹון ונִכסַת קוּדשֵׁיכֹון ויָת מַעסרֵיכֹון ויָת אַפרָשׁוּת יַדכֹון ונִדרֵיכֹון ונִדבָתכֹון וֻבִכֹורֵי תֹורֵיכֹון ועָנכֹון
ותֵיכלוּן תַמָן קדָם יוי אַלָהַכֹון ותִחדֹון בכֹל אֹושָׁטוּת יַדכֹון אַתוּן וַאַנָשׁ בָתֵיכֹון דבָרכָך יוי אַלָהָך
לָא תַעבדוּן ככֹל דַאַנַחנָא עָבדִין כָא יֹומָא דֵין גבַר כֹל דכָשַׁר בעֵינֹוהִי
אַרֵי לָא אַתֵיתֹון עַד כעַן לבֵית נִיָחָא וֻלאַחסָנתָא דַיוי אַלָהָך יָהֵיב לָך
ותִעברוּן יָת יַרדנָא ותִיתבוּן באַרעָא דַיוי אַלָהַכֹון מַחסֵין יָתכֹון וִינִיַח לכֹון מִכֹל בַעַלֵי דבָבֵיכֹון מִסחֹור סחֹור ותִיתבוּן לרוּחצָן
וִיהֵי אַתרָא דיִתרעֵי יוי אַלָהַכֹון בֵיה לאַשׁרָאָה שׁכִינתֵיה תַמָן לתַמָן תַיתֹון יָת כֹל דַאַנָא מפַקֵיד יָתכֹון עַלָוָתכֹון ונִכסַת קוּדשֵׁיכֹון מַעשׁרֵיכֹון ואַפרָשׁוּת יַדכֹון וכֹל שׁפַר נִדרֵיכֹון דתִידרוּן קדם יוי
ותִחדֹון קדם יוי אַלָהַכֹון אַתוּן וֻבנֵיכֹון וֻבנָתכֹון ועַבדֵיכֹון ואַמהָתכֹון ולֵיוָאָה דִבקִרוֵיכֹון אַרֵי לֵית לֵיה חוּלָק ואַחסָנָא עִמכֹון
אִסתַמַר לָך דִלמָא תַסֵיק עַלָוָתָך בכֹל אַתרָא דתִחזֵי
אַלָהֵין באַתרָא דיִתרעֵי יוי בחַד מִן שִׁבטָך תַמָן תַסֵיק עַלָוָתָך ותַמָן תַעַבֵיד כֹל דַאַנָא מפַקֵיד לָך
לחֹוד בכֹל רעוּת נַפשָׁך תִיכֹוס ותֵיכֹול בִסרָא כבִרכתָא דַיוי אַלָהָך דִיהַב לָך בכֹל קִרוָך מסָאַבָא ודַכיָא יֵיכלִינֵיה כִבסַר טַביָא ואַילָא
לחֹוד דמָא לָא תֵיכלוּן עַל ארעא תֵישׁדִינֵיה כמַיָא
לֵית לָך רשׁוּ למֵיכַל בקִרוָך מַעסַר עִיבוּרָך חַמרָך ומִשׁחָך וֻבכֹורֵי תֹורָך ועָנָך וכֹל נִדרָך דתִידַר ונִדבָתָך ואַפרָשׁוּת ידָך
אַלָהֵין קדם יוי אַלָהָך תֵיכלִינֵיה באַתרָא דיִתרעֵי יוי אַלָהָך בֵיה אַת וֻברָך וֻברַתָך ועַבדָך ואַמתָך ולֵיוָאָה דִבקִרוָך ותִחדֵי קדָם יוי אַלָהָך בכֹל אֹושָׁטוּת ידָך
אִסתַמַר לָך דִלמָא תִשׁבֹוק יָת לֵיוָאָה כֹל יֹומָך עַל אַרעָך
אַרֵי יַפתֵי יוי אַלָהָך יָת תחוּמָך כמָא דמַלֵיל לָך ותֵימַר אֵיכֹול בִסרָא אַרֵי תִתרעִי נַפשָׁך למֵיכַל בִסרָא בכֹל רעוּת נַפשָׁך תֵיכֹול בִסרָא
אַרֵי יִתרַחַק מִינָך אַתרָא דיִתרעֵי יוי אַלָהָך לאַשׁרָאָה שׁכִינתֵיה תַמָן ותִכֹוס מִתֹורָך וֻמֵעָנָך דִיהַב יוי לָך כמָא דפַקֵידתָך ותֵיכֹול בקִרוָך בכֹל רעוּת נַפשָׁך
ברַם כמָא דמִתאַכִיל בסַר טַביָא ואַילָא כֵין תֵיכלִינֵיה מסָאַבָא ודַכיָא כַחדָא יֵיכלִינֵיה
לחֹוד תקַף בדִיל דלָא למֵיכַל דמָא אַרֵי דמָא הוּא נַפשָׁא ולָא תֵיכֹול נַפשָׁא עִם בִסרָא
לָא תֵיכלִינֵיה עַל אַרעָא תֵישׁדִינֵיה כמַיָא
לָא תֵיכלִינֵיה בדִיל דיִיטַב לָך ולִבנָך בָתרָך אַרֵי תַעַבֵיד דכָשַׁר קדָם יוי
לחֹוד קוּדשָׁך דִיהֹון לָך ונִדרָך תִיטֹול ותֵיתֵי לאַתרָא דיִתרעֵי יוי
ותַעַבֵיד עַלָוָתָך בִסרָא וֻדמָא עַל מַדבחָא דַיוי אַלָהָך ודַם נִכסַת קוּדשָׁך יִשׁתפֵיך עַל מַדבחָא דַיוי אַלָהָך וֻבִסרָא תֵיכֹול
טַר וֻתקַבֵיל יָת כֹל פִתגָמַיָא הָאִלֵין דַאַנָא מפַקֵיד לָך בדִיל דיִיטַב לָך ולִבנָך בָתרָך עַד עָלמָא אַרֵי תַעַבֵיד דתָקֵין וֻדכָשַׁר קדם יוי אַלָהָך
אַרֵי ישֵׁיצֵי יוי אַלָהָך יָת עַממַיָא דאַת עָלֵיל לתַמָן למֵירַת יָתהֹון מִן קדָמָך ותֵירַת יָתהֹון ותִיתֵיב בַאַרַעהֹון
אִסתַמַר לָך דִלמָא תִתקֵיל בָתרֵיהֹון בָתַר דיִשׁתֵיצֹון מִן קדָמָך ודִלמָא תִתבַע לטָעַוָתהֹון למֵימַר אֵיכדֵין פָלחִין עַממַיָא הָאִלֵין יָת טָעַוָתהֹון ואַעַבֵיד כֵין אַף אַנָא
לָא תַעַבֵיד כֵין קדָם יוי אַלָהָך אַרֵי כֹל דִמרַחַק קדם יוי דסָנֵי עָבדִין לטָעַוָתהֹון אַרֵי אַף יָת בנֵיהֹון ויָת בנָתהֹון מֹוקדִין בנוּרָא לטָעַוָתהֹון
יָת כָל פִתגָמָאתפקדתא דַאַנָא מפַקֵיד יָתכֹון יָתֵיה תִטרוּן למַעַבַד לָא תֹוספוּןתֵיספוּן עַלֹוהִי ולָא תִמנעוּןתימינעון מִנֵיה
אַרֵי יקוּם בֵינָך נבִייָא אֹו חָלֵים חַלמָאחילמא ויִתֵין לָך אָת אֹו מֹופֵתמֹופָת
ויֵיתֵי אָתָא וֻמֹופתָא דמַלֵיל עִימָך למֵימַר נהָך בָתַר טָעַוָת עַממַיָא דלָא ידַעתָנִין ונִפלחִינִין
לָא תקַבֵיל לפִתגָמֵי נבִיָיא הַהוּא אֹו מִןלות חָלֵים חַלמָאחילמא הַהוּא אַרֵי מנַסֵי יוי אַלָהַכֹון יָתכֹון למִידַע הַאִיתֵיכֹוןהָאִיתֵיכֹון רָחַמִין יָתקדם יוי אַלָהַכֹון בכֹל לִיבכֹון וֻבכָל נַפשׁכֹון
בָתַר פוּלחָנָאדחלתא דַיוי אַלָהַכֹון תהָכוּן ויָתֵיה תִדחַלוּן ויָת פִיקֹודֹוהִי תִטרוּן וֻלמֵימרֵיה תקַבלוּן וֻקדָמֹוהִי תִפלחוּן וֻלדַחַלתֵיה תִתקָרבֻיןתקרבון
וֻנבִיָיא הַהוּא אֹו חָלֵים חַלמָאחילמא הַהוּא יִתקטִיל אַרֵי מַלֵיל סָטיָא עַל יוי אַלָהַכֹון דאַפֵיק יָתכֹון מארעא דמצרים וֻדפַרקָך מִבֵית עַבדוּתָא לאַטעָיוּתָך מִן אֹורחָא דפַקדָך יוי אַלָהָך לִמהָך בַה וֻתפַלֵי עָבֵיד דבִישׁ מִבֵינָך
אַרֵי יִמלכִינָךיַמלכִנָך אַחוּך בַר אִימָך אֹו ברָך אֹו ברַתָך אֹו אִיתַת קיָמָךקִיָמָך אֹו חַברָך דִכנַפשָׁך בסִתרָא למֵימַר נהָך ונִפלַח לטָעַוָת עַממַיָא דלָא ידַעתָא אַת וַאַבָהָתָך
מִטָעַוָת עַממַיָא דִבסַחרָנֵיכֹוןדי בסוחרניכון דקָרִיבִין לָך אֹו דרַחִיקִין מִינָך מִסיָפֵימִסִיָפֵי אַרעָא ועַד סיָפֵי ארעא
לָא תֵיבֵי לֵיה ולָא תקַבֵיל מִנֵיה ולָא תחוּס עֵינָך עַלֹוהִי ולָא תרַחֵים ולָא תכַסֵי עַלֹוהִי
אַרֵי מִקטָל תִקטלִינֵיה ידָך תהֵי בֵיה בקַדמֵיתָא למִקטלֵיה וִידָא דכֹל עַמָא בבָתרֵיתָא
ותִרגמִינֵיה באַבנַיָא וִימוּת אַרֵי בעָא לאַטעָיוּתָך מִדַחַלתָאמִדַחלתָא דַיוי אַלָהָך דאַפקָך מארעא דמצרים מִבֵית עַבדוּתָא
וכָל יִשׁרָאֵל יִשׁמעוּן ויִדחלוּן ולָא יֹוספוּןיֵיספוּן למַעַבַד כפִתגָמָא בִישָׁא הָדֵין בֵינָך
אַרֵי תִשׁמַע בַחדָא מִן קִרוָך דַיוי אַלָהָך יָהֵיב לָך למִיתַב תַמָן למֵימַר
נפַקוּ גַברִיןגֻברִין בנֵי רִשׁעָא מִבֵניָך ואַטעִיוּ יָת יָתבֵי קַרתהֹון למֵימַר נהָך ונִפלַח לטָעַוָת עַממַיָא דלָא ידַעתוּן
ותִתבַע ותִבדֹוק ותִשׁאַל יָאוּת והָא קוּשׁטָא כֵיוָן פִתגָמָא אִתעַבֵידַת תֹועֵיבתָא הָדָא בֵינָך
מִמחָא תִמחֵי יָת יָתבֵי קַרתָא הַהִיא לפִתגָם דחָרַב גַמַר יָתַה ויָת כֹל דבַה ויָת בעִירַה לפִתגָם דחָרַב
ויָת כֹל עַדָאַה תִכנֹושׁ לגֹו פתָאָה ותֹוקֵיד בנוּרָא יָת קַרתָא ויָת כֹל עַדָאַה גמִיר קדם יוי אַלָהָך וֻתהֵי תֵל חָרוּבחריב לעָלַם לָא תִתבנֵי עֹוד
ולָא יִדבַק בִידָך מִידָעַם מִן חִרמָאחַרמָא בדִיל דִיתוּב יוי מִתקֹוף רוּגזֵיה ויִתֵין לָך רַחמִין וִירַחֵים עַלָך ויַסגֵינָך כמָא דקַיֵים לַאַבָהָתָך
אַרֵי תקַבֵיל למֵימרָא דַיוי אַלָהָך למִטַר יָת כֹל פִקֹודֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין למַעַבַד דכָשַׁר קדם יוי אַלָהָך
בנִין אַתוּן קדם יוי אַלָהַכֹון לָא תִתהָממוּן ולָא תשַׁוֹון מרַט בֵין עֵינֵיכֹון עַל מִית
אַרֵי עַם קַדִישׁ אַת קדם יוי אַלָהָך וֻבָך אִתרעִי יוי למִהוֵי לֵיה לעַם חַבִיב מִכֹל עַממַיָא דעַל אַפֵי ארעא
לָא תֵיכֹול כֹל דִמרַחַקדִמרֻחַק
דֵיןדא בעִירָא דתֵיכלוּן תֹורִין אִימרִין דרַחלִיןדרחילין וֻגדִיןוגדיין דעִזִין
אַילָא וטַביָא ויַחמוּרָא ויַעַלָא ורֵימָא ותֹורבָלָאותוּרבָלָא ודֵיצָא
וכֹל בעִירָא דִסדִיקָא פַרסתַה וֻמַטִלפַןוֻמַטלפָן טִלפִין תַרתֵין פַרסָתַה מַסקָא פִשׁרָא בִבעִירָא יָתַה תֵיכלוּן
ברַם יָת דֵין לָא תֵיכלוּן מִמַסקֵי פִשׁרָא וֻמִסדִיקֵי פַרסתָא מַטִלפֵימַטלפֵי טִלפַיָא יָת גַמלָא ויָת אַרנבָא ויָת טַפזָאטַבזָא אַרֵי מַסקֵי פִשׁרָא אִנוּן וֻפַרסָתהֹון לָא סדִיקָא מסָאַבִין אִנוּן לכֹון
ויָת חַזִירָא אַרֵי סדִיק פַרסתָא הוּא ולָא פָשַׁר מסָאַב הוּא לכֹון מִבִסרהֹון לָא תֵיכלוּן וֻבִנבֵילַתהֹוןוֻבִנבִילַתהֹון לָא תִקרבוּן
יָת דֵין תֵיכלוּן מִכֹל דִבמַיָא כֹל דלֵיה צִיצִין וקַלפִין תֵיכלוּן
וכֹל דלֵית לֵיה צִיצִין וקַלפִין לָא תֵיכלוּן מסָאַב הוּא לכֹון
כֹל צִיפַר דכֵי תֵיכלוּן
ודֵין דלָא תֵיכלוּן מִנהֹון נִשׁרָא ועָר ועוּזיָאועָזיָא
וֻבַת כַנפָא וטָרָפִיתָא ודָיתָאודַיתָא לִזנַה
ויָת כֹל עֹורבָא לִזנֵיה
ויָת בַת נַעָמִיתָא וצִיצָא וצִיפַר שַׁחפָא ונַצָא לִזנֹוהִי
קַדיָאוקָדיָא וקִיפוּפָא וֻבַותָאוֻבָותָא
וקָתָא וִירַקרֵיקָא ושָׁלֵינוּנָא
וחָוָרִיתָא ואִבָאואִבֹו לִזנַה ונַגָר טוּרָא וַעַטַלֵיפָא
וכֹל רִחשָׁא דעֹופָא מסָאַב הוּא לכֹון לָא יִתאַכלוּן
כֹל עֹוף דכֵי תֵיכלוּן
לָא תֵיכלוּן כֹל נבִילָא לתֹותַב עַרַל דִבקִרוָך תִתנִינַה ויֵיכלִינַה אֹו תזַבנִינַה לבַר עַממִין אַרֵי עַם קַדִישׁ אַת קדם יוי אַלָהָך לָא תֵיכלוּן בסַר בַחלַב
עַסָרָא תעַסַר יָת כֹל עַללַת זַרעָך דיַפֹוקדיַפֵיק חַקלָא שׁנָא שׁנָא
ותֵיכֹול קדם יוי אַלָהָך באַתרָא דיִתרעֵידיִיתִרעֵי לאַשׁרָאָה שׁכִינתֵיה תַמָן מַעסַר עִיבוּרָךעבוּרָך חַמרָך ומִשׁחָך וֻבכֹורֵיובוכרי תֹורָך ועָנָך בדִיל דתֵילַף למִדחַל קדם יוי אַלָהָך כֹל יֹומַיָא
וַאַרֵי יִסגֵיתִסגֵי מִנָך אֹורחָא אַרֵי לָא תִכֹול למִיטַלֵיה אַרֵי יִתרַחַק מִינָך אֹורחָאאַתרָא דיִתרעֵי יוי אַלָהָך לאַשׁרָאָה שׁכִינתֵיה תַמָן אַרֵי יבָרכִינָך יוי אַלָהָך
ותִתֵין בכַספָא וֻתצוּר כַספָא בִידָך וֻתהָך לאַתרָא דיִתרעֵי יוי אַלָהָך בֵיה
ותִתֵין כַספָא בכֹל דתִתרעֵי נַפשָׁך בתֹורֵי וֻבעָנָא וֻבַחמַר חַדַת ועַתִיק וֻבכֹל דתִשׁאַלִינָך נַפשָׁך ותֵיכֹול תַמָן קדם יוי אַלָהָך ותִחדֵי אַת וַאַנָשׁ בֵיתָך
ולֵיוָאָה דִבקִרוָך לָא תִשׁבקִינֵיהתרַחקִנֵיה אַרֵי לֵית לֵיה חוּלָק ואַחסָנָא עִימָך
מִסֹוף תלָת שׁנִין תַפֵיק יָת כֹל מַעסַר עַלַלתָך בשַׁתָא הַהִיא ותַצנַע בקִרוָך
ויֵיתֵי לֵיוָאָה אַרֵי לֵית לֵיה חוּלָק ואַחסָנָא עִימָך וגִיֹורָא ויַתמָא ואַרמַלתָא דִבקִרוָך ויֵיכלוּן ויִסבעוּן בדִיל דִיבָרכִינָך יוי אַלָהָך בכֹל עוּבָדֵי ידָך דתַעַבֵיד
מִסֹוף שׁבַע שׁנִין תַעַבֵיד שׁמִיטתָא
ודֵין פִתגָם שׁמִיטתָא ויַשׁמֵיט כֹל גבַר מָרֵי רשׁוּ דיִרשֵׁי בחַברֵיה לָא יִתבַע מִן חַברֵיה וֻמִן אחוּהִי אַרֵי קרָא שׁמִיטתָא קדם יוי
מִן בַר עַממִין תִתבַע ודִיהֵי לָך עִםמן אַחוּך תַשׁמֵיט ידָך
לחֹוד אַרֵי לָא יהֵי בָך מִסכֵינָא אַרֵי בָרָכָא יבָרכִינָך יוי באַרעָא דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא למֵירתַה
לחֹוד אִם קַבָלָא תקַבֵיל למֵימרָא דַיוי אַלָהָך למִיטַר למַעַבַד יָת כֹל תַפקֵידתָא הָדָא דַאַנָא מפַקֵיד לָך יֹומָא דֵין
אַרֵי יוי אַלָהָך בָרכָך כמָא דמַלֵיל לָך ותֹוזֵיףתזוף לעַממִין סַגִיאִין ואַת לא תזִיף ותִשׁלֹוטותִשׁלוּט בעַממִין סַגִיאִין וֻבָך לָא יִשׁלטוּן
אַרֵי יהֵי בָך מִסכֵינָא חַד מֵאַחָך בַחדָא מִן קִרוָך באַרעָך דַיוי אַלָהָך יָהֵיב לָך לָא תתַקֵיףתַתקֵיף יָת לִיבָך ולָא תִקפֹוץתקמוט יָת ידָך מֵאַחוּך מִסכֵינָא
אַרֵי מִפתָח תִפתַח יָת ידָך לֵיה ואֹוזָפָא תֹוזפִינֵיה כמִסַת חוּסרָנֵיהחיסרוניה דחַסִיר לֵיה
אִסתַמַראִסתמַר לָך דִלמָא יהֵי פִתגָמָא עִם לִיבָך בִרשַׁע למֵימַר קרֵיבַת שַׁתָאשׁנת שׁבִיעֵיתָא שַׁתָא דִשׁמִטתָא ויִבאַשׁ עֵינָך בַאַחֻך מִסכֵינָא ולָא תִתֵין לֵיה ויִקרֵי עַלָך קדם יוי וִיהֵי בָך חֹובָא
מִיתָן תִיתֵין לֵיה ולָא יִבאַשׁיבאישׁ לִיבָךעינך במִיתנָך לֵיה אַרֵי בדִיל פִתגָמָא הָדֵין יבָרכִינָך יוי אַלָהָך בכֹל עוּבָדָך וֻבכֹל אֹושָׁטוּת ידָך
אַרֵי לָא יִפסֹוקיִפסוּק מִסכֵינָא מִגֹו אַרעָא עַל כֵין אַנָא מפַקֵיד לָך למֵימַר מִפתָח תִפתַח יָת ידָך לאַחוּך לעַניָך וֻלמִסכֵינָך באַרעָך
אַרֵי יִזדַבַן לָך אָחוּךאחוּך בַר ישׁראל אֹו בַת ישׁראל ויִפלחִינָך שֵׁית שׁנִין וֻבשַׁתָא שׁבִיעֵיתָא תִפטרִינֵיה בַר חֹורִיןבַר חירין מֵעִמָך
וַאַרֵי תִפטרִינֵיה בַר חֹורֵיןבַר חירין מֵעִמָך לָא תִפטרִינֵיה רֵיקָן
אַפרָשָׁא תַפרֵישׁ לֵיה מֵעָנָך וֻמֵאִידרָך וֻמִמַעַצַרתָך דבָרכָך יוי אַלָהָך תִתֵין לֵיה
ותִדכַר אַרֵי עַבדָא הַוֵיתָא בארעא דמצרים וֻפַרקָך יוי אַלָהָך עַל כֵין אַנָא מפַקֵיד לָך יָת פִתגָמָא הָדֵין יֹומָא דֵין
וִיהֵי אַרֵי יֵימַר לָך לָא אִיפֹוק מֵעִימָך אַרֵי רִחמָךרַחמָך וֻלאַנָשׁ בֵיתָך אַרֵי טָב לֵיה עִמָך
ותִיסַב יָת מַרצעָא ותִתֵין באוּדנֵיה וֻבדַשָׁא וִיהֵי לָך עַבַד פָלַח לעָלַם ואַף לאַמתָך תַעַבֵיד כֵין
לָא יִקשֵׁי בעֵינָך במִפטרָך יָתֵיה בַר חֹורִין מֵעִמָך אַרֵי עַל חַד תרֵין בַאַגַר אַגִירָא פַלחָך שֵׁית שׁנִין וִיבָרכִינָך יוי אַלָהָך בכֹל דתַעַבֵיד
כֹל בוּכרָא דיִתילֵיד בתֹורָך וֻבעָנָך דִכרִין תַקדֵישׁ קדם יוי אַלָהָך לָא תִפלַח בבוּכרָא דתֹורָך ולָא תִגֹוז בוּכרָא דעָנָך
קדם יוי אַלָהָך תֵיכלִינֵיה שׁנָא בִשׁנָא באַתרָא דיִתרעֵידיִיתִרעֵי יוי אַת וַאַנָשׁ בֵיתָך
וַאַרֵי יהֵי בֵיה מוּמָא חַגִיר אֹו עַוִיר כֹל מוּםמדעם בִישׁ לָא תִכסִינֵיה קדם יוי אַלָהָך
בקִרוָך תֵיכלִינֵיה מסָאַבָא ודַכיָא כַחדָא כִבסַר טַביָאטָביָא ואַילָא
לחֹוד יָת דמֵיה לָא תֵיכֹול עַל ארעא תֵישׁדִינֵיהתֹושׁדִינֵיה כמַיָא
טַר יָת יַרחָא דַאַבִיבָא ותַעַבֵיד פִסחָא קדם יוי אַלָהָך אַרֵי ביַרחָא דַאַבִיבָא אַפקָך יוי אַלָהָך מִמִצרַיִם וַעַבַד לָך נִסִין בלֵיליָא
ותִכֹוס פִסחָא קדם יוי אַלָהָך מִן בנֵי עָנָא ונִכסַת קוּדשַׁיָא מִן תֹורֵי באַתרָא דיִתרעֵי יוי לאַשׁרָאָה שׁכִינתֵיה תַמָן
לָא תֵיכֹול עַלֹוהִי חַמִיעָא שִׁבעָה יֹומִין תֵיכֹול עַלֹוהִי פַטִירָא לחֵים עַנֵיעוני אַרֵי בִבהִילוּ נפַקתָא מארעא דמצרים בדִיל דתִדכַר יָת יֹום מִפקַך מארעא דמצרים כֹל יֹומֵי חַייָך
ולָא יִתַחזֵי לָך חַמִיר בכָל תחוּמָך שִׁבעָה יֹומִין ולָא יבִית מִן בִסרָא דתִכֹוס ברַמשָׁא ביֹומָא קַדמָאָה לצַפרָא
לֵית לָך רשׁוּ למִכַסלמיכוס יָת פִסחָא בַחדָא מִן קִרוָך דַיוי אַלָהָך יָהֵיב לָך
אַלָהֵין לאַתרָא דיִתרעֵי יוי אַלָהָך לאַשׁרָאָה שׁכִינתֵיה תַמָן תִיכֹוסתיכלון יָת פִסחָא ברַמשָׁא כמֵיעַל שִׁמשָׁא זמָן מִפקָך ממצרים
וֻתבַשֵׁיל ותֵיכֹול באַתרָא דיִתרעֵי יוי אַלָהָך בֵיה ותִתפנֵי בצַפרָא וֻתהָך לקִרוָךלמַשׁכנָך
שִׁיתָה יֹומִין תֵיכֹול פַטִירָא וֻביֹומָא שׁבִיעָאָה כנִישׁ קדם יוי אַלָהָך לָא תַעַבֵיד עַבִידָא
שִׁבעָה שָׁבוּעִיןשׁבועיין תִמנֵי לָך מִשֵׁירָיוּת מַגלָא בַחצַד עוּמרָא דַאַרָמוּתָא תשָׁרֵי למִמנֵי שִׁבעָה שָׁבוּעִיןשׁבועיין
ותַעַבֵיד חַגָא דשָׁבוּעַיָא קדם יוי אַלָהָך מִסַת נִדבַת ידָך דתִיתֵין כמָא דִיבָרכִינָך יוי אַלָהָך
ותִחדֵי קדם יוי אַלָהָך אַת וֻברָך וֻברַתָך ועַבדָך ואַמתָך ולֵיוָאָה דִבקִרוָך וגִיֹורָא ויַתמָא ואַרמַלתָא דבֵינָך באַתרָא דיִתרעֵי יוי אַלָהָך לאַשׁרָאָה שׁכִינתֵיה תַמָן
ותִדכַרותיתכר אַרֵי עַבדָא הַוֵיתָא במצרים ותִטַר ותַעַבֵיד יָת קִיָמַיָאקיָמַיָא הָאִלֵין
חַגָא דִמטַלַיָא תַעַבֵיד לָך שִׁבעָה יֹומִין במֵכנשָׁךבמִכנשָׁך מֵאִדרָך וֻמִמַעַצַרתָך
ותִחדֵי בחַגָך אַת וֻברָך וֻברַתָך ועַבדָך ואַמתָך ולֵיוָאָה וגִיֹורָא ויַתמָא ואַרמַלתָא דִבקִרוָך
שִׁבעָה יֹומִין תֵיחֹוג קדם יוי אַלָהָך באַתרָא דיִתרעֵי יוי אַרֵי יבָרכִינָך יוי אָלָהָך בכָל עַלַלתָך וֻבכָל עוּבָדֵי ידָך וֻתהֵי ברַם חָדֵי
תלָת זִמנִין בשַׁתָא יִתחַזֹוןיִתַחזֹון כָל דכוּרָך קדם יוי אַלָהָך באַתרָא דיִתרעֵי בחַגָא דפַטִירַיָא וֻבחַגָא דשָׁבוּעַיָא וֻבחַגָא דִמטַלַיָא ולָא יִתחַזֹוןיִתַחזֹון קדם יוי רֵיקָנִין
גבַר כמַתנַת ידֵיה כבִרכתָא דַיוי אַלָהָך דִיהַב לָך
דַיָנִין ופֹורעָנִיןוֻפוּרעָנִין תמַנֵי לָך בכָל קִרוָך דַיוי אַלָהָך יָהֵיב לָך לשִׁבטָך וִידִינוּןוידונון יָת עַמָא דִין דִקשֹׁוט
לָא תִצלֵיתַצלֵי דִין לָא תִשׁתמֹודַע אַפִין ולָא תקַבֵיל שׁוּחדָא אַרֵי שׁוּחדָא מעַוַר עֵינֵי חַכִימִין וֻמקַלקֵיל פִתגָמִין תרִיצִין
קוּשׁטָא קוּשׁטָא קושׁתא קושׁתא תִרדוּףהוי רדיף בדִיל דתֵיחֵי ותֵירַת יָת ארעא דַיוי אַלָהָך יָהֵיב לָך
לָא תִיצַבתִיצוּבתנצוב לָך אַשֵׁירַת כָל אִילָן בִסטַר מַדבחָא דַיוי אַלָהָך דתַעַבֵיד לָך
ולָא תָקִיםתקִים לָך קָמָא דרַחֵיקדסני יוי אַלָהָך
לָא תִיכֹוס קדם יוי אלהך תֹור ואִימַר דִיהֵי בֵיה מוּמָא כָלכֹל מִדָעַם בִישׁ אַרֵי מרַחַקמֻרחַק קדם יוי אַלָהָך הוּא
אַרֵי יִשׁתכַח בֵינָך בַחדָא מִן קִרוָך דַיוי אַלָהָך יָהֵיב לָך גבַר אֹו אִיתָא דיַעַבֵיד דבִישׁ קדם יוי אַלָהָך למִיעִיבַר קִיָמֵיהקיָמֵיה
וַאַזַל וֻפלַח לטָעַוָת עַממַיָא וֻסגֵיד להֹוןלהין וֻלשִׁמשָׁא אֹו לסֵיהַרָא אֹו לכֹל חֵילֵי שׁמַיָא דלָא פַקדִיתפַקֵידִית
ויִתחַוַה לָך ותִשׁמַע ותִתבַע יָאוּת והָא קוּשׁטָא כֵיוָן פִתגָמָא אִתעַבֵידַת תֹועֵיבתָא הָדָא בישׁראל
ותַפֵיק יָת גַברָאגֻברָא הַהוּא אֹו יָת אִיתתָא הַהִיא דַעַבַדוּ יָת פִתגָמָא בִישָׁא הָדֵין לִתרַע בֵית דִינָך יָת גַברָאגֻברָא אֹו יָת אִיתתָא ותִרגֹומִינוּן באַבנַיָא וִימוּתוּן
עַל מֵימַר תרֵין סָהַדִין אֹו תלָתָה סָהַדִין יִתקטִיל דחַייָב קַטלָא לָא יִתקטִיל עַל מֵימַר סָהִיד חַד
ידָא דסָהַדַיָא תהֵי בֵיה בקַדמֵיתָא למִקטלֵיה וִידָא דכֹל עַמָא בבָתרֵיתָא ותפַלֵי עָבֵיד דבִישׁ מִבֵינָך
אַרֵי יִתפָרַשׁיתפרישׁ מִינָך פִתגָמָא דדִינָא בֵין דַם לדַם בֵין דִין לדִין בֵין מַכתָשׁ סגִירוּ למַכתָשׁ סגִירוּ פִתגָמֵי פלוּגַת דִינָא בקִרוָך וֻתקוּם ותִיסַק לאַתרָא דיִתרעֵי יוי אַלָהָך בֵיה
ותֵיתֵי לוָת כָהַנַיָא לֵיוָאֵי וֻלוָת דַיָינַיָא דִיהֵי ביֹומַיָא הָאִינוּן ותִתבַע וִיחַוֹון לָך יָת פִתגָמָא דדִינָא
ותַעַבֵיד עַל מֵימַר פִיתגָמָא דִיחַוֹון לָך מִן אַתרָא הַהוּא דיִתרעֵי יוי ותִיטַר למַעַבַד ככֹל דיַלפוּנָך
עַל מֵימַר אֹורָיתָא דִיַלפוּנָך ועַל דִינָא דיֵימרוּן לָך תַעַבֵיד לָא תִסטֵי מִן פִתגָמָא דִיחַוֹן לָך ליַמִינָא ולִסמָלָא
וגַברָאוגֻברָא דיַעַבֵיד בִרשַׁע בדִיל דלָא לקַבָלָא מִן כָהַנָא דקָאֵים לשַׁמָשָׁא תַמָן קדם יוי אַלָהָך אֹו מִן דַיָנָא ויִתקטִיל גַברָאגֻברָא הַהוּא וֻתפַלֵי עָבֵיד דבִישׁ מִיִשׁרָאֵל
וכֹל עַמָא יִשׁמעוּן ויִדחַלוּןוִידַחלוּן ולָא יַרשׁעוּן עֹוד
אַרֵי תֵיעֹול לארעא דַיוי אַלָהָך יָהֵיב לָך ותֵירתַה ותִיתֵיב בַה ותֵימַר אַמַנֵי עַלַי מַלכָא ככֹל עַממַיָא דִבסַחרָנַידי בסוחרני
מַנָאָה תמַנֵי עַלָך מַלכָא דיִתרעֵי יוי אַלָהָך בֵיה מִגֹו אַחָך תמַנֵי עַלָך מַלכָא לֵית לָך רשׁוּ למַנָאָה עַלָך גבַר נוּכרַי דלָא אַחוּך הוּא
לחֹוד לָא יִסגֵי לֵיה סוּסָוָן ולָא יָתֵיב יָת עַמָא למצרים בדִיל לאַסגָאָה לֵיה סוּסָוָן וַיוי אַמַר לכֹון לָא תֹוספוּןתֵיספוּן לִמתָבלמתוב באֹורחָא הָדָא עֹוד
ולָא יִסגֵי לֵיה נשִׁין ולָא יִטעֵי לִבֵיה וכַספָא ודַהבָא לָא יִסגֵי לֵיה לַחדָא
וִיהֵי כמִיתבֵיהכמותביה עַל כוּרסֵי מַלכוּתֵיה ויִכתֹוב לֵיה יָת פַרשׁגַן אֹורָיתָא הָדָא עַל סִפרָא מִן קדָם כָהַנַיָא לֵיוָאֵי
וֻתהֵי עִמֵיה וִיהֵי קָרֵי בַה כֹל יֹומֵי חַיֹוהִי בדִיל דיֵילַף למִדחַל קדָם יוי אַלָהֵיה למִיטַר יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא ויָת קִיָמַיָאקיָמַיָא הָאִלֵין למַעַבַדהֹון
בדִיל דלָא יִירַםירים לִיבֵיה מֵאַחֹוהִי וֻבדִיל דלָא יִסטֵי מִן תַפקֵידתָא ליַמִינָא ולִסמָלָא בדִיל דיֵירֻיךדיֹורֵיך יֹומִין עַל מַלכוּתֵיה הוּא וֻבנֹוהִי בגֹו ישׁראל
לָא יהֵי לכָהַנַיָא לֵיוָאֵי כֹל שִׁבטָא דלֵוִי חוּלָק לאַחסָנָא עִם ישׁראל קוּרבָנַיָא דַיוי ואַחסָנתֵיה יֵיכלוּןיאכלון
ואַחסָנָא לָא יהֵי לֵיה בגֹו אַחֹוהִי מַתנָן דִיהַב לֵיה יוי אִינִין אַחסָנתֵיה כמָא דמַלֵיל לֵיה
ודֵין יהֵי דחָזֵי לכָהָנַיָא מִן עַמָא מִן נָכסֵי נִכסתָאנכסיתא אִם תֹור אִם אִימַר ויִתֵין לכָהַנָא דרָעָאדרועא ולוּעָא וקֵיבתָאוקובתא
רֵישׁ עִיבוּרָךעבוּרָך חַמרָך וֻמִשׁחָך ורֵישׁ גִיזַת עָנָך תִיתֵיןתפרישׁ לֵיה
אַרֵי בֵיה אִתרעִי יוי אֻלָהָך מִכֹל שִׁבטָך לִמקָם לשַׁמָשָׁא בִשׁמָא דַיוי הוּא וֻבנֹוהִי כֹל יֹומַיָא
וַאַרֵי יֵיתֵי לֵיוָאָה מֵחַדָא מִקִרוָך מִכֹל ישׁראל דהוּא דָאַרדָר תַמָן ויֵיתֵי בכֹל רעוּת נַפשֵׁיה לאַתרָא דיִתרעֵי יוי
וִישַׁמֵישׁ בִשׁמָא דַיוי אַלָהֵיה ככֹל אַחֹוהִי לֵיוָאֵי דקָימִין תַמָן לשַׁמָשָׁא קדם יוי דִמשַׁמשִׁין תַמָן
חוּלָק כחוּלָקכוחלק יֵיכלוּן בָר מִמַטַרתָא דיָתַה שַׁבתָאשַׁבתָא דכֵין אַתקִינוּ אַבָהָתָא
אַרֵי אַת עָלֵיל לארעא דיוי אַלָהָך יָהֵיב לָך לָא תֵילַף למַעַבַד כתֹועֵיבָתכתֹועבָת עַממַיָא הָאִינוּן
לָא יִשׁתכַח בָך מַעַבַר בָרֵיה וֻברַתֵיה בנוּרָא קָסֵיםקוסם קִסמִין מעָנֵיןמעונן וֻמנַחֵישׁ וחָרַשׁוחָרָשׁ
ורָטֵין רטַן ושָׁאֵיל בבִדִין וֻבִזכוּרוּ ותָבַע מִן מִיתַיָא
אַרֵי מרַחַקמֻרחַק קדם יוי כֹל עָבֵיד אִלֵין וֻבדִיל תֹועֵיבָתָא הָאִלֵין יוי אַלָהָך מתָרֵיך להֹוןיָתהֹון מִן קדָמָך
שׁלִים תהֵי בדַחַלתָאבדַחלתָא דַיוי אַלָהָך
אַרֵי עַממַיָא הָאִלֵין דאַת יָרֵית יָתהֹון מִן מעָננַיָאמעונניא וֻמִן קַסָמַיָאקוסמיא שָׁמעִין ואַת לָא כֵין יהַב לָך יוי אַלָהָך
נבִייָא מִבֵינָך מֵאַחָך דִכוָתִי יקִים לָך יוי אַלָהָך מִנֵיה תקַבלוּן
ככֹל דִשׁאֵילתָא מִן קדם יוי אַלָהָך בחֹורֵב ביֹומָא דִקהָלָא למֵימַר לָא אֹוסֵיף למִשׁמַע יָת קָל מֵימרָא דַיוי אַלָהִי ויָת אִישָׁתָא רַבתָא הָדָא לָא אִחזֵי עֹוד ולָא אֵימוּת
וַאַמַר יוי לִי אַתקִינוּ דמַלִילוּ
נבִייָא אַקִיםאקִים להֹון מִגֹו אַחֵיהֹון כוָתָךדכותך ואִתֵין פִתגָמֵי נבוּאַתִינביאותי בפוּמֵיה וִימַלֵיל עִמהֹון יָת כֹל דַאפַקדִינֵיה
וִיהֵי גַברָאגֻברָא דלָא יקַבֵיל לפִתגָמַי דִימַלֵיל בִשׁמִי מֵימרִיאנא יִתבַע מִנֵיה
ברַם נבִייָא דיַרשַׁע למַלָלָא פִתגָמָא בִשׁמִי יָת דלָא פַקֵידתֵיה למַלָלָא ודִימַלֵיל בשֹׁום טָעַוָת עַממַיָא ויִתקטִיל נבִייָא הַהוּא
וַאַרֵי תֵימַר בלִיבָך אֵיכדֵין נִידַע יָת פִתגָמָא דלָא מַללֵיה יוי
דִימַלֵיל נבִייָא בִשׁמָא דַיוי ולָא יהֵי פִתגָמָא ולָא יִתקַיַים הוּא פִתגָמָא דלָא מַללֵיה יוי בִרשַׁע מַללֵיה נבִייָא לָא תִדחַלוּןתדַחלוּן מִנֵיה
אַרֵי ישֵׁיצֵי יוי אַלָהָך יָת עַממַיָא דַיוי אַלָהָך יָהֵיב לָך יָת אַרַעהֹון ותֵירתִינוּן ותִיתֵיב בקִרוֵיהֹון וֻבבָתֵיהֹון
תלָת קִרוִין תַפרֵישׁ לָך בגֹו אַרעָך דַיוי אַלָהָך יָהֵיב לָך למֵירתַה
תַתקֵין לָך אֹורחָא וֻתתַלֵית יָת תחוּם אַרעָך דיַחסנִינָך יוי אַלָהָך וִיהֵי למִיעִירַקלמיעירוק לתַמָן כֹל קָטֹול
ודֵין פִתגָם קָטֹולָא דיִעִירֹוק לתַמָן ויִתקַיַים דיִקטֹול יָת חַברֵיה בלָא מַדעֵיה והוּא לָא סָנֵי לֵיה מֵאִתמָלִי וֻמִדקַמֹוהִיומדקדמוהי
וֻדיֵיעֹול עִם חַברֵיה בחוּרשָׁא למִיקַץ אָעִין ותִתמרֵיךותִתמרֵיג ידֵיה בבַרזלָאבגרזנא למִיקצֵיה אָעָא ויִשׁתלֵיף בַרזלָא מִן אָעָא ויַשׁכַח יָת חַברֵיה וִימוּת הוּא יעִירֹוק לַחדָא מִן קִרוַיָא הָאִלֵין ויִתקַיַים
דִלמָא יִרדֹוף גָאֵיל דמָא בָתַר קָטֹולָא אַרֵי יִיחַםיתיחם לִיבֵיה ויִדבקִינֵיה אַרֵי תַסגֵי אֹורחָא ויִקטלִינֵיה נפַשׁ ולֵיה לֵית חֹובַת דִין דִקטֹול אַרֵי לָא סָנֵי הוּא לֵיה מֵאִתמָלִי וֻמִדקַמֹוהִיומדקדמוהי
עַל כֵין אַנָא מפַקֵיד לָך למֵימַר תלָת קִרוִין תַפרֵישׁ לָך
ואִם יַפתֵי יוי אַלָהָך יָת תחוּמָך כמָא דקַיֵים לַאַבָהָתָך ויִתֵין לָך יָת כֹל ארעא דמַלֵיל למִיתַן לַאַבָהָתָך
אַרֵי תִיטַר יָת כֹל תַפקֵידתָא הָדָא למַעבדָה דַאַנָא מפַקֵיד לָך יֹומָא דֵין למִרחַם יָת יוי אַלָהָך ולִמהָך באֹורחָן דתָקנָן קדָמֹוהִי כֹל יֹומַיָא ותֹוסֵיף לָך עֹוד תלָת קִרוִין עַל תלָת אִלֵין
ולָא יִשׁתפֵיך דַם זַכַי בגֹו אַרעָך דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא וִיהֵי עַלָך חֹובַת דִין דִקטֹול
וַאַרֵי יהֵי גבַר סָנֵי לחַברֵיה ויִכמֹון לֵיה וִיקוּם עַלֹוהִי ויִקטַלִינֵיה נפַשׁ וִימוּת ויִעִירֹוק לַחדָא מִן קִרוַיָא הָאִלֵין
ויִשׁלחוּן סָבֵי קַרתֵיה ויִדברוּן יָתֵיה מִתַמָן ויִתנוּןויִמסרוּן יָתֵיה ביַד גָאֵיל דמָא וִימוּתויתקטיל
לָא תחוּס עֵינָך עַלֹוהִי וֻתפַלֵי אָשׁדֵי דַם זַכַי מִישׁראל ויִיטַב לָך
לָא תשַׁנֵי תחוּמָא דחַברָך דתַחִימוּ קַדמָאֵי באַחסָנתָך דתַחסֵין בארעא דַיוי אַלָהָך יָהֵיב לָך למֵירתַה
לָא יקוּם סָהִיד חַד בִגבַר לכֹל עַוָיָן וֻלכָל חֹובִין בכֹל חֵיטחֵטא דיִחטֵי עַל מֵימַר תרֵין סָהַדִין אֹו עַל מֵימַר תלָתָה סָהַדִין יִתקַייַם פִתגָמָא
אַרֵי יקוּם סָהִיד שַׁקָרשׁקַר בִגבַר לאַסהָדָא בֵיה סָתיָא
וִיקוּמוּן תרֵין גַברִיןגוברין דִילהֹון דִינָא קדם יוי קדם כָהַנַיָא ודַיָינַיָא דִיהֹון ביֹומַיָא הָאִינוּן
ויִתבעוּן דַיָינַיָא יָאוּת והָא סָהִיד שִׁקרָא סָהַדָא שִׁקרָא אַסהֵיד בַאַחוּהִי
ותַעבדוּן לֵיה כמָא דחַשֵׁיב למַעַבַד לַאַחוּהִי וֻתפַלֵי עָבֵיד דבִישׁ מִבֵינָך
וֻדיִשׁתאַרוּןוֻדיִשׁתַארוּן יִשׁמעוּן ויִדחַלוּן ולָא יֹוספוּןיֵיספוּן למַעַבַד עֹוד כפִתגָמָא בִישָׁא הָדֵין בֵינָך
ולָא תחוּס עֵינָך נַפשָׁא חַלָף נַפשָׁא עֵינָא חַלָף עֵינָא שִׁינָא חלָף שִׁינָא ידָא חַלָף ידָא רִגלָא חַלָף רִגלָא
אַרֵי תִיפֹוק לאָגָחָא קרָבָא עַל בַעַלֵי דבָבָך ותִחזֵי סוּסָוָן וֻרתִכִין עַם סַגִי מִינָך לָא תִדחַל מִנהֹון אַרֵי יוי אַלָהָך מֵימרֵיה בסַעַדָך דאַסקָךדאַפקָך מארעא דמִצרָיִם
וִיהֵי כמִקרַבכֹון לאָגָחָא קרָבָא ויִתקָרַבויתקריב כָהַנָא וִימַלֵיל עִם עַמָא
ויֵימַר להֹון שׁמַע ישׁראל אַתוּן מִתקָרבִין יֹומָא דֵין לאָגָחָא קרָבָא עַל בַעַלֵי דבָבֵיכֹון לָא יזוּעַ לִיבכֹון לָא תִדחַלוּן ולָא תִתבַעתוּןתתבהתון ולָא תִיתַברוּן מִן קדָמֵיהֹון
אַרֵי יוי אַלָהַכֹון מֵימרֵיה מדַבַר קדָמֵיכֹון לאָגָחָא לכֹון קרָב עִם בַעַלֵי דבָבֵיכֹון למִפרַק יָתכֹון
וִימַללוּן סָרכַיָא עִםקדם עַמָא למֵימַר מַן גַברָאגֻברָא דִבנָא בֵיתָא חַדַתָא ולָא חַנכֵיה יהָך וִיתוּב לבֵיתֵיה דִלמָא יִתקטִיל בִקרָבָא וֻגבַר אוּחרָןאָחָרָן יַחנכִינֵיהיחַנכִינֵיה
וֻמַן גַברָאגֻברָא דִנצַב כַרמָא ולָא אַחַלֵיה יהָך וִיתוּב לבֵיתֵיה דִלמַא יִתקטִיל בִקרָבָא וֻגבַר אוּחרָן יַחַלִינֵיהיחלליניה
וֻמַן גַברָאגֻברָא דאַרַסדַארַס אִיתתָא ולָא נִסבַהנַסבַה יהָך וִיתוּב לבֵיתֵיה דִלמָא יִתקטִיל בִקרָבָא וֻגבַר אוּחרָןאָחָרָן יִסבִינַה
ויֹוספוּןויֵיספוּן סָרכַיָא למַלָלָא עִם עַמָא ויֵימרוּן מַן גַברָאגֻברָא דדַחוּלדדָחוּל וֻתבִיר לִיבָא יהָך וִיתוּב לבֵיתֵיה ולָא יִתבַר יָת לִיבָא דַאַחֹוהִי כלִיבֵיה
וִיהֵי כַד ישֵׁיצֹון סָרכַיָא למַלָלָא עִם עַמָא וִימַנֹון רַבָנֵי חֵילָא ברֵישׁ עַמָא
אַרֵי תִקרַב לקַרתָא לאָגָחָא קרָבָא עַלַה ותִקרֵי לַה מִלִין דִשׁלָם
וִיהֵי אִם שׁלָם תַעַנֵינָךתתיבינך ותִפתַח לָך וִיהֵי כֹל עַמָא דיִשׁתכַח בַה יהֹון לָך למַסקֵי מִסִין ויִפלחוּנָך
ואִם לָא תַשׁלִים עִמָך ותַעַבֵיד עִמָך קרָב וֻתצוּר עלַה
ויִמסרִינַה יוי אַלָהָך בִידָך ותִמחֵי יָת כֹל דכוּרַה לפִתגָם דחָרַב
לחֹוד נשַׁיָא וטַפלָא וֻבעִירָא וכֹל דִיהֵי בקַרתָא כֹל עַדָאַה תִיבֹוז לָך ותֵיכֹול יָת עַדַי סָנאָך דִיהַב יוי אַלָהָך לָך
כֵין תַעַבֵיד לכֹל קִרוַיָא דרַחִיקָן מִינָך לַחדָא דלָא מִקִרוֵי עַממַיָא הָאִלֵין אִינוּןאִינִין
לחֹוד מִקִרוֵי עַממַיָא הָאִלֵין דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא לָא תקַיֵיםתיחי כֹל נִשׁמָא
אַרֵי גַמָרָא תגַמַרִינוּן חִיתָאֵי וַאַמֹורָאֵי כנַעַנָאֵי וֻפרִזָאֵי חִיוָאֵי וִיבוּסָאֵי כמָא דפַקדָך יוי אַלָהָך
בדִיל דלָא יַלפוּן יָתכֹון למַעַבַד ככֹל תֹועֵיבָתהֹון דַעַבַדוּ לטָעַוָתהֹון וֻתחוּבוּן קדם יוי אַלָהַכֹון
אַרֵי תצוּר לקַרתָא יֹומִין סַגִיאִין לאָגָחָא קרָבָא עַלַה למִכבשַׁה לָא תחַבֵיל יָת אִילָנַה לַאַרָמָא עַלֹוהִי בַרזלָא אַרֵי מִינֵיה תֵיכֹול ויָתֵיה לָא תקוּץ אַרֵי לָא כַאַנָשָׁא אִילָן חַקלָא למֵיעַל מִן קדָמָך בִציָרָא
לחֹוד אִילָן דתִידַע אַרֵי לָא אִילָן דמֵיכַל הוּא יָתֵיה תחַבֵילתחַבַל וֻתקוּץ ותִבנֵי כַרקֹומִיןכרכומין עַל קַרתָא דהִיא עָבדָא עִמָך קרָב עַד דתִכבשַׁה
אַרֵי יִשׁתכַח קטִילָא בארעא דיוי אַלָהָך יָהֵיב לָך למֵירתַה רמִי בחַקלָא לָא ידִיַעאיתידע מַן קַטלֵיה
ויִפקוּן סָבָך ודַייָנָך ויִמשׁחוּן לקִרוַיָא דִבסַחרָנוּתדי בסוחרנות קַטִילָא
וֻתהֵי קַרתָא דקָרִיבָאדִקרִיבָא לִקטִילָא ויִסבוּןויִדברוּן סָבֵי קַרתָא הַהִיא עַגלַת תֹורִין דלָא אִתפלַח בַה דלָא נגַדַתנגידת בנִיר
ויַחַתוּן סָבֵי קַרתָא הַהִיא יָת עַגַלתָא לִנחַל ביָר דלָא יִתפלַח בֵיה ולָא יִזדרַע ויִקפֹוןויַקפוּןוינקפון תַמָן יָת עַגַלתָא בנַחלָא
ויִתקָרבוּן כָהַנַיָא בנֵי לֵוִיליואי אַרֵי בהֹון אִתרעִי יוי אַלָהָך לשַׁמָשׁוּתֵיה ולבָרָכָא בִשׁמָא דַיוי ועַל מֵימַרהֹון יהֵי כֹל דִין וכֹל מַכתָשׁמוכתשׁ סגִירוּ
וכֹל סָבֵי קַרתָא הַהִיא דקָרִיבִין לִקטִילָא יַסחֹון יָת ידֵיהֹון עַל עַגַלתָאעגַלתָא דִנקִיפָא בנַחלָא
ויָתִיבוּן ויֵימרוּן ידַנָא לָא אַשַׁדָא יָת דמָא הָדֵין ועֵינַנָא לָא חַזַאָה
כָהַנַיָא יֵימרוּן כַפַר לעַמָך יִשׁרָאֵל דִפרַקתָא יוי ולָא תִתֵין חֹובַתאשׁדי דַם זַכַי בגֹו עַמָך ישׁראל ויִתכַפַר להֹון עַל דמָא
ואַת תפַלֵי אָשׁדֵיחובת דַם זַכַי מִבֵינָך אַרֵי תַעַבֵיד דכָשַׁר קדָם יוי
אַרֵי תִפֹוק לאָגָחָא קרָבָא עַל בַעַלֵי דבָבָך ויִמסַרִינוּן יוי אַלָהָך בִידָך ותִשׁבֵי שׁבֵיהֹוןשִׁביהֹון
ותִחזֵי בשִׁביָא אִיתתָא שַׁפִירַת רֵיוחיזו ותִתרעֵי בַה ותִסבַה לָך לאִיתוּלאנתו
ותַעֵילִינַה לגֹו בֵיתָך וֻתגַלַח יָת רֵישַׁה וֻתרַבֵי יָת טוּפרַהָאטופרנהא
ותַעַדֵי יָת כסוּת שִׁביַה מִינַה ותִתֵיב בבֵיתָך ותִבכֵי יָת אַבוּהָא ויָת אִימַה ירַח יֹומִין וֻבָתַר כֵין תֵיעֹול לוָתַה ותִבעַלִינַה וֻתהֵי לָך לאִיתוּלאנתו
וִיהֵי אִם לָא תִתרעֵי בַה ותִפטרִינַה לנַפשַׁה וזַבָנָא לָא תזַבַנִינַה בכַספָא לָא תִיתַגַרתִיתגַר בַה חַלָף דעַנִיתַה
אַרֵי יִהוִיָןיִהויָן לִגבַר תַרתֵין נשִׁין חַדַאחדָא רחוּמתָארחימתא וֻחדַאוֻחדָא סנוּאַתָאסניאתא וִילִידָן לֵיה בנִין רחוּמתָארחימתא וֻסנוּאַתָא וִיהֵי ברָא בוּכרָא לִסנִיאַתָא
וִיהֵי ביֹומָא דיַחסֵין לִבנֹוהִי יָת דִיהֵי לֵיה לֵית לֵיה רשׁוּ לבַכָרָא יָת בַר רחוּמתָארחימתא עַל אַפֵי בַר סנוּאַתָאסנִיאתָא בוּכרָא
אַרֵי יָת בוּכרָא בַר סנוּאַתָאסניאתא יַפרֵישׁיפָרֵישׁ למִיתַן לֵיה תרֵיןתרתין חוּלָקִין בכֹל דיִשׁתכַח לֵיה אַרֵי הוּא רֵישׁ תוּקפֵיה לֵיה חָזיָא בכֵירוּתָאבכֹורוֻתָא
אַרֵי יהֵי לִגבַר בַר סָטֵי וֻמָרֹודומריד לָיתֹוהִי מקַבֵיל למֵימַר אַבוּהִי וֻלמֵימַר אִימֵיה וֻמַלפִין יָתֵיה ולָא מקַבֵיל מִנהֹון
ויֵיחַדוּןויַחדוּן בֵיה אַבוּהִי ואִמֵיה ויַפקוּן יָתֵיה לִקדָם סָבֵי קַרתֵיה ולִתרַע בֵית דִין אַתרֵיה
ויֵימרוּן לסָבֵי קַרתֵיה ברַנָא דֵין סָטֵי וֻמָרֹודומריד לָיתֹוהִי מקַבֵיל למֵימרַנָא זָלֵיל בסַר וסָבֵי חַמַר
ויִרגמוּנֵיה כֹל אַנָשֵׁי קַרתֵיה באַבנַיָא וִימוּת וֻתפַלֵי עָבֵיד דבִישׁ מִבֵינָך וכֹל ישׁראל יִשׁמעוּן ויִדחַלוּן
וַאַרֵי יהֵי בִגבַר חֹובַת דִין דִקטֹול ויִתקטִיל ותִצלֹוב יָתֵיה עַל צלִיבָא
לָא תָבֵיתתבִית נבֵילתֵיהנבִילתֵיה עַל צלִיבָא אַרֵי מִקבָר תִקברִינֵיה ביֹומָא הַהוּא אַרֵי עַל דחָב קדם יוי אִצטלִיב ולָא תסַאֵיב יָת אַרעָך דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא
לָא תִחזֵי יָת תֹורָא דַאַחוּך אֹו יָת אִימרֵיה דטָעַן ותִכבֹושׁ מִנהֹון אָתָבָא תָתִיבִינוּן לַאַחוּך
ואִם לָא קָרִיב אַחוּך לוָתָך ולָא ידַעת לֵיה ותִכנשִׁינֵיה לגֹו בֵיתָך וִיהֵי עִמָך עַד דיִתבַע אַחוּך יָתֵיה ותָתִיבִינֵיה לֵיה
וכֵין תַעַבֵיד לִחמָרֵיה וכֵין תַעַבֵיד לִכסוּתֵיה וכֵין תַעַבֵיד לכֹל אַבֵידתָא דַאַחוּך דתֵיבַד מִנֵיה ותַשׁכחִינַה לֵית לָך רשׁוּ לכַסָיוּתַה
לָא תִחזֵי יָת חַמָרָא דַאַחוּך אֹו תֹורֵיה רמַן באֹורחָא ותִכבֹושׁותכבישׁ מִנהֹון אָקָמָא תָקִים עִמֵיה
לָא יהֵי תִיקוּן זֵין דִגבַר עַל אִיתָא ולָא יִתַקַןיתקין גבַר בתִקוּנֵי אִיתָא אַרֵי מרַחַק קדם יוי אַלָהָך כֹל עָבֵיד אִלֵין
אַרֵי תעָרַע קִינָא דצִיפרָאדצִפָרָא קדָמָך באֹורחָא בכֹל אִילָן אֹו עַל ארעא אַפרֹוחִין אֹו בֵיעִין ואִימָא רבִיעָא עַל אַפרֹוחִין אֹו עַל בֵיעִין לָא תִיסַב אִימָא עַל בנַיָא
שַׁלָחָא תשַׁלַח יָת אִימָא ויָת בנַיָא תִיסַב לָך בדִיל דיִיטַבדיוטיב לָך ותֹורֵיך יֹומִין
אַרֵי תִבנֵי בֵיתָא חַדַתָא ותַעַבֵיד תִיָקָאתיָקָא לאִיגָרָך ולָא תשַׁוֵי חֹובַת קטֹול בבֵיתָך אַרֵי יִפֹוליפיל דנָפֵיל מִנֵיה
ולָא תִזרַע כַרמָך עֵירוּבִין דִלמָא תִסתָאַב דִמעַת זַרעָא דתִזרַע ועַללַת כַרמָא
לָא תִרדֵי בתֹורָא וֻבִחמָרָא כַחדָא
לָא תִלבַשׁתלבישׁ שַׁעַטנֵיזָא עַמַרעמַר וכִיתָן מחַבַרמחֻבַר כַחדָא
כרוּספדִין תַעַבֵיד לָך עַל אַרבַע כַנפֵי כסוּתָך דתִתכַסֵי בַה
אַרֵי יִסַב גבַר אִיתתָא ויֵיעֹול לוָתַה ויִסנֵינַה
וִישַׁוִי לַה תַסקוּפֵי מִלִין ויַפֵיק עַלַה שׁוּםשֹׁום בִישׁ ויֵימַר יָת אִיתתָא הָדָא נסֵיבִית ועַלִית לוָתַה ולָא אַשׁכַחִית לַה בתוּלִין
ויִסַב אַבוּהָא דעוּלֵימתָא ואִימַה ויַפקוּן יָת בתוּלֵי עוּלֵימתָא לִקדָם סָבֵי קַרתָא ולִתרַע בֵית דִין אַתרָא
ויֵימַר אַבוּהָא דעוּלֵימתָא לסָבַיָא יָת ברַתִי יהַבִית לגַברָאלגֻברָא הָדֵין לאִיתוּ וֻסנַה
והָא הוּא שַׁוִי תַסקוּפֵי מִלִין למֵימַר לָא אַשׁכַחִית לִברַתָך בתוּלִין ואִלֵין בתוּלֵי ברַתִי ויִפרסוּןויפירסון שֹׁושִׁיפָא קדָםקֻדָם סָבֵי קַרתָא
ויִסבוּן סָבֵי קַרתָא הַהִיא יָת גַברָאגֻברָא ויַלקֹון יָתֵיה
ויִגבֹון מִנֵיה מאָה סִלעִין דִכסַף ויִתנוּן לַאַבוּהָא דעוּלֵימתָא אַרֵי אַפֵיק שׁוּםשֹׁום בִישׁ עַל בתוּלתָא בַת ישׁראל ולֵיה תהֵי לאִיתוּ לֵית לֵיה רשׁוּ למִפטרַה כֹל יֹומֹוהִי
ואִם קוּשׁטָא הַוָה פִתגָמָא הָדֵין לָא אִשׁתכַחוּ בתוּלִין לעוּלֵימתָא
ויַפקוּן יָת עוּלֵימתָא לִתרַע בֵית אַבוּהָא ויִרגמוּנַה אַנָשֵׁי קַרתַה באַבנַיָא וֻתמוּת אַרֵי עַבַדַתעבידת קלָנָא בישׁראל לזַנָאָה בֵית אַבוּהָא וֻתפַלֵי עַבֵיד דבִישׁ מִבֵינָך
אַרֵי יִשׁתכַח גבַר שָׁכֵיב עִם אִיתתָא אִיתַת גבַר ויִתקַטלוּן אַף תַרוֵיהֹון גַברָאגֻברָא דִשׁכֵיבדשָׁכֵיב עִם אִיתתָא ואִיתתָא וֻתפַלֵי עָבֵיד דבִישׁ מישׁראל
אַרֵי תהֵי עוּלֵימתָא בתוּלתָא דִמאָרסָא לִגבַר ויַשׁכחִינַה גַברָאגֻברָא בקַרתָא וישׁכֹוב עִמַה
ותַפקוּן יָת תַרוֵיהֹון לִתרַע קַרתָא הַהִיא ותִרגמוּן יָתהֹון באַבנַיָא וִימוּתוּן יָת עוּלֵימתָא עַל עֵיסַק דלָא צוַחַת בקַרתָא ויָת גַברָאגֻברָא עַל עֵיסַק דעַנִי יָת אִיתַת חַברֵיה וֻתפַלֵי עָבֵיד דבִישׁ מִיבֵינָך
ואִם בחַקלָא יַשׁכַח גַברָאגֻברָא יָת עוּלֵימתָא דִמאָרסָא ויִתַקַףויִתקַף בַה גַברָאגֻברָא ויִשׁכֹוב עִימַה ויִתקטִיל גַברָאגֻברָא דִשׁכֵיב עִמַה בִלחֹודֹוהִי
וֻלעוּלֵימתָא לָא תַעַבֵיד מִדָעַם לֵית לעוּלֵימתָא חֹובַת דִין דִקטֹול אַרֵי כמָא דִיקוּם גַברָאגֻברָא עַל חַברֵיה ויִקטלִינֵיה נפַשׁ כֵין פִתגָמָא הָדֵין
אַרֵי בחַקלָא אַשׁכחַה צוַחַת עוּלֵימתָא דִמאָרסָא ולֵית דפָרִיק לַה
אַרֵי יַשׁכַח גבַר עוּלֵימתָא בתוּלתָא דלָא מאָרסָא ויֵיחַדִינַהויַחדִנַה ויִשׁכֹוב עִמַה ויִשׁתַכחוּן
ויִתֵין גַברָאגֻברָא דִשׁכֹוב עִימַה לאַבוּהָא דעוּלֵימתָא חַמשִׁין סִלעִין דִכסַף ולֵיה תהֵי לאִיתוּ חַלָף דעַניַה לֵית לֵיה רשׁוּ למִפטרַה כָל יֹומֹוהִי
לָא יִסַב גבַר יָת אִיתַת אַבוּהִי ולָא יגַלֵי כַנפָא דַאַבוּהִי
לָא יִדכֵי דִפסִיק ודִמחַבַלודִמחֻבַל דגזיר מטלאדגזיר דמשׁלף למֵיעַל בִקהָלָא דַיוי
לָא יִדכֵי מַמזֵירָא למֵיעַל בִקהָלָא דַיוי אַף דָרָא עַסִירָאָה לָא יִדכֵי לֵיה למֵיעַל בִקהָלָא דַיוי
לָא יִדכֹון עַמֹונָאֵי וֻמֹואַבָאֵי למֵיעַל בִקהָלָא דַיוי אַף דָרָא עַשִׁירָאָה לָא יִדכֵי להֹון למֵיעַל בִקהָלָא דַיוי עַד עָלמָא
עַל עֵיסַק דלָא עָרַעוּעָרעוּ יָתכֹון בלַחמָא וֻבמַיָא באֹורחָא במִפַקכֹון ממצרים וֻדַאגַר עַלָך יָת בִלעָם בַר בעֹור מִפתֹור אַרַםארָם דעַל פרָת ללָטָטוּתָך
ולָא אַבָאאבָא יוי אַלָהָך לקַבָלָא מִן בִלעָם וַהפַך יוי אַלָהָך לָך יָת לוָטִין לבִרכָן אַרֵי רִחמָךרַחמָך יוי אַלָהָך
לָא תִתבַע שׁלָמהֹון וטָבָתהֹון כֹל יֹומָך לעָלַם
לָא תרַחֵיקתרַחַק אַדֹומָאָה אַרֵי אַחוּך הוּא לָא תרַחֵיקתרַחַק מִצרָאָה אַרֵי דַייָר הַוֵיתָא באַרעֵיה
בנִין דיִתיַלדוּן להֹון דָרָא תלִתָאָה יִדכֵי להֹון למֵיעַל בִקהָלָא דַיוי
אַרֵי תִיפֹוק מַשׁרִיתָא עַל בַעלֵי דבָבָך ותִסתמַרותסטמר מִכֹל מִדָעַם בִישׁ
אַרֵי יהֵי בָך גבַר דלָא יהֵי דכֵי מִקרֵימסואבת לֵיליָא ויִפֹוק למִבַרָא למַשׁרִיתָא לָא יֵיעֹול לגֹו מַשׁרִיתָא
וִיהֵי למִפנֵילעידן רַמשָׁא יַסחֵייִסחֵי במַיָא וֻכמֵיעַל שִׁמשָׁא יֵיעֹול לגֹו מַשׁרִיתָא
וַאַתַר מתַקַןמתֻקָןמותקָן יהֵי לָך מִבַרָא למַשׁרִיתָא ותִיפֹוק תַמָן לבָרָא
וסִיכתָא תהֵי לָך עַל זֵינָךאזנך וִיהֵי במִתבָך בבָרָא ותַחפַר בַה וֻתתוּב וֻתכַסֵי יָת מַפַקתָךמפקנך
אַרֵי יוי אַלָהָך שׁכִינתֵיה מהַלכָא בגֹו מַשׁרִיתָך לשֵׁיזָבוּתָך וֻלמִמסַר סַנאָך קדָמָך וֻתהֵי מַשׁרִיתָך קַדִישָׁא ולָא יִחזֵייִתַחזֵי בָך עַבִירַתעבֵירַת פִתגָם וִיתוּב מֵימרֵיה מִלאֹוטָבָאמִלאֵיתָבָא לָך
לָא תִמסַר עַבַד עַממִין ליַד רִבֹונֵיה דיִשׁתֵיזַב לוָתָך מִן קדָםמלות רִבֹונֵיה
עִמָך יִתֵיביהא בֵינָך באַתרָא דיִתרעֵי בַחדָא מִן קִרוָך בִדיִיטַבבדיוטב לֵיה לָא תֹונֵינֵיה
לָא תהֵי אִתתָא מִבנָת ישׁראל לִגבַר עַבַד ולָא יִסַב גַברָאגוּברָא מִבנֵי ישׁראל אִיתָא אָמָא
לָא תַעֵיל אַגַר זָנִיתָא וחוּלפַןוחֻלפָן כַלבָא לבֵית מַקדשָׁא דַיוי אַלָהָך לכָל נדַר אַרֵי מרַחַקמרֻחַק קדם יוי אַלָהָך אַף תַרוֵיהֹון
לָא תרַבֵי לאַחוּך רִבִית כסַף רִבִית עִיבוּרעבוּר רִבִית כֹל מִדָעַם דמִתרבֵידמִתרַבֵי
לבַר עַממִין תרַבֵי וֻלאַחוּך לָא תרַבֵי בדִיל דִיבָרכִינָך יוי אַלָהָך בכֹל אֹושָׁטוּת ידָך עַל אַרעָא דאַת עָלֵיל לתַמָן למֵירתַה
אַרֵי תִידַרתדור נדַר קדם יוי אַלָהָך לָא תאַחַר לשַׁלָמוּתֵיה אַרֵי מִתבָע יִתבעִינֵיה יוי אַלָהָך מֵעִימָךמִינָך וִיהֵי בָך חֹובָא
וַאַרֵי תִתמנַע מִלמִידַר לָא יהֵי בָך חֹובָא
אַפָקוּת סִפוָתָך תִיטַר ותַעַבֵיד כמָא דִנדַרתָא קדם יוי אַלָהָך נדַבתָא דמַלֵילתָא בפוּמָך
אַרֵי תִתַגַר בכַרמָא דחַברָך ותֵיכֹול עִנבִין כנַפשָׁך סִבעָךלמשׂבעך וֻלמָנָך לָא תִתֵין
אַרֵי תִיתַגַר בקָמתָא דחַברָך ותִקטוּף דמַליָןמלילןמללין בִידָך וֻמַגלָא לָא תרִים עַל קָמתָא דחַברָך
אַרֵי יִסַב גבַר אִיתתָא ויִבעַלִינַה וִיהֵי אִם לָא תַשׁכַח רַחמִין בעֵינֹוהִי אַרֵי אַשׁכַח בַה עַבִירַת פִתגָם ויִכתֹוב לַה גַט פִיטוּרִין ויִתֵין בִידַה ויִפטרִינַה מִבֵיתֵיה
ותִפֹוק מִבֵיתֵיה וֻתהָך וֻתהֵי לִגבַר אוּחרָן
ויִסנֵינַה גַברָא בָתרָאָה ויִכתֹוב לַה גַט פִיטוּרִין ויִתֵין בִידַה ויִפטרִינַה מִבֵיתֵיה אֹו אַרֵי ימוּת גַברָא בָתרָאָה דנִסבַה לֵיה לאִיתוּ
לֵית לֵיה רשׁוּ לבַעַלַה קַדמָאָה דפַטרַה לִמתָב למִסבַה למִהוֵי לֵיה לאִיתוּ בָתַר דאִסתָאַבַת אַרֵי מרַחַקָא הִיא קדם יוי ולָא תחַיֵיב יָת אַרעָך דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא
אַרֵי יִסַב גבַר אִיתתָא חַדַתָא לָא יִפֹוק בחֵילָא ולָא יעִיבַר עַלֹוהִי לכֹל פִתגָם פנִי יהֵי לבֵיתֵיה שַׁתָא חַדָא וִיחַדֵי יָת אִיתתֵיה דִנסִיב
לָא יִסַב מַשׁכֹונָא רִחיָא ורָכבַה אַרֵי בהֹון מִתעַבֵיד מָזֹון לכָל נפַשׁ
אַרֵי יִשׁתכַח גבַר גָנֵיב נַפשָׁא מֵאַחֹוהִי מִבנֵי ישׁראל ויִתַגַר בֵיה וִיזַבנִינֵיה ויִתקטִיל גַנָבָא הַהוּא וֻתפַלֵי עָבֵיד דבִישׁ מִבֵינָך
אִסתַמַר במַכתָשׁ סגִירוּ למִטַר לַחדָא וֻלמַעַבַד ככֹל דיַלפוּן יָתכֹון כָהַנַיָא לֵיוָאֵי כמָא דפַקֵידתִינוּן תִיטרוּן למַעַבַד
הַוִי דכִיר יָת דַעַבַד יוי אַלָהָך למִריָם באֹורחָא במִפַקכֹון מִמִצרָיִם
אַרֵי תִרשֵׁי בחַברָך רשׁוּת מִדָעַם לָא תֵיעֹול לבֵיתֵיה למִסַב מִשׁכֹונֵיה
בבָרָא תקוּם וגַברָא דאַת רָשֵׁי בֵיה יַפֵיק לָך יָת מַשׁכֹונָא לבָרָא
ואִם גבַר מִסכֵין הוּא לָא תִשׁכֹוב במַשׁכֹונֵיה
אָתָבָא תָתִיב לֵיה יָת מַשׁכֹונָא כמֵיעַל שִׁמשָׁא ויִשׁכֹוב בִכסוּתֵיה וִיבָרכִינָך ולָך תהֵי זָכוּ קדם יוי אַלָהָך
לָא תעִישֹׁוק אַגִירָא עַניָא וֻמִסכֵינָא מֵאַחָך אֹו מִגִיֹורָך דִבאַרעָך בקִרוָך
ביֹומֵיה תִתֵין אַגרֵיה ולָא תֵיעֹול עַלֹוהִי שִׁמשָׁא אַרֵי עַניָא הוּא ולֵיה הוּא מָסַר יָת נַפשֵׁיה ולָא יִקרֵי עַלָך קדם יוי וִיהֵי בָך חֹובָא
לָא ימוּתוּן אַבָהָן עַל פֹום בנִין וֻבנִין לָא ימוּתוּן עַל פֹום אַבָהָן אַנָשׁ בחֹובֵיה ימוּתוּן
לָא תִצלֵי דִין גִיֹור יִתַם ולָא תִיסַב מַשׁכֹונָא כסוּת אַרמלָא
ותִדכַר אַרֵי עַבדָא הַוֵיתָא במִצרַיִם וֻפַרקָך יוי אַלָהָך מִתַמָן עַל כֵין אַנָא מפַקֵיד לָך למַעַבַד יָת פִתגָמָא הָדֵין
אַרֵי תִחצוּד חַצָדָך בחַקלָך ותִתנשֵׁי עוּמרָא בחַקלָא לָא תתוּב למִסבֵיה לגִיֹורָא ליַתמָא וֻלאַרמַלתָא יהֵי בדִיל דִיבָרכִינָך יוי אַלָהָך בכֹל עוּבָדֵי ידָך
אַרֵי תַחבֹוט זֵיתָך לָא תפַלֵי בָתרָך לגִיֹורָא ליַתמָא וֻלאַרמַלתָא יהֵי
אַרֵי תִקטוּף כַרמָך לָא תעָלֵיל בָתרָך לגִיֹורָא ליַתמָא וֻלאַרמַלתָא יהֵי
ותִדכַר אַרֵי עַבדָא הַוֵיתָא בארעא דמִצרַיִם עַל כֵין אַנָא מפַקֵיד לָך למַעַבַד יָת פִתגָמָא הָדֵין
אַרֵי יהֵי דִין בֵין גַברַיָאגוּברַיָא ויִתקָרבוּן לדִינָא וִידִינוּנוּן וִיזַכֹון יָת זַכָאָה וִיחַייבוּן יָת חַיָיבָא
וִיהֵי אִם בַר חַיָיב לאַלקָאָה חַיָיבָא ויִרמֵינֵיה דַיָינָא ויַלקֵינֵיה קדָמֹוהִי כמִיסַת חֹובתֵיה במִניָן
אַרבעִין יַלקֵינֵיה לָא יֹוסִיףיֹוסֵיף דִלמָא יֹוסִיףיֹוסֵיף לאַלקָיוּתֵיה עַל אִלֵין מַחָא רַבָאסגי ויֵיקַל אַחוּך לעֵינָך
לָא תֵיחֹודתחיד פֹום תֹורָא בדיָשֵׁיה
אַרֵי יִתבוּן אַחִין כַחדָא וִימוּת חַד מִינהֹון וֻבַר לֵית לֵיה לָא תהֵי אִיתַת מֹותָנָאמיתנא לבָרָא לִגבַר אוּחרָןאָחָרָןחלוני יַבמַהיבָמַה יֵיעֹול עַלַה ויִסבַה לֵיה לאִיתוּלאנתו ויִבמִינַהויַבמִינַה
וִיהֵי בוּכרָא דִתלִידדתיליד יקוּם עַל שׁמָא דַאַחוּהִי מֹותָנָאמיתנא ולָא יִתמחֵי שׁמֵיה מישׁראל
ואִם לָא יִצבֵי גַברָאגֻברָא למִיסַב יָת יבִמתֵיה ותִיסַק יבִמתֵיה לִתרַע בֵית דִינָא לִקדָם סָבַיָא ותֵימַר לָא אַבֵי סָרֵיב יַבמִייבָמִי לאָקָמָאלמיקם לַאַחוּהִי שׁמָא בישׁראל לָא אַבֵי ליַבָמוּתִי
ויִקרֹון לֵיה סָבֵי קַרתֵיה וימַללוּן עִמֵיה וִיקוּם ויֵימַר לָא רעֵינָארעיתי למִסבַהלנסבה
ותִתקָרַבותתקריב יבִמתֵיה לוָתֵיהליה לִקדָםקדם סָבַיָא ותִשׁרֵי סֵינֵיה מֵעַל רַגלֵיהריגליה ותִרֹוק באַפֹוהִיבאַנפֹוהִי ותָתֵיב ותֵימַר כדֵין יִתעַבֵיד לגַברָאלגֻברָא דלָא יִבנֵי יָת בֵיתָא דַאַחוּהִי
ויִתקרֵי שׁמֵיה בישׁראל בֵית שׁרִי סֵינָא
אַרֵי יִנצֹוןיצון גַברִיןגֻברִין כַחדָא גבַר וַאַחוּהִי ותִתקָרַבותתקריב אִיתַת חַד לשֵׁיזָבָא יָת בַעַלַה מִיַד מָחֹוהִי ותֹושֵׁיט ידַה ותִתַקַףותִתקַףותַתקֵיף בבֵית בַהתתָיה
וֻתקוּץ יָת ידַה לָא תחוּס עֵינָך
לָא יהֵי לָך בכִיסָך מַתקַל וֻמַתקַל רַב וֻזעֵיר רבתא וזעירתא
לָא יהֵי לָך בבֵיתָך מכִילָא וֻמכִילָא רַבתָארבא וֻזעֵירתָא
מַתקָלִין שַׁלמִיןשַׁלמָן דִקשֹׁוט יהֹון לָך מכִילָן שַׁלמָןשַׁלמִין דִקשֹׁוט יהֹון לָך בדִיל דיֵירכוּןדיורכון יֹומָך עַל ארעא דַיוי אַלָהָך יָהֵיב לָך
אַרֵי מרַחַק קדם יוי אַלָהָך כֹל עָבֵיד אִלֵין כֹל עָבֵיד שׁקַר
הַוִי דכִיר יָת דַעַבַד לָך עַמָלֵק באֹורחָא במִיפַקכֹון מִמִצרָיִם
דעָרעָךדארעך באֹורחָא וקַטֵיל בָך כֹל דַהוֵי מִתאַחרִין בָתרָך ואַת משַׁלהֵי ולאֵיולָאֵיולהי ולָא דחֵילדָחֵיל מִן קדם יוי יקרא דייי
וִיהֵי כַד ינִיַח יוי אַלָהָך לָך מִכֹל בַעַלֵי דבָבָך מִסחֹור סחֹור בארעא דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא למֵירתַה תִמחֵי יָת דוּכרָנֵיה דַעמָלֵיק מִתחֹות שׁמַיָא לָא תִתנשֵׁיתנשׁי
וִיהֵי אַרֵי תֵיעֹול לארעא דַיוי אַלָהָך יָהֵיב לָך אַחסָנָא ותֵירתַה ותִיתֵיב בַה
ותִיסַב מֵרֵישׁ כֹל אִיבָא דארעא דתַעֵילדתיתי מֵאַרעָך דַיוי אַלָהָך יָהֵיב לָך וֻתשַׁוֵי בסַלָא וֻתהָך לאַתרָא דיִתרעֵי יוי אַלָהָך לאַשׁרָאָה שׁכִינתֵיה תַמָן
ותֵיתֵי לוָת כָהַנָא דִיהֵי ביֹומַיָא הָאִינוּן ותֵימַר לֵיה חַוִיתִי יֹומָא דֵין קדם יוי אַלָהָך אַרֵי עַלִית לארעא דקַיֵים יוי לַאַבָהָתַנָא למִיתַן לַנָא
ויִסַב כָהַנָא סַלָא מִן ידָך ויַחַתִינֵיהויצנעיניה קדָם מַדבחָא דַיוי אַלָהָך
ותָתֵיב ותֵימַר קדם יוי אַלָהָך לָבָן אַרַמָאָה בעָא לאֹובָדָאלאַבָדָא יָת אַבָא וֻנחַת למצרים ודָר תַמָן בעַם זעֵיר וַהַוָה תַמָן לעַם רַב תַקִיף וסַגִי
ואַבאִישׁוּ לַנָא מִצרָאֵי ועַניוּנָא וִיהַבוּ עַלַנָא פוּלחָנָא קַשׁיָא
וצַלִינָא קדם יוי אַלָהָא דַאַבָהָתַנָא וקַבֵיל יוי צלֹותַנָא וֻגלֵי קדָמֹוהִי עַמלַנָא ולֵיאוּתַנָא ודוּחקַנָא
ואַפקַנָא יוי מִמִצרַיִם ביַד תַקִיפָא וֻבִדרָע מרָמַם וֻבחִזוָנָאובחיזו רַבָא וֻבאָתִין וֻבמֹופתִין
ואֵתִיַנָאואעלנא לאַתרָא הָדֵיןהדא וִיהַב לַנָא יָת ארעא הָדָא אַרַע עָבדָא חַלָב וֻדבָשׁ
וֻכעַן הָא אֵיתִיתִי יָת רֵישׁ אִיבָא דארעא דִיהַבת לִי יוי ותַחַתִינֵיהותצנעינה קדָם יוי אַלָהָך ותִסגֹוד קדם יוי אַלָהָך
ותִחדֵי בכֹל טָבתָא דִיהַב לָך יוי אַלָהָך וֻלאַנָשׁ בֵיתָך אַת ולֵיוָאָה וגִיֹורָא דבֵינָך
אַרֵי תשֵׁיצֵי לעַסָרָא יָת כֹל מַעסַר עַלַלתָך בשַׁתָא תלִיתֵיתָא שׁנַת מַעַסרָא ותִתֵין ללֵיוָאָה לגִיֹורָא ליַתמָא וֻלאַרמַלתָא ויֵיכלוּן בקִרוָך ויִסבעוּן
ותֵימַר קדם יוי אַלָהָך פַלִיתִי קֹודשׁ מַעַסרָא מַעסַר קוּדשָׁא מִן בֵיתָא ואַף יהַבתֵיה ללֵיוָאָה וֻלגִיֹורָא ליַתמָא וֻלאַרמַלתָא ככֹל תַפקֵידתָךפיקודך דפַקֵידתַנִידפַקֵידתָנִי לָא עַבַרִית מִפִקֹודָך ולָא אִתנשִׁיתִיאנשׁיתי
לָא אַכַלִית באִבלִיבאַבלִי מִנֵיה ולָא חַלֵיפיִתפליתי מִנֵיה בִמסָאַב ולָא יהַבִית מִנֵיה למִית קַבֵילִית למֵימרָא דַיוי אַלָהִי עַבָדִית ככָל דפַקֵידתַנִידפַקֵידתָנִי
אִסתַכִי מִמדֹור קוּדשָׁך מִן שׁמַיָא וֻבָרֵיך יָת עַמָך יָת ישׁראל ויָת ארעא דִיהַבת לַנָא כמָא דקַיֵימתָא לַאַבָהָתַנָא אַרַע עָבדָא חַלָב וֻדבָשׁ
יֹומָא הָדֵיןארי יוי אַלָהָך מפַקֵיד לָך למַעַבַד יָת קִיָמַיָאקיָמַיָא הָאִלֵין ויָת דִינַיָא ותִיטַר ותַעַבֵיד יָתהֹון בכֹל לִיבָך וֻבכֹל נַפשָׁך
יָת יוי חַטַבת יֹומָא דֵין למִהוֵי לָך לַאַלָה ולִמהָך באֹורחָן דתָקנָן קדָמֹוהִי וֻלמִטַר קִיָמֹוהִיקיָמֹוהִי וֻפִקֹודֹוהִי ודִינֹוהִי וֻלקַבָלָאולאתקבלא למֵימרָיה
וַיוי חַטבָך יֹומָא דֵין למִהוֵי לֵיה לעַם חַבִיב כמָא דמַלֵיל לָך וֻלמִיטַר כֹל פִקֹודֹוהִי
וֻלמִיתנָך עִלַאיעלאה עַל כֹל עַממַיָא דַעַבַד לתוּשׁבחָא וֻלשׁוּםוֻלשֹׁום ולִרבוּ וֻלמִהוָך עַם קַדִישׁ קדם יוי אַלָהָך כמָא דמַלֵיל
וֻפַקֵיד מֹשַׁה וסָבֵי ישׁראל יָת עַמָא למֵימַר טַרוּ יָת כֹל תַפקֵידתָא דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין
וִיהֵי ביֹומָא דתִעִברוּן יָת יַרדנָא לארעא דַיוי אַלָהָך יָהֵיב לָך וֻתקִים לָך אַבנִין רַברבָןרברבין וֻתסוּדותסידותשׁיעון יָתהֹוןיתהין בסִידָאבגירא
ותִכתֹוב עַלֵיהֹון יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא במִעברָך בדִיל דתֵיעֹול לארעא דַיוי אַלָהָך יָהֵיב לָך אַרַע עָבדָא חַלָב וֻדבָשׁ כמָא דמַלֵיל יוי אַלָהָא דַאַבָהָתָך לָך
וִיהֵי במִעבַרכֹון יָת יַרדנָא תקִימוּן יָת אַבנַיָא הָאִלֵין דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין בטוּרָא דעֵיבָל וֻתסוּדוֻתסִיד יָתהֹוןיתהין בסִידָא
ותִבנֵי תַמָן מַדבחָא קדָם יוי אַלָהָך מַדבַח אַבנִין לָא תרִים עַלֵיהֹון בַרזלָאפרזלא
אַבנִין שַׁלמָןשׁלמין תִבנֵי יָת מַדבחָא דַיוי אַלָהָך ותַסֵיק עַלֹוהִי עַלָוָן קדם יוי אַלָהָך
ותִכֹוס נִכסַת קוּדשִׁין ותֵיכֹול תַמָן ותִחדֵי קדם יוי אַלָהָך
ותִכתֹוב עַל אַבנַיָא יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא פָרֵישׁ יַאוּת
וֻמַלֵיל מֹשַׁה וכָהַנַיָא לֵיוָאֵי עִם כֹל יִשׁרָאֵל למֵימַר אַצֵית וֻשׁמַע ישׁראל יֹומָא הָדֵיןדֵין הַוֵיתָא לעַם קדָם יוי אַלָהָך
וֻתקַבֵיל למֵימרָא דַיוי אַלָהָך ותַעַבֵיד יָת פִקֹודֹוהִי ויָת קיָמֹוהִיקִיָמֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין
וֻפַקֵיד מֹשַׁה יָת עַמָא ביֹומָא הַהוּא למֵימַר
אִלֵין יקוּמוּן לבָרָכָא יָת עַמָא עַל טוּרָא דִגרִיזִין במִעבַרכֹון יָת יַרדנָא שִׁמעֹון ולֵוִי וִיהוּדָה ויִשָׁשׁכָר ויֹוסֵף וֻבִניָמִן
ואִלֵין יקוּמוּן עַל לוָטַיָאמלטטיא בטוּרָא דעֵיבָל ראוּבֵן גָד ואָשֵׁר וֻזבוּלֻן דָן ונַפתָלִי
ויָתִיבוּן לֵיוָאֵי ויֵימרוּן לכֹל אַנָשׁגבר ישׁראל קָל רַם
לִיט גַברָאגֻברָא דיַעַבֵיד צַלַםצֵילַם וֻמַתכָא מרַחַקמרֻחַק קדם יוי עֹובָד ידֵי אוּמָנָא וִישַׁוֵי בסִתרָא ויָתִיבוּן כֹל עַמָא ויֵימרוּן אָמֵן
לִיט דיִקלֵי אַבוּהִי ואִמֵיה ויֵימַר כָל עַמָא אָמֵן
לִיט דִישַׁנֵי תחוּמָא דחַברֵיה ויֵימַר כֹל עַמָא אָמֵן
לִיט דיִטעֵי עַוִירָא באֹורחָא ויֵימַר כֹל עַמָא אָמֵן
לִיט דיִצלֵי דִין גִיֹורדייר יִתַםיתים ואַרמלָא וייֵמַר כֹל עַמָא אָמֵן
לִיט דיִשׁכֹוב עִם אִיתַת אַבוּהִי אַרֵי גַלִי כַנפָא דַאַבוּהִי ויֵימַר כֹל עַמָא אָמֵן
לִיט דיִשׁכֹוב עִם כֹל בעִירָא וייֵמַר כֹל עַמָא אָמֵן
לִיט דיִשׁכֹוב עִם אַחָתֵיה בַת אַבוּהִי אֹו בַת אִימֵיה ויֵימַר כֹל עַמָא אָמֵן
לִיט דיִשׁכֹוב עִם חַמָתֵיהחמותיה ויֵימַר כֹל עַמָא אָמֵן
לִיט דיִמחֵידיקטול חַברֵיה בסִתרָא וייֵמַר כֹל עַמָא אָמֵן
לִיט דִיקַבֵיל שׁוּחדָא למִקטַללקטלא נפַשׁ דַם זַכַי ויֵימַר כֹל עַמָא אָמֵן
לִיט דלָא יקַיֵים יָת פִתגָמֵי אֹורָיתָא הָדָא למַעַבַד יָתהֹון ויֵימַר כֹל עמא אָמֵן
וִיהֵי אִם קַבָלָא תקַבֵיל למֵימרָא דַיוי אַלָהָך למִיטַר למַעַבַד יָת כֹל פִקֹודֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין ויִתנִינָך יוי אַלָהָך עִלַי עַל כֹל עַממֵי ארעא
ויֵיתִיָןויֵיתֹון עַלָך כֹל בִרכָתָא הַאִלֵין ויִדבקוּנָך אַרֵי תקַבֵיל למֵימרָא דַיוי אַלָהָך
ברִיך אַת בקַרתָא וֻברִיך אַת בחַקלָא
ברִיך וַלדָא דִמעָך ואִיבָא דאַרעָך ווַלדָא דִבעִירָך בַקרֵי תֹורָך ועַדרֵי עָנָך
ברִיך סַלָך ואָצוּתָךואסוותך
ברִיך אַת במֵיעַלָך וֻברִיך אַת במִפקָך
יִתֵין יוי יָת בַעלֵי דבָבָך דקָימִין עַלָך תבִירִין קדָמָך באֹורחָא חַדָא יִפקוּן לוָתָך וֻבִשׁבַע אֹורחָן יִיעִרקוּן מִן קדָמָך
יפַקֵיד יוי לָך יָת בִרכתָא באֹוצרָך וֻבכָל אֹושָׁטוּת ידָך וִיבָרכִינָך בארעא דַיוי אַלָהָך יָהֵיב לָך
יקִימִינָך יוי קדָמֹוהִי לעַם קַדִישׁ כמָא דקַיֵים לָך אַרֵי תִיטַר יָת פִקֹודַיָא דַיוי אַלָהָך וֻתהָך באֹורחָן דתָקנָן קדָמֹוהִי
ויִחזֹון כֹל עַממֵי ארעא אַרֵי שׁמָא דַיוי אִתקרִי עַלָך ויִדחַלוּן מִנָך
ויֹותרִינָךויותירינך יוי לטָבָא בוַלדָא דִמעָך וֻבוַלדָא דִבעִירָך וֻבאִיבָא דאַרעָך עַל ארעא דקַיֵים יוי לַאַבָהָתָך למִיתַן לָך
יִפתַח יוי לָך יָת אֹוצרֵיה טָבָא יָת שׁמַיָא למִתַן מטַר אַרעָך בעִידָנֵיה וֻלבָרָכָא יָת כֹל עוּבָדֵי ידָך ותֹוזֵיף לעַממִין סַגִיאִין ואַת לָא תזִיףתזוף
ויִתנִינָך יוי תַקִיף ולָא חַלָשׁ וֻתהֵי ברַםלחוד לעֵילָא ולָא תהֵי לתַחתָאלתחותא אַרֵי תקַבֵיל לפִקֹודַיָאלמימרא דַיוי אַלָהָך דַאַנָא מפַקֵיד לָך יֹומָא דֵין למִיטַר וֻלמַעַבַד
ולָא תִסטֹון מִכֹל פִתגָמַיָא דַאַנָא מפַקֵיד יָתכֹון יֹומָא דֵין ליַמִינָא ולִסמָלָא לִמהָך בָתַר טָעַוָת עַממַיָא למִפלַחהֹון
וִיהֵי אִם לָא תקַבֵיל למֵימרָא דַיוי אַלָהָך למִטַר למַעַבַד יָת כֹל פִיקֹודֹוהִי וֻקיָמֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין ויֵיתֹון עַלָך כֹל לוָטַיָא הָאִלֵין ויִדבקוּנָך
לִיט אַת בקַרתָא ולִיט אַת בחַקלָא
לִיט סַלָך ואָצוּתָךואסוותך
לִיט וַלדָא דִמעָך ואִיבָא דאַרעָך בַקרֵי תֹורָך ועַדרֵי עָנָך
לִיט אַת במֵיעַלָך ולִיט אַת במִיפקָך
ישַׁלַחיגרי יוי בָך יָת מאֵירתָא ויָת שִׁגוּשׁיָא ויָת מַזֹופִיתָאמזֹופִיתָא בכֹל אֹושָׁטוּת ידָך דתַעַבֵיד עַד דתִשׁתֵיצֵי ועַד דתֵיבַדדתוביד בִפרִיַע מִן קדָם בִישׁוּת עוּבָדָך דִשׁבַקתָא דַחַלתִי
יַדבֵיק יוי בָך יָת מֹותָא עַד דִישֵׁיצֵי יָתָך מֵעַל ארעא דאַת עָלֵיל לתַמָן למֵירתַה
יִמחֵינָך יוי בשַׁחַפתָא וֻבקַדַחתָא וֻבִדלֵיקתָא וֻבחַרחוּרָא וֻבחַרבָא וֻבשַׁדפָנָאובשׁידפונא וֻביַרקָנָאובירקונא ויִרדפוּנָך עַד דתֵיבַד
וִיהֹון שׁמַיָא דעִלָוֵי רֵישָׁך חַסִינִין כנחָשָׁא מִלאַחָתָא מִטרָא ואַרעָא דִתחֹותָך תַקִיפָא כבַרזלָאכפרזלא מִלמַעַבַד פֵירִין
יִתֵין יוי יָת מטַר אַרעָך אַבקָא ועַפרָא מִן שׁמַיָא יֵיחֹות עַלָך עַד דתִשׁתֵיצֵי
יִתנִינָך יוי תבִיר קדָם סָנאָךבעלי דבבך באֹורחָא חַדָא תִיפֹוק לוָתֵיה וֻבִשׁבַע אֹורחָןאורחין תעִירֹוק מִן קדָמֹוהִי וֻתהֵי לִזיָעלזעו לכֹל מַלכוָת ארעא
וֻתהֵי נבֵילתָך משַׁגרָאמשֻׁגרָא למֵיכַל לכֹל עֹופָא דִשׁמַיָא ולִבעִירָא דארעא ולֵית דמַנִיד
יִמחֵינָך יוי בשִׁחנָא דמִצרַיִם וֻבִטחֹורִין וֻבגַרבָא וֻבַחרַסובחרסונא יַבִישׁיבִישׁ דלָא תִיכֹול לאִיתַסָאָה
יִמחֵינָך יוי בטַפשׁוּתָאבטיפשׁותא וֻבסַמיוּתָאובסמאותא וֻבשַׁעממוּתובשׁעמימות לִיבָא
וֻתהֵי ממַשֵׁישׁ בטֵיהַרָאבסיהרא כמָא דִממַשֵׁישׁדִימַשֵׁישׁ עַוִירָא בקַבלָא ולָא תַצלַח יָת אֹורחָתָך וֻתהֵי ברַםלחוד עַשִׁיקעשִׁיק וַאַנִיס כֹל יֹומַיָא ולֵית דפָרִיק
אִיתתָא תֵירוּס וֻגבַר אוּחרָןאָחָרָן יִשׁכבִינַה בֵיתָא תִבנֵי ולָא תִתֵיב בֵיה כַרמָא תִיצוּבתנציב ולָא תַחַלִינֵיהתחלליניה
תֹורָך יהֵי נכִיס לעֵינָך ולָא תֵיכֹול מִנֵיה חַמָרָךחַמָרָך יהֵי אַנִיסאנִיס מִן קדָמָך ולָא יתוּב לָך עָנָך מסִירָן לבַעלֵי דבָבָך ולֵית לָך פָרִיק
בנָך וֻבנָתָך מסִירִיןמסִירָן לעַם אוּחרָןאָחָרָן ועֵינָך חָזיָן וִיסוּפָןויסופון בִגלַלהֹון כֹל יֹומָא ולֵית חֵילָא בִידָך
אִיבָא דאַרעָך וכָל לֵיאוּתָך יֵיכֹול עַם דלָא ידַעתָא וֻתהֵי ברַםלחוד עַשִׁיקעשִׁיק וֻרעִיַעורציץ כֹל יֹומַיָא
וֻתהֵי מִשׁתַטֵי מֵיחֵיזוּ עֵינָך דִתהֵי חָזֵי
יִמחֵינָך יוי בשִׁחנָאבשׁחינא בִישָׁא עַל רכוּבִין ועַל שָׁקִיןשׁוקין דלָא תִיכֹול לאִיתַסָאָה מִפַרסַת רַגלָך ועַד מוּחָך
יַגלֵי יוי יָתָך ויָת מַלכָך דִתקִיםדתוקים עַלָך לעַם דלָא ידַעתָא אַת וַאַבָהָתָך ותִפלַח תַמָן לעַממַיָא פָלחֵי טָעַוָתָא אָעָא ואַבנָא
וֻתהֵי לצָדוּ לִמתַללִמתָל וֻלשֹׁועִי בכֹל עַממַיָא דִידַברִינָךדאגלך יוי לתַמָן
בַר זרַע סַגִי תַפֵיק לחַקלָא וֻזעֵיר תִכנֹושׁתכנישׁ אַרֵי יַחסלִינֵיהיחסניניה גֹובָא
כַרמִין תִיצוּבתנציב ותִפלַח וחַמרָא לָא תִשׁתֵי ולָא תִכנֹושׁ אַרֵי תֵיכלִינֵיה תֹולַעתָא
זֵיתִין יהֹון לָך בכֹל תחוּמָך וֻמִשׁחָא לָא תשׁוּףתסוך אַרֵי יִתרוּן זֵיתָך
בנִין וֻבנָן תלִידתֹולִיד ולָא יהֹון לָך אַרֵי יהָכוּן בשִׁביָא
כֹל אִילָנָך ואִיבָא דאַרעָך יַחסנִינֵיהיתריך סַקָאָה
תֹותָב עַרַל דבֵינָך יהֵי סָלֵיק עֵיל מִינָך לעֵילָא לעֵילָא ואַת תהֵי נָחֵית לתַחתָא לתַחתָא לתתא לתתא
הוּא יֹוזפִינָך ואַת לָא תֹוזפִינֵיהתזופיניה הוּא יהֵי תַקִיף ואַת תהֵי חַלָשׁ
ויֵיתֹון עַלָך כֹל לוָטַיָא הָאִלֵין ויִרדפוּנָך ויִדבקוּנָך עַד דתִשׁתֵיצֵי אַרֵי לָא קַבֵילתָא למֵימרָא דַיוי אַלָהָך למִיטַר פִקֹודֹוהִי וֻקיָמֹוהִי דפַקדָך
וִיהֹון בָך לאָת וֻלמֹופַת ובִבנָך עַד עָלמָא
חַלָף דלָא פלָחתָא קדם יוי אַלָהָך בחַדוָא וֻבשַׁפִירוּתובקשׁיטות לִיבָא מִיסגֵי כֹולָא
ותִפלַח יָת בַעַלֵי דבָבָך דִיגָרֵינוּן יוי בָך בכַפנָא וֻבצָהוּתָאובצחותא וֻבעַרטִלָיוּתָא וֻבחַסִירוּת כֹולָא ויִתֵין נִיר דבַרזַלפרזלא עַל צַורָך עַד דִישֵׁיצֵי יָתָך
יַיתֵי יוי עַלָך עַם מֵרַחִיק מִסִיָפֵימִסיָפֵי ארעא כמָא דמִשׁתַדֵידמִשׁתדֵי נִשׁרָא עַמָא דלָא תִשׁמַעתִדַעתקבל לִישָׁנֵיה
עַם תַקִיף אַפִין דלָא נסֵיב אַפֵי סָבָא ועַל יָנקָא לָא מרַחֵים
ויֵיכֹול וַלדָא דִבעִירָך ואִיבָא דאַרעָך עַד דתִשׁתֵיצֵי דלָא יַשׁאַר לָך עִיבוּרָא חַמרָא וֻמִשׁחָא בַקרֵי תֹורָך ועַדרֵי עָנָך עַד דיֹובֵידדיֵיבֹוד יָתָך
וִיעִיק לָך בכֹל קִרוָך עַד דִיכַבֵישׁדיכבושׁ שׁוּרָך רָמַיָאכריכתא וֻכרִיכַיָאותקיפתא דאַת רחִיץ לאִשׁתֵיזָבָא בהֹון בכֹל אַרעָךקירוך וִיעִיק לָך בכֹל קִרוָך בכֹל אַרעָך דִיהַב יוי אַלָהָך לָך
ותִיכֹול וַלדָא דִמעָך בסַר בנָך וֻבנָתָך דִיהַב לָך יוי אַלָהָך בִציָרָא וֻבעָקתָא דִיעִיק לָך סָנאָך
גַברָאגֻברָא דרַכִיך בָך ודִמפַנַקודִמפֻנַק לַחדָא תִבאַשׁתבאישׁ עֵינֵיה בַאַחוּהִי וֻבאִיתַת קִיָמֵיהקיָמֵיה וֻבִשׁאָר בנֹוהִי דיַשׁאַרדישׁתאר
מִלמִיתַן לחַד מִנהֹון מִבסַר בנֹוהִי דיֵיכֹול מִדלָא אִשׁתאַרישׁאר לֵיה כֹולָא בִציָרָא וֻבעָקתָא דִיעִיק לָך סָנאָך בכֹל קִרוָך
דרַכִיכָא בָך ודִמפַנקָאודִמפֻנקָא דלָא נַסִיאַת פַרסַת רַגלַה לַאַחָתָא עַל אַרעָא מִפַנַקוּמִמפֻנקוּ וֻמֵירַכִיכוּ תִבאַשׁתבאישׁ עֵינַה בִגבַר קיָמַה וֻבִברַה וֻבִברַתַה
וֻבִזעֵיר בנַהָא דיִפקוּן מִינַה וֻבִבנַהָא דִתלִידדתוליד אַרֵי תֵיכֹולִינוּןתֵיכַלִינוּן בחַסִירוּת כֹולָא בסִתרָא בִציָרָא וֻבעָקתָא דִיעִיק לָך סָנאָך בקִרוָך
אִם לָא תִיטַר למַעַבַד יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא דִכתִיבִין בסִפרָא הָדֵין למִדחַל יָת שׁמָא יַקִירָארַבָא וֻדחִילָא הָדֵין יָת יוי אַלָהָך
ויַפרֵישׁ יוי יָת מַחָתָך ויָת מַחַת בנָך מַחָן רַברבָןסגיאן וֻמהֵימנָן וֻמַכתָשִׁיןומרעין בִישִׁין וֻמהֵימנִין
ויָתֵיב בָך יָת כֹל מַכתָשֵׁי מִצרַיִם דִדחֵילתָא מִן קדָמֵיהֹון ויִדבקוּן בָך
אַף כֹל מרַע וכֹל מַחָא דלָא כתִיבִין בִספַר אֹורָיתָא הָדָאהדין יַיתֵינוּןיסקינון יוי עַלָך עַד דתִשׁתֵיצֵי
ותִשׁתאַרוּןותִשׁתַארוּן בעַם זעֵירדמנין חַלָף דַהוֵיתֹון ככֹוכבֵי שׁמַיָא לִסגֵי אַרֵי לָא קַבֵילתָא למֵימרָא דַיוי אַלָהָך
וִיהֵי כמָא דַחדִי יוי עַלֵיכֹון לאֹוטָבָאלאֵיטָבָא יָתכֹון וֻלאַסגָאָה יָתכֹון כֵין יִחדֵי יוי עַלֵיכֹון לאֹובָדָא יָתכֹון וֻלשֵׁיצָאָה יָתכֹון ותִיטַלטלוּן מֵעַל ארעא דאַת עָלֵיל לתַמָן למֵירתַה
וִיבַדרִינָך יוי בכֹל עַממַיָא מִסִיָפֵימִסיָפֵי ארעא ועַד סִיָפֵיסיָפֵי ארעא ותִפלַח תַמָן לעַמָמַיָא פָלחֵי טָעַוָתָא דלָא ידַעתָא אַת וַאַבָהָתָך אָעָא ואַבנָא
וֻבעַממַיָא הָאִינוּן לָא תנוּחַ ולָא יהֵי מנָח לפָרסַת רַגלָך ויִתֵין יוי לָך תַמָן לַב דָחוּלדחיל וחַשׁכוּת עֵינִין וֻמַפחָת נפַשׁ
וִיהֹון חַייָך תלַן לָך מִקבַלמִקָבֵיל וֻתהֵי תָוַהפחיד בלֵיליָא וֻבִימָמָא ולָא תהֵימֹוןתהֵימֵין בחַייָך
בצַפרָא תֵימַר מַן יִתֵין רַמשָׁא וֻברַמשָׁא תֵימַר מַן יִתֵין צַפרָא מִתִיוהַתמתוהות לִיבָך דִתהֵי תָוַה וֻמֵיחֵיזוּ עֵינָך דִתהֵי חָזֵי
ויָתִיבִינָך יוי למִצרַיִם בִספִינָן באֹורחָא דַאַמַרִית לָך לָא תֹוסֵיף עֹוד למִחזַה ותִזדַבנוּן תַמָן לבַעלֵי דבָבֵיכֹון לעַבדִין וֻלאַמהָן ולֵית דקָנֵי
אִלֵין פִתגָמֵי קִיָמָאקיָמָא דפַקֵיד יוי יָת מֹשַׁה למִגזַר עִם בנֵי ישׁראל בארעא דמֹואָב בָר מִקִיָמָא דִגזַר עִמהֹון בחֹורֵב
וֻקרָא מֹשַׁה לכֹל ישׁראל וַאַמַר להֹון אַתוּן חַזֵיתֹון יָת כֹל דַעַבַד יוי לעֵינֵיכֹון באַרעָא דמצרים לפַרעֹה וֻלכָל עַבדֹוהִי וֻלכָל אַרעֵיה
נִסִין רַברבִיןרַברבָן דַחזַאָה עֵינָך אָתַיָא וֻמֹופתַיָא רַברבַיָא הָאִינוּן
ולָא יהַב יוי לכֹון לִיבָא למִידַע ועֵינִין למִחזֵי ואוּדנִין למִשׁמַע עַד יֹומָא הָדֵין
ודַבַרִית יָתכֹון אַרבעִין שׁנִין במַדברָא לָא בלִאיַת כסוּתכֹון מִנכֹון וֻמסָנָך לָא עַדֹויחיפו מֵעַל רַגלָך
לַחמָא לָא אַכַלתוּן וַחמַר חַדַת ועַתִיקומרוי לָא שׁתֵיתֹון בדִיל דתִדעוּן אַרֵי אַנָא יהוה אַלָהַכֹון
וַאַתֵיתֹון לאַתרָא הָדֵין וֻנפַק סִיחֹון מַלכָא דחַשׁבֹון ועֹוג מַלכָא דמַתנַן לקַדָמוּתַנָא לאָגָחָא קרָבָא וֻמחֵינָנוּן
וֻנסֵיבנָאוכבשׁנא יָת אַרַעהֹון וִיהַבנַה לאַחסָנָא לשֵׁיבַט ראוּבֵן וֻלשֵׁיבַט גָד וֻלפַלגוּת שִׁבטָא דִמנַשַׁה
ותִיטרוּן יָת פִתגָמֵי קִיָמָאקיָמָא הָדֵיןהדא ותַעבדוּן יָתהֹון בדִיל דתַצִלחוּןדתשׁכלון יָת כֹל דתַעבדוּן
אַתוּן קָימִיןקַיָמִין יֹומָא דֵין כוּלכֹון קדם יוי אַלָהַכֹון רֵישֵׁיכֹון שִׁבטֵיכֹון סָבֵיכֹון וסָרכֵיכֹון כֹל אַנָשׁ ישׁראל
טַפלכֹון נשֵׁיכֹון וגִיֹורָך דִבגֹו מַשׁרִיָתָךמַשׁרִיתָך מִלָקֵיט אָעָך עַד מָלֵי מָךמַיָךמימך
לאַעָלוּתָך בִקיָמָא דַיוי אַלָהָך וֻבמֹומָתֵיה דַיוי אַלָהָך גָזַר עִמָך יֹומָא דֵין
בדִיל לקַיָמָאלאָקָמָא יָתָך יֹומָא דֵין קדָמֹוהִי לעַם והוּא יִהוֵי לָך לַאַלָה כמָא דמַלֵיל לָך וֻכמָא דקַיֵים לַאַבָהָתָך לאברהם ליִצחָק וליעקב
ולָא עִמכֹון בִלחֹודֵיכֹון אַנָא גָזַר יָת קִיָמָאקיָמָא הָדֵין ויָת מֹומָתָא הָדָא
אַרֵי יָת מַן דאִיתֹוהִי הָכָא עִמַנָא קָאֵים יֹומָא דֵין קדָם יוי אַלָהַנָא ויָת מַן דלָיתֹוהִי הָכָא עִמַנָא יֹומָא דֵין
אַרֵי אַתוּן ידַעתוּן יָת דִיתֵיבנָא בארעא דמצרים ויָת דַעַבַרנָא בֵינֵי עַממַיָא דִיתֵיבתוּןדַעבַרתוּן
וַחזֵיתֹון יָת שִׁקוּצֵיהֹון ויָת טָעַוָתהֹון אָעָא ואַבנָא כַספָא ודַהבָא דעִימהֹון
דִלמָא אִית בכֹון גבַר אֹו אִיתָא אֹו זַרעִי אֹו שִׁבטָא דלִבֵיה פנִיטעי יֹומָא דֵין מִדַחַלתָא דַיוי אַלָהַנָא למִפלַחלִמהָך יָת טָעַוָת עַממַיָא הָאִינוּן דִלמָא אִית בכֹון גבַר מהַרהֵיר חִטאִיןחטִין אֹו זָדֹון
וִיהֵי במִשׁמעֵיה יָת פִתגָמֵי מֹומָתָא הָדָא וִיחַשֵׁיב בלִיבֵיה למֵימַר שׁלָמָא יהֵי לִי אַרֵי בהַרהוּרבהירהור לִבִי אַנָא אָזֵיל בדִיל לאֹוסָפָא לֵיה חִטאֵיחטָאֵי שָׁלוּתָא עַל זֵידָנוּתָאזדונותא
לָא יֵיבֵי יוי למִשׁבַק לֵיה אַרֵי בכֵין יִתקַףיתקוף רוּגזָא דַיוי וחִמתֵיה בגַברָאבגֻברָא הַהוּא ויִדבקוּן בֵיה כֹל לוָטַיָא דִכתִיבִין בסִפרָא הָדֵין ויִמחֵי יוי יָת שׁמֵיה מִתחֹות שׁמַיָא
ויַפרשִׁינֵיה יוי לבִישׁוּ מִכֹל שִׁבטַיָא דישׁראל ככֹל לוָטֵי קִיָמָאקיָמָא דִכתִיבִין בִספַר אֹורָיתָא הָדָא
ויֵימַר דָרָא בָתרָאָה בנֵיכֹון דִיקוּמוּן מִבָתרֵיכֹון וֻבַר עַממִין דיֵיתֵי מֵאַרַע רַחִיקָא ויִחזֹון יָת מַחָתַה דארעא הַהִיא ויָת מַרעַהָא דאַמרַע יוי בַה
גוּפרֵיתָא וֻמֵלחָאוֻמִלחָא תהֵי יָקדָאיקידא כֹל אַרעַה לָא תִזדרַעתזרע ולָא תצַמַח ולָא יִסַק בַה כֹל עֵיסַב כַהפֵיכתָאכמהפכתא דִסדֹום וַעַמֹורָה אַדמָה וֻצבֹואִים דַהפַך יוי ברוּגזֵיה וֻבחִמתֵיה
ויֵימרוּן כֹל עַממַיָא עַל מָא עַבַד יוי כדֵין לאַרעָא הָדָא מָא תקֹוף רוּגזָא רַבָא הָדֵין
ויֵימרוּן עַל דִשׁבַקוּ יָת קִיָמָא דַיוי אַלָהָא דַאַבָהָתהֹון דִיגזַר עִמהֹון באַפָקוּתֵיה יָתהֹון מֵאַרעָא דמצרים
וַאַזַלוּ וֻפלַחוּ לטָעַוָת עַממַיָא וֻסגִידוּ להֹוןלהין דַחלָן דלָא ידַעוּנִין ולָא אֹוטִיבָא להֹון
וֻתקֵיף רוּגזָא דַיוי בארעא הַהִיא לאֵיתָאָה עַלַה יָת כֹל לוָטַיָא דִכתִיבִין בסִפרָא הָדֵין
וטַלטֵילִינוּן יוי מֵעַל אַרַעהֹון בִרגַז וֻבִחמָאובחימה וֻבִתקֹוף רַב ואַגלִינוּן לַאַרַע אוּחרִיאָחָרִי כיֹומָא הָדֵין
דמִטַמרָן קדָם יוי אַלָהַנָא וֻדגַליָן לַנָא ולִבנַנָא עַד עָלמָא למַעַבַד יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא
וִיהֵי אַרֵי יֵיתֹוןייעלון עַלָך כֹל פִתגָמַיָא הָאִלֵין בִרכָן וֻלוָטִין דִיהַבִית קדָמָך ותָתֵיב ללִיבָך בכָל עַממַיָא דאַגלִיָך יוי אַלָהָך לתַמָן
וֻתתוּב לדַחַלתָא דַיוי אַלָהָך וֻתקַבֵיל למֵימרֵיה ככֹל דַאַנָא מפַקֵיד לָך יֹומָא דֵין אַת וֻבנָך בכֹל לִיבָך וֻבכָל נַפשָׁך
ויָתֵיב יוי אַלָהָך יָת שָׁבֵישׁבות גָלוָתָך וִירַחֵים עַלָך וִיתוּב ויִכנשִׁינָך מִכֹל עַממַיָא דבַדרָך יוי אַלָהָך לתַמָן
אִם יִהוִיָןיִהויָן גָלוָתָך בִסִיָפֵיבִסיָפֵי שׁמַיָא מִתַמָן יִכנשִׁינָך יוי אַלָהָך וֻמִתַמָן יקָרבִינָךידברינך
ויַעֵילִינָך יוי אַלָהָך לארעא דִירִיתוּ אַבָהָתָך ותֵירתַה ויֹוטֵיב לָך ויַסגֵינָךויפישׁנך מֵאַבָהָתָך
ויַעַדֵי יוי אַלָהָך יָת טַפשׁוּתטיפשׁות לִיבָך ויָת טַפשׁוּתטיפשׁות לִיבָא דִבנָך למִרחַם יָת יוי אַלָהָך בכֹל לִיבָך וֻבכָל נַפשָׁך בדִיל חַייָך
ויִתֵין יוי אַלָהָך יָת כֹל לוָטַיָא הָאִלֵין עַל בַעַלֵי דבָבָך ועַל סָנאָך דרַדפוּך
ואַת תתוּב וֻתקַבֵיל למֵימרָא דַיוי ותַעַבֵיד יָת כֹל פִקֹודֹוהִי דַאַנָא מפַקֵיד לָך יֹומָא דֵין
ויֹותרִינָך יוי אַלָהָך בכֹל עוּבָדֵי ידָך בוַלדָא דִמעָך וֻבוַלדָא דִבעִירָך וֻבאִיבָא דאַרעָך לטָבָא אַרֵי יתוּב יוי למִחדֵי עַלָך לטָב כמָא דַחדִי עַל אַבָהָתָך
אַרֵי תקַבֵיל למֵימרָא דַיוי אַלָהָך למִיטַר פִקֹודֹוהִי וֻקיָמֹוהִי דִכתִיבִין בִספַר אֹורָיתָא הָדֵין אַרֵי תתוּב לדַחַלתָא דַיוי אַלָהָך בכֹל לִיבָך וֻבכָל נַפשָׁך
אַרֵי תַפקֵידתָא הָדָא דַאַנָא מפַקֵיד לָך יֹומָא דֵין לָא מפָרשָׁא היא מִינָך ולָא רַחִיקָא הִיא
לָא בִשׁמַיָא הִיא למֵימַר מַן יִסַק לַנָא לִשׁמַיָא ויִסבַה לַנָא ויַשׁמעִינַנָא יָתַה ונַעבדִינַה
ולָא מֵעִברָא ליַמָא הִיא למֵימַר מַן יעִיבַר לַנָא לעֵיבַר יַמָא ויִסבַה לַנָא ויַשׁמעִינַנָא יָתַה ונַעבדִינַה
אַרֵי קָרִיב לָך פִתגָמָא לַחדָא בפוּמָך וֻבלִיבָך למַעבדֵיה
חַזִיחזֵי דִיהַבִית קדָמָך יֹומָא דֵין יָת חַיֵי ויָת טָבתָא ויָת מֹותָא ויָת בִשׁתָא
דַאַנָא מפַקֵיד לָך יֹומָא דֵין למִרחַם יָת יוי אַלָהָך לִמהָך באֹורחָן דתָקנָן קדָמֹוהִי וֻלמִיטַר פִקֹודֹוהִי וֻקיָמֹוהִי ודִינֹוהִי ותֵיחֵי ותִסגֵי וִיבָרכִינָך יוי אַלָהָך באַרעָא דאַת עָלֵיל לתַמָן למֵירתַה
ואִם יִתפנֵי לִיבָך ולָא תקַבֵיל ותִטעֵי ותִסגֹוד לטָעַוָת עַממַיָא ותִפלַחִינִין
חַוִיתִי לכֹון יֹומָא דֵין אַרֵי מֵיבַד תֵיבדוּןתובדון לָא תֵירכוּןתורכון יֹומִין עַל אַרעָא דאַת עָבַר יָת יַרדנָא למֵיעַל לתַמָן למֵירתַה
אַסהֵידִית בכֹון יֹומָא דֵין יָת שׁמַיָא ויָת אַרעָא חַיֵי וֻמֹותָא יהַבִית קדָמָך בִרכָן וֻלוָטִין ותִתרעֵי בחַיֵי בדִיל דתֵיחֵי אַת וֻבנָך
למִרחַם יָת יוי אַלָהָך לקַבָלָא למֵימרֵיה וֻלאִתקָרָבָאולקרבא לדַחַלתֵיה אַרֵי הוּא חַייָך ואֹורָכוּתואוריכות יֹומָך למִיתַב עַל אַרעָא דקַיֵים יוי לַאַבָהָתָך לאַברָהָם ליִצחָק וֻליַעַקֹב למִיתַן להֹון
וַאַזַל מֹשַׁה וֻמַלֵיל יָת פִתגָמַיָא הָאִלֵין עִם כֹל יִשׁרָאֵל
וַאַמַר להֹון בַר מאָה ועַסרִין שׁנִין אַנָא יֹומָא דֵין לֵית אַנָא יָכִיליָכֵיל עֹוד למִפַק וֻלמֵיעַל וַיוי אַמַר לִי לָא תעִיבַר יָת יַרדנָא הָדֵין
יוי אַלָהָך הוּא עָבַר קדָמָך הוּא ישֵׁיצֵי יָת עַממַיָא הָאִלֵין מִן קדָמָך ותִירתִינוּןותֵירתִינוּן יהֹושֻׁעַ הוּא עָבַר קדָמָך כמָא דמַלֵיל יוי
ויַעַבֵיד יוי להֹון כמָא דַעַבַד לסִיחֹון וֻלעֹוג מַלכֵי אַמֹורָאָה וֻלאַרַעהֹון דשֵׁיצִי יָתהֹון
ויִמסרִינוּן יוי קדָמֵיכֹון ותַעבדוּן להֹון ככֹל תַפקֵידתָא דפַקֵידִית יָתכֹון
תקַפוּתקֻפוּ ועֵילַמוּואלימו לָא תִדחַלוּן ולָא תִיתַברוּן מִן קדָמֵיהֹון אַרֵי יוי אַלָהָך מֵימרֵיה מדַבַר קדָמָך לָא יִשׁבקִינָך ולָא ירַחַקִינָך
וֻקרָא מֹשַׁה לִיהֹושֻׁעַ וַאַמַר לֵיה לעֵינֵי כֹל ישׁראל תקַף ועֵילַםועליםואֵילַם אַרֵי אַת תֵיעֹול עִם עַמָא הָדֵין לאַרעָא דקַיֵים יוי לַאַבָהָתהֹון למִיתַן להֹון ואַת תַחסנִינַה להֹון
וַיוי הוּא מדַבַר קדָמָך מֵימרֵיה יהֵי בסַעַדָך לָא יִשׁבקִינָך ולָא ירַחַקִינָךירחיקינך לָא תִידחַל ולָא תִיתבַר
וֻכתַב מֹשַׁה יָת אֹורָיתָא הָדָא ויַהבַה לכָהַנַיָא בנֵי לֵוִי דנָטלִין יָת אַרֹון קִיָמָאקיָמָא דַיוי וֻלכָל סָבֵי ישׁראל
וֻפַקֵיד מֹשַׁה יָתהֹון למֵימַר מִסֹוף שׁבַע שׁנִין בִזמַן שַׁתָא דִשׁמִיטתָא בחַגָא דִמטַלַיָא
במֵיתֵי כֹל יִשׁרָאֵל לאִתַחזָאָה קדָם יוי אַלָהָך באַתרָא דיִתרעֵי תִקרֵי יָת אֹורָיתָא הָדָא קדָם כֹל יִשׁרָאֵל ותַשׁמַעִינוּן
כנֹושׁאכנישׁ יָת עַמָא גַברַיָאגֻברַיָא וֻנשַׁיָא וטַפלָא וגִיֹורָך דִבקִרוָך בדִיל דיִשׁמעוּן וֻבדִיל דיֵילפוּן ויִדחַלוּן קדָם יוי אַלָהַכֹון ויִטרוּן למַעַבַד יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא
וֻבנֵיהֹון דלָא ידַעוּ יִשׁמעוּן ויֵילפוּן למִדחַל קדָם יוי אַלָהַכֹון כֹל יֹומַיָא דאַתוּן קַיָימִין עַל אַרעָא דַאַתוּן עָברִין יָת יַרדנָא לתַמָן למֵירתַה
וַאַמַר יוי למֹשַׁה הָא קרִיבוּ יֹומָך לִיממָת קרִי יָת יהֹושֻׁעַ ואִתעַתַדוּ במַשׁכַן זִמנָא וַאַפַקדִינֵיה וַאַזַל מֹשַׁה וִיהֹושֻׁעַ ואִתעַתַדוּ במַשׁכַן זִמנָא
ואִתגלִי יוי במַשׁכנָא בעַמוּדָא דַעַנָנָא וקָם עַמוּדָא דַעַנָנָא עַל תרַע מַשׁכנָא
וַאַמַר יוי למֹשַׁה הָא אַת שָׁכֵיב עִם אַבָהָתָך וִיקוּם עַמָא הָדֵין ויִטעֵי בָתַר טָעַוָת עַממֵי אַרעָא דהוּא עָלֵיל לתַמָן בֵינֵיהֹון ויִשׁבקוּן דַחַלתִי וִישַׁנֹון יָת קיָמִיקִיָמִי דִגזַרִית עִמהֹון
ויִתקַףויִתקֹוף רוּגזִי בהֹון בעִדָנָאביומא הַהוּא וַאַרַחֵיקִינוּן וַאַסַלֵיק שׁכִינתִי מִנהֹון וִיהֹון למִיבַזלמיכל ויִעָרעָן יָתהֹון בִישָׁן סַגִיאָן ועָקָן וייֵמַר בעִדָנָאביומא הַהוּא הַלָא מִדלֵית שׁכִינַת אַלָהִי בֵינַי עָרַעַנִי בִישָׁתָא הָאִלֵין
וַאַנָא סַלָקָא אַסַלֵיק שׁכִינתִי מִנהֹון בעִדָנָאביומא הַהוּא עַל כֹל בִשָׁתָאבישׁיא דַעַבַדוּ אַרֵי אִתפנִיאוּ בָתַר טָעַוָת עַממַיָא
וֻכעַן כתוּבוּכתיבו לכֹון יָת תוּשׁבַחתָא הָדָא ואַלִיפָאואַלפַה לִבנֵי יִשׁרָאֵל שַׁוִיהָא בפוּמהֹון בדִיל דִתהֵי קדָמַי תוּשׁבַחתָא הָדָא לסָהִיד בִבנֵי יִשׁרָאֵל
אַרֵי אַעֵילִינוּן לארעא דקַיֵימִית לַאַבָהָתהֹון עָבדָא חַלָב וֻדבָשׁוֻדבַשׁ וייֵכלוּן ויִסבעוּן ויִתפַנקוּן ויִתפנֹון בָתַר טָעַוָת עַממַיָא ויִפלחוּן להֹוןלהין ויַרגזוּןויִרגזוּן קדָמַי ויִשַׁנֹון יָת קִיָמִיקיָמִי
וִיהֵי אַרֵי יעָרעָן יָתהֹון בִישָׁן סַגִיאָן ועָקָן ותָתֵיב תוּשׁבַחתָא הָדָא קדָמֹוהִי לסָהִיד אַרֵי לָא תִתנשֵׁי מִפֹום בנֵיהֹון אַרֵי גלֵי קדָמַי יִצרהֹון דאִינוּן עָבדִין יֹומָא דֵין עַד לָא אַעֵילִינוּן לארעא דקַיֵימִית
וֻכתַב מֹשַׁה יָת תוּשׁבַחתָא הָדָא ביֹומָא הַהוּא ואַלפַה יָת בנֵי יִשׁרָאֵל
וֻפַקֵיד יָת יהֹושֻׁעַ בַר נוּן וַאַמַר תקַףתקיף ועֵילַםועליםואלים אַרֵי אַת תַעֵיל יָת בנֵי ישׁראל לארעא דקַיֵימִית להֹון וֻמֵימרִי יהֵי בסַעַדָך
וַהַוָה כַד שֵׁיצִי מֹשַׁה למִכתַב יָת פִתגָמֵי אֹורָיתָא הָדָא עַל סִפרָא עַד דִשׁלִימוּ
וֻפַקֵיד מֹשַׁה יָת לֵיוָאֵי נָטלֵי אַרֹון קִיָמָאקיָמָא דַיוי למֵימַר
סוּבוּסַבוּקבילו יָת סִפרָא דאֹורָיתָא הָדֵיןהָדָא וֻתשַׁוֹון יָתֵיה מִסטַר אַרֹון קִיָמָאקיָמָא דַיוי אַלָהַכֹון וִיהֵי תַמָן בָך לסָהִיד
אַרֵי אַנָא יָדַענָא יָת סָרבָנוּתָך ויָת קדָלָך קַשׁיָא הָא עַדבעוד דַאַנָא קַיָם עִמכֹון יֹומָא דֵין מסָרבִין הַוֵיתֹון קדם יוי ואַף בָתַר דאֵימוּת
כנוּשׁוּאכנישׁו לוָתִי יָת כֹל סָבֵי שִׁבטֵיכֹון וסָרכֵיכֹון וַאַמַלֵיל קדָמֵיהֹון יָת פִתגָמַיָא הָאִלֵין ואַסהֵיד בכֹון יָת שׁמַיָא ויָת ארעא
אַרֵי יָדַענָא בָתַר דאֵימוּת אַרֵי חַבָלָא תחַבלוּן ותִסטֹון מִן אֹורחָא דפַקֵידִית יָתכֹון אַרֵי תעָרַע יָתכֹון בִשׁתָא בסֹוף יֹומַיָא אַרֵי תַעבדוּן יָת דבִישׁ קדם יוי לאַרגָזָא קדָמֹוהִי בעֹובָדֵיבעוּבָדֵי ידֵיכֹון
וֻמַלֵיל מֹשַׁה קדָם כֹל קהָלָא דישׁראל יָת פִתגָמֵי תוּשׁבַחתָא הָדָא עַד דִשׁלִימוּ
אַצִיתוּ שׁמַיָא וַאַמַלֵיל ותִשׁמַע ארעא מֵימרֵי פוּמִי
יִבסַם כמִטרָא אוּלפָנִי יִתקַבַל כטַלָא מֵימרִי כרוּחֵיכרַוחֵי מִטרָא דנָשׁבִין עַל דִתאָה וכִרסִיסֵי מַלקֹושָׁא דעַל עִסבָא
אַרֵי בִשׁמָא דַיוי אַנָא מצַלֵי הַבוּהֻבוּ רבוּתָארבו קדָם אַלָהַנָא
תַקִיפָא דשָׁלמִין עֹובָדֹוהִי אַרֵי כֹל אֹורחָתֵיה דִינָא אַלָהָא מהֵימנָא דמִן קדָמֹוהִי עַולָא לָא נָפֵיק מִן קדָם דזַכַי וקַשִׁיט הוּא
חַבִילוּ להֹון לָא לֵיה בנַיָא דִפלַחוּ לטָעַוָתָא דָרָא דאַשׁנִי עֹובָדֹוהִי ואִשׁתַנַיוּ
הָא קדם יוי אַתוּן גָמלִין דָא עַמָא דקַבִילוּ אֹורָיתָא ולָא חַכִימוּ הַלָא הוּא אַבוּך אַת דִילֵיה הוּא עָבדָך ואַתקנָך
אִידכַראִידַכַר יֹומִין דמִן עָלמָא אִסתַכַל בִשׁנֵי דָר ודָר שׁאַל אַבוּך וִיחַוֵי לָך סָבָך ויֵימרוּן לָך
באַחסָנָא עִלָאָה עַממַיָא בפָרָשׁוּתֵיהבאפרשׁותיה בנֵי אַנָשָׁא קַיֵים תחוּמֵי עַממַיָא למִניַן בנֵי ישׁראל
אַרֵי חוּלָקֵיה דַיוי עַמֵיה יַעַקֹב עַדַבעדַב אַחסָנתֵיה
סֹופֵיקסיפיק צוּרכֵיהֹון באַרַע מַדברָא בֵית צַהוָנָאצחונא אַתַר דלֵית מַיָא אַשׁרֵינוּן סחֹור סחור לִשׁכִינתֵיה אַלַיפִינוּןאַלֵיפִינוּן פִתגָמֵי אֹורָיתֵיה נטַרִינוּן כבָבַת עֵינהֹון
כנִשׁרָא דִמחִישׁ לקִנֵיה עַל בנֹוהִי מִתחֹופַףמִתחָפַף פָרֵיסמפרשׁ גַדפֹוהִי מקַבֵילהֹון מנַטֵילהֹון עַל תקֹוף אַברֹוהִיאיברוהי
יוי בִלחֹודֵיהֹון עַתִיד לאַשׁרָיוּתהֹון בעָלמָא דהוּא עַתִיד לאִתחַדָתָאלחדתא ולָא יִתקַיַים קדָמֹוהִי פוּלחַן טָעַוָן
אַשׁרֵינוּן עַל תוּקפֵי ארעא ואֹוכֵילִינוּן בִיזַת סָנאֵיהֹון יהַב להֹון בִזַת שַׁלִיטֵי קִרוִין ונִכסֵי יָתבֵי כַרכִין תַקִיפִין
יהַב להֹון בִיזַת מַלכֵיהֹון ושַׁלִיטֵיהֹוןותקיפֵהון עִם עֹותַר רַברבֵיהֹוןרברבניהון ותַקִיפֵיהֹון עַמָא דַאַרַעהֹון אַחסָנַתהֹון עִם בִיזַת חֵילֵיהֹון וֻמַשִׁריָתהֹון ודַם גִיבָרֵיהֹון יִתאַשַׁדאיתשׁד כמַיָא
עַתַרעתַר ישׁראל וֻבעַט אַצלַח תקֹוף קנָא נִכסִין שׁבַק פוּלחַן אַלָהָא דעָבדֵיה אַרגֵיז קדָם תַקִיפָא פָרקֵיה
אַקנִיוּ קדָמֹוהִי בפוּלחַן טָעַוָן בתֹועֵיבָתָא אַרגִיזוּ קדָמֹוהִי
דַבַחוּ לשֵׁדִין דלֵית בהֹון צרֹוך דַחלָן דלָא ידַעוּנִין חַדָתָן דמִקָרִיב אִתעַבִידָא דלָא אִתעַסַקוּאיתעסיקו בהֹוןבהין אַבָהָתהֹון
דַחלַת תַקִיפָא דִברָך אִתנשִׁיתָא שׁבַקתָא פוּלחַן אַלָהָא דעָבדָךדברך
וֻגלֵי קדם יוי וֻתקֵיף רוּגזֵיה מִדאַרגִיזוּ קדָמֹוהִי בנִין וֻבנָן
וַאמַר אַסַלֵיק שׁכִינתִי מִנהֹון גלֵי קדָמַי מָא יהֵי בסֹופהֹון אַרֵי דָרָא דאַשׁנִידאשׁניו אִנוּן בנַיָא דלֵית בהֹון הֵימָנוּ
אִינוּן אַקנִיאוּ קדָמַי בלָא דַחלָא אַרגִיזוּ קדָמַי בטָעַוָתהֹוןבפולחן טעואן וַאַנָא אַקנֵינוּן בלָא עַם בעַמָא טַפשָׁא אַרגֵיזִינוּן
אַרֵי קִדוּם תַקִיף כאִישָׁא נפַק מִן קדָמַי בִרגַז שֵׁיצִי עַד שׁאֹול אַרעָיתָא אַסִיף אַרעָא וַעַלַלתַה שֵׁיצִי עַד סִיָפֵיסיָפֵי טוּרַיָא
אַסִיףאוסיף עַלֵיהֹון בִישָׁןבישׁין מַכתָשַׁי אַשֵׁיצֵיאגרי בהֹון
נפִיחֵי כפַן ואַכִילֵי עוּף וֻכתִישֵׁי רוּחִין בִישִׁין ושַׁן חַיַתחיות בָרָא אַגָרֵי בהֹון עִם חַמַתחֵימַת תַנִינַיָא דזָחַלִין בעַפרָא
מִבַרָא תַתכֵיל חַרבָא וֻמִתוָניָאוֻמִתַוָנַיָא חַרגַת מֹותָא אַף עוּלֵימֵיהֹון אַף עוּלֵימָתהֹון יָנקֵיהֹון עִם סָבֵיהֹון
אַמַרִית יחוּל רוּגזִי עַלֵיהֹון וַאַשֵׁיצֵינוּן אַבטֵילאבַטֵיל מִבנֵי אַנָשָׁא דוּכרָנהֹון
אִילוּ לָא פֹון רוּגזָא דסָנאָה כנִישׁ דִלמָא יִתרָרַביתרברב בעֵיל דבָבָא דִלמָא יֵימרוּן ידַנָא תקֵיפַת לַנָא ולָא מִן קדם יוי הַוָת כֹל דָא
אַרֵי עַם מאַבדי עֵיצָא אִינוּן ולֵית בהֹון סוּכלתָנוּ
אִילוּ חַכִימו אִסתַכַלוּ בדָא סַבַרוּ מָא יהֵי בסֹופהֹון
אֵיכדֵין יִרדֹוף חַד לאַלפָא וֻתרֵין יעָרקוּןיעירקון לרִיבֹותָא אַלָהֵין תַקִיפֵיהֹון מסַרִינוּן וַיוי אַשׁלֵימִינוּן
אַרֵי לָא כתוּקפַנָא תוּקפהֹון וֻבַעַלֵי דבָבַנָא הַוֹו דַייָינַנָא
אַרֵי כפֹורעָנוּת עַמָא דִסדֹום פֹורעָנוּתהֹון ולָקוּתהֹון כעַם עַמֹורָא מַחָתהֹון בִישָׁןבִישִׁין כרֵישֵׁי חִיוִין ותוּשִׁלמַתותוּשׁלמַת עוּבָדֵיהֹון כִמרָרָתהֹוןכמרירתהון
הָא כמִרַת תַנִינַיָא כָס פֹורעַנוּתהֹון וֻכרֵישׁ פִתנֵי חִוִין אַכזרָאִין
הַלָא כֹל עֹובָדֵיהֹון גלַן קדָמַי גנִיזִין ליֹום דִינָא באֹוצרָי
קדָמַי פֹורעָנוּתָא וַאַנָא אַשַׁלֵים לעִדָן דיִגלֹון מֵאַרַעהֹון אַרֵי קָרִיב יֹום תבָרהֹון וֻמַבַע דַעַתִיד להֹון
אַרֵי ידִין יוי דִינָא דעַמֵיה ופֹורעָנוּת עַבדֹוהִי צַדִיקַיָא יִתפרַע אַרֵי גלֵי קדָמֹוהִי דִבעִידָן דתִיתַקַףדתתקוף עַלֵיהֹון מַחַת סָנאָה יהֹון מטַלטלִיןמטֻלטלִין וֻשׁבִיקִין
ויֵימַר אָן דַחלָתהֹון תַקִיפָא דַהוֹו רחִיצִין בֵיה
דִתרַב נִכסַתהֹון הַוֹו אָכלִין שָׁתַן חַמַר נִסכֵיהֹון יקוּמוּן כעַן וִיסַעַדוּנכֹון יהֹון עַלֵיכֹון למַגִין
חַזֹו כעַן דַאַנָא אַנָא הוּא ולֵית אַלָה בָר מִנִי אַנָא ממִית וֻמַחֵי מחֵינָא ואַף מסֵינָא ולֵית דמִן ידִי משֵׁיזִיב
אַרֵי אַתקֵינִית בִשׁמַיָא בֵית שׁכִינתִי וַאַמַרִית קַייָם אַנָא לעָלמִין
אִם עַל חַד תרֵין כחֵיזוּ בַרקָא מִסֹוף שׁמַיָא ועַד סֹוף שׁמַיָא תִתגלֵי חַרבִי ותִיתַקַףותִתקַף בדִינָא ידִי אַתֵיב פֹורעָנוּתָא לסָנאַי וֻלבַעַלֵי דבָבַי אַשַׁלֵים
אַרַוֵי גִיררַיגִרַי מִדמָא וחַרבִי תקַטֵילתקטול בעַממַיָא מִדַם קטִילִין וֻשׁבַןושׁביין לאַעַדָאָה כִתרִין מֵרֵישׁ סָנאָה וֻבעֵיל דבָבָא
שַׁבַחוּ עַממַיָא עַמֵיה אַרֵי פֹורעָנוּת עַבדֹוהִי צַדִיקַיָא מִתפרַע ופֹורעָנוּתָא יָתֵיב לסָנאֹוהִי וִיכַפַר עַל אַרעֵיה ועַל עַמֵיה
וַאַתָא מֹשַׁה וֻמַלֵיל יָת כֹל פִתגָמֵי תוּשׁבַחתָא הָדָא קדָם עַמָא הוּא והֹושֵׁעַ בַר נוּן
ושֵׁיצִי מֹשַׁה למַלָלָא יָת כֹל פִתגָמַיָא הָאִלֵין עִם כֹל ישׁראל
וַאַמַר להֹון שַׁוֹו לִיבכֹון לכֹל פִתגָמַיָא דַאַנָא מַסהֵיד בכֹון יֹומָא דֵין דִתפַקדוּנוּנוּן יָת בנֵיכֹון למִיטַר למַעַבַד יָת כֹל פִתגָמֵי אֹורָיתָא הָדָא
אַרֵי לָא פִתגָם רֵיקָן הוּא מִנכֹון אַרֵי הוּא חַיֵיכֹון וֻבפִתגָמָא הָדֵין תֵירכוּןתורכון יֹומִין עַל ארעא דאַתוּן עָברִין יָת יַרדנָא לתַמָן למֵירתַה
וֻמַלֵיל יוי עִם מֹשַׁה בִכרַן יֹומָא הָדֵין למֵימַר
סַק לטוּרָא דעִברָאֵי הָדֵין לטוּרָא דִנבֹו דִבאַרעָא דמֹואָב דעַל אַפֵי ירִחֹו וֻחזִי יָת ארעא דִכנַעַן דַאַנָא יָהֵיב לִבנֵי ישׁראל לאַחסָנָא
ומוּת בטוּרָא דאַת סָלֵיק לתַמָן ואִתכנֵישׁ לעַמָך כמָא דמִית אַהַרֹן אַחוּך בהֹור טוּרָא ואִתכנֵישׁ לעַמֵיה
עַל דשַׁקַרתוּןדסָרֵיבתוּן במֵימרִי בגֹו בנֵי ישׁראל במֵי מַצוּת רקַם מַדברָא דצִין עַל דלָא קַדֵישׁתוּן יָתִי בגֹו בנֵי ישׁראל
אַרֵי מִקבַלמִקָבֵל תִחזִי יָת אַרעָא וֻלתַמָן לָא תֵיעֹול לארעא דַאַנָא יָהֵיב לִבנֵי ישׁראל
ודָא בִרכתָא דבָרֵיך מֹשַׁה נבִיַיא דַיוי יָת בנֵי ישׁראל קדָם מֹותֵיה
וַאַמַר יוי מִסִינַי אִתגלִי וזֵיהֹור יקָרֵיה מִסֵעִיר אִתַחזִי לַנָא אִתגלִי בִגבוּרתֵיה עַל טוּרָא דפַראָן ועִמֵיה רִבוָתריבבת קַדִישִׁין כתָב יַמִינֵיה מִגֹו אִישָׁתָא אֹורָיתָא וִיהַב לַנָא
אַףברם חַבֵיבֵינוּןחִבבִינוּן לשִׁבטַיָא כָל קַדִישֹׁוהִי בֵית ישׁראל בִגבוּרָא אַפֵיקאַפַק מִמצרים ואִנוּן מִדַברִין תחֹות עַנָנָך נָטלִין עַל מֵימרָך
אֹורָיתָא יהַב לַנָא מֹשַׁה מַסרַה ירוּתָא לכִנשָׁת יַעַקֹב
וַהַוָה בישׁראל מַלכָא באִתכנָשׁוּתבאִתכַנָשׁוּת רֵישֵׁי עַמָא כַחַדָא שִׁבטַיָא דישׁראל
יֵיחֵי ראוּבֵן בחַיֵי עָלמָא וֻמֹותָא תִניָנָא לָא ימוּת וִיקַבלוּן בנֹוהִי אַחסָנַתהֹון במִניָנֵיהֹון
ודָא לִיהוּדָה ואַמַר קַבֵיל יוי צלֹותֵיה דִיהוּדָה במִפקֵיה לִקרָבָא לאגחא קרבא וֻלעַמֵיה תָתִיבִינֵיה בִשׁלָם ידֹוהִי יַעבדָן לֵיה פֹורעָנוּתָא מִסָנָואהִי וֻסעֵידוסָעֵיד מִבעֵיל דבָבָא הַוִי לֵיה
וֻללֵוִי אַמַר תוּמַיָא ואוּרַיָא אַלבֵישׁתָא לִגבַר דאִשׁתכַח חַסִיד קדָמָך דנַסִיתָהִידנסיתוהי בנִיסֵיתָא וַהַוָה שׁלִים בחַרתָהִיבחַנתָהִי עַל מֵי מַצוּתָא ואִשׁתכַח מהֵימָן
דעַל אַבוּהִי ועַל אִימֵיה לָא רָחֵים כַד חָבוּ מִן דִינָא ואַפֵי אַחֹוהִי וֻבנֹוהִי לָא נסֵיב אַרֵי נטַרוּ מַטרַתמיטרת מֵימרָך וֻקיָמָך לָא אַשׁנִיוּ
כָשׁרִין אִלֵין דיַלפוּן דִינָך ליַעַקֹב ואֹורָיתָך לישׁראל ישַׁוֹון קטֹורַת בוּסמִין קדָמָך וֻגמִיר לרַעַוָא עַל מַדבחָך
בָרֵיך יוי נִכסֹוהִי וקוּרבַן ידֹוהִי קַבֵיל ברַעַוָא תבַרתַבַר חַרצָא דסָנאֹוהִי וֻדבַעַלֵי דבָבֹוהִי דלָא יקוּמוּן
לבִניָמִן אַמַר רחִמָא דַיוי יִשׁרֵי לרוּחצָן עַלֹוהִי יהֵי מַגִין עַלֹוהִי כֹל יֹומָא וֻבאַרעֵיה תִשׁרֵי שׁכִינתָא
וֻליֹוסֵף אַמַר מבָרכָא מִן קדם יוי אַרעֵיה עָבדָא מַגדָנִיןמיגדנין מִטַלָא דִשׁמַיָא מִלעֵילָא וֻמִמַבוּעֵי עֵינָווָת תהֹומִין דנָגדִין מִמַעַמַקֵי אַרעָא מִלרַע
עָבדָא מַגדָנִין ועַללָן מִיבוּל שִׁמשָׁא עָבדָא מַגדָנִיןמיגדנין מֵרֵישׁ ירַח בִירַח
וֻמֵרֵישׁ טוּרַיָא בַכִירַיָאבקיריא וֻמִטוּב רָמָן דלָא פָסקָן
וֻמִטוּב ארעא וֻמלָאַה רעֵי לֵיה דִשׁכִינתֵיה בִשׁמַיָא ועַל מֹשַׁה אִתגלִי בַאַסַנָא יֵיתִיָן כֹל אִיֵלין לרֵישָׁא דיֹוסֵף גַברָאגֻברָא פרִישָׁא דַאַחֹוהִי
רַבָא דִבנֹוהִי זִיוָא לֵיה גבוּרָן אִתעַבִידָא לֵיה מִן קדָם דתוּקפָא ורוּמָא דִילֵיה בִגבוּרתֵיה עַממַיָא יקַטֵיל כַחדָא עַד סִיָפֵיסיָפֵי ארעא ואִנוּן רִבָוָתָארִבוָתָא דבֵית אַפרַיִם ואִינוּן אַלפַיָא דבֵית מנַשַׁה
ולִזבוּלֻן אַמַר חַדִי זבוּלֻן במִפקָך לאָגָחָא קרָבָא עַל בַעַלֵי דבָבָך ויִשָׁשׁכָר בִמהָכָך למַעַבַד זִמנֵי מֹועַדַיָא בִירוּשׁלַם
שִׁבטַיָא דישׁראל לטוּר בֵית מַקדשָׁא יִתכַנשׁוּן תַמָן יִכסוּן נִכסַת קוּדשִׁין לרַעַוָא אַרֵי נִכסֵי עַממַיָא יֵיכלוּן וסִימָן דמִיטַמרָן בחָלָא יִתגַליָן להֹון
וֻלגָד אַמַר ברִיך דאַפתִי לגָד כלֵיתָא שׁרֵי וקָטֵילוקָטֹול שִׁלטֹונִין עִם מַלכִין
ואִתקַבַל בקָדמֵיתָא דִילֵיה אַרֵי תַמָן באַחסָנתֵיה מֹשַׁה סָפרָא רַבָא דיִשׁרָאֵל קבִירגניז הוּא נפַק ועָל ברֵישׁ עַמָא זָכוָון קדם יוי עַבַדעַבַד ודִינֹוהִי עִם ישׁראל
וֻלדָן אַמַר דָן תַקִיף כגַרכגור אַריָוָן אַרעֵיה שָׁתיָא מִן נַחלַיָא דנָגדִין מִן מַתנָן
וֻלנַפתָלִי אַמַר נַפתָלִי סבַע רַעַוָא וֻמלֵי בִרכָן מִן קדם יוי מַערַב יַם גִנֵיסַרגינוסר ודָרֹומֹוהִי יֵירַת
וֻלאָשֵׁר אַמַר ברִיך מִבַרכַתמִבִרכַת בנַיָא אָשֵׁר יהֵי רַעַוָא לַאַחֹוהִי ויִתרַבָא בתַפנוּקֵי מַלכִין
תַקִיף כבַרזלָאכפרזלא וכִנחָשָׁא וֻכיֹומֵי עֵולֹומוּתָךעֹולֵימוּתָך תוּקפָך
לֵית אלָה אֵילָא אַלָהָא דישׁראל דִשׁכִנתֵיה בִשׁמַיָא בסַעַדָך ותוּקפֵיה בִשׁמֵי מטי עד צית שׁמַיָא
מדֹור אַלָהָא מִלקַדמִין דִבמֵימרֵיה אִתעַבֵיד עָלמָא ותָרֵיך מִן קדָמָך סָנאָה וַאַמַר שֵׁיצִי
ויִשׁרֵי ישׁראל לרוּחצָן בִלחֹודֹוהִי כעֵין בִרכתָא דבָרֵיכִינוּן יַעַקֹב אַבוּהֹוןאבוּהֵין כאַרַע עָבדָא עִיבוּרעבוּר וַחמַר אַף שׁמַיָא דעִלָוֵיהֹון ישַׁמשׁוּנוּנוּן בטַלָא
טוּבָך יִשׁרָאֵל לֵית דִכוָתָך עַמָא דפוּרקָנֵיה מִן קדם יוי תקֹוףתקיף סַעַדָך וֻדמִן קדָמֹוהִי נִצחָן גִבָרוָתָך ויִתכַדבוּן סָנאָך לָך ואַת עַל פִרקַתפריקת צָורֵי מַלכֵיהֹון תִדרֹוך
וֻסלֵיק מֹשַׁה מִמֵישׁרַיָא דמֹואָב לטוּרָא דִנבֹו רֵישׁ רָמתָא דעַל אַפֵי ירֵחֹו ואַחזִיֵיה יוי יָת כֹל ארעא יָת גִלעָד עַד דָן
ויָת כֹל נַפתַלִי ויָת אַרַע אַפרַיִם וֻמנַשַׁה ויָת כֹל אַרַע יהוּדָה עַד יַמָא מַעַרבָאָהבתראה
ויָת דָרֹומָא ויָת מֵישׁרָא בִקעַת ירֵחֹו קִריַת דִקלַיָא עַד צֹעַר
וַאַמַר יוי לָיה דָא אַרעָא דקַיֵימִית לאברהם ליצחק וליעקב למֵימַר לִבנָך אִיתנִינַה אַחזִיתָךחזיתך בעֵינָך וֻלתַמָן לָא תעִיבַר
וֻמִית תַמָן מֹשַׁה עַבדָא דַיוי בארעא דמֹואָב עַל מֵימרָא דַיוי
וֻקבַר יָתֵיה בחִילתָא בארעא דמֹואָב לִקבֵיללָקָבֵיל בֵית פעֹור ולָא ידַע אַנָשׁ יָת קבוּרתֵיה עַד יֹומָא הָדֵין
וֻמֹשַׁה בַר מאָה ועַסרִין שׁנִין כַד מִית לָא כהָת עֵינֵיה ולָא שׁנָא זִיו יקָרָא דאַפֹוהִי
וֻבכֹו בנֵי ישׁראל יָת מֹשַׁה במֵישׁרַיָא דמֹואָב תלָתִין יֹומִין וֻשׁלִימוּ יֹומֵי בכִיתָא אִבלָאאַבלָא דמֹשַׁה
וִיהֹושֻׁעַ בַר נוּן אִתמלִי רוּח חוּכמָאחָכמָא אַרֵי סמַך מֹשַׁה יָת ידֹוהִי עַלֹוהִי וקַבִילוּ מִנֵיה בנֵי ישׁראל וַעַבַדוּ כמָא דפַקֵיד יוי יָת מֹשַׁה
ולָא קָם נבִייָא עֹוד ביִשׁרָאֵל כמֹשַׁה דאִתגלִי לֵיה יוי אַפִין באַפִין
לכֹל אָתַיָא וֻמֹופתַיָא דשַׁלחֵיה יוי למַעַבַד בארעא דמצרים לפרעה וֻלכֹל עַבדֹוהִי וֻלכָל אַרעֵיה
וֻלכָל ידָא תַקִיפתָא וֻלכֹל חַזוָונָא רַבָא דַעַבַד מֹשַׁה לעֵינֵי כָל יִשׁרָאֵל
